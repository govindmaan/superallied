<%
  const isAdmin = user && user.role === 'admin';
  const isMgr   = user && (user.role === 'admin' || user.role === 'manager');
  const can     = (p) => isAdmin || hasPerm(p);

  // Menu = sections → groups → links. `show` decides visibility for the logged-in
  // user; a group or section with nothing visible is not rendered at all.
  // `keys` are the `active` values pages pass in, used when the URL alone doesn't match.
  const menu = [
    { id: 'sales', label: 'Sales', icon: 'bi-graph-up-arrow', groups: [
      { items: [
        { href: '/enquiries',           icon: 'bi-funnel-fill',            label: 'Enquiries',          show: isMgr || can('enquiries'), keys: ['enquiries'] },
        { href: '/enquiries/pipeline',  icon: 'bi-kanban',                 label: 'Enquiry Pipeline',   show: isMgr || can('enquiries') },
        { href: '/enquiries/dashboard', icon: 'bi-bar-chart-fill',         label: 'Enquiry Dashboard',  show: isMgr || can('enquiries') },
        { href: '/customers',           icon: 'bi-people-fill',            label: 'Customers',          show: can('customers'),  keys: ['customers'] },
        { href: '/quotations',          icon: 'bi-file-earmark-text-fill', label: 'Machine Quotations', show: can('quotations'), keys: ['quotations'] },
      ]},
      { label: 'Sales Team', items: [
        { href: '/salespersons',                 icon: 'bi-person-badge-fill', label: 'Salespersons',      show: isMgr, keys: ['salespersons'] },
        { href: '/salespersons/reports/summary', icon: 'bi-bar-chart-fill',    label: 'Sales Reports',     show: isMgr },
        { href: '/calculator',                   icon: 'bi-calculator-fill',   label: 'Profit Calculator', show: isAdmin, keys: ['calculator'] },
      ]},
    ]},
    { id: 'operations', label: 'Operations', icon: 'bi-gear-wide-connected', groups: [
      { items: [
        { href: '/form-22',               icon: 'bi-patch-check-fill', label: 'Form 22',        show: can('quotations'), keys: ['form22'] },
        { href: '/machines',              icon: 'bi-sliders2',         label: 'Machine Master', show: isMgr, keys: ['machines'] },
        { href: '/machines/price-update', icon: 'bi-currency-rupee',   label: 'Update Prices',  show: isMgr },
      ]},
      { label: 'System', items: [
        { href: '/users',    icon: 'bi-person-gear', label: 'Users',    show: isAdmin, keys: ['users'] },
        { href: '/settings', icon: 'bi-sliders',     label: 'Settings', show: isAdmin, keys: ['settings'] },
        { href: '/backup',   icon: 'bi-shield-lock', label: 'Backup & Restore', show: isAdmin, keys: ['backup'] },
      ]},
    ]},
    { id: 'spares', label: 'Spares', icon: 'bi-box-seam-fill', groups: [
      { items: [
        { href: '/spare-quotations',                 icon: 'bi-receipt-cutoff',       label: 'Spare Quotations',   show: can('spare_quotations'), keys: ['spare-quotations'] },
        { href: '/part-orders',                      icon: 'bi-cart-fill',            label: 'Part Orders',        show: can('spare_parts'),      keys: ['part-orders'] },
        { href: '/spare-parts',                      icon: 'bi-boxes',                label: 'Parts Master',       show: can('spare_parts'),      keys: ['spare-parts'] },
        { href: '/stock',                            icon: 'bi-clipboard-data',       label: 'Stock Availability', show: can('stock'),            keys: ['stock'] },
        { href: '/spare-quotations/reports/summary', icon: 'bi-bar-chart-line-fill',  label: 'Parts Reports',      show: can('spare_reports'),    keys: ['spare-reports'] },
      ]},
    ]},
    { id: 'service', label: 'Service', icon: 'bi-tools', groups: [
      { items: [
        { href: '/sold-machines', icon: 'bi-hdd-rack-fill', label: 'Sold Machines', show: can('sold_machines'), keys: ['sold-machines'] },
        { href: '/visits',        icon: 'bi-geo-alt-fill',  label: 'Site Visits',   show: can('field_visit'),   keys: ['visits'] },
        { href: '/my-route',      icon: 'bi-map-fill',      label: 'My Route',      show: can('route_map'),     keys: ['route'] },
      ]},
    ]},
    { id: 'hr', label: 'Human Resources', icon: 'bi-people-fill', groups: [
      { items: [
        { href: '/notifications', icon: 'bi-bell-fill',            label: 'Notifications', show: true, keys: ['notifications'], badge: unreadCount },
        { href: '/attendance',    icon: 'bi-calendar-check-fill',  label: 'Attendance',    show: hasPerm('attendance'), keys: ['attendance'] },
        { href: '/leaves',        icon: 'bi-calendar-x-fill',      label: 'My Leaves',     show: true, keys: ['leaves'] },
        { href: '/salary',        icon: 'bi-cash-coin',            label: 'My Salary',     show: true, keys: ['salary'] },
        { href: '/id-card',       icon: 'bi-credit-card-2-front-fill', label: 'ID Card',   show: true, keys: ['id-card'] },
        { href: '/profile',       icon: 'bi-person-circle',        label: 'My Profile',    show: true, keys: ['profile'] },
      ]},
      { label: 'Expenses', items: [
        { href: '/travel-expenses/new',       icon: 'bi-truck',          label: 'New Travel Expense',  show: can('expense_claim') },
        { href: '/travel-expenses/my',        icon: 'bi-receipt-cutoff', label: 'My Travel Expenses',  show: can('expense_claim'), keys: ['travel-expenses'] },
        { href: '/travel-expenses/queue',     icon: 'bi-check2-square',  label: 'Expense Approvals',   show: can('expense_approval') },
        { href: '/travel-expenses/admin/rates', icon: 'bi-sliders',      label: 'Expense Rate Config', show: isMgr },
      ]},
      { label: 'HR Admin', items: [
        { href: '/hr/dashboard',  icon: 'bi-grid-fill',            label: 'HR Dashboard',      show: can('hr_admin'), keys: ['hr'] },
        { href: '/hr/employees',  icon: 'bi-person-lines-fill',    label: 'Employees',         show: can('hr_admin') },
        { href: '/hr/attendance', icon: 'bi-calendar-week-fill',   label: 'Attendance Report', show: can('hr_admin') },
        { href: '/hr/leaves',     icon: 'bi-check2-square',        label: 'Leave Approvals',   show: can('hr_admin') && can('leave_approval') },
        { href: '/hr/salary',     icon: 'bi-wallet2',              label: 'Salary Manager',    show: can('hr_admin') && can('salary_admin') },
      ]},
    ]},
  ];

  // Drop hidden links / empty groups / empty sections for this user
  menu.forEach(s => {
    s.groups = s.groups.map(g => ({ ...g, items: g.items.filter(i => i.show) })).filter(g => g.items.length);
  });
  const sections = menu.filter(s => s.groups.length);

  // Highlight one link: longest href that prefixes the current URL, else the page's `active` key
  const path = (typeof currentPath !== 'undefined' && currentPath) || '';
  const allLinks = sections.flatMap(s => s.groups.flatMap(g => g.items.map(i => ({ i, s }))));
  let hit = allLinks
    .filter(({ i }) => path === i.href || path.startsWith(i.href + '/'))
    .sort((a, b) => b.i.href.length - a.i.href.length)[0];
  if (!hit) hit = allLinks.find(({ i }) => (i.keys || []).includes(active));
  const activeHref    = hit ? hit.i.href : null;
  const activeSection = hit ? hit.s.id : null;

  // With no active page (Dashboard, Help), open the section that fits the user's role
  const roleHome = { sales: 'sales', staff: 'sales', office: 'sales', service: 'service', hr: 'hr', employee: 'hr' };
  const defaultOpen = activeSection || roleHome[user?.role] || null;
%>

<!-- Mobile Top Bar -->
<div class="mobile-topbar">
  <button class="hamburger-btn" onclick="toggleSidebar()" aria-label="Open menu">
    <i class="bi bi-list"></i>
  </button>
  <a href="/" class="app-title">SUPER ALLIED</a>
  <a href="/help" class="btn btn-sm btn-outline-light ms-auto me-2" title="Help & Updates" aria-label="Help & Updates">
    <i class="bi bi-question-circle"></i>
  </a>
  <a href="/logout" class="btn btn-sm btn-outline-light">
    <i class="bi bi-box-arrow-right"></i>
  </a>
</div>

<!-- Backdrop overlay -->
<div id="sidebarBackdrop" class="sidebar-backdrop" onclick="toggleSidebar()"></div>

<!-- Sidebar -->
<nav id="sidebar" class="d-flex flex-column text-white">

  <!-- Mobile close -->
  <div class="d-flex justify-content-between align-items-center d-lg-none px-3 pt-3 pb-2 border-bottom border-secondary">
    <span class="fw-semibold text-white-50 small text-uppercase" style="font-size:11px">Menu</span>
    <button onclick="toggleSidebar()" class="btn btn-sm text-white border-0 p-0">
      <i class="bi bi-x-lg fs-5"></i>
    </button>
  </div>

  <!-- Brand -->
  <a href="/" class="d-flex align-items-center px-3 pt-3 pb-1 text-white text-decoration-none gap-2">
    <div class="brand-logo flex-shrink-0">SA</div>
    <div>
      <div class="fw-bold lh-1">Super Allied</div>
      <small class="text-white-50" style="font-size:10px">Bull CE Dealer</small>
    </div>
  </a>
  <div class="text-center pb-2">
    <img src="/bull-logo.jpg" alt="Bull" style="height:30px;opacity:0.85;border-radius:4px;" onerror="this.style.display='none'">
  </div>
  <hr class="border-secondary my-0">

  <!-- Universal Search Bar -->
  <div class="p-2 border-bottom border-secondary">
    <div class="search-input-wrapper">
      <div class="input-group input-group-sm">
        <span class="input-group-text bg-secondary border-0"><i class="bi bi-search text-white"></i></span>
        <input type="text" class="form-control border-0" id="universalSearch" placeholder="Search..." autocomplete="off">
      </div>
      <div class="search-dropdown" id="searchDropdown"></div>
    </div>
  </div>

  <!-- Nav -->
  <div class="flex-grow-1 overflow-auto px-2 py-2 sidebar-scroll">

    <!-- Dashboard -->
    <a href="/" class="sb-top-link nav-link text-white d-flex align-items-center gap-2 px-2 py-2 rounded mb-1 <%= active==='dashboard'?'active':'' %>" onclick="closeSidebarOnMobile()">
      <i class="bi bi-speedometer2"></i><span class="fw-semibold">Dashboard</span>
    </a>

    <% sections.forEach(sec => { const open = sec.id === defaultOpen; %>
    <div class="sb-section" data-section="<%= sec.id %>" data-has-active="<%= sec.id === activeSection ? 1 : 0 %>">
      <button type="button" class="sb-section-hdr<%= sec.id === activeSection ? ' has-active' : '' %>" onclick="toggleSection('<%= sec.id %>')" aria-expanded="<%= open %>" aria-controls="section-<%= sec.id %>">
        <i class="bi <%= sec.icon %> sb-sec-icon"></i>
        <span class="flex-grow-1 text-start"><%= sec.label %></span>
        <i class="bi bi-chevron-right sb-chevron<%= open ? ' open' : '' %>"></i>
      </button>
      <div class="sb-section-body<%= open ? ' show' : '' %>" id="section-<%= sec.id %>">
        <% sec.groups.forEach(g => { %>
          <% if (g.label) { %><div class="sb-sub-label"><%= g.label %></div><% } %>
          <% g.items.forEach(it => { %>
          <a href="<%= it.href %>" class="sb-link nav-link<%= it.href === activeHref ? ' active' : '' %>" onclick="closeSidebarOnMobile()">
            <i class="bi <%= it.icon %>"></i><span class="flex-grow-1"><%= it.label %></span>
            <% if (it.badge > 0) { %><span class="badge bg-danger" style="font-size:9px"><%= it.badge %></span><% } %>
          </a>
          <% }) %>
        <% }) %>
      </div>
    </div>
    <% }) %>

  </div><!-- /scrollable -->

  <!-- User strip -->
  <hr class="border-secondary my-0">
  <div class="d-flex align-items-center gap-2 px-3 py-2">
    <div class="flex-grow-1" style="min-width:0">
      <small class="text-white-50" style="font-size:9px">Logged in as</small><br>
      <span class="fw-semibold text-truncate d-block" style="max-width:140px;font-size:13px">
        <%= user ? user.full_name || user.username : '' %>
      </span>
      <% const roleBadge = {admin:'bg-danger',manager:'bg-warning text-dark',sales:'bg-info text-dark',office:'bg-primary',hr:'bg-purple',service:'bg-secondary',staff:'bg-secondary',employee:'bg-success'}; %>
      <span class="badge <%= roleBadge[user?.role] || 'bg-secondary' %>" style="font-size:9px"><%= (user?.role||'').toUpperCase() %></span>
    </div>
    <a href="/help" class="btn btn-sm <%= active==='help'?'btn-light':'btn-outline-light' %> flex-shrink-0" title="Help & Updates" aria-label="Help & Updates">
      <i class="bi bi-question-circle"></i>
    </a>
    <a href="/logout" class="btn btn-sm btn-outline-light flex-shrink-0" title="Logout">
      <i class="bi bi-box-arrow-right"></i>
    </a>
  </div>
</nav>

<style>
/* Section headers */
.sb-section { margin-top: 2px; }
.sb-section-hdr {
  display: flex; align-items: center; gap: 8px; width: 100%;
  padding: 8px 8px; background: none; border: 0;
  font-size: 11px; font-weight: 800; letter-spacing: 1.1px; text-transform: uppercase;
  color: rgba(255,255,255,0.55);
  cursor: pointer; border-radius: 6px;
  user-select: none; transition: background .15s, color .15s;
}
.sb-section-hdr:hover { background: rgba(255,255,255,0.07); color: rgba(255,255,255,0.85); }
.sb-section-hdr .sb-sec-icon { font-size: 14px; width: 16px; text-align: center; }
.sb-section-hdr.has-active { color: #fff; }
.sb-section-hdr .sb-chevron { font-size: 11px; }

/* Chevron animation */
.sb-chevron { transition: transform .2s; }
.sb-chevron.open { transform: rotate(90deg); }

/* Section body */
.sb-section-body { display: none; padding-left: 10px; margin: 0 0 4px 8px; border-left: 1px solid rgba(255,255,255,0.1); }
.sb-section-body.show { display: block; }

/* Nav links inside sections */
#sidebar .sb-link {
  display: flex; align-items: center; gap: 8px;
  padding: 5px 8px; border-radius: 6px; margin-bottom: 1px;
  font-size: 13px; color: rgba(255,255,255,0.72) !important;
  text-decoration: none; transition: background .12s, color .12s;
}
.sb-link i { font-size: 13px; width: 15px; text-align: center; flex-shrink: 0; }
.sb-link:hover { background: rgba(255,255,255,0.1) !important; color: #fff !important; }
.sb-link.active { background: rgba(255,255,255,0.15) !important; color: #fff !important; font-weight: 600; }

/* Top-level dashboard link */
.sb-top-link { font-size: 14px !important; }
.sb-top-link i { font-size: 16px; width: 18px; }
.sb-top-link:hover { background: rgba(255,255,255,0.1); }
.sb-top-link.active { background: rgba(255,255,255,0.16) !important; font-weight: 700 !important; }

/* Sub-labels inside sections */
.sb-sub-label {
  font-size: 9px; font-weight: 700; letter-spacing: 1px;
  color: rgba(255,255,255,0.35); text-transform: uppercase;
  padding: 6px 8px 3px 8px;
}

.sidebar-scroll { scrollbar-width: thin; scrollbar-color: rgba(255,255,255,0.15) transparent; }
</style>

<script>
// Collapsible sections. Each user's open/closed choice is remembered on this device;
// the section holding the current page always opens.
const SB_KEY = 'sb-open:<%= user ? user.id : 0 %>';
function setSection(id, open) {
  const body = document.getElementById('section-' + id);
  if (!body) return;
  body.classList.toggle('show', open);
  const hdr = body.previousElementSibling;
  hdr.setAttribute('aria-expanded', open);
  hdr.querySelector('.sb-chevron').classList.toggle('open', open);
}
function saveSections() {
  const open = [...document.querySelectorAll('.sb-section-body.show')].map(b => b.id.replace('section-', ''));
  try { localStorage.setItem(SB_KEY, JSON.stringify(open)); } catch (e) {}
}
function toggleSection(id) {
  const body = document.getElementById('section-' + id);
  setSection(id, !body.classList.contains('show'));
  saveSections();
}
(function restoreSections() {
  let saved = null;
  try { saved = JSON.parse(localStorage.getItem(SB_KEY)); } catch (e) {}
  if (!Array.isArray(saved)) return; // first visit: keep the server's role-based default
  document.querySelectorAll('.sb-section').forEach(sec => {
    const id = sec.dataset.section;
    setSection(id, saved.includes(id) || sec.dataset.hasActive === '1');
  });
})();
function toggleSidebar() {
  document.getElementById('sidebar').classList.toggle('sidebar-open');
  document.getElementById('sidebarBackdrop').classList.toggle('show');
}
function closeSidebarOnMobile() {
  if (window.innerWidth < 992) {
    document.getElementById('sidebar').classList.remove('sidebar-open');
    document.getElementById('sidebarBackdrop').classList.remove('show');
  }
}

// Universal search
const searchInput = document.getElementById('universalSearch');
const searchDropdown = document.getElementById('searchDropdown');
let searchTimeout;

if (searchInput) {
  searchInput.addEventListener('input', async (e) => {
    clearTimeout(searchTimeout);
    const query = e.target.value.trim();

    if (!query) {
      searchDropdown.classList.remove('show');
      return;
    }

    searchTimeout = setTimeout(async () => {
      try {
        const resp = await fetch(`/api/search?q=${encodeURIComponent(query)}`);
        const results = await resp.json();

        if (!results.results || results.results.length === 0) {
          searchDropdown.innerHTML = '<div class="p-2 text-muted small text-center">No results found</div>';
          searchDropdown.classList.add('show');
          return;
        }

        let html = '';
        let currentCategory = '';

        results.results.forEach(item => {
          if (item.category !== currentCategory) {
            if (currentCategory) html += '</div>';
            html += `<div class="search-result-category">${item.category}</div>`;
            currentCategory = item.category;
          }
          html += `
            <a href="${item.link}" class="search-result-item" onclick="closeSidebarOnMobile()">
              <div class="search-result-title">${item.title}</div>
              ${item.meta ? `<div class="search-result-meta">${item.meta}</div>` : ''}
            </a>
          `;
        });

        searchDropdown.innerHTML = html;
        searchDropdown.classList.add('show');
      } catch(e) {
        searchDropdown.innerHTML = '<div class="p-2 text-danger small">Search error</div>';
        searchDropdown.classList.add('show');
      }
    }, 300);
  });

  document.addEventListener('click', (e) => {
    if (!e.target.closest('.search-input-wrapper')) {
      searchDropdown.classList.remove('show');
    }
  });
}
</script>
