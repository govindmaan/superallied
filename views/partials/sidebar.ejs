<%
  const isAdmin = user && user.role === 'admin';
  const isMgr   = user && (user.role === 'admin' || user.role === 'manager');
  const can     = (p) => isAdmin || hasPerm(p);
  // Route map: everyone who records visits sees their own; admin sees everyone's
  const routeMap = isAdmin || can('field_visit') || can('route_map') || can('enquiries');

  // Menu = sections → groups → links. `show` decides visibility for the logged-in
  // user; a group or section with nothing visible is not rendered at all.
  // `keys` are the `active` values pages pass in, used when the URL alone doesn't match.
  const menu = [
    { id: 'sales', label: t('Sales'), icon: 'bi-graph-up-arrow', groups: [
      { items: [
        { href: '/my-leads',            icon: 'bi-person-badge-fill',      label: t('My Leads'),           show: can('enquiries'), keys: ['myleads'] },
        { href: '/enquiries',           icon: 'bi-funnel-fill',            label: t('Enquiries'),          show: isMgr || can('enquiries'), keys: ['enquiries'] },
        { href: '/enquiries/pipeline',  icon: 'bi-kanban',                 label: t('Enquiry Pipeline'),   show: isMgr || can('enquiries') },
        { href: '/enquiries/dashboard', icon: 'bi-bar-chart-fill',         label: t('Enquiry Dashboard'),  show: isMgr || can('enquiries') },
        { href: '/customers',           icon: 'bi-people-fill',            label: t('Customers'),          show: can('customers'),  keys: ['customers'] },
        { href: '/quotations',          icon: 'bi-file-earmark-text-fill', label: t('Machine Quotations'), show: can('quotations'), keys: ['quotations'] },
      ]},
      { label: t('Sales Team'), items: [
        { href: '/salespersons',                 icon: 'bi-person-badge-fill', label: t('Salespersons'),      show: isMgr, keys: ['salespersons'] },
        { href: '/salespersons/reports/summary', icon: 'bi-bar-chart-fill',    label: t('Sales Reports'),     show: isMgr },
        { href: '/calculator',                   icon: 'bi-calculator-fill',   label: t('Profit Calculator'), show: isAdmin, keys: ['calculator'] },
      ]},
    ]},
    { id: 'databank', label: t('Databank'), icon: 'bi-database-fill', groups: [
      { items: [
        { href: '/databank',        icon: 'bi-search',      label: t('Search Customers'), show: can('databank'), keys: ['databank'] },
        { href: '/databank/access', icon: 'bi-shield-lock', label: t('Databank Access'),  show: isAdmin,         keys: ['databank-access'] },
      ]},
    ]},
    { id: 'telecaller', label: t('Telecaller'), icon: 'bi-telephone-inbound-fill', groups: [
      { items: [
        { href: '/telecaller',             icon: 'bi-grid-1x2-fill',      label: t('Telecaller Home'),  show: can('telecaller'),       keys: ['telecaller'] },
        { href: '/telecaller/new',         icon: 'bi-plus-circle-fill',   label: t('New Enquiry'),      show: can('telecaller') },
        { href: '/telecaller/queue',       icon: 'bi-telephone-outbound', label: t('Call Queue'),       show: can('telecaller') },
        { href: '/telecaller/history',     icon: 'bi-clock-history',      label: t('My Call History'),  show: can('telecaller') },
        { href: '/telecaller/reports',     icon: 'bi-clipboard-data',     label: t('Lead Reports'),     show: can('telecaller_admin'), keys: ['telecaller-reports'] },
        { href: '/telecaller/territories', icon: 'bi-geo-alt-fill',       label: t('Territories'),      show: can('telecaller_admin'), keys: ['telecaller-territories'] },
        { href: '/telecaller/config',      icon: 'bi-sliders',            label: t('Scripts & Pitches'),show: can('telecaller_admin'), keys: ['telecaller-config'] },
      ]},
    ]},
    { id: 'operations', label: t('Operations'), icon: 'bi-gear-wide-connected', groups: [
      { items: [
        { href: '/form-22',               icon: 'bi-patch-check-fill', label: t('Form 22'),        show: can('quotations'), keys: ['form22'] },
        { href: '/machines',              icon: 'bi-sliders2',         label: t('Machine Master'), show: isMgr, keys: ['machines'] },
        { href: '/machines/price-update', icon: 'bi-currency-rupee',   label: t('Update Prices'),  show: isMgr },
      ]},
    ]},
    { id: 'spares', label: t('Spares'), icon: 'bi-box-seam-fill', groups: [
      { items: [
        { href: '/spare-quotations',                 icon: 'bi-receipt-cutoff',       label: t('Spare Quotations'),   show: can('spare_quotations'), keys: ['spare-quotations'] },
        { href: '/part-orders',                      icon: 'bi-cart-fill',            label: t('Part Orders'),        show: can('spare_parts'),      keys: ['part-orders'] },
        { href: '/spare-parts',                      icon: 'bi-boxes',                label: t('Parts Master'),       show: can('spare_parts'),      keys: ['spare-parts'] },
        { href: '/stock',                            icon: 'bi-clipboard-data',       label: t('Stock Availability'), show: can('stock'),            keys: ['stock'] },
        { href: '/spare-quotations/reports/summary', icon: 'bi-bar-chart-line-fill',  label: t('Parts Reports'),      show: can('spare_reports'),    keys: ['spare-reports'] },
      ]},
    ]},
    { id: 'service', label: t('Service'), icon: 'bi-tools', groups: [
      { items: [
        { href: '/complaints',    icon: 'bi-wrench-adjustable', label: t('Machine Complaints'), show: can('service_complaints'), keys: ['complaints'] },
        { href: '/sold-machines', icon: 'bi-hdd-rack-fill', label: t('Sold Machines'), show: can('sold_machines'), keys: ['sold-machines'] },
        { href: '/visits',        icon: 'bi-geo-alt-fill',  label: t('Site Visits'),   show: can('field_visit'),   keys: ['visits'] },
      ]},
    ]},
    { id: 'hr', label: t('Human Resources'), icon: 'bi-people-fill', groups: [
      { items: [
        { href: '/notifications', icon: 'bi-bell-fill',            label: t('Notifications'), show: true, keys: ['notifications'], badge: unreadCount },
        { href: '/attendance',    icon: 'bi-calendar-check-fill',  label: t('Attendance'),    show: hasPerm('attendance'), keys: ['attendance'] },
        { href: '/route-map',     icon: 'bi-map-fill',             label: isAdmin ? 'Route Maps' : 'My Route Map', show: routeMap, keys: ['route'] },
        { href: '/route-map/heatmap', icon: 'bi-fire',             label: t('Visit Heatmap'), show: isAdmin || user.role === 'head_of_finance' },
        { href: '/leaves',        icon: 'bi-calendar-x-fill',      label: t('My Leaves'),     show: true, keys: ['leaves'] },
        { href: '/salary',        icon: 'bi-cash-coin',            label: t('My Salary'),     show: true, keys: ['salary'] },
        { href: '/id-card',       icon: 'bi-credit-card-2-front-fill', label: t('ID Card'),   show: true, keys: ['id-card'] },
        { href: '/profile',       icon: 'bi-person-circle',        label: t('My Profile'),    show: true, keys: ['profile'] },
      ]},
      { label: t('Expenses'), items: [
        { href: '/travel-expenses/new',       icon: 'bi-truck',          label: t('New Travel Expense'),  show: can('expense_claim') },
        { href: '/travel-expenses/my',        icon: 'bi-receipt-cutoff', label: t('My Travel Expenses'),  show: can('expense_claim'), keys: ['travel-expenses'] },
        { href: '/travel-expenses/bills',     icon: 'bi-file-earmark-text', label: t('TA Bills'),          show: can('expense_claim') || can('expense_approval') },
        { href: '/travel-expenses/queue',     icon: 'bi-check2-square',  label: t('Expense Approvals'),   show: can('expense_approval') },
        { href: '/travel-expenses/admin/rates', icon: 'bi-sliders',      label: t('Expense Rate Config'), show: isMgr },
      ]},
      { label: t('HR Admin'), items: [
        { href: '/hr/dashboard',  icon: 'bi-grid-fill',            label: t('HR Dashboard'),      show: can('hr_admin'), keys: ['hr'] },
        { href: '/hr/employees',  icon: 'bi-person-lines-fill',    label: t('Employees'),         show: can('hr_admin') },
        { href: '/org-chart',     icon: 'bi-diagram-3',            label: t('Organisation Chart'), show: can('hr_admin') && !isAdmin },
        { href: '/hr/attendance', icon: 'bi-calendar-week-fill',   label: t('Attendance Report'), show: can('hr_admin') },
        { href: '/hr/attendance/employee', icon: 'bi-person-badge',  label: t('Employee Attendance'), show: isMgr },
        { href: '/hr/leaves',     icon: 'bi-check2-square',        label: t('Leave Approvals'),   show: can('hr_admin') && can('leave_approval') },
        { href: '/hr/salary',     icon: 'bi-wallet2',              label: t('Salary Manager'),    show: can('hr_admin') && can('salary_admin') },
      ]},
    ]},
    { id: 'admin', label: t('Admin'), icon: 'bi-shield-lock-fill', groups: [
      { items: [
        { href: '/users',    icon: 'bi-person-gear', label: t('Users'),            show: isAdmin, keys: ['users'] },
        { href: '/org-chart', icon: 'bi-diagram-3',  label: t('Organisation Chart'), show: isAdmin, keys: ['org-chart'] },
        { href: '/settings', icon: 'bi-sliders',     label: t('Settings'),         show: isAdmin, keys: ['settings'] },
        { href: '/backup',   icon: 'bi-database-down', label: t('Backup & Restore'), show: isAdmin, keys: ['backup'] },
      ]},
    ]},
  ];

  // Drop hidden links / empty groups / empty sections for this user
  menu.forEach(s => {
    s.groups = s.groups.map(g => ({ ...g, items: g.items.filter(i => i.show) })).filter(g => g.items.length);
  });
  const sections = menu.filter(s => s.groups.length);

  // Highlight one link: longest href that prefixes the current URL, else the page's `active` key
  const path = (typeof currentPath !== 'undefined' && currentPath) || '';
  const allLinks = sections.flatMap(s => s.groups.flatMap(g => g.items.map(i => ({ i, s }))));
  let hit = allLinks
    .filter(({ i }) => path === i.href || path.startsWith(i.href + '/'))
    .sort((a, b) => b.i.href.length - a.i.href.length)[0];
  if (!hit) hit = allLinks.find(({ i }) => (i.keys || []).includes(active));
  const activeHref    = hit ? hit.i.href : null;
  const activeSection = hit ? hit.s.id : null;

  // With no active page (Dashboard, Help), open the section that fits the user's role
  const roleHome = { sales: 'sales', staff: 'sales', office: 'sales', service: 'service', hr: 'hr', employee: 'hr', accountant: 'accounts', accounts_manager: 'accounts' };
  const defaultOpen = activeSection || roleHome[user?.role] || null;
%>

<!-- Mobile Top Bar -->
<div class="mobile-topbar">
  <button class="hamburger-btn" onclick="toggleSidebar()" aria-label="<%= t("Open menu") %>">
    <i class="bi bi-list"></i>
  </button>
  <a href="/" class="app-title">SUPER ALLIED</a>
  <% const otherLang = lang === 'hi' ? 'en' : 'hi'; %>
  <button type="button" class="btn btn-sm btn-outline-light ms-auto me-2 lang-btn" onclick="setLang('<%= otherLang %>')" title="<%= t("Language") %>" aria-label="<%= t("Language") %>: <%= LANGS[otherLang].label %>">
    <i class="bi bi-translate me-1"></i><%= LANGS[otherLang].label %>
  </button>
  <a href="/help" class="btn btn-sm btn-outline-light me-2" title="<%= t("Help & Updates") %>" aria-label="<%= t("Help & Updates") %>">
    <i class="bi bi-question-circle"></i>
  </a>
  <a href="/logout" class="btn btn-sm btn-outline-light">
    <i class="bi bi-box-arrow-right"></i>
  </a>
</div>

<%
  // Bottom bar on phones for field staff (sales, service, office…); admin/manager/HR use the sidebar
  const fieldUser = user && !['admin','manager','hr','accountant','accounts_manager'].includes(user.role);
  const p = (typeof currentPath !== 'undefined' && currentPath) || '';
  const bottomNav = (user && user.role === 'telecaller') ? [
    { href: '/telecaller',         icon: 'bi-house-door-fill',     label: t('Home'),       on: p === '/telecaller' },
    { href: '/telecaller/queue',   icon: 'bi-telephone-outbound',  label: t('Call Queue'), on: p.startsWith('/telecaller/call') },
    { href: '/telecaller/new',     icon: 'bi-plus-circle-fill',    label: t('New'),        center: true },
    { href: '/telecaller/history', icon: 'bi-clock-history',       label: t('History'),    on: p.startsWith('/telecaller/history') },
  ] : (user && user.role === 'head_of_finance') ? [
    { href: '/', icon: 'bi-house-door-fill', label: t('Home'), on: p === '/' },
    { href: '/travel-expenses/queue', icon: 'bi-inbox-fill', label: t('Approvals'), on: p.startsWith('/travel-expenses') },
    { href: '/attendance', icon: 'bi-calendar-check-fill', label: t('Attendance'), on: p.startsWith('/attendance') },
    { href: '/route-map', icon: 'bi-map-fill', label: t('Route Map'), on: p.startsWith('/route-map') },
  ] : fieldUser ? [
    { href: '/', icon: 'bi-house-door-fill', label: t('Home'), on: p === '/' },
    can('enquiries')
      ? { href: '/my-leads', icon: 'bi-person-badge-fill', label: t('My Leads'), on: p.startsWith('/my-leads') }
      : can('service_complaints')
      ? { href: '/complaints', icon: 'bi-wrench-adjustable', label: t('Complaints'), on: p.startsWith('/complaints') }
      : { href: '/customers', icon: 'bi-people-fill', label: t('Customers'), on: p.startsWith('/customers') },
    { href: '/?visit=1', icon: 'bi-geo-alt-fill', label: t('Visit'), center: true },
    hasPerm('attendance')
      ? { href: '/attendance', icon: 'bi-calendar-check-fill', label: t('Attendance'), on: p.startsWith('/attendance') }
      : { href: '/leaves', icon: 'bi-calendar-x-fill', label: t('Leaves'), on: p.startsWith('/leaves') },
  ] : [];
%>
<% if (fieldUser) { %>
<nav class="bottom-nav" aria-label="<%= t("Quick navigation") %>">
  <% bottomNav.forEach(b => { %>
  <a href="<%= b.href %>" class="bn-item<%= b.center ? ' bn-center' : '' %><%= b.on ? ' active' : '' %>">
    <span class="bn-icon"><i class="bi <%= b.icon %>"></i></span><span class="bn-label"><%= t(b.label) %></span>
  </a>
  <% }) %>
  <button type="button" class="bn-item" onclick="toggleSidebar()" aria-label="<%= t("Open menu") %>">
    <span class="bn-icon"><i class="bi bi-list"></i></span><span class="bn-label"><%= t("Menu") %></span>
  </button>
</nav>
<% } %>

<!-- Backdrop overlay -->
<div id="sidebarBackdrop" class="sidebar-backdrop" onclick="toggleSidebar()"></div>

<!-- Sidebar -->
<nav id="sidebar" class="d-flex flex-column text-white">

  <!-- Mobile close -->
  <div class="d-flex justify-content-between align-items-center d-lg-none px-3 pt-3 pb-2 border-bottom border-secondary">
    <span class="fw-semibold text-white-50 small text-uppercase" style="font-size:11px"><%= t("Menu") %></span>
    <button onclick="toggleSidebar()" class="btn btn-sm text-white border-0 p-0">
      <i class="bi bi-x-lg fs-5"></i>
    </button>
  </div>

  <!-- Brand -->
  <a href="/" class="d-flex align-items-center px-3 pt-3 pb-1 text-white text-decoration-none gap-2">
    <div class="brand-logo flex-shrink-0">SA</div>
    <div>
      <div class="fw-bold lh-1">Super Allied</div>
      <small class="text-white-50 text-xs"><%= t("Bull CE Dealer") %></small>
    </div>
  </a>
  <div class="text-center pb-2">
    <img src="/bull-logo.jpg" alt="Bull" style="height:30px;opacity:0.85;border-radius:4px;" onerror="this.style.display='none'">
  </div>
  <hr class="border-secondary my-0">

  <!-- Universal Search Bar -->
  <div class="p-2 border-bottom border-secondary">
    <div class="search-input-wrapper">
      <div class="input-group input-group-sm">
        <span class="input-group-text bg-secondary border-0"><i class="bi bi-search text-white"></i></span>
        <input type="text" class="form-control border-0" id="universalSearch" placeholder="<%= t("Search...") %>" autocomplete="off">
      </div>
      <div class="search-dropdown" id="searchDropdown"></div>
    </div>
  </div>

  <!-- Nav -->
  <div class="flex-grow-1 overflow-auto px-2 py-2 sidebar-scroll">

    <!-- Dashboard -->
    <a href="/" class="sb-top-link nav-link text-white d-flex align-items-center gap-2 px-2 py-2 rounded mb-1 <%= active==='dashboard'?'active':'' %>" onclick="closeSidebarOnMobile()">
      <i class="bi bi-speedometer2"></i><span class="fw-semibold"><%= t("Dashboard") %></span>
    </a>

    <% sections.forEach(sec => { const open = sec.id === defaultOpen; %>
    <div class="sb-section" data-section="<%= sec.id %>" data-has-active="<%= sec.id === activeSection ? 1 : 0 %>">
      <button type="button" class="sb-section-hdr<%= sec.id === activeSection ? ' has-active' : '' %>" onclick="toggleSection('<%= sec.id %>')" aria-expanded="<%= open %>" aria-controls="section-<%= sec.id %>">
        <i class="bi <%= sec.icon %> sb-sec-icon"></i>
        <span class="flex-grow-1 text-start"><%= t(sec.label) %></span>
        <i class="bi bi-chevron-right sb-chevron<%= open ? ' open' : '' %>"></i>
      </button>
      <div class="sb-section-body<%= open ? ' show' : '' %>" id="section-<%= sec.id %>">
        <% sec.groups.forEach(g => { %>
          <% if (g.label) { %><div class="sb-sub-label"><%= t(g.label) %></div><% } %>
          <% g.items.forEach(it => { %>
          <a href="<%= it.href %>" class="sb-link nav-link<%= it.href === activeHref ? ' active' : '' %>" onclick="closeSidebarOnMobile()">
            <i class="bi <%= it.icon %>"></i><span class="flex-grow-1"><%= t(it.label) %></span>
            <% if (it.badge > 0) { %><span class="badge bg-danger"><%= it.badge %></span><% } %>
          </a>
          <% }) %>
        <% }) %>
      </div>
    </div>
    <% }) %>

  </div><!-- /scrollable -->

  <!-- Language -->
  <hr class="border-secondary my-0">
  <div class="px-3 py-2 d-flex align-items-center gap-2">
    <i class="bi bi-translate text-white-50" title="<%= t("Language") %>"></i>
    <div class="btn-group btn-group-sm flex-grow-1 lang-switch" role="group" aria-label="<%= t("Language") %>">
      <% Object.entries(LANGS).forEach(([code, L]) => { %>
      <button type="button" class="btn <%= lang === code ? 'btn-light' : 'btn-outline-light' %>" aria-pressed="<%= lang === code %>" onclick="setLang('<%= code %>')"><%= L.label %></button>
      <% }) %>
    </div>
  </div>

  <!-- User strip -->
  <hr class="border-secondary my-0">
  <div class="d-flex align-items-center gap-2 px-3 py-2">
    <div class="flex-grow-1" style="min-width:0">
      <small class="text-white-50 text-xs"><%= t("Logged in as") %></small><br>
      <span class="fw-semibold text-truncate d-block" style="max-width:140px;font-size:13px">
        <%= user ? user.full_name || user.username : '' %>
      </span>
      <% const roleBadge = {admin:'bg-danger',manager:'bg-warning text-dark',sales:'bg-info text-dark',office:'bg-primary',hr:'bg-purple',service:'bg-secondary',staff:'bg-secondary',employee:'bg-success',accountant:'bg-dark',accounts_manager:'bg-dark'}; %>
      <span class="badge <%= roleBadge[user?.role] || 'bg-secondary' %>"><%= (user?.role||'').replace('_', ' ').toUpperCase() %></span>
    </div>
    <a href="/help" class="btn btn-sm <%= active==='help'?'btn-light':'btn-outline-light' %> flex-shrink-0" title="<%= t("Help & Updates") %>" aria-label="<%= t("Help & Updates") %>">
      <i class="bi bi-question-circle"></i>
    </a>
    <a href="/logout" class="btn btn-sm btn-outline-light flex-shrink-0" title="<%= t("Logout") %>">
      <i class="bi bi-box-arrow-right"></i>
    </a>
  </div>
</nav>


<script>
// Collapsible sections. Each user's open/closed choice is remembered on this device;
// the section holding the current page always opens.
const SB_KEY = 'sb-open:<%= user ? user.id : 0 %>';
function setSection(id, open) {
  const body = document.getElementById('section-' + id);
  if (!body) return;
  body.classList.toggle('show', open);
  const hdr = body.previousElementSibling;
  hdr.setAttribute('aria-expanded', open);
  hdr.querySelector('.sb-chevron').classList.toggle('open', open);
}
function saveSections() {
  const open = [...document.querySelectorAll('.sb-section-body.show')].map(b => b.id.replace('section-', ''));
  try { localStorage.setItem(SB_KEY, JSON.stringify(open)); } catch (e) {}
}
function toggleSection(id) {
  const body = document.getElementById('section-' + id);
  setSection(id, !body.classList.contains('show'));
  saveSections();
}
(function restoreSections() {
  let saved = null;
  try { saved = JSON.parse(localStorage.getItem(SB_KEY)); } catch (e) {}
  if (!Array.isArray(saved)) return; // first visit: keep the server's role-based default
  document.querySelectorAll('.sb-section').forEach(sec => {
    const id = sec.dataset.section;
    setSection(id, saved.includes(id) || sec.dataset.hasActive === '1');
  });
})();
function toggleSidebar() {
  document.getElementById('sidebar').classList.toggle('sidebar-open');
  document.getElementById('sidebarBackdrop').classList.toggle('show');
}
function closeSidebarOnMobile() {
  if (window.innerWidth < 992) {
    document.getElementById('sidebar').classList.remove('sidebar-open');
    document.getElementById('sidebarBackdrop').classList.remove('show');
  }
}

// Universal search
const searchInput = document.getElementById('universalSearch');
const searchDropdown = document.getElementById('searchDropdown');
let searchTimeout;

if (searchInput) {
  searchInput.addEventListener('input', async (e) => {
    clearTimeout(searchTimeout);
    const query = e.target.value.trim();

    if (!query) {
      searchDropdown.classList.remove('show');
      return;
    }

    searchTimeout = setTimeout(async () => {
      try {
        const resp = await fetch(`/api/search?q=${encodeURIComponent(query)}`);
        const results = await resp.json();

        if (!results.results || results.results.length === 0) {
          searchDropdown.innerHTML = '<div class="p-2 text-muted small text-center">' + T('No results found') + '</div>';
          searchDropdown.classList.add('show');
          return;
        }

        let html = '';
        let currentCategory = '';

        results.results.forEach(item => {
          if (item.category !== currentCategory) {
            if (currentCategory) html += '</div>';
            html += `<div class="search-result-category">${T(item.category)}</div>`;
            currentCategory = item.category;
          }
          html += `
            <a href="${item.link}" class="search-result-item" onclick="closeSidebarOnMobile()">
              <div class="search-result-title">${item.title}</div>
              ${item.meta ? `<div class="search-result-meta">${item.meta}</div>` : ''}
            </a>
          `;
        });

        searchDropdown.innerHTML = html;
        searchDropdown.classList.add('show');
      } catch(e) {
        searchDropdown.innerHTML = '<div class="p-2 text-danger small">' + T('Search error') + '</div>';
        searchDropdown.classList.add('show');
      }
    }, 300);
  });

  document.addEventListener('click', (e) => {
    if (!e.target.closest('.search-input-wrapper')) {
      searchDropdown.classList.remove('show');
    }
  });
}
</script>
