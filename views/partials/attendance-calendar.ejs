<%
  // Month attendance calendar + day detail (photos, times, location, bike km).
  // Needs: cal, todayStr, monthUrl (prefix for ?m=YYYY-MM links), dayUrl (prefix for the day JSON).
%>
  <!-- Month calendar -->
  <div class="card border-0 shadow-sm">
    <div class="card-header bg-white d-flex align-items-center gap-2">
      <a href="<%= monthUrl %><%= cal.prev %>" class="btn btn-sm btn-outline-secondary" aria-label="Previous month"><i class="bi bi-chevron-left"></i></a>
      <span class="fw-semibold flex-grow-1 text-center"><%= cal.label %></span>
      <% if (cal.next) { %><a href="<%= monthUrl %><%= cal.next %>" class="btn btn-sm btn-outline-secondary" aria-label="Next month"><i class="bi bi-chevron-right"></i></a>
      <% } else { %><span class="btn btn-sm btn-outline-secondary disabled"><i class="bi bi-chevron-right"></i></span><% } %>
    </div>
    <div class="card-body pb-2">
      <div class="d-flex flex-wrap gap-2 mb-3 small">
        <span class="cal-key present">Present <strong><%= cal.totals.present %></strong></span>
        <span class="cal-key absent">Absent <strong><%= cal.totals.absent %></strong></span>
        <span class="cal-key leave">Leave <strong><%= cal.totals.leave %></strong></span>
        <span class="cal-key km">🏍 <strong><%= cal.totals.km.toFixed(0) %></strong> km</span>
      </div>
      <div class="cal-grid">
        <% ['Sun','Mon','Tue','Wed','Thu','Fri','Sat'].forEach(d => { %><div class="cal-dow"><%= d %></div><% }) %>
        <% for (let i = 0; i < cal.lead; i++) { %><div></div><% } %>
        <% cal.cells.forEach(c => { const clickable = ['present','no-checkout'].includes(c.status); %>
        <<%= clickable ? 'button type="button"' : 'div' %> class="cal-day <%= c.status %><%= c.date === todayStr ? ' is-today' : '' %>"
          <% if (clickable) { %>onclick="openDay('<%= c.date %>')" aria-label="<%= c.date %> details"<% } %>>
          <span class="cal-num"><%= c.d %></span>
          <% if (c.km) { %><span class="cal-km"><%= c.km.toFixed(0) %> km</span><% } %>
        </<%= clickable ? 'button' : 'div' %>>
        <% }) %>
      </div>
      <div class="small text-muted mt-2">Tap a present day to see check-in / check-out photos and bike km. Sundays are off.</div>
    </div>
  </div>
<!-- Day detail -->
<div class="modal fade" id="dayModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
    <div class="modal-content">
      <div class="modal-header"><h5 class="modal-title fw-bold" id="dayTitle"></h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
      <div class="modal-body" id="dayBody"><div class="text-center py-4"><div class="spinner-border text-danger"></div></div></div>
    </div>
  </div>
</div>
<style>
.cal-grid { display: grid; grid-template-columns: repeat(7, 1fr); gap: 4px; }
.cal-dow { font-size: 11px; color: #6c757d; text-align: center; font-weight: 600; padding-bottom: 2px; }
.cal-day { aspect-ratio: 1 / 1; border-radius: 10px; border: 1px solid #eee; background: #fff; display: flex; flex-direction: column;
           align-items: center; justify-content: center; padding: 0; min-height: 42px; font: inherit; color: #adb5bd; }
.cal-num { font-weight: 700; font-size: 14px; line-height: 1; }
.cal-km  { font-size: 9px; margin-top: 2px; }
.cal-day.present     { background: #d1e7dd; border-color: #a3cfbb; color: #0f5132; }
.cal-day.no-checkout { background: #fff3cd; border-color: #ffe69c; color: #664d03; }
.cal-day.absent      { background: #f8d7da; border-color: #f1aeb5; color: #842029; }
.cal-day.leave       { background: #cfe2ff; border-color: #9ec5fe; color: #084298; }
.cal-day.off         { background: #f8f9fa; color: #adb5bd; }
.cal-day.today       { color: #212529; }
.cal-day.is-today    { outline: 2px solid #cc0000; outline-offset: 1px; }
button.cal-day:active { transform: scale(.96); }
.cal-key { padding: 3px 10px; border-radius: 20px; }
.cal-key.present { background: #d1e7dd; color: #0f5132; }
.cal-key.absent  { background: #f8d7da; color: #842029; }
.cal-key.leave   { background: #cfe2ff; color: #084298; }
.cal-key.km      { background: #f1f3f5; color: #343a40; }
.day-photo { width: 100%; aspect-ratio: 1 / 1; object-fit: cover; border-radius: 10px; background: #f1f3f5; }
</style>
<script>
function openDay(date) {
  const modal = bootstrap.Modal.getOrCreateInstance(document.getElementById('dayModal'));
  document.getElementById('dayTitle').textContent = new Date(date + 'T00:00:00').toLocaleDateString('en-IN', { weekday: 'long', day: 'numeric', month: 'long' });
  const body = document.getElementById('dayBody');
  body.innerHTML = '<div class="text-center py-4"><div class="spinner-border text-danger"></div></div>';
  modal.show();
  fetch(<%- JSON.stringify(dayUrl) %> + date).then(r => r.json()).then(d => {
    const t = v => v ? new Date(v).toLocaleTimeString('en-IN', { hour: '2-digit', minute: '2-digit' }) : '—';
    const map = (lat, lng) => lat ? `<a href="https://maps.google.com/?q=${lat},${lng}" target="_blank" rel="noopener" class="small"><i class="bi bi-geo-alt-fill text-danger"></i> Location</a>` : '';
    const photo = (src, alt) => src ? `<a href="${src}" target="_blank" rel="noopener"><img src="${src}" class="day-photo" alt="${alt}" loading="lazy"></a>`
                                    : '<div class="day-photo d-flex align-items-center justify-content-center small text-muted">No photo</div>';
    const a = d.att || {}, j = d.journey;
    let html = `<div class="row g-3">
      <div class="col-6"><div class="fw-semibold small mb-1 text-success"><i class="bi bi-box-arrow-in-right"></i> Check in · ${t(a.check_in_time)}</div>${photo(a.check_in_photo, 'Check-in selfie')}<div class="mt-1">${map(a.check_in_lat, a.check_in_lng)}</div></div>
      <div class="col-6"><div class="fw-semibold small mb-1 text-danger"><i class="bi bi-box-arrow-right"></i> Check out · ${t(a.check_out_time)}</div>${photo(a.check_out_photo, 'Check-out selfie')}<div class="mt-1">${map(a.check_out_lat, a.check_out_lng)}</div></div>
    </div>`;
    if (a.check_in_time && a.check_out_time) {
      const hrs = ((new Date(a.check_out_time) - new Date(a.check_in_time)) / 3600000).toFixed(1);
      html += `<div class="small text-muted mt-2">${hrs} hours on duty · ${d.visits} site visit${d.visits === 1 ? '' : 's'}</div>`;
    }
    if (j) {
      html += `<hr><div class="fw-semibold mb-2">🏍 Bike: <span class="text-primary">${j.total_km != null ? Number(j.total_km).toFixed(1) + ' km' : 'journey not closed'}</span></div>
      <div class="row g-3">
        <div class="col-6"><div class="small mb-1">Start odometer: <strong>${j.start_km ?? '—'}</strong></div>${photo(j.start_photo, 'Start odometer')}</div>
        <div class="col-6"><div class="small mb-1">End odometer: <strong>${j.end_km ?? '—'}</strong></div>${photo(j.end_photo, 'End odometer')}</div>
      </div>`;
    } else {
      html += '<hr><div class="small text-muted">No bike km recorded this day.</div>';
    }
    body.innerHTML = html;
  }).catch(() => { body.innerHTML = '<div class="text-danger">Could not load this day.</div>'; });
}
</script>
