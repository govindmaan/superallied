<%- include('../partials/head', { title }) %>
<%- include('../partials/sidebar', { active: 'salespersons', user }) %>
<div class="main-content">
  <div class="page-header d-flex justify-content-between align-items-center mb-4">
    <h4 class="mb-0 fw-bold"><i class="bi bi-person-badge-fill me-2 text-danger"></i>Salespersons</h4>
    <a href="/salespersons/new" class="btn btn-danger"><i class="bi bi-plus-lg me-1"></i>Add Salesperson</a>
  </div>

  <% if (flash.success) { %><div class="alert alert-success alert-dismissible"><%= flash.success %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div><% } %>
  <% if (flash.error) { %><div class="alert alert-danger alert-dismissible"><%= flash.error %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div><% } %>

  <div class="card border-0 shadow-sm">
    <div class="table-responsive">
      <table class="table table-hover mb-0">
        <thead class="table-light">
          <tr>
            <th>Name</th>
            <th>Phone</th>
            <th>Email</th>
            <th>Territory</th>
            <th>Monthly Target</th>
            <th>Status</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% salespersons.forEach(sp => { %>
          <tr>
            <td class="fw-semibold"><%= sp.name %></td>
            <td><%= sp.phone %></td>
            <td><small class="text-muted"><%= sp.email %></small></td>
            <td><small class="text-muted"><%= sp.territory %></small></td>
            <td><span class="badge bg-info">₹<%= sp.target_monthly.toLocaleString('en-IN') %></span></td>
            <td><span class="badge <%= sp.active ? 'bg-success' : 'bg-secondary' %>"><%= sp.active ? 'Active' : 'Inactive' %></span></td>
            <td>
              <% if (sp.active) { %>
                <a href="/salespersons/<%= sp.id %>/edit" class="btn btn-sm btn-outline-primary me-1" title="Edit">
                  <i class="bi bi-pencil"></i>
                </a>
                <form method="POST" action="/salespersons/<%= sp.id %>/delete" style="display:inline" onsubmit="return confirm('Deactivate this salesperson?')">
                  <button type="submit" class="btn btn-sm btn-outline-danger" title="Deactivate">
                    <i class="bi bi-trash"></i>
                  </button>
                </form>
              <% } else { %>
                <a href="/salespersons/<%= sp.id %>/edit" class="btn btn-sm btn-outline-secondary me-1" title="Edit">
                  <i class="bi bi-pencil"></i>
                </a>
                <form method="POST" action="/salespersons/<%= sp.id %>/delete" style="display:inline" onsubmit="return confirm('Reactivate this salesperson?')">
                  <button type="submit" class="btn btn-sm btn-outline-success" title="Reactivate">
                    <i class="bi bi-arrow-repeat"></i>
                  </button>
                </form>
              <% } %>
            </td>
          </tr>
          <% }) %>
          <% if (!salespersons.length) { %>
          <tr><td colspan="7" class="text-center text-muted py-4">No salespersons found. <a href="/salespersons/new">Add one</a></td></tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body></html>
