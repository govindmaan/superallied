<%- include('partials/head', { title }) %>
<%- include('partials/sidebar', { active: 'id-card', user }) %>
<div class="main-content">
  <div class="page-header d-flex justify-content-between align-items-center mb-4">
    <h4 class="mb-0 fw-bold"><i class="bi bi-credit-card-2-front me-2 text-danger"></i><%= t("Employee ID Card") %></h4>
    <div class="d-flex gap-2">
      <button onclick="window.print()" class="btn btn-outline-secondary"><i class="bi bi-printer me-1"></i><%= t("Print") %></button>
      <a href="<%= adminView ? '/hr/employees/'+emp.id+'/id-card/pdf' : '/id-card/pdf' %>" class="btn btn-danger">
        <i class="bi bi-file-pdf me-1"></i><%= t("Download PDF") %>
      </a>
      <% if (adminView) { %><a href="/hr/employees/<%= emp.id %>" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i><%= t("Back") %></a><% } %>
    </div>
  </div>

  <div class="d-flex justify-content-center">
    <div class="id-card-preview">
      <!-- Header -->
      <div class="id-card-header">
        <div class="id-card-company"><%= settings.company_name %></div>
        <div class="id-card-subtitle"><%= settings.dealer_of %></div>
      </div>
      <!-- Body -->
      <div class="id-card-body">
        <div class="text-center mb-3">
          <% if (emp.photo_path) { %>
            <img src="<%= emp.photo_path %>" class="id-photo">
          <% } else { %>
            <div class="id-photo-placeholder"><%= (emp.full_name||'?').charAt(0).toUpperCase() %></div>
          <% } %>
        </div>
        <div class="id-name"><%= emp.full_name %></div>
        <div class="id-designation"><%= emp.designation || t('Employee') %></div>
        <div class="id-dept"><%= emp.department || '' %></div>
        <hr class="my-2">
        <div class="id-detail-row"><span><%= t("Emp. Code") %></span><span class="fw-bold"><%= emp.employee_code || '—' %></span></div>
        <div class="id-detail-row"><span><%= t("Mobile") %></span><span class="fw-bold"><%= emp.mobile || '—' %></span></div>
        <div class="id-detail-row"><span><%= t("DOJ") %></span><span class="fw-bold"><%= emp.date_of_joining || '—' %></span></div>
        <div class="id-detail-row"><span><%= t("Emergency") %></span><span><%= emp.emergency_contact || '—' %></span></div>
        <hr class="my-2">
        <div class="text-center">
          <img src="<%= qrDataUrl %>" style="width:90px;height:90px">
          <div style="font-size:9px;color:#666;margin-top:2px"><%= t("Scan to verify") %></div>
        </div>
      </div>
      <!-- Footer -->
      <div class="id-card-footer"><%= settings.company_address %></div>
    </div>
  </div>
</div>

<style>
.id-card-preview {
  width: 320px;
  border-radius: 14px;
  overflow: hidden;
  box-shadow: 0 8px 32px rgba(0,0,0,0.18);
  background: #fff;
  border: 1px solid #eee;
}
.id-card-header {
  background: linear-gradient(135deg, #cc0000 0%, #8b0000 100%);
  padding: 16px 16px 12px;
  text-align: center;
  color: #fff;
}
.id-card-company { font-size: 20px; font-weight: 900; letter-spacing: 1px; }
.id-card-subtitle { font-size: 10px; opacity: 0.85; margin-top: 2px; }
.id-card-body { padding: 16px; }
.id-photo { width: 90px; height: 90px; border-radius: 50%; object-fit: cover; border: 3px solid #cc0000; }
.id-photo-placeholder {
  width: 90px; height: 90px; border-radius: 50%;
  background: #cc0000; color: #fff;
  display: flex; align-items: center; justify-content: center;
  font-size: 2.5rem; font-weight: 900; margin: 0 auto;
}
.id-name { text-align: center; font-size: 17px; font-weight: 800; margin-top: 6px; }
.id-designation { text-align: center; font-size: 12px; color: #cc0000; font-weight: 600; }
.id-dept { text-align: center; font-size: 11px; color: #666; }
.id-detail-row {
  display: flex; justify-content: space-between;
  font-size: 11px; padding: 2px 0; color: #444;
}
.id-card-footer {
  background: #f8f8f8;
  padding: 8px 12px;
  text-align: center;
  font-size: 9px;
  color: #666;
  border-top: 1px solid #eee;
}
@media print {
  .main-content > *:not(.d-flex.justify-content-center),
  .page-header, nav, .mobile-topbar { display: none !important; }
  .id-card-preview { box-shadow: none; border: 1px solid #ccc; }
}
</style>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body></html>
