<%- include('partials/head', { title }) %>
<%- include('partials/sidebar', { active: 'attendance', user }) %>
<div class="main-content">
  <div class="page-header d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0 fw-bold"><i class="bi bi-calendar-check me-2 text-danger"></i>My Attendance</h4>
    <small class="text-muted"><%= todayStr %></small>
  </div>

  <% if (flash.success) { %><div class="alert alert-success alert-dismissible"><%= flash.success %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div><% } %>
  <% if (flash.error)   { %><div class="alert alert-danger  alert-dismissible"><%= flash.error   %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div><% } %>

  <!-- Today's status card -->
  <div class="card border-0 shadow-sm mb-4">
    <div class="card-header bg-white fw-semibold">Today — <%= todayStr %></div>
    <div class="card-body text-center py-4">
      <% if (!todayRec || !todayRec.check_in_time) { %>
        <p class="text-muted mb-3">You have <strong>not checked in</strong> today.</p>
        <button class="btn btn-success btn-lg px-5 fw-bold" onclick="startCapture('checkin')">
          <i class="bi bi-box-arrow-in-right me-2"></i>Check In + Start Journey
        </button>
      <% } else if (!todayRec.check_out_time) { %>
        <div class="row justify-content-center g-3 mb-3">
          <div class="col-auto text-center">
            <span class="badge bg-success fs-6 mb-1">✓ Checked In</span><br>
            <small class="text-muted"><%= new Date(todayRec.check_in_time).toLocaleTimeString('en-IN',{hour:'2-digit',minute:'2-digit'}) %></small>
            <% if (todayRec.check_in_photo) { %><div class="mt-1"><img src="<%= todayRec.check_in_photo %>" style="height:70px;border-radius:8px;border:2px solid #28a745"></div><% } %>
          </div>
          <% if (todayJourney?.start_km) { %>
          <div class="col-auto text-center">
            <span class="badge bg-primary fs-6 mb-1">🏍 Start KM</span><br>
            <small class="text-muted"><strong><%= todayJourney.start_km %></strong> km</small>
            <% if (todayJourney.start_photo) { %><div class="mt-1"><img src="<%= todayJourney.start_photo %>" style="height:70px;border-radius:8px;border:2px solid #0d6efd"></div><% } %>
          </div>
          <% } %>
        </div>
        <button class="btn btn-danger btn-lg px-5 fw-bold" onclick="startCapture('checkout')">
          <i class="bi bi-box-arrow-right me-2"></i>Check Out + End Journey
        </button>
      <% } else { %>
        <div class="row justify-content-center g-3">
          <div class="col-auto text-center">
            <span class="badge bg-success fs-6">✓ In</span><br>
            <small class="text-muted"><%= new Date(todayRec.check_in_time).toLocaleTimeString('en-IN',{hour:'2-digit',minute:'2-digit'}) %></small>
            <% if (todayRec.check_in_photo) { %><div class="mt-1"><img src="<%= todayRec.check_in_photo %>" style="height:60px;border-radius:8px"></div><% } %>
          </div>
          <% if (todayJourney?.start_km) { %>
          <div class="col-auto text-center">
            <span class="badge bg-primary fs-6">🏍 Start</span><br>
            <small class="fw-bold text-primary"><%= todayJourney.start_km %> km</small>
          </div>
          <% } %>
          <% if (todayJourney?.end_km) { %>
          <div class="col-auto text-center">
            <span class="badge bg-secondary fs-6">🏍 End</span><br>
            <small class="fw-bold text-secondary"><%= todayJourney.end_km %> km</small>
          </div>
          <% } %>
          <div class="col-auto text-center">
            <span class="badge bg-secondary fs-6">✓ Out</span><br>
            <small class="text-muted"><%= new Date(todayRec.check_out_time).toLocaleTimeString('en-IN',{hour:'2-digit',minute:'2-digit'}) %></small>
            <% if (todayRec.check_out_photo) { %><div class="mt-1"><img src="<%= todayRec.check_out_photo %>" style="height:60px;border-radius:8px"></div><% } %>
          </div>
        </div>
        <% if (todayJourney?.total_km > 0) { %>
        <div class="mt-3">
          <span class="badge bg-success fs-5">🏍 Total: <%= todayJourney.total_km.toFixed(1) %> km today</span>
        </div>
        <% } %>
        <p class="text-success fw-bold mt-3 mb-0">✅ Attendance complete for today.</p>
      <% } %>
    </div>
  </div>

  <!-- Month calendar -->
  <div class="card border-0 shadow-sm">
    <div class="card-header bg-white d-flex align-items-center gap-2">
      <a href="/attendance?m=<%= cal.prev %>" class="btn btn-sm btn-outline-secondary" aria-label="Previous month"><i class="bi bi-chevron-left"></i></a>
      <span class="fw-semibold flex-grow-1 text-center"><%= cal.label %></span>
      <% if (cal.next) { %><a href="/attendance?m=<%= cal.next %>" class="btn btn-sm btn-outline-secondary" aria-label="Next month"><i class="bi bi-chevron-right"></i></a>
      <% } else { %><span class="btn btn-sm btn-outline-secondary disabled"><i class="bi bi-chevron-right"></i></span><% } %>
    </div>
    <div class="card-body pb-2">
      <div class="d-flex flex-wrap gap-2 mb-3 small">
        <span class="cal-key present">Present <strong><%= cal.totals.present %></strong></span>
        <span class="cal-key absent">Absent <strong><%= cal.totals.absent %></strong></span>
        <span class="cal-key leave">Leave <strong><%= cal.totals.leave %></strong></span>
        <span class="cal-key km">🏍 <strong><%= cal.totals.km.toFixed(0) %></strong> km</span>
      </div>
      <div class="cal-grid">
        <% ['Sun','Mon','Tue','Wed','Thu','Fri','Sat'].forEach(d => { %><div class="cal-dow"><%= d %></div><% }) %>
        <% for (let i = 0; i < cal.lead; i++) { %><div></div><% } %>
        <% cal.cells.forEach(c => { const clickable = ['present','no-checkout'].includes(c.status); %>
        <<%= clickable ? 'button type="button"' : 'div' %> class="cal-day <%= c.status %><%= c.date === todayStr ? ' is-today' : '' %>"
          <% if (clickable) { %>onclick="openDay('<%= c.date %>')" aria-label="<%= c.date %> details"<% } %>>
          <span class="cal-num"><%= c.d %></span>
          <% if (c.km) { %><span class="cal-km"><%= c.km.toFixed(0) %> km</span><% } %>
        </<%= clickable ? 'button' : 'div' %>>
        <% }) %>
      </div>
      <div class="small text-muted mt-2">Tap a present day to see check-in / check-out photos and bike km. Sundays are off.</div>
    </div>
  </div>
</div>

<!-- Day detail -->
<div class="modal fade" id="dayModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
    <div class="modal-content">
      <div class="modal-header"><h5 class="modal-title fw-bold" id="dayTitle"></h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
      <div class="modal-body" id="dayBody"><div class="text-center py-4"><div class="spinner-border text-danger"></div></div></div>
    </div>
  </div>
</div>
<style>
.cal-grid { display: grid; grid-template-columns: repeat(7, 1fr); gap: 4px; }
.cal-dow { font-size: 11px; color: #6c757d; text-align: center; font-weight: 600; padding-bottom: 2px; }
.cal-day { aspect-ratio: 1 / 1; border-radius: 10px; border: 1px solid #eee; background: #fff; display: flex; flex-direction: column;
           align-items: center; justify-content: center; padding: 0; min-height: 42px; font: inherit; color: #adb5bd; }
.cal-num { font-weight: 700; font-size: 14px; line-height: 1; }
.cal-km  { font-size: 9px; margin-top: 2px; }
.cal-day.present     { background: #d1e7dd; border-color: #a3cfbb; color: #0f5132; }
.cal-day.no-checkout { background: #fff3cd; border-color: #ffe69c; color: #664d03; }
.cal-day.absent      { background: #f8d7da; border-color: #f1aeb5; color: #842029; }
.cal-day.leave       { background: #cfe2ff; border-color: #9ec5fe; color: #084298; }
.cal-day.off         { background: #f8f9fa; color: #adb5bd; }
.cal-day.today       { color: #212529; }
.cal-day.is-today    { outline: 2px solid #cc0000; outline-offset: 1px; }
button.cal-day:active { transform: scale(.96); }
.cal-key { padding: 3px 10px; border-radius: 20px; }
.cal-key.present { background: #d1e7dd; color: #0f5132; }
.cal-key.absent  { background: #f8d7da; color: #842029; }
.cal-key.leave   { background: #cfe2ff; color: #084298; }
.cal-key.km      { background: #f1f3f5; color: #343a40; }
.day-photo { width: 100%; aspect-ratio: 1 / 1; object-fit: cover; border-radius: 10px; background: #f1f3f5; }
</style>
<script>
function openDay(date) {
  const modal = bootstrap.Modal.getOrCreateInstance(document.getElementById('dayModal'));
  document.getElementById('dayTitle').textContent = new Date(date + 'T00:00:00').toLocaleDateString('en-IN', { weekday: 'long', day: 'numeric', month: 'long' });
  const body = document.getElementById('dayBody');
  body.innerHTML = '<div class="text-center py-4"><div class="spinner-border text-danger"></div></div>';
  modal.show();
  fetch('/attendance/api/day/' + date).then(r => r.json()).then(d => {
    const t = v => v ? new Date(v).toLocaleTimeString('en-IN', { hour: '2-digit', minute: '2-digit' }) : '—';
    const map = (lat, lng) => lat ? `<a href="https://maps.google.com/?q=${lat},${lng}" target="_blank" rel="noopener" class="small"><i class="bi bi-geo-alt-fill text-danger"></i> Location</a>` : '';
    const photo = (src, alt) => src ? `<a href="${src}" target="_blank" rel="noopener"><img src="${src}" class="day-photo" alt="${alt}" loading="lazy"></a>`
                                    : '<div class="day-photo d-flex align-items-center justify-content-center small text-muted">No photo</div>';
    const a = d.att || {}, j = d.journey;
    let html = `<div class="row g-3">
      <div class="col-6"><div class="fw-semibold small mb-1 text-success"><i class="bi bi-box-arrow-in-right"></i> Check in · ${t(a.check_in_time)}</div>${photo(a.check_in_photo, 'Check-in selfie')}<div class="mt-1">${map(a.check_in_lat, a.check_in_lng)}</div></div>
      <div class="col-6"><div class="fw-semibold small mb-1 text-danger"><i class="bi bi-box-arrow-right"></i> Check out · ${t(a.check_out_time)}</div>${photo(a.check_out_photo, 'Check-out selfie')}<div class="mt-1">${map(a.check_out_lat, a.check_out_lng)}</div></div>
    </div>`;
    if (a.check_in_time && a.check_out_time) {
      const hrs = ((new Date(a.check_out_time) - new Date(a.check_in_time)) / 3600000).toFixed(1);
      html += `<div class="small text-muted mt-2">${hrs} hours on duty · ${d.visits} site visit${d.visits === 1 ? '' : 's'}</div>`;
    }
    if (j) {
      html += `<hr><div class="fw-semibold mb-2">🏍 Bike: <span class="text-primary">${j.total_km != null ? Number(j.total_km).toFixed(1) + ' km' : 'journey not closed'}</span></div>
      <div class="row g-3">
        <div class="col-6"><div class="small mb-1">Start odometer: <strong>${j.start_km ?? '—'}</strong></div>${photo(j.start_photo, 'Start odometer')}</div>
        <div class="col-6"><div class="small mb-1">End odometer: <strong>${j.end_km ?? '—'}</strong></div>${photo(j.end_photo, 'End odometer')}</div>
      </div>`;
    } else {
      html += '<hr><div class="small text-muted">No bike km recorded this day.</div>';
    }
    body.innerHTML = html;
  }).catch(() => { body.innerHTML = '<div class="text-danger">Could not load this day.</div>'; });
}
</script>

<!-- ── Attendance + Journey Modal ───────────────────────────────────────────── -->
<div class="modal fade" id="punchModal" tabindex="-1" data-bs-backdrop="static" data-bs-keyboard="false">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">

      <!-- Step 1: Selfie camera -->
      <div id="s1" class="modal-step">
        <div class="modal-header border-0 pb-0">
          <h5 class="modal-title fw-bold" id="s1Title">📸 Take Selfie</h5>
        </div>
        <div class="modal-body text-center pb-2">
          <video id="selfieVideo" autoplay playsinline style="width:100%;border-radius:10px;max-height:280px;background:#000"></video>
          <div id="gpsStatus" class="mt-2 small text-muted"><i class="bi bi-geo-alt me-1"></i>Getting location…</div>
          <div class="mt-3 d-flex gap-2 justify-content-center">
            <button class="btn btn-danger px-5 fw-bold" onclick="snapSelfie()" id="snapBtn" disabled>
              <i class="bi bi-camera-fill me-1"></i>Take Selfie & Continue
            </button>
          </div>
          <button class="btn btn-link text-muted btn-sm mt-2" onclick="closeModal()">Cancel</button>
        </div>
      </div>

      <!-- Step 2: Submitting selfie -->
      <div id="s2" class="modal-step d-none text-center py-5">
        <div class="spinner-border text-danger mb-3"></div>
        <p class="text-muted">Saving attendance…</p>
      </div>

      <!-- Step 3: Journey (KM entry) -->
      <div id="s3" class="modal-step d-none">
        <div class="modal-header border-0 pb-0">
          <h5 class="modal-title fw-bold" id="s3Title">🏍 Journey Details</h5>
        </div>
        <div class="modal-body">
          <div class="alert alert-success py-2 small" id="s3AttMsg">✓ Attendance marked!</div>
          <div class="mb-3">
            <label class="form-label fw-bold fs-6" id="s3KmLabel">Starting KM (Odometer Reading)</label>
            <input type="number" id="kmInput" class="form-control form-control-lg text-center fw-bold"
                   placeholder="e.g. 12450" min="0" inputmode="numeric">
            <small class="text-muted" id="s3KmHint">Enter the current reading on your bike/car odometer</small>
          </div>
          <div id="s3StartKmInfo" class="alert alert-info py-2 small d-none"></div>
          <div class="d-flex gap-2">
            <button class="btn btn-primary flex-grow-1 fw-bold" onclick="goToVehicleCamera()" id="vehiclePhotoBtn">
              <i class="bi bi-camera-fill me-1"></i>Take Vehicle Photo
            </button>
            <button class="btn btn-outline-secondary" onclick="skipJourney()">Skip</button>
          </div>
        </div>
      </div>

      <!-- Step 4: Vehicle camera (rear) -->
      <div id="s4" class="modal-step d-none">
        <div class="modal-header border-0 pb-0">
          <h5 class="modal-title fw-bold">📷 Vehicle Photo</h5>
        </div>
        <div class="modal-body text-center pb-2">
          <p class="text-muted small mb-2">Point camera at your vehicle (odometer visible is better)</p>
          <video id="vehicleVideo" autoplay playsinline style="width:100%;border-radius:10px;max-height:280px;background:#000"></video>
          <div class="mt-3 d-flex gap-2 justify-content-center">
            <button class="btn btn-primary px-5 fw-bold" onclick="snapVehicle()" id="vehicleSnapBtn">
              <i class="bi bi-camera-fill me-1"></i>Snap Vehicle
            </button>
          </div>
          <button class="btn btn-link text-muted btn-sm mt-1" onclick="skipJourney()">Skip vehicle photo</button>
        </div>
      </div>

      <!-- Step 5: Submitting journey -->
      <div id="s5" class="modal-step d-none text-center py-5">
        <div class="spinner-border text-primary mb-3"></div>
        <p class="text-muted">Saving journey details…</p>
      </div>

      <!-- Step 6: Final success -->
      <div id="s6" class="modal-step d-none text-center py-4 px-3">
        <i class="bi bi-check-circle-fill text-success" style="font-size:3.5rem"></i>
        <h5 class="fw-bold mt-3" id="s6Title">All Done!</h5>
        <p class="text-muted" id="s6Msg"></p>
        <button class="btn btn-success px-5 fw-bold" onclick="closeModal()">Close</button>
      </div>

      <!-- Step 7: Error -->
      <div id="s7" class="modal-step d-none text-center py-4 px-3">
        <i class="bi bi-exclamation-circle-fill text-danger" style="font-size:3rem"></i>
        <p class="fw-bold mt-2" id="s7Msg">Something went wrong.</p>
        <button class="btn btn-outline-danger" onclick="closeModal()">Close</button>
      </div>

    </div>
  </div>
</div>

<style>
.modal-step { padding: 0 4px; }
</style>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
const EMPLOYEE_NAME = '<%= (user.full_name || user.username).replace(/'/g, "\\'") %>';
let _type, _selfieStream, _vehicleStream, _lat = null, _lng = null, _selfiePhoto, _vehiclePhoto;

function showStep(n) {
  [1,2,3,4,5,6,7].forEach(i => document.getElementById('s'+i).classList.add('d-none'));
  document.getElementById('s'+n).classList.remove('d-none');
}

async function startCapture(type) {
  _type = type;
  _lat = null; _lng = null; _selfiePhoto = null; _vehiclePhoto = null;

  document.getElementById('s1Title').textContent = type === 'checkin' ? '📸 Check In — Take Selfie' : '📸 Check Out — Take Selfie';
  document.getElementById('snapBtn').disabled = true;
  document.getElementById('gpsStatus').innerHTML = '<i class="bi bi-geo-alt me-1"></i>Getting location…';
  showStep(1);
  new bootstrap.Modal(document.getElementById('punchModal')).show();

  // Start front camera for selfie
  try {
    _selfieStream = await navigator.mediaDevices.getUserMedia({
      video: { facingMode: 'user', width: { ideal: 480 }, height: { ideal: 480 } }, audio: false
    });
    document.getElementById('selfieVideo').srcObject = _selfieStream;
  } catch(e) {
    showStep(7);
    document.getElementById('s7Msg').textContent = 'Camera not available: ' + e.message;
    return;
  }

  // GPS in parallel
  navigator.geolocation.getCurrentPosition(pos => {
    _lat = pos.coords.latitude; _lng = pos.coords.longitude;
    document.getElementById('gpsStatus').innerHTML =
      '<i class="bi bi-geo-alt-fill text-success me-1"></i>' + _lat.toFixed(4) + ', ' + _lng.toFixed(4);
    document.getElementById('snapBtn').disabled = false;
  }, () => {
    document.getElementById('gpsStatus').innerHTML = '<i class="bi bi-exclamation-triangle text-warning me-1"></i>No GPS — tap to continue';
    document.getElementById('snapBtn').disabled = false;
  }, { enableHighAccuracy: true, timeout: 10000 });
}

async function snapSelfie() {
  const video = document.getElementById('selfieVideo');
  const canvas = document.createElement('canvas'); canvas.width = 480; canvas.height = 480;
  canvas.getContext('2d').drawImage(video, 0, 0, 480, 480);
  _selfiePhoto = canvas.toDataURL('image/jpeg', 0.75);

  if (_selfieStream) { _selfieStream.getTracks().forEach(t => t.stop()); _selfieStream = null; }
  showStep(2);

  try {
    // Upload selfie
    const up = await fetch('/api/upload', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ data: _selfiePhoto, folder: 'attendance' })
    }).then(r => r.json());

    // Submit check-in or check-out
    const resp = await fetch('/attendance/api/' + _type, {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ lat: _lat, lng: _lng, photo: up.path || '' })
    }).then(r => r.json());

    if (!resp.ok) { showStep(7); document.getElementById('s7Msg').textContent = resp.message; return; }

    // Show journey step
    const isCheckin = _type === 'checkin';
    document.getElementById('s3Title').textContent = isCheckin ? '🏍 Journey Start' : '🏍 Journey End';
    document.getElementById('s3AttMsg').textContent = isCheckin ? '✓ Checked in successfully!' : '✓ Checked out successfully!';
    document.getElementById('s3KmLabel').textContent = isCheckin ? 'Starting KM (Odometer Reading)' : 'Ending KM (Odometer Reading)';
    document.getElementById('s3KmHint').textContent = isCheckin ? 'What does your odometer show right now?' : 'What does your odometer show now?';
    document.getElementById('kmInput').value = '';

    // For checkout: fetch today's journey to show start km
    if (!isCheckin) {
      const j = await fetch('/expenses/journey/today').then(r => r.json());
      if (j.start_km) {
        const el = document.getElementById('s3StartKmInfo');
        el.textContent = `Starting KM was: ${j.start_km}`;
        el.classList.remove('d-none');
      }
    }

    showStep(3);

  } catch(e) {
    showStep(7);
    document.getElementById('s7Msg').textContent = 'Network error. Please try again.';
  }
}

async function goToVehicleCamera() {
  const km = parseFloat(document.getElementById('kmInput').value);
  if (!km || km <= 0) {
    document.getElementById('kmInput').focus();
    document.getElementById('kmInput').classList.add('is-invalid');
    setTimeout(() => document.getElementById('kmInput').classList.remove('is-invalid'), 2000);
    return;
  }

  showStep(4);
  try {
    _vehicleStream = await navigator.mediaDevices.getUserMedia({
      video: { facingMode: 'environment', width: { ideal: 640 }, height: { ideal: 480 } }, audio: false
    });
    document.getElementById('vehicleVideo').srcObject = _vehicleStream;
  } catch(e) {
    // Try any camera
    try {
      _vehicleStream = await navigator.mediaDevices.getUserMedia({ video: true, audio: false });
      document.getElementById('vehicleVideo').srcObject = _vehicleStream;
    } catch(e2) {
      await submitJourney(null); // submit without vehicle photo
    }
  }
}

async function snapVehicle() {
  const video = document.getElementById('vehicleVideo');
  const canvas = document.createElement('canvas'); canvas.width = 640; canvas.height = 480;
  canvas.getContext('2d').drawImage(video, 0, 0, 640, 480);
  _vehiclePhoto = canvas.toDataURL('image/jpeg', 0.8);
  if (_vehicleStream) { _vehicleStream.getTracks().forEach(t => t.stop()); _vehicleStream = null; }
  await submitJourney(_vehiclePhoto);
}

async function skipJourney() {
  if (_vehicleStream) { _vehicleStream.getTracks().forEach(t => t.stop()); _vehicleStream = null; }
  await submitJourney(null);
}

async function submitJourney(vehiclePhotoData) {
  showStep(5);
  try {
    const km = parseFloat(document.getElementById('kmInput').value) || 0;
    let vehiclePath = null;

    if (vehiclePhotoData) {
      const up = await fetch('/api/upload', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ data: vehiclePhotoData, folder: 'expenses' })
      }).then(r => r.json());
      vehiclePath = up.path || null;
    }

    const endpoint = _type === 'checkin' ? '/expenses/journey/start' : '/expenses/journey/end';
    const resp = await fetch(endpoint, {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ km, photo: vehiclePath, lat: _lat, lng: _lng })
    }).then(r => r.json());

    document.getElementById('s6Title').textContent = _type === 'checkin' ? '✅ Checked In!' : '✅ Checked Out!';
    if (resp.totalKm !== undefined && parseFloat(resp.totalKm) > 0) {
      document.getElementById('s6Msg').textContent = `Journey: ${resp.startKm} → ${resp.endKm} km (Total: ${resp.totalKm} km)`;
    } else {
      document.getElementById('s6Msg').textContent = _type === 'checkin' ? `Starting KM recorded: ${km}` : 'Journey recorded.';
    }
    showStep(6);

  } catch(e) {
    // Even if journey save fails, attendance was already saved — show partial success
    document.getElementById('s6Title').textContent = _type === 'checkin' ? '✅ Checked In!' : '✅ Checked Out!';
    document.getElementById('s6Msg').textContent = 'Attendance saved. Journey details could not be saved.';
    showStep(6);
  }
}

function closeModal() {
  [_selfieStream, _vehicleStream].forEach(s => { if(s) s.getTracks().forEach(t=>t.stop()); });
  _selfieStream = null; _vehicleStream = null;
  bootstrap.Modal.getInstance(document.getElementById('punchModal'))?.hide();
  location.reload();
}
</script>
</body></html>
