<%- include('partials/head', { title }) %>
<%- include('partials/sidebar', { active: 'attendance', user }) %>
<div class="main-content">
  <div class="page-header d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0 fw-bold"><i class="bi bi-calendar-check me-2 text-danger"></i><%= t("My Attendance") %></h4>
    <div class="d-flex align-items-center gap-2">
      <% if (canEdit) { %>
      <a href="/attendance/requests#pending" class="btn btn-sm <%= pendingRequests ? 'btn-warning' : 'btn-outline-secondary' %>"><i class="bi bi-hourglass-split me-1"></i><%= t("Requests") %><% if (pendingRequests) { %> <span class="badge bg-dark"><%= pendingRequests %></span><% } %></a>
      <% } %>
      <a href="/attendance/requests#new" class="btn btn-sm btn-outline-danger"><i class="bi bi-send me-1"></i><%= t("Request a change") %></a>
    </div>
  </div>

  <% if (flash.success) { %><div class="alert alert-success alert-dismissible"><%= flash.success %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div><% } %>
  <% if (flash.error)   { %><div class="alert alert-danger  alert-dismissible"><%= flash.error   %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div><% } %>

  <% if (staffAttendance) { %>
  <!-- Staff attendance overview (HoF / Admin) -->
  <div class="card border-0 shadow-sm mb-4">
    <div class="card-header bg-white d-flex justify-content-between align-items-center">
      <span class="fw-semibold"><i class="bi bi-people me-2 text-danger"></i><%= t("Staff Attendance") %></span>
      <form method="GET" action="/attendance" class="d-flex align-items-center gap-2 mb-0">
        <input type="date" name="date" class="form-control form-control-sm" style="width:150px"
               value="<%= staffAttendance.date %>" max="<%= todayStr %>"
               onchange="this.form.submit()">
      </form>
    </div>
    <div class="card-body pb-2">
      <div class="row g-2 mb-3">
        <div class="col-6 col-md-3">
          <div class="text-center border rounded py-2">
            <div class="fw-bold fs-4 text-dark"><%= staffAttendance.summary.total %></div>
            <div class="small text-muted"><%= t("Total") %></div>
          </div>
        </div>
        <div class="col-6 col-md-3">
          <div class="text-center border rounded py-2 border-success">
            <div class="fw-bold fs-4 text-success"><%= staffAttendance.summary.present %></div>
            <div class="small text-muted"><%= t("Checked In") %></div>
          </div>
        </div>
        <div class="col-6 col-md-3">
          <div class="text-center border rounded py-2 border-secondary">
            <div class="fw-bold fs-4 text-secondary"><%= staffAttendance.summary.out %></div>
            <div class="small text-muted"><%= t("Checked Out") %></div>
          </div>
        </div>
        <div class="col-6 col-md-3">
          <div class="text-center border rounded py-2 border-danger">
            <div class="fw-bold fs-4 text-danger"><%= staffAttendance.summary.absent %></div>
            <div class="small text-muted"><%= t("Absent") %></div>
          </div>
        </div>
      </div>
      <div class="table-responsive">
        <table class="table table-sm table-hover mb-0">
          <thead class="table-light">
            <tr>
              <th><%= t("Name") %></th>
              <th class="d-none d-md-table-cell"><%= t("Position") %></th>
              <th><%= t("Check In") %></th>
              <th><%= t("Check Out") %></th>
              <th><%= t("Status") %></th>
              <% if (canEdit) { %><th></th><% } %>
            </tr>
          </thead>
          <tbody>
            <% staffAttendance.rows.forEach(r => { %>
            <% const checkedIn = !!r.check_in_time; const checkedOut = !!r.check_out_time; %>
            <tr>
              <td class="fw-semibold"><%= r.full_name || r.employee_code || '—' %></td>
              <td class="small text-muted d-none d-md-table-cell"><%= r.position_title || '—' %></td>
              <td class="small"><%= checkedIn ? new Date(r.check_in_time).toLocaleTimeString(locale,{hour:'2-digit',minute:'2-digit'}) : '—' %></td>
              <td class="small"><%= checkedOut ? new Date(r.check_out_time).toLocaleTimeString(locale,{hour:'2-digit',minute:'2-digit'}) : '—' %></td>
              <td>
                <% if (r.marked) { %><span class="badge <%= {present:'bg-success',absent:'bg-danger',leave:'bg-primary'}[r.marked] %>" title="<%= r.marked_note %>"><%= t({present:'Present',absent:'Absent',leave:'Leave'}[r.marked]) %> <i class="bi bi-pencil-fill"></i></span>
                <% } else if (checkedOut) { %><span class="badge bg-secondary"><%= t("Out") %></span>
                <% } else if (checkedIn) { %><span class="badge bg-success"><%= t("In") %></span>
                <% } else { %><span class="badge bg-danger bg-opacity-75"><%= t("Absent") %></span><% } %>
              </td>
              <% if (canEdit) { %><td class="text-end"><a href="/attendance/requests?user=<%= r.id %>&date=<%= staffAttendance.date %>#edit" class="btn btn-sm btn-link p-0" title="<%= t("Edit attendance") %>" aria-label="<%= t("Edit attendance") %>"><i class="bi bi-pencil-square"></i></a></td><% } %>
            </tr>
            <% }) %>
            <% if (!staffAttendance.rows.length) { %>
            <tr><td colspan="<%= canEdit ? 6 : 5 %>" class="text-center text-muted py-3"><%= t("No staff records.") %></td></tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
  <% } %>

  <!-- Today's status card -->
  <div class="card border-0 shadow-sm mb-4">
    <div class="card-header bg-white fw-semibold"><%= t("Today —") %> <%= todayStr %></div>
    <div class="card-body text-center py-4">
      <% if (!todayRec || !todayRec.check_in_time) { %>
        <p class="text-muted mb-3"><%= t("You have") %> <strong><%= t("not checked in") %></strong> <%= t("today.") %></p>
        <button class="btn btn-success btn-lg px-5 fw-bold" onclick="startCapture('checkin')">
          <i class="bi bi-box-arrow-in-right me-2"></i><%= t("Check In + Start Journey") %>
        </button>
      <% } else if (!todayRec.check_out_time) { %>
        <div class="row justify-content-center g-3 mb-3">
          <div class="col-auto text-center">
            <span class="badge bg-success fs-6 mb-1"><%= t("✓ Checked In") %></span><br>
            <small class="text-muted"><%= new Date(todayRec.check_in_time).toLocaleTimeString(locale,{hour:'2-digit',minute:'2-digit'}) %></small>
            <% if (todayRec.check_in_photo) { %><div class="mt-1"><img src="<%= todayRec.check_in_photo %>" style="height:70px;border-radius:8px;border:2px solid #28a745"></div><% } %>
          </div>
          <% if (todayJourney?.start_km) { %>
          <div class="col-auto text-center">
            <span class="badge bg-primary fs-6 mb-1"><%= t("🏍 Start KM") %></span><br>
            <small class="text-muted"><strong><%= todayJourney.start_km %></strong> <%= t("km") %></small>
            <% if (todayJourney.start_photo) { %><div class="mt-1"><img src="<%= todayJourney.start_photo %>" style="height:70px;border-radius:8px;border:2px solid #0d6efd"></div><% } %>
          </div>
          <% } %>
        </div>
        <% if (checkoutOpen) { %>
        <button class="btn btn-danger btn-lg px-5 fw-bold" onclick="startCapture('checkout')">
          <i class="bi bi-box-arrow-right me-2"></i><%= t("Check Out + End Journey") %>
        </button>
        <% } else { %>
        <button class="btn btn-outline-secondary btn-lg px-5 fw-bold" disabled>
          <i class="bi bi-lock me-2"></i><%= t("Check Out + End Journey") %>
        </button>
        <div class="small text-muted mt-2"><i class="bi bi-clock me-1"></i><%= t("Check-out opens at 2:00 PM.") %></div>
        <% } %>
      <% } else { %>
        <div class="row justify-content-center g-3">
          <div class="col-auto text-center">
            <span class="badge bg-success fs-6"><%= t("✓ In") %></span><br>
            <small class="text-muted"><%= new Date(todayRec.check_in_time).toLocaleTimeString(locale,{hour:'2-digit',minute:'2-digit'}) %></small>
            <% if (todayRec.check_in_photo) { %><div class="mt-1"><img src="<%= todayRec.check_in_photo %>" style="height:60px;border-radius:8px"></div><% } %>
          </div>
          <% if (todayJourney?.start_km) { %>
          <div class="col-auto text-center">
            <span class="badge bg-primary fs-6"><%= t("🏍 Start") %></span><br>
            <small class="fw-bold text-primary"><%= todayJourney.start_km %> <%= t("km") %></small>
          </div>
          <% } %>
          <% if (todayJourney?.end_km) { %>
          <div class="col-auto text-center">
            <span class="badge bg-secondary fs-6"><%= t("🏍 End") %></span><br>
            <small class="fw-bold text-secondary"><%= todayJourney.end_km %> <%= t("km") %></small>
          </div>
          <% } %>
          <div class="col-auto text-center">
            <span class="badge bg-secondary fs-6"><%= t("✓ Out") %></span><br>
            <small class="text-muted"><%= new Date(todayRec.check_out_time).toLocaleTimeString(locale,{hour:'2-digit',minute:'2-digit'}) %></small>
            <% if (todayRec.check_out_photo) { %><div class="mt-1"><img src="<%= todayRec.check_out_photo %>" style="height:60px;border-radius:8px"></div><% } %>
          </div>
        </div>
        <% if (todayJourney?.total_km > 0) { %>
        <div class="mt-3">
          <span class="badge bg-success fs-5"><%= t("🏍 Total:") %> <%= todayJourney.total_km.toFixed(1) %> <%= t("km today") %></span>
        </div>
        <% } %>
        <p class="text-success fw-bold mt-3 mb-0"><%= t("✅ Attendance complete for today.") %></p>
      <% } %>
    </div>
  </div>

  <%- include('partials/attendance-calendar', { cal, todayStr, monthUrl: '/attendance?m=', dayUrl: '/attendance/api/day/' }) %>
</div>


<!-- ── Attendance + Journey Modal ───────────────────────────────────────────── -->
<div class="modal fade" id="punchModal" tabindex="-1" data-bs-backdrop="static" data-bs-keyboard="false">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">

      <!-- Step 1: Selfie camera -->
      <div id="s1" class="modal-step">
        <div class="modal-header border-0 pb-0">
          <h5 class="modal-title fw-bold" id="s1Title"><%= t("📸 Take Selfie") %></h5>
        </div>
        <div class="modal-body text-center pb-2">
          <video id="selfieVideo" autoplay playsinline style="width:100%;border-radius:10px;max-height:280px;background:#000"></video>
          <div id="gpsStatus" class="mt-2 small text-muted"><i class="bi bi-geo-alt me-1"></i><%= t("Getting location…") %></div>
          <button type="button" class="btn btn-sm btn-outline-secondary mt-2 d-none" id="gpsRetry" onclick="getLocation()">
            <i class="bi bi-arrow-clockwise me-1"></i><%= t("Try location again") %>
          </button>
          <div class="mt-3 d-flex gap-2 justify-content-center">
            <button class="btn btn-danger px-5 fw-bold" onclick="snapSelfie()" id="snapBtn" disabled>
              <i class="bi bi-camera-fill me-1"></i><%= t("Take Selfie & Continue") %>
            </button>
          </div>
          <button class="btn btn-link text-muted btn-sm mt-2" onclick="closeModal()"><%= t("Cancel") %></button>
        </div>
      </div>

      <!-- Step 2: Submitting selfie -->
      <div id="s2" class="modal-step d-none text-center py-5">
        <div class="spinner-border text-danger mb-3"></div>
        <p class="text-muted"><%= t("Saving attendance…") %></p>
      </div>

      <!-- Step 3: Journey (KM entry) -->
      <div id="s3" class="modal-step d-none">
        <div class="modal-header border-0 pb-0">
          <h5 class="modal-title fw-bold" id="s3Title"><%= t("🏍 Journey Details") %></h5>
        </div>
        <div class="modal-body">
          <div class="alert alert-light border py-2 small" id="s3AttMsg"><%= t("✓ Selfie taken. Now the odometer.") %></div>
          <div class="mb-3">
            <label class="form-label fw-bold fs-6" id="s3KmLabel"><%= t("Starting KM (Odometer Reading)") %></label>
            <input type="number" id="kmInput" class="form-control form-control-lg text-center fw-bold"
                   placeholder="e.g. 12450" min="0" inputmode="numeric">
            <small class="text-muted" id="s3KmHint"><%= t("Enter the current reading on your bike/car odometer") %></small>
          </div>
          <div id="s3StartKmInfo" class="alert alert-info py-2 small d-none"></div>
          <div class="d-flex gap-2">
            <button class="btn btn-primary flex-grow-1 fw-bold" onclick="goToVehicleCamera()" id="vehiclePhotoBtn">
              <i class="bi bi-camera-fill me-1"></i><%= meterRequired ? t("Take Meter Photo") : t("Take Vehicle Photo") %>
            </button>
            <% if (!meterRequired) { %><button class="btn btn-outline-secondary" onclick="skipJourney()"><%= t("Skip") %></button><% } %>
          </div>
        </div>
      </div>

      <!-- Step 4: Vehicle camera (rear) -->
      <div id="s4" class="modal-step d-none">
        <div class="modal-header border-0 pb-0">
          <h5 class="modal-title fw-bold"><%= t("📷 Vehicle Photo") %></h5>
        </div>
        <div class="modal-body text-center pb-2">
          <p class="text-muted small mb-2"><%= meterRequired ? t("Point the camera at the odometer so the reading is clear") : t("Point camera at your vehicle (odometer visible is better)") %></p>
          <video id="vehicleVideo" autoplay playsinline style="width:100%;border-radius:10px;max-height:280px;background:#000"></video>
          <div class="mt-3 d-flex gap-2 justify-content-center">
            <button class="btn btn-primary px-5 fw-bold" onclick="snapVehicle()" id="vehicleSnapBtn">
              <i class="bi bi-camera-fill me-1"></i><%= t("Snap Vehicle") %>
            </button>
          </div>
          <% if (!meterRequired) { %><button class="btn btn-link text-muted btn-sm mt-1" onclick="skipJourney()"><%= t("Skip vehicle photo") %></button><% } %>
        </div>
      </div>

      <!-- Step 5: Submitting journey -->
      <div id="s5" class="modal-step d-none text-center py-5">
        <div class="spinner-border text-primary mb-3"></div>
        <p class="text-muted"><%= t("Saving attendance…") %></p>
      </div>

      <!-- Step 6: Final success -->
      <div id="s6" class="modal-step d-none text-center py-4 px-3">
        <i class="bi bi-check-circle-fill text-success" style="font-size:3.5rem"></i>
        <h5 class="fw-bold mt-3" id="s6Title"><%= t("All Done!") %></h5>
        <p class="text-muted" id="s6Msg"></p>
        <button class="btn btn-success px-5 fw-bold" onclick="closeModal()"><%= t("Close") %></button>
      </div>

      <!-- Step 7: Error -->
      <div id="s7" class="modal-step d-none text-center py-4 px-3">
        <i class="bi bi-exclamation-circle-fill text-danger" style="font-size:3rem"></i>
        <p class="fw-bold mt-2" id="s7Msg"><%= t("Something went wrong.") %></p>
        <button class="btn btn-outline-danger" onclick="closeModal()"><%= t("Close") %></button>
      </div>

    </div>
  </div>
</div>

<style>
.modal-step { padding: 0 4px; }
</style>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
// Check-in / check-out: selfie → odometer (+ meter photo) → one save.
// Location is required; sales and service must give the meter photo.
const METER_REQUIRED = <%= meterRequired ? 'true' : 'false' %>;
let _type, _selfieStream, _vehicleStream, _lat = null, _lng = null, _selfiePhoto, _vehiclePhoto;

function showStep(n) {
  [1,2,3,4,5,6,7].forEach(i => document.getElementById('s'+i).classList.add('d-none'));
  document.getElementById('s'+n).classList.remove('d-none');
}
function fail(msg) { stopStreams(); showStep(7); document.getElementById('s7Msg').textContent = msg; }
function stopStreams() {
  [_selfieStream, _vehicleStream].forEach(s => { if (s) s.getTracks().forEach(t => t.stop()); });
  _selfieStream = null; _vehicleStream = null;
}

async function startCapture(type) {
  _type = type;
  _lat = null; _lng = null; _selfiePhoto = null; _vehiclePhoto = null;

  document.getElementById('s1Title').textContent = type === 'checkin' ? T('📸 Check In — Take Selfie') : T('📸 Check Out — Take Selfie');
  showStep(1);
  new bootstrap.Modal(document.getElementById('punchModal')).show();

  try {
    _selfieStream = await navigator.mediaDevices.getUserMedia({
      video: { facingMode: 'user', width: { ideal: 480 }, height: { ideal: 480 } }, audio: false
    });
    document.getElementById('selfieVideo').srcObject = _selfieStream;
  } catch(e) {
    return fail(T('Camera not available') + ': ' + e.message);
  }
  getLocation();
}

// Location is required: the selfie button stays off until we have it
function getLocation() {
  const status = document.getElementById('gpsStatus'), retry = document.getElementById('gpsRetry'), snap = document.getElementById('snapBtn');
  snap.disabled = true; retry.classList.add('d-none');
  status.innerHTML = '<i class="bi bi-geo-alt me-1"></i>' + T('Getting location…');
  if (!navigator.geolocation) {
    status.innerHTML = '<i class="bi bi-x-circle text-danger me-1"></i>' + T('This phone cannot share location. Attendance needs location.');
    return;
  }
  navigator.geolocation.getCurrentPosition(pos => {
    _lat = pos.coords.latitude; _lng = pos.coords.longitude;
    status.innerHTML = '<i class="bi bi-geo-alt-fill text-success me-1"></i>' + _lat.toFixed(4) + ', ' + _lng.toFixed(4);
    snap.disabled = false;
  }, err => {
    status.innerHTML = '<i class="bi bi-exclamation-triangle text-danger me-1"></i>' +
      (err.code === 1 ? T('Location permission is off. Allow location for this site, then try again.')
                      : T('Could not get location. Turn on GPS / location and try again.'));
    retry.classList.remove('d-none');
  }, { enableHighAccuracy: true, timeout: 15000, maximumAge: 60000 });
}

async function snapSelfie() {
  if (_lat === null || _lng === null) return getLocation();
  const video = document.getElementById('selfieVideo');
  const canvas = document.createElement('canvas'); canvas.width = 480; canvas.height = 480;
  canvas.getContext('2d').drawImage(video, 0, 0, 480, 480);
  _selfiePhoto = canvas.toDataURL('image/jpeg', 0.75);
  if (_selfieStream) { _selfieStream.getTracks().forEach(t => t.stop()); _selfieStream = null; }

  const isCheckin = _type === 'checkin';
  document.getElementById('s3Title').textContent = isCheckin ? T('🏍 Journey Start') : T('🏍 Journey End');
  document.getElementById('s3KmLabel').textContent = isCheckin ? T('Starting KM (Odometer Reading)') : T('Ending KM (Odometer Reading)');
  document.getElementById('s3KmHint').textContent = isCheckin ? T('What does your odometer show right now?') : T('What does your odometer show now?');
  document.getElementById('kmInput').value = '';
  const info = document.getElementById('s3StartKmInfo'); info.classList.add('d-none');
  if (!isCheckin) {
    try {
      const j = await fetch('/expenses/journey/today').then(r => r.json());
      if (j.start_km) { info.textContent = T('Starting KM was') + ': ' + j.start_km; info.classList.remove('d-none'); }
    } catch(e) {}
  }
  showStep(3);
}

async function goToVehicleCamera() {
  const input = document.getElementById('kmInput');
  const km = parseFloat(input.value);
  if (!km || km <= 0) {
    input.focus(); input.classList.add('is-invalid');
    setTimeout(() => input.classList.remove('is-invalid'), 2000);
    return;
  }
  showStep(4);
  try {
    _vehicleStream = await navigator.mediaDevices.getUserMedia({
      video: { facingMode: 'environment', width: { ideal: 640 }, height: { ideal: 480 } }, audio: false
    });
  } catch(e) {
    try { _vehicleStream = await navigator.mediaDevices.getUserMedia({ video: true, audio: false }); }
    catch(e2) {
      if (METER_REQUIRED) return fail(T('Camera not available') + ': ' + e2.message);
      return submitAll(null);
    }
  }
  document.getElementById('vehicleVideo').srcObject = _vehicleStream;
}

async function snapVehicle() {
  const video = document.getElementById('vehicleVideo');
  const canvas = document.createElement('canvas'); canvas.width = 640; canvas.height = 480;
  canvas.getContext('2d').drawImage(video, 0, 0, 640, 480);
  _vehiclePhoto = canvas.toDataURL('image/jpeg', 0.8);
  if (_vehicleStream) { _vehicleStream.getTracks().forEach(t => t.stop()); _vehicleStream = null; }
  await submitAll(_vehiclePhoto);
}

async function skipJourney() {
  if (METER_REQUIRED) return;
  if (_vehicleStream) { _vehicleStream.getTracks().forEach(t => t.stop()); _vehicleStream = null; }
  document.getElementById('kmInput').value = '';
  await submitAll(null);
}

const upload = (data, folder) => fetch('/api/upload', {
  method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ data, folder })
}).then(r => r.json()).then(r => r.path || '');

// One save: selfie, location, odometer and meter photo together
async function submitAll(meterData) {
  showStep(2);
  try {
    const km = parseFloat(document.getElementById('kmInput').value) || 0;
    const photo = await upload(_selfiePhoto, 'attendance');
    const meter_photo = meterData ? await upload(meterData, 'expenses') : '';
    if (METER_REQUIRED && !meter_photo) return fail(T('Meter photo could not be uploaded. Please try again.'));

    const resp = await fetch('/attendance/api/' + _type, {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ lat: _lat, lng: _lng, photo, km: km || '', meter_photo })
    }).then(r => r.json());
    if (!resp.ok) return fail(resp.message);

    document.getElementById('s6Title').textContent = _type === 'checkin' ? T('✅ Checked In!') : T('✅ Checked Out!');
    const j = resp.journey;
    document.getElementById('s6Msg').textContent =
      j && parseFloat(j.totalKm) > 0 ? `${T('Journey:')} ${j.startKm} → ${j.endKm} km (${T('Total:')} ${j.totalKm} km)`
      : km ? `${T('KM recorded:')} ${km}` : '';
    showStep(6);
  } catch(e) {
    fail(T('Network error. Please try again.'));
  }
}

function closeModal() {
  stopStreams();
  bootstrap.Modal.getInstance(document.getElementById('punchModal'))?.hide();
  location.reload();
}
</script>
</body></html>
