<%- include('../partials/head', { title }) %>
<%- include('../partials/sidebar', { active: 'spare-quotations', user }) %>
<% const isAdm = isAdmin || (user && user.userRole === 'admin'); %>
<div class="main-content">
  <div class="page-header d-flex justify-content-between align-items-center mb-4">
    <div>
      <h4 class="mb-0 fw-bold"><i class="bi bi-receipt-cutoff me-2 text-success"></i><%= q.quotation_no %></h4>
      <small class="text-muted"><%= new Date(q.created_at).toLocaleDateString('en-IN', {day:'2-digit',month:'short',year:'numeric'}) %></small>
    </div>
    <div class="d-flex gap-2 flex-wrap">
      <!-- Status badge + change -->
      <% const sc = {draft:'bg-secondary',sent:'bg-primary',confirmed:'bg-success',cancelled:'bg-danger'}; %>
      <div class="dropdown">
        <button class="btn btn-sm dropdown-toggle badge <%= sc[q.status]||'bg-secondary' %> fs-6 border-0" data-bs-toggle="dropdown">
          <%= q.status.toUpperCase() %>
        </button>
        <ul class="dropdown-menu">
          <% ['draft','sent','confirmed','cancelled'].forEach(s => { %>
          <li><a class="dropdown-item" href="#" onclick="setStatus('<%= s %>');return false"><%= s.toUpperCase() %></a></li>
          <% }) %>
        </ul>
      </div>
      <!-- Approval status badge -->
      <% if (q.approval_status && q.approval_status !== 'draft') { %>
      <% const asc = {pending:'bg-warning text-dark',approved:'bg-success',rejected:'bg-danger'}; %>
      <span class="badge <%= asc[q.approval_status]||'bg-secondary' %>">
        <i class="bi bi-shield-check me-1"></i><%= q.approval_status.toUpperCase() %>
      </span>
      <% } %>
      <!-- Submit for Approval (non-admin, when draft/sent) -->
      <% if (!isAdm && (!q.approval_status || q.approval_status === 'draft') && q.status !== 'cancelled') { %>
      <form method="post" action="/spare-quotations/<%= q.id %>/submit-approval" style="display:inline"
        onsubmit="return confirm('Submit this quotation for admin approval?')">
        <button class="btn btn-sm btn-warning text-dark"><i class="bi bi-send me-1"></i>Submit for Approval</button>
      </form>
      <% } %>
      <!-- WhatsApp: shares the quotation PDF (customer copy) -->
      <button type="button" class="btn btn-sm btn-success" id="waShareBtn" title="Send the PDF on WhatsApp">
        <i class="bi bi-whatsapp me-1"></i>WhatsApp PDF
      </button>
      <a href="/spare-quotations/<%= q.id %>/pdf" class="btn btn-sm btn-danger" target="_blank">
        <i class="bi bi-file-pdf me-1"></i>PDF
      </a>
      <a href="/spare-quotations/<%= q.id %>/edit" class="btn btn-sm btn-outline-secondary">
        <i class="bi bi-pencil me-1"></i>Edit
      </a>
      <form method="post" action="/spare-quotations/<%= q.id %>/clone" style="display:inline">
        <button class="btn btn-sm btn-outline-primary"><i class="bi bi-copy me-1"></i>Clone</button>
      </form>
      <a href="/spare-quotations" class="btn btn-sm btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i>Back
      </a>
    </div>
  </div>

  <% if (flash && flash.success) { %><div class="alert alert-success alert-dismissible"><%= flash.success %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div><% } %>
  <% if (flash && flash.error)   { %><div class="alert alert-danger  alert-dismissible"><%= flash.error   %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div><% } %>

  <!-- ── Approval Panel (Admin only, when pending) ── -->
  <% if (isAdm && q.approval_status === 'pending') { %>
  <div class="alert alert-warning d-flex align-items-start gap-3 mb-3">
    <i class="bi bi-shield-exclamation fs-4 mt-1"></i>
    <div class="flex-grow-1">
      <div class="fw-bold mb-1">Pending Approval</div>
      <div class="small text-muted mb-2">This quotation was submitted for your approval by <%= q.creator_name || 'salesperson' %>.</div>
      <form method="post" action="/spare-quotations/<%= q.id %>/approve" class="d-flex gap-2 align-items-end flex-wrap">
        <div>
          <label class="form-label small mb-1">Notes (optional)</label>
          <input type="text" name="notes" class="form-control form-control-sm" style="min-width:250px" placeholder="Approval notes...">
        </div>
        <button type="submit" name="action" value="approve" class="btn btn-sm btn-success"><i class="bi bi-check-circle me-1"></i>Approve</button>
        <button type="submit" name="action" value="reject"  class="btn btn-sm btn-danger"><i class="bi bi-x-circle me-1"></i>Reject</button>
      </form>
    </div>
  </div>
  <% } %>

  <!-- ── Approval Result ── -->
  <% if (q.approval_status === 'approved' || q.approval_status === 'rejected') { %>
  <div class="alert <%= q.approval_status === 'approved' ? 'alert-success' : 'alert-danger' %> small mb-3 py-2">
    <i class="bi bi-shield-<%= q.approval_status === 'approved' ? 'check' : 'x' %> me-2"></i>
    <b><%= q.approval_status === 'approved' ? 'Approved' : 'Rejected' %></b>
    <% if (q.approval_notes) { %> — <%= q.approval_notes %><% } %>
    <% if (q.approved_at) { %><span class="text-muted ms-2"><%= new Date(q.approved_at).toLocaleDateString('en-IN') %></span><% } %>
  </div>
  <% } %>

  <div class="row g-3 mb-3">
    <div class="col-md-6">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-header bg-white fw-semibold small">Customer & Machine</div>
        <div class="card-body small">
          <dl class="row mb-0">
            <dt class="col-5 text-muted">Machine No</dt><dd class="col-7 font-monospace fw-semibold"><%= q.machine_no || '—' %></dd>
            <dt class="col-5 text-muted">Customer</dt><dd class="col-7 fw-semibold"><%= q.customer_name %></dd>
            <dt class="col-5 text-muted">Contact</dt><dd class="col-7"><%= q.contact_person || '—' %></dd>
            <dt class="col-5 text-muted">Mobile</dt><dd class="col-7">
              <% if (q.mobile) { %><a href="tel:<%= q.mobile %>"><%= q.mobile %></a><% } else { %>—<% } %>
            </dd>
            <dt class="col-5 text-muted">Address</dt><dd class="col-7"><%= q.customer_address || '—' %></dd>
            <dt class="col-5 text-muted">GST</dt><dd class="col-7 font-monospace"><%= q.customer_gstin || '—' %></dd>
            <dt class="col-5 text-muted">Place of Supply</dt><dd class="col-7"><%= q.place_of_supply || '—' %></dd>
          </dl>
        </div>
      </div>
    </div>
    <div class="col-md-6">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-header bg-white fw-semibold small">Quotation Info</div>
        <div class="card-body small">
          <dl class="row mb-0">
            <dt class="col-5 text-muted">Quotation No</dt><dd class="col-7 fw-bold font-monospace"><%= q.quotation_no %></dd>
            <dt class="col-5 text-muted">Date</dt><dd class="col-7"><%= new Date(q.created_at).toLocaleDateString('en-IN') %></dd>
            <dt class="col-5 text-muted">Validity</dt><dd class="col-7"><%= q.validity_days %> days</dd>
            <dt class="col-5 text-muted">Tax Mode</dt><dd class="col-7"><span class="badge bg-secondary"><%= q.tax_mode %></span></dd>
            <dt class="col-5 text-muted">Salesperson</dt><dd class="col-7"><%= q.salesperson || '—' %></dd>
            <dt class="col-5 text-muted">Created By</dt><dd class="col-7"><%= q.creator_name || '—' %></dd>
            <% if (q.remarks) { %><dt class="col-5 text-muted">Remarks</dt><dd class="col-7"><%= q.remarks %></dd><% } %>
          </dl>
        </div>
      </div>
    </div>
  </div>

  <!-- Items table -->
  <div class="card border-0 shadow-sm mb-3">
    <div class="card-header bg-white fw-semibold small"><%= items.length %> Spare Parts</div>
    <div class="table-responsive">
      <table class="table table-sm table-bordered mb-0 small">
        <thead class="table-light">
          <tr>
            <th>#</th>
            <th>Part No</th>
            <th>Description</th>
            <th>HSN</th>
            <th class="text-center">Qty</th>
            <th class="text-end">Basic Rate</th>
            <th class="text-end">Disc%</th>
            <th class="text-end">Disc Amt</th>
            <th class="text-center">Tax%</th>
            <th class="text-end">Tax Amt</th>
            <th class="text-end">Net Rate</th>
            <th class="text-end">Line Total</th>
          </tr>
        </thead>
        <tbody>
          <% items.forEach((it, i) => { %>
          <tr>
            <td class="text-muted"><%= i+1 %></td>
            <td class="font-monospace"><%= it.part_no || '—' %></td>
            <td class="fw-semibold"><%= it.description %></td>
            <td><%= it.hsn || '—' %></td>
            <td class="text-center"><%= it.qty %></td>
            <td class="text-end">₹<%= formatINR(it.basic_rate) %></td>
            <td class="text-end"><%= it.discount_percent %>%</td>
            <td class="text-end">₹<%= formatINR(it.discount_amount) %></td>
            <td class="text-center"><%= it.tax_rate %>%</td>
            <td class="text-end">₹<%= formatINR(it.tax_amount) %></td>
            <td class="text-end">₹<%= formatINR(it.net_rate) %></td>
            <td class="text-end fw-semibold">₹<%= formatINR(it.line_total) %></td>
          </tr>
          <% }) %>
        </tbody>
        <tfoot class="table-light fw-semibold">
          <tr>
            <td colspan="10" class="text-end text-muted">Total Basic:</td>
            <td colspan="2" class="text-end">₹<%= formatINR(q.total_basic) %></td>
          </tr>
          <% if (q.tax_mode === 'IGST') { %>
          <tr><td colspan="10" class="text-end text-muted">Total IGST:</td><td colspan="2" class="text-end">₹<%= formatINR(q.total_gst) %></td></tr>
          <% } else { %>
          <tr><td colspan="10" class="text-end text-muted">Total CGST:</td><td colspan="2" class="text-end">₹<%= formatINR(q.total_gst/2) %></td></tr>
          <tr><td colspan="10" class="text-end text-muted">Total SGST:</td><td colspan="2" class="text-end">₹<%= formatINR(q.total_gst/2) %></td></tr>
          <% } %>
          <% if (q.roundoff_amount && q.roundoff_amount !== 0) { %>
          <tr><td colspan="10" class="text-end text-muted">Round Off:</td><td colspan="2" class="text-end"><%= q.roundoff_amount > 0 ? '+' : '' %>₹<%= formatINR(q.roundoff_amount) %></td></tr>
          <% } %>
          <tr class="table-success">
            <td colspan="10" class="text-end fw-bold">Grand Total:</td>
            <td colspan="2" class="text-end fw-bold fs-6">₹<%= formatINR(q.grand_total) %></td>
          </tr>
        </tfoot>
      </table>
    </div>
  </div>

  <div class="card border-0 shadow-sm mb-3">
    <div class="card-header bg-white fw-semibold small">Terms &amp; Conditions</div>
    <div class="card-body">
      <ol class="small text-muted mb-0" style="padding-left:1.2rem; line-height:1.7;">
        <li><strong>Estimate Validity:</strong> This estimate is valid for 7 days from the date of issue, unless otherwise specified. Prices are subject to change thereafter.</li>
        <li><strong>Taxes:</strong> GST and other applicable government taxes/levies shall be charged as applicable on the date of invoicing.</li>
        <li><strong>Payment:</strong> Payment shall be made as per the agreed payment terms. Any delay in payment may attract applicable interest/charges.</li>
        <li><strong>Order Confirmation:</strong> An order shall be considered confirmed only upon receipt of the required advance/payment and written acceptance by the Company.</li>
        <li><strong>Delivery:</strong> Delivery shall be subject to availability of equipment and receipt of the agreed payment. Delivery timelines are indicative and may vary due to circumstances beyond the Company's control.</li>
        <li><strong>Transportation:</strong> Transportation, loading/unloading, insurance, registration, road tax, permits and other incidental charges shall be borne by the customer unless specifically included in the estimate.</li>
        <li><strong>Warranty:</strong> Warranty, if applicable, shall be governed strictly by the manufacturer's warranty terms and conditions. Warranty does not cover normal wear and tear, misuse, negligence, accidents, unauthorized modifications/repairs or use contrary to manufacturer recommendations.</li>
        <li><strong>Specifications:</strong> Product specifications, features, dimensions, colours and equipment configurations are subject to change by the manufacturer without prior notice.</li>
        <li><strong>Cancellation &amp; Refund:</strong> Cancellation of an order shall be subject to the Company's approval. Any applicable cancellation, processing, restocking or other charges may be deducted from the amount received.</li>
        <li><strong>Documentation:</strong> Registration, insurance, financing and statutory documentation, wherever applicable, shall be the customer's responsibility unless specifically agreed otherwise in writing.</li>
        <li><strong>Invoice:</strong> The invoice shall be treated as the final document for the quantity, model, specifications, price, taxes and other commercial terms applicable to the transaction.</li>
        <li><strong>Force Majeure:</strong> The Company shall not be liable for any delay or failure caused by circumstances beyond its reasonable control, including natural calamities, strikes, transport disruptions, government restrictions, shortage of materials or manufacturer-related delays.</li>
        <li><strong>Jurisdiction:</strong> Any dispute arising out of the transaction shall be subject to the jurisdiction of the competent courts at Meerut, Uttar Pradesh.</li>
        <li><strong>Acceptance:</strong> Placement of an order or acceptance of delivery shall constitute acceptance of these terms and conditions.</li>
      </ol>
    </div>
  </div>

  <!-- Delete -->
  <div class="card border-0 shadow-sm">
    <div class="card-body d-flex justify-content-between align-items-center">
      <span class="text-muted small">Delete this quotation permanently.</span>
      <form method="post" action="/spare-quotations/<%= q.id %>/delete" onsubmit="return confirm('Delete quotation <%= q.quotation_no %>?')">
        <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash me-1"></i>Delete</button>
      </form>
    </div>
  </div>
</div>

<script>
async function setStatus(status) {
  const r = await fetch('/spare-quotations/<%= q.id %>/status', {
    method:'POST', headers:{'Content-Type':'application/json'},
    body: JSON.stringify({ status })
  });
  if ((await r.json()).ok) location.reload();
}
</script>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
// WhatsApp can't receive a file through a link, so:
//  - phones: build the PDF and open the share sheet (choose WhatsApp → PDF attached)
//  - computers: send a WhatsApp message with a secure download link to the PDF
(() => {
  const btn = document.getElementById('waShareBtn');
  if (!btn) return;
  const Q = <%- JSON.stringify({ id: q.id, no: q.quotation_no, name: q.customer_name, mobile: String(q.mobile || '').replace(/\D/g, '').slice(-10), total: q.grand_total || 0 }).replace(/</g, '\\u003c') %>;
  const amount = '₹' + Number(Q.total).toLocaleString('en-IN', { maximumFractionDigits: 2 });
  const intro = `Dear ${Q.name},\nPlease find your spare parts quotation ${Q.no} for ${amount}.`;
  const label = btn.innerHTML;
  const busy = (t) => { btn.disabled = !!t; btn.innerHTML = t ? `<span class="spinner-border spinner-border-sm me-1"></span>${t}` : label; };

  btn.addEventListener('click', async () => {
    try {
      // Phone: attach the actual PDF
      if (navigator.canShare && /Android|iPhone|iPad|Mobile/i.test(navigator.userAgent)) {
        busy('Preparing PDF…');
        const r = await fetch(`/spare-quotations/${Q.id}/pdf?copy=customer`);
        if (!r.ok) throw new Error('Could not create the PDF.');
        const file = new File([await r.blob()], Q.no.replace(/\//g, '-') + '.pdf', { type: 'application/pdf' });
        if (navigator.canShare({ files: [file] })) {
          busy('');
          try { await navigator.share({ files: [file], title: Q.no, text: intro + '\nRegards, Super Allied' }); }
          catch (e) { if (e.name !== 'AbortError') throw e; }
          return;
        }
      }
      // Computer (or a phone browser that can't share files): WhatsApp message with a link
      busy('Creating link…');
      const r = await fetch(`/spare-quotations/${Q.id}/share-link`, { method: 'POST' });
      const j = await r.json();
      if (!r.ok) throw new Error(j.error || 'Could not create the link.');
      const text = `${intro}\nDownload the PDF: ${j.url}\n(The link is valid for 30 days.)\nRegards, Super Allied`;
      const to = Q.mobile.length === 10 ? '91' + Q.mobile : '';
      window.open(`https://wa.me/${to}?text=${encodeURIComponent(text)}`, '_blank', 'noopener');
      busy('');
    } catch (e) {
      busy('');
      alert(e.message || 'Could not share the quotation.');
    }
  });
})();
</script>
</body></html>
