<%- include('../partials/head', { title }) %>
<%- include('../partials/sidebar', { active: 'spare-reports', user }) %>
<div class="main-content">
  <div class="page-header d-flex justify-content-between align-items-center mb-4">
    <h4 class="mb-0 fw-bold"><i class="bi bi-bar-chart me-2 text-primary"></i>Spare Parts Reports</h4>
    <a href="/spare-quotations" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left me-1"></i>Back</a>
  </div>

  <!-- Filters -->
  <div class="card border-0 shadow-sm mb-3">
    <div class="card-body py-2">
      <form method="get" class="row g-2 align-items-end">
        <div class="col-md-2">
          <label class="form-label small">From Date</label>
          <input type="date" name="from" value="<%= from %>" class="form-control form-control-sm">
        </div>
        <div class="col-md-2">
          <label class="form-label small">To Date</label>
          <input type="date" name="to" value="<%= to %>" class="form-control form-control-sm">
        </div>
        <div class="col-md-2">
          <label class="form-label small">Customer</label>
          <input name="customer" value="<%= customer %>" class="form-control form-control-sm" placeholder="Customer name">
        </div>
        <div class="col-md-2">
          <label class="form-label small">Machine No</label>
          <input name="machine_no" value="<%= machine_no %>" class="form-control form-control-sm">
        </div>
        <div class="col-md-2">
          <label class="form-label small">Salesperson</label>
          <input name="salesperson" value="<%= salesperson %>" class="form-control form-control-sm">
        </div>
        <div class="col-auto">
          <button class="btn btn-primary btn-sm">Apply Filters</button>
          <a href="/spare-quotations/reports/summary" class="btn btn-outline-secondary btn-sm">Clear</a>
        </div>
      </form>
    </div>
  </div>

  <!-- Summary Cards -->
  <div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
      <div class="card border-0 shadow-sm text-center p-3">
        <div class="fw-bold fs-3 text-primary"><%= quotations.length %></div>
        <small class="text-muted">Total Quotations</small>
      </div>
    </div>
    <div class="col-6 col-md-3">
      <div class="card border-0 shadow-sm text-center p-3">
        <div class="fw-bold fs-3 text-success">₹<%= formatINR(totalValue) %></div>
        <small class="text-muted">Total Value</small>
      </div>
    </div>
    <div class="col-6 col-md-3">
      <div class="card border-0 shadow-sm text-center p-3">
        <div class="fw-bold fs-3 text-warning"><%= quotations.filter(q=>q.status==='approved').length %></div>
        <small class="text-muted">Approved</small>
      </div>
    </div>
    <div class="col-6 col-md-3">
      <div class="card border-0 shadow-sm text-center p-3">
        <div class="fw-bold fs-3 text-info"><%= formatINR(quotations.length ? totalValue/quotations.length : 0) %></div>
        <small class="text-muted">Avg. Value</small>
      </div>
    </div>
  </div>

  <div class="row g-3">
    <!-- Top Parts -->
    <div class="col-md-5">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-header bg-white fw-semibold small">Top Quoted Parts</div>
        <div class="table-responsive">
          <table class="table table-sm mb-0">
            <thead class="table-light"><tr><th>Description</th><th class="text-center">Times</th><th class="text-end">Value</th></tr></thead>
            <tbody>
              <% if (!topParts.length) { %><tr><td colspan="3" class="text-center text-muted py-2">No data</td></tr><% } %>
              <% topParts.forEach(p => { %>
              <tr>
                <td class="small fw-semibold" style="max-width:200px"><%= p.description %></td>
                <td class="text-center"><span class="badge bg-primary"><%= p.times_quoted %></span></td>
                <td class="text-end small">₹<%= formatINR(p.total_value) %></td>
              </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- Quotation list -->
    <div class="col-md-7">
      <div class="card border-0 shadow-sm">
        <div class="card-header bg-white fw-semibold small">Quotation List</div>
        <div class="table-responsive" style="max-height:400px;overflow-y:auto">
          <table class="table table-sm table-hover mb-0">
            <thead class="table-light sticky-top"><tr><th>No</th><th>Customer</th><th>Machine</th><th>Date</th><th class="text-end">Total</th><th>Status</th></tr></thead>
            <tbody>
              <% if (!quotations.length) { %><tr><td colspan="6" class="text-center text-muted py-2">No data</td></tr><% } %>
              <% quotations.forEach(q => { %>
              <tr>
                <td><a href="/spare-quotations/<%= q.id %>" class="text-decoration-none small"><%= q.quotation_no %></a></td>
                <td class="small fw-semibold"><%= q.customer_name %></td>
                <td class="small font-monospace"><%= q.machine_no || '—' %></td>
                <td class="small"><%= new Date(q.created_at).toLocaleDateString('en-IN') %></td>
                <td class="text-end small fw-semibold">₹<%= formatINR(q.grand_total) %></td>
                <td><% const sc={draft:'bg-secondary',sent:'bg-primary',approved:'bg-success',rejected:'bg-danger',converted:'bg-info'}; %><span class="badge <%= sc[q.status]||'bg-secondary' %>"><%= q.status %></span></td>
              </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body></html>
