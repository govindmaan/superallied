<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<style>
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body { font-family: Arial, sans-serif; font-size: 10px; color: #000; background: transparent; -webkit-print-color-adjust: exact; }
  .page { width: 210mm; padding: 4mm 5mm; }

  /* ── Main outer bordered container ── */
  .outer { width: 100%; border: 1.5px solid #000; border-collapse: collapse; }
  .outer td, .outer th { border: 1px solid #000; vertical-align: top; }

  /* ── Document title row ── */
  .title-td { text-align: center; padding: 5px 8px; border-bottom: 1.5px solid #000; }
  .doc-title { font-size: 16px; font-weight: 900; letter-spacing: 3px; text-transform: uppercase; }
  .orig-label { font-size: 8.5px; font-style: italic; float: right; font-weight: normal; margin-top: 5px; }
  .juris-label { font-size: 8px; font-style: italic; float: left; font-weight: normal; margin-top: 5px; color: #555; }

  /* ── Company block (left side of header) ── */
  .co-block { padding: 6px 8px; width: 55%; }
  .co-name  { font-size: 15px; font-weight: 900; line-height: 1.1; }
  .co-dealer { font-size: 8.5px; color: #444; margin: 2px 0 4px 0; font-style: italic; }
  .co-line  { font-size: 9px; line-height: 1.75; }
  .co-line b { font-weight: 700; }

  /* ── Meta grid (right side of header) ── */
  .meta-inner { width: 100%; border-collapse: collapse; }
  .meta-inner td { border: none; border-bottom: 1px solid #ccc; padding: 3px 5px; font-size: 9px; }
  .meta-inner tr:last-child td { border-bottom: none; }
  .mk { color: #555; white-space: nowrap; width: 45%; }
  .mv { font-weight: 700; color: #000; }
  .qno { font-size: 12px; font-weight: 900; }

  /* ── Buyer section ── */
  .buyer-td { padding: 5px 8px; }
  .buyer-head { font-size: 8.5px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; color: #555; margin-bottom: 2px; }
  .buyer-name { font-size: 12px; font-weight: 900; line-height: 1.2; }
  .buyer-line { font-size: 9px; line-height: 1.7; }

  /* ── Items table ── */
  table.items { width: 100%; border-collapse: collapse; }
  table.items th { background: #e0e0e0; font-size: 9px; text-align: center; padding: 4px 3px;
    border: 1px solid #000; font-weight: 700; border-top: none; }
  table.items td { font-size: 9.5px; padding: 3px 4px; border: 1px solid #000; border-top: none; vertical-align: top; }
  table.items .desc-main { font-weight: 700; display: block; }
  table.items .desc-code { font-family: 'Courier New', monospace; font-size: 8.5px; color: #444; display: block; }
  table.items .tax-row td { background: #f5f5f5; font-style: italic; }
  table.items .total-row td { background: #e8e8e8; font-weight: 700; }

  .tr { text-align: right !important; }
  .tc { text-align: center !important; }
  .tl { text-align: left !important; }

  /* ── Words row ── */
  .words-td { padding: 5px 7px; border-top: 1px solid #000; }
  .words-label { font-size: 9px; color: #555; }
  .words-val { font-size: 10px; font-weight: 700; }
  .eoe { font-size: 8.5px; font-style: italic; text-align: right; float: right; margin-top: 2px; }

  /* ── Tax summary ── */
  table.tax-sum { width: 100%; border-collapse: collapse; }
  table.tax-sum td, table.tax-sum th { border: 1px solid #000; padding: 3px 5px; font-size: 9px; vertical-align: middle; }
  table.tax-sum th { background: #e0e0e0; font-weight: 700; text-align: center; }
  table.tax-sum .tax-words-td { padding: 4px 7px; font-size: 9px; }

  /* ── Footer ── */
  .footer-outer { width: 100%; border-collapse: collapse; }
  .footer-outer td { border: 1px solid #000; padding: 5px 7px; vertical-align: top; font-size: 9px; }
  .decl-head { font-weight: 700; font-size: 9px; margin-bottom: 2px; }
  .bank-head { font-weight: 700; font-size: 9px; margin-bottom: 3px; }
  .bank-line { font-size: 9px; line-height: 1.75; }
  .sig-area { text-align: right; }
  .sig-line { border-top: 1px solid #000; margin-top: 35px; padding-top: 4px; font-size: 9px; text-align: center; }

  .mono { font-family: 'Courier New', monospace; }
  .bold { font-weight: 700; }
</style>
</head>
<body>
<div class="page">
<%
  const fmtDate = (d) => {
    if (!d) return '—';
    const dt = new Date(d);
    if (isNaN(dt)) return String(d);
    return dt.toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' });
  };
  const fmtAmt = (n) => {
    const num = parseFloat(n) || 0;
    return num.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  };
  const qDate    = q.quotation_date || q.created_at;
  const validDt  = new Date(qDate);
  validDt.setDate(validDt.getDate() + (q.validity_days || 7));
  const showDisc = q.show_discount === 1;
  const isIGST   = q.tax_mode === 'IGST';

  // Compute per-rate tax summary for the tax table
  const taxMap = {};
  items.forEach(it => {
    const r = parseFloat(it.tax_rate) || 0;
    const basic = parseFloat(it.line_total) - parseFloat(it.tax_amount);
    if (!taxMap[r]) taxMap[r] = { basic: 0, tax: 0 };
    taxMap[r].basic += basic;
    taxMap[r].tax   += parseFloat(it.tax_amount);
  });
  const taxRows = Object.entries(taxMap).sort((a,b) => a[0]-b[0]);

  const s = settings;
  const coState = s.company_state || 'Uttar Pradesh';
  const coCode  = s.company_state_code || '09';
%>

<!-- ═══ TITLE ROW ═══ -->
<table class="outer">
<tr>
  <td class="title-td" colspan="2">
    <span class="doc-title">Spare Parts Quotation</span>
    <span class="orig-label">(Customer Copy)</span>
  </td>
</tr>

<!-- ═══ QUOTATION META ═══ -->
<tr>
  <!-- Left spacer (letterhead provides company info) -->
  <td class="co-block" style="background:transparent;"></td>

  <!-- Quotation meta -->
  <td style="padding:0; width:45%;">
    <table class="meta-inner">
      <tr><td class="mk">Quotation No.</td><td class="mv qno"><%= q.quotation_no %></td></tr>
      <tr><td class="mk">Dated</td><td class="mv"><%= fmtDate(qDate) %></td></tr>
      <tr><td class="mk">Valid Until</td><td class="mv"><%= fmtDate(validDt) %></td></tr>
      <tr><td class="mk">Tax Mode</td><td class="mv"><%= isIGST ? 'IGST' : 'CGST + SGST' %></td></tr>
      <tr><td class="mk">Machine No.</td><td class="mv mono"><%= q.machine_no || '—' %></td></tr>
      <tr><td class="mk">Prepared By</td><td class="mv"><%= q.salesperson || s.salesperson_name || '—' %></td></tr>
      <% if (q.remarks) { %><tr><td class="mk">Remarks</td><td class="mv"><%= q.remarks %></td></tr><% } %>
    </table>
  </td>
</tr>

<!-- ═══ BUYER SECTION ═══ -->
<tr>
  <td class="buyer-td" colspan="2">
    <div class="buyer-head">Buyer (Bill To)</div>
    <div class="buyer-name"><%= q.customer_name %></div>
    <div class="buyer-line">
      <% if (q.customer_address) { %><%= q.customer_address %><br><% } %>
      <% if (q.customer_gstin)   { %><b>GSTIN/UIN:</b> <span class="mono"><%= q.customer_gstin %></span>&nbsp;&nbsp;<% } %>
      <% if (q.place_of_supply)  { %><b>Place of Supply:</b> <%= q.place_of_supply %><% } %>
      <% if (q.mobile)           { %>&nbsp;&nbsp;<b>Mobile:</b> <%= q.mobile %><% } %>
    </div>
  </td>
</tr>
</table>

<!-- ═══ ITEMS TABLE ═══ -->
<table class="items" style="border-top:none;">
  <thead>
    <tr>
      <th style="width:22px">Sl<br>No.</th>
      <th style="width:72px">Part No.</th>
      <th class="tl" style="min-width:110px">Description of Goods</th>
      <th style="width:55px">HSN/<br>SAC</th>
      <th style="width:42px">GST<br>Rate</th>
      <th style="width:32px">Qty</th>
      <th style="width:68px">Rate<br>(₹)</th>
      <th style="width:28px">Per</th>
      <% if (showDisc) { %>
      <th style="width:38px">Disc<br>%</th>
      <th style="width:52px">Disc<br>Amt</th>
      <% } %>
      <th style="width:72px">Amount<br>(₹)</th>
    </tr>
  </thead>
  <tbody>
    <% items.forEach((it, idx) => {
       const lineBasic = (parseFloat(it.line_total) - parseFloat(it.tax_amount)).toFixed(2);
    %>
    <tr>
      <td class="tc"><%= idx + 1 %></td>
      <td class="tc mono" style="font-size:8.5px"><%= it.part_no || '—' %></td>
      <td>
        <span class="desc-main"><%= it.description %></span>
      </td>
      <td class="tc mono" style="font-size:9px"><%= it.hsn || '—' %></td>
      <td class="tc"><%= it.tax_rate %>%</td>
      <td class="tc"><%= it.qty %></td>
      <td class="tr"><%= fmtAmt(it.basic_rate) %></td>
      <td class="tc">NOS</td>
      <% if (showDisc) { %>
      <td class="tc"><%= it.discount_percent ? it.discount_percent + '%' : '—' %></td>
      <td class="tr"><%= it.discount_amount ? fmtAmt(it.discount_amount) : '—' %></td>
      <% } %>
      <td class="tr bold"><%= fmtAmt(lineBasic) %></td>
    </tr>
    <% }) %>

    <!-- Tax lines (like the invoice shows OUTPUT CGST / SGST) -->
    <% if (isIGST) { %>
    <tr style="background:#f9f9f9">
      <td colspan="<%= showDisc ? 10 : 8 %>" style="font-style:italic; font-size:9px; color:#555; padding-right:6px; text-align:right;">Output IGST</td>
      <td class="tr" style="font-size:9px"><%= fmtAmt(q.total_gst) %></td>
    </tr>
    <% } else { %>
    <tr style="background:#f9f9f9">
      <td colspan="<%= showDisc ? 10 : 8 %>" style="font-style:italic; font-size:9px; color:#555; padding-right:6px; text-align:right;">Output CGST</td>
      <td class="tr" style="font-size:9px"><%= fmtAmt(q.total_gst / 2) %></td>
    </tr>
    <tr style="background:#f9f9f9">
      <td colspan="<%= showDisc ? 10 : 8 %>" style="font-style:italic; font-size:9px; color:#555; padding-right:6px; text-align:right;">Output SGST/UTGST</td>
      <td class="tr" style="font-size:9px"><%= fmtAmt(q.total_gst / 2) %></td>
    </tr>
    <% } %>

    <!-- Roundoff row -->
    <% if (q.roundoff_amount && q.roundoff_amount !== 0) { %>
    <tr style="background:#f9f9f9">
      <td colspan="<%= showDisc ? 10 : 8 %>" style="font-style:italic; font-size:9px; color:#555; padding-right:6px; text-align:right;">Round Off</td>
      <td class="tr" style="font-size:9px"><%= q.roundoff_amount > 0 ? '+' : '' %><%= fmtAmt(q.roundoff_amount) %></td>
    </tr>
    <% } %>
    <!-- Grand Total row -->
    <tr class="total-row">
      <td colspan="<%= showDisc ? 10 : 8 %>" class="tr bold" style="font-size:10px; padding-right:6px;">Grand Total</td>
      <td class="tr bold" style="font-size:11px">₹ <%= fmtAmt(q.grand_total) %></td>
    </tr>
  </tbody>
</table>

<!-- ═══ AMOUNT IN WORDS ═══ -->
<table class="outer" style="border-top:none; border-collapse:collapse;">
<tr>
  <td class="words-td">
    <span class="eoe">E. &amp; O.E</span>
    <div class="words-label">Amount Chargeable (in words)</div>
    <div class="words-val">INR <%= numberToWords(Math.round(q.grand_total)) %></div>
  </td>
</tr>

<!-- ═══ TAX SUMMARY TABLE ═══ -->
<tr>
  <td style="padding:0;">
    <table class="tax-sum">
      <thead>
        <tr>
          <th>HSN/SAC</th>
          <th>Taxable Value</th>
          <% if (isIGST) { %>
          <th>IGST Rate</th><th>IGST Amount</th>
          <% } else { %>
          <th>Central Tax<br>Rate</th><th>Central Tax<br>Amount</th>
          <th>State Tax / UTGST<br>Rate</th><th>State Tax / UTGST<br>Amount</th>
          <% } %>
          <th>Total Tax<br>Amount</th>
        </tr>
      </thead>
      <tbody>
        <% taxRows.forEach(([rate, vals]) => { %>
        <tr>
          <td class="tc"><%= rate %>%</td>
          <td class="tr"><%= fmtAmt(vals.basic) %></td>
          <% if (isIGST) { %>
          <td class="tc"><%= rate %>%</td><td class="tr"><%= fmtAmt(vals.tax) %></td>
          <% } else { %>
          <td class="tc"><%= (rate/2).toFixed(2) %>%</td><td class="tr"><%= fmtAmt(vals.tax/2) %></td>
          <td class="tc"><%= (rate/2).toFixed(2) %>%</td><td class="tr"><%= fmtAmt(vals.tax/2) %></td>
          <% } %>
          <td class="tr bold"><%= fmtAmt(vals.tax) %></td>
        </tr>
        <% }) %>
        <tr style="background:#e8e8e8; font-weight:700;">
          <td class="bold">Total</td>
          <td class="tr bold"><%= fmtAmt(q.total_basic) %></td>
          <% if (isIGST) { %>
          <td></td><td class="tr bold"><%= fmtAmt(q.total_gst) %></td>
          <% } else { %>
          <td></td><td class="tr bold"><%= fmtAmt(q.total_gst/2) %></td>
          <td></td><td class="tr bold"><%= fmtAmt(q.total_gst/2) %></td>
          <% } %>
          <td class="tr bold"><%= fmtAmt(q.total_gst) %></td>
        </tr>
      </tbody>
    </table>
  </td>
</tr>

<!-- Tax amount in words -->
<tr>
  <td class="words-td" style="font-size:9px;">
    <span style="color:#555">Tax Amount (in words):</span>
    <b>INR <%= numberToWords(Math.round(q.total_gst)) %></b>
  </td>
</tr>
</table>


<!-- ═══ FOOTER: DECLARATION | SIGNATURE ═══ -->
<!-- ═══ TERMS & CONDITIONS ═══ -->
<div style="margin-top:10px; border:1px solid #ccc; border-radius:3px; padding:8px 10px; page-break-inside:avoid;">
  <div style="font-size:8px; font-weight:700; letter-spacing:0.8px; color:#1a1a1a; border-bottom:1px solid #ddd; padding-bottom:4px; margin-bottom:5px; text-transform:uppercase;">Terms &amp; Conditions</div>
  <table style="width:100%; border-collapse:collapse; font-size:7.5px; color:#333; line-height:1.5;">
    <colgroup><col style="width:50%"><col style="width:50%"></colgroup>
    <tr>
      <td style="vertical-align:top; padding-right:8px; padding-bottom:3px;"><b>1. Estimate Validity:</b> This estimate is valid for 7 days from the date of issue. Prices are subject to change thereafter.</td>
      <td style="vertical-align:top; padding-bottom:3px;"><b>2. Taxes:</b> GST and other applicable government taxes/levies shall be charged as applicable on the date of invoicing.</td>
    </tr>
    <tr>
      <td style="vertical-align:top; padding-right:8px; padding-bottom:3px;"><b>3. Payment:</b> Payment shall be made as per agreed payment terms. Delay in payment may attract applicable interest/charges.</td>
      <td style="vertical-align:top; padding-bottom:3px;"><b>4. Order Confirmation:</b> An order is confirmed only upon receipt of the required advance/payment and written acceptance by the Company.</td>
    </tr>
    <tr>
      <td style="vertical-align:top; padding-right:8px; padding-bottom:3px;"><b>5. Delivery:</b> Delivery is subject to availability and receipt of agreed payment. Timelines are indicative and may vary due to circumstances beyond the Company's control.</td>
      <td style="vertical-align:top; padding-bottom:3px;"><b>6. Transportation:</b> Transportation, insurance, registration, road tax, permits and incidental charges shall be borne by the customer unless specifically included.</td>
    </tr>
    <tr>
      <td style="vertical-align:top; padding-right:8px; padding-bottom:3px;"><b>7. Warranty:</b> Warranty is governed strictly by manufacturer's terms. It does not cover wear and tear, misuse, negligence, accidents or unauthorized repairs.</td>
      <td style="vertical-align:top; padding-bottom:3px;"><b>8. Specifications:</b> Product specifications, features and configurations are subject to change by the manufacturer without prior notice.</td>
    </tr>
    <tr>
      <td style="vertical-align:top; padding-right:8px; padding-bottom:3px;"><b>9. Cancellation &amp; Refund:</b> Cancellation is subject to Company's approval. Applicable cancellation, processing or restocking charges may be deducted.</td>
      <td style="vertical-align:top; padding-bottom:3px;"><b>10. Documentation:</b> Registration, insurance, financing and statutory documentation shall be the customer's responsibility unless specifically agreed otherwise.</td>
    </tr>
    <tr>
      <td style="vertical-align:top; padding-right:8px; padding-bottom:3px;"><b>11. Invoice:</b> The invoice shall be treated as the final document for quantity, model, specifications, price, taxes and other commercial terms.</td>
      <td style="vertical-align:top; padding-bottom:3px;"><b>12. Force Majeure:</b> The Company shall not be liable for any delay caused by natural calamities, strikes, government restrictions, shortage of materials or manufacturer-related delays.</td>
    </tr>
    <tr>
      <td style="vertical-align:top; padding-right:8px;"><b>13. Jurisdiction:</b> Any dispute shall be subject to the jurisdiction of competent courts at Meerut, Uttar Pradesh.</td>
      <td style="vertical-align:top;"><b>14. Acceptance:</b> Placement of an order or acceptance of delivery shall constitute acceptance of these terms and conditions.</td>
    </tr>
  </table>
</div>

<table class="footer-outer" style="border-top: none; margin-top:8px;">
  <tr>
    <!-- Declaration -->
    <td style="width:60%">
      <div class="decl-head">Declaration</div>
      <div style="font-size:8.5px; line-height:1.65; color:#333;">
        We declare that this quotation shows the actual price of the goods described and that all particulars are true and correct.
      </div>
    </td>

    <!-- Signature -->
    <td style="width:40%" class="sig-area">
      <div class="sig-line">
        Customer's Seal and Signature
      </div>
      <div style="margin-top:30px;" class="sig-line">
        for <b><%= s.company_name || 'SUPER ALLIED' %></b><br>
        Authorised Signatory
      </div>
    </td>
  </tr>
</table>

<!-- ═══ PAYMENT DETAILS (end of page) ═══ -->
<table class="footer-outer" style="border-top: none; margin-top:0;">
  <tr>
    <% if (qrDataUrl) { %>
    <td style="width:90px; text-align:center; vertical-align:middle; padding:6px;">
      <img src="<%= qrDataUrl %>" style="height:75px; display:block; margin:0 auto 3px auto;">
      <span style="font-size:8px; color:#555;">Scan to Pay</span>
    </td>
    <% } %>
    <td>
      <div class="bank-head">Payment Details</div>
      <% if (s.bank_account) { %>
      <div class="bank-line">
        <b>A/c Name:</b> <%= s.bank_beneficiary %>&nbsp;&nbsp;
        <b>A/c No.:</b> <span class="mono"><b><%= s.bank_account %></b></span>&nbsp;&nbsp;
        <b>IFSC:</b> <span class="mono"><b><%= s.bank_ifsc %></b></span>&nbsp;&nbsp;
        <b>Branch:</b> <%= s.bank_branch %><br>
        <% if (s.company_upi) { %><b>UPI:</b> <span class="mono"><%= s.company_upi %></span><% } %>
      </div>
      <% } %>
    </td>
  </tr>
</table>

<!-- Bottom note -->
<div style="text-align:center; font-size:8px; color:#777; margin-top:3px; border-top:1px solid #ccc; padding-top:3px;">
  This is a computer-generated quotation. SUBJECT TO MEERUT JURISDICTION.
</div>

</div>
</body>
</html>
