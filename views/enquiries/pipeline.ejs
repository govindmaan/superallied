<%- include('../partials/head', { title }) %>
<%- include('../partials/sidebar', { active: 'enquiries', user }) %>
<div class="main-content">
  <div class="page-header d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0 fw-bold"><i class="bi bi-kanban text-danger me-2"></i>Enquiry Pipeline</h4>
    <div class="d-flex gap-2">
      <a href="/enquiries" class="btn btn-outline-secondary btn-sm"><i class="bi bi-list me-1"></i>List View</a>
      <a href="/enquiries/dashboard" class="btn btn-outline-secondary btn-sm"><i class="bi bi-bar-chart me-1"></i>Dashboard</a>
      <a href="/enquiries/new" class="btn btn-danger btn-sm"><i class="bi bi-plus-lg me-1"></i>New Enquiry</a>
    </div>
  </div>

  <div class="d-flex gap-3 overflow-auto pb-3" style="min-height:calc(100vh - 160px)">

    <% const stageBg = { phone_followup: '#e3f2fd', sales_visit: '#e0f7fa', enquiry_generated: '#fff8e1', sales_closed: '#e8f5e9' }; %>
    <% STAGE_KEYS.forEach(sk => { %>
    <div class="flex-shrink-0" style="width:280px">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-header py-2 d-flex align-items-center gap-2" style="background:<%= stageBg[sk] %>">
          <span class="badge bg-<%= STAGES[sk].color %>"><%= STAGES[sk].order %></span>
          <span class="fw-semibold small"><%= STAGES[sk].label %></span>
          <span class="badge bg-secondary ms-auto"><%= pipeline[sk].length %></span>
        </div>
        <div class="card-body p-2" style="overflow-y:auto;max-height:calc(100vh - 220px)">
          <% if (!pipeline[sk].length) { %>
          <div class="text-center text-muted small py-3">No enquiries</div>
          <% } %>
          <% pipeline[sk].forEach(e => { %>
          <div class="card mb-2 border-0 shadow-sm" style="cursor:pointer" onclick="location.href='/enquiries/<%= e.id %>'">
            <div class="card-body p-2">
              <small class="text-danger fw-semibold"><%= e.enquiry_number %></small>
              <div class="fw-semibold small mt-1"><%= e.customer_name %></div>
              <% if (e.phone) { %><div class="text-muted" style="font-size:11px"><i class="bi bi-telephone me-1"></i><%= e.phone %></div><% } %>
              <% if (e.machine_interested || e.machine_model) { %><div class="text-muted" style="font-size:11px"><i class="bi bi-gear me-1"></i><%= e.machine_model || e.machine_interested %></div><% } %>
              <% if (e.village_city || e.district) { %><div class="text-muted" style="font-size:11px"><i class="bi bi-geo-alt me-1"></i><%= [e.village_city, e.district].filter(Boolean).join(', ') %></div><% } %>
              <% if (allAccess && e.assignee_name) { %><div class="text-muted mt-1 text-xs"><i class="bi bi-person me-1"></i><%= e.assignee_name %></div><% } %>
            </div>
          </div>
          <% }) %>
        </div>
      </div>
    </div>
    <% }) %>

    <!-- Won column -->
    <div class="flex-shrink-0" style="width:240px">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-header py-2 d-flex align-items-center gap-2 bg-success-subtle">
          <i class="bi bi-trophy text-success"></i><span class="fw-semibold small text-success">Won</span>
          <span class="badge bg-success ms-auto"><%= pipeline.won.length %></span>
        </div>
        <div class="card-body p-2" style="overflow-y:auto;max-height:calc(100vh - 220px)">
          <% pipeline.won.forEach(e => { %>
          <div class="card mb-2 border-0 border-start border-success border-3 shadow-sm" onclick="location.href='/enquiries/<%= e.id %>'" style="cursor:pointer">
            <div class="card-body p-2">
              <small class="text-danger fw-semibold"><%= e.enquiry_number %></small>
              <div class="fw-semibold small"><%= e.customer_name %></div>
            </div>
          </div>
          <% }) %>
        </div>
      </div>
    </div>

    <!-- Lost column -->
    <div class="flex-shrink-0" style="width:240px">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-header py-2 d-flex align-items-center gap-2 bg-danger-subtle">
          <i class="bi bi-x-circle text-danger"></i><span class="fw-semibold small text-danger">Lost</span>
          <span class="badge bg-danger ms-auto"><%= pipeline.lost.length %></span>
        </div>
        <div class="card-body p-2" style="overflow-y:auto;max-height:calc(100vh - 220px)">
          <% pipeline.lost.forEach(e => { %>
          <div class="card mb-2 border-0 border-start border-danger border-3 shadow-sm" onclick="location.href='/enquiries/<%= e.id %>'" style="cursor:pointer">
            <div class="card-body p-2">
              <small class="text-danger fw-semibold"><%= e.enquiry_number %></small>
              <div class="fw-semibold small"><%= e.customer_name %></div>
            </div>
          </div>
          <% }) %>
        </div>
      </div>
    </div>

  </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body></html>
