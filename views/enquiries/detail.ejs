<%- include('../partials/head', { title }) %>
<%- include('../partials/sidebar', { active: 'enquiries', user }) %>
<div class="main-content">

  <div class="page-header d-flex justify-content-between align-items-center mb-3">
    <div>
      <h4 class="mb-0 fw-bold"><%= enquiry.enquiry_number %></h4>
      <small class="text-muted">Created <%= new Date(enquiry.created_at).toLocaleDateString('en-IN') %> by <%= enquiry.creator_name || 'Unknown' %></small>
    </div>
    <div class="d-flex gap-2">
      <a href="/enquiries/<%= enquiry.id %>/edit" class="btn btn-sm btn-outline-primary"><i class="bi bi-pencil me-1"></i>Edit</a>
      <a href="/enquiries" class="btn btn-sm btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Back</a>
    </div>
  </div>

  <% if (flash.success) { %><div class="alert alert-success alert-dismissible py-2"><%= flash.success %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div><% } %>
  <% if (flash.error) { %><div class="alert alert-danger alert-dismissible py-2"><%= flash.error %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div><% } %>

  <!-- Status banner -->
  <div class="card border-0 shadow-sm mb-3">
    <div class="card-body">
      <div class="row align-items-center">
        <div class="col-md-8">
          <h5 class="mb-1 fw-bold"><%= enquiry.customer_name %></h5>
          <div class="text-muted d-flex flex-wrap gap-3 align-items-center">
            <% if (enquiry.phone) { %>
            <a href="tel:<%= enquiry.phone %>" class="text-decoration-none text-success"><i class="bi bi-telephone-fill me-1"></i><%= enquiry.phone %></a>
            <a href="https://wa.me/91<%= enquiry.phone.replace(/\D/g,'').slice(-10) %>" target="_blank" class="text-decoration-none text-success"><i class="bi bi-whatsapp me-1"></i>WhatsApp</a>
            <% } %>
            <% if (enquiry.machine_model || enquiry.machine_interested) { %><span><i class="bi bi-gear me-1"></i><%= enquiry.machine_model || enquiry.machine_interested %></span><% } %>
            <% if (enquiry.village_city || enquiry.district) { %>
            <a href="https://www.google.com/maps/search/?api=1&query=<%= encodeURIComponent([enquiry.village_city, enquiry.district, enquiry.location].filter(Boolean).join(', ')) %>" target="_blank" class="text-decoration-none">
              <i class="bi bi-geo-alt-fill me-1"></i><%= [enquiry.village_city, enquiry.district].filter(Boolean).join(', ') %>
            </a>
            <% } %>
          </div>
        </div>
        <div class="col-md-4 text-md-end mt-3 mt-md-0">
          <% if (enquiry.status === 'won') { %>
          <span class="badge bg-success fs-6 px-3 py-2"><i class="bi bi-trophy me-1"></i>WON</span>
          <% } else if (enquiry.status === 'lost') { %>
          <span class="badge bg-danger fs-6 px-3 py-2"><i class="bi bi-x-circle me-1"></i>LOST</span>
          <% } else { %>
          <span class="badge bg-<%= STAGES[enquiry.current_stage]?.color||'secondary' %> fs-6 px-3 py-2"><i class="bi bi-activity me-1"></i><%= STAGES[enquiry.current_stage]?.label %></span>
          <% } %>
          <div class="mt-2">
            <% if (enquiry.status !== 'won') { %><button class="btn btn-sm btn-success me-1" onclick="changeStatus('won')"><i class="bi bi-trophy me-1"></i>Mark Won</button><% } %>
            <% if (enquiry.status !== 'lost') { %><button class="btn btn-sm btn-danger" onclick="changeStatus('lost')"><i class="bi bi-x-circle me-1"></i>Mark Lost</button><% } %>
            <% if (enquiry.status !== 'active') { %><button class="btn btn-sm btn-outline-secondary" onclick="changeStatus('active')"><i class="bi bi-arrow-repeat me-1"></i>Reopen</button><% } %>
          </div>
        </div>
      </div>

      <!-- Stage progress -->
      <% if (enquiry.status === 'active') { %>
      <div class="mt-3">
        <div class="d-flex justify-content-between mb-1">
          <% STAGE_KEYS.forEach(sk => { %>
          <div class="text-center" style="flex:1">
            <div class="rounded-circle d-inline-flex align-items-center justify-content-center fw-bold"
                 style="width:32px;height:32px;font-size:12px;
                        background:<%= STAGES[enquiry.current_stage].order >= STAGES[sk].order ? '#dc3545' : '#e9ecef' %>;
                        color:<%= STAGES[enquiry.current_stage].order >= STAGES[sk].order ? '#fff' : '#6c757d' %>">
              <%= STAGES[sk].order %>
            </div>
            <div style="font-size:10px;margin-top:2px;color:<%= STAGES[enquiry.current_stage].order >= STAGES[sk].order ? '#dc3545' : '#6c757d' %>">
              <%= STAGES[sk].label %>
            </div>
          </div>
          <% }) %>
        </div>
      </div>
      <% } %>
    </div>
  </div>

  <div class="row g-3">

    <!-- Left column: current state -->
    <div class="col-lg-5">

      <% if (allAccess) { %>
      <div class="card border-0 shadow-sm mb-3">
        <div class="card-header py-2 bg-light"><span class="fw-semibold small">Assignment</span></div>
        <div class="card-body">
          <form method="post" action="/enquiries/<%= enquiry.id %>/assign" class="d-flex gap-2">
            <select class="form-select form-select-sm" name="assigned_to" required>
              <option value="">— Select Salesperson —</option>
              <% staff.forEach(s => { %><option value="<%= s.id %>" <%= enquiry.assigned_to==s.id?'selected':'' %>><%= s.full_name %></option><% }) %>
            </select>
            <button class="btn btn-sm btn-outline-primary text-nowrap"><i class="bi bi-arrow-left-right"></i> Reassign</button>
          </form>
          <div class="small text-muted mt-2">Currently: <strong><%= enquiry.assignee_name || 'Unassigned' %></strong></div>
        </div>
      </div>
      <% } %>

      <!-- Enquiry Generated -->
      <div class="card border-0 shadow-sm mb-3">
        <div class="card-header py-2 bg-light d-flex justify-content-between align-items-center">
          <span class="fw-semibold small">Enquiry Generated</span>
          <% if (enquiry.quotation_sent) { %><span class="badge bg-success">Quotation Sent</span><% } %>
        </div>
        <div class="card-body">
          <form method="post" action="/enquiries/<%= enquiry.id %>/generate">
            <div class="row g-2">
              <div class="col-6">
                <label class="form-label small">Machine Model</label>
                <input type="text" class="form-control form-control-sm" name="machine_model" value="<%= enquiry.machine_model||'' %>">
              </div>
              <div class="col-6">
                <label class="form-label small">Expected Purchase Date</label>
                <input type="date" class="form-control form-control-sm" name="expected_purchase_date" value="<%= enquiry.expected_purchase_date ? enquiry.expected_purchase_date.slice(0,10) : '' %>">
              </div>
              <div class="col-6">
                <label class="form-label small">Budget (₹)</label>
                <input type="number" class="form-control form-control-sm" name="budget" value="<%= enquiry.budget||'' %>">
              </div>
              <div class="col-6">
                <label class="form-label small">Probability %</label>
                <input type="number" min="0" max="100" class="form-control form-control-sm" name="probability_percent" value="<%= enquiry.probability_percent||'' %>">
              </div>
              <div class="col-6 form-check pt-4">
                <input class="form-check-input" type="checkbox" name="finance_required" value="1" <%= enquiry.finance_required?'checked':'' %> id="chkFinance">
                <label class="form-check-label small" for="chkFinance">Finance Required</label>
              </div>
              <div class="col-6 form-check pt-4">
                <input class="form-check-input" type="checkbox" name="quotation_sent" value="1" <%= enquiry.quotation_sent?'checked':'' %> id="chkQtnSent">
                <label class="form-check-label small" for="chkQtnSent">Quotation Sent</label>
              </div>
            </div>
            <button class="btn btn-sm btn-warning mt-2"><i class="bi bi-check-lg me-1"></i>Save</button>
          </form>
          <hr>
          <div class="d-flex justify-content-between align-items-center">
            <span class="small fw-semibold">Quotations</span>
            <a href="/enquiries/<%= enquiry.id %>/quotations/new" class="btn btn-xs btn-outline-warning"><i class="bi bi-plus-lg"></i> New Quotation</a>
          </div>
          <% if (quotations.length) { %>
          <ul class="list-unstyled small mt-2 mb-0">
            <% quotations.forEach(q => { %>
            <li class="d-flex justify-content-between border-bottom py-1">
              <span><%= q.quotation_number %> <span class="badge bg-secondary-subtle text-secondary"><%= q.status %></span></span>
              <a href="/enquiries/quotations/<%= q.id %>/pdf" target="_blank"><i class="bi bi-file-earmark-pdf"></i> PDF</a>
            </li>
            <% }) %>
          </ul>
          <% } %>
        </div>
      </div>

      <!-- Sales Closed -->
      <div class="card border-0 shadow-sm mb-3 <%= enquiry.current_stage==='sales_closed'?'':'opacity-75' %>">
        <div class="card-header py-2 bg-light"><span class="fw-semibold small">Sales Closed</span></div>
        <div class="card-body">
          <% if (sale) { %>
          <table class="table table-sm mb-0">
            <tr><td class="text-muted small">Invoice #</td><td><%= sale.invoice_number||'—' %></td></tr>
            <tr><td class="text-muted small">Machine #</td><td><%= sale.machine_number||'—' %></td></tr>
            <tr><td class="text-muted small">Delivery Date</td><td><%= sale.delivery_date ? new Date(sale.delivery_date).toLocaleDateString('en-IN') : '—' %></td></tr>
            <tr><td class="text-muted small">Finance Company</td><td><%= sale.finance_company||'—' %></td></tr>
            <tr><td class="text-muted small">Sale Amount</td><td class="fw-bold">₹<%= sale.sale_amount ? sale.sale_amount.toLocaleString('en-IN') : 0 %></td></tr>
          </table>
          <% } else if (enquiry.status !== 'won') { %>
          <form method="post" action="/enquiries/<%= enquiry.id %>/close">
            <div class="row g-2">
              <div class="col-6"><label class="form-label small">Invoice Number</label><input type="text" class="form-control form-control-sm" name="invoice_number"></div>
              <div class="col-6"><label class="form-label small">Machine Number</label><input type="text" class="form-control form-control-sm" name="machine_number"></div>
              <div class="col-6"><label class="form-label small">Delivery Date</label><input type="date" class="form-control form-control-sm" name="delivery_date"></div>
              <div class="col-6"><label class="form-label small">Finance Company</label><input type="text" class="form-control form-control-sm" name="finance_company"></div>
              <div class="col-12"><label class="form-label small">Sale Amount (₹)</label><input type="number" class="form-control form-control-sm" name="sale_amount"></div>
            </div>
            <button class="btn btn-sm btn-success mt-2" onclick="return confirm('Close this sale? This will mark the enquiry as WON.')"><i class="bi bi-check-circle me-1"></i>Close Sale</button>
          </form>
          <% } else { %>
          <div class="text-muted small">No sale record yet.</div>
          <% } %>
        </div>
      </div>

      <% if (user.role === 'admin') { %>
      <form method="post" action="/enquiries/<%= enquiry.id %>/delete" onsubmit="return confirm('Delete this enquiry permanently?')">
        <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash me-1"></i>Delete Enquiry</button>
      </form>
      <% } %>
    </div>

    <!-- Right column: timeline -->
    <div class="col-lg-7">

      <!-- Quick-action tabs -->
      <div class="card border-0 shadow-sm mb-3">
        <div class="card-body">
          <ul class="nav nav-pills nav-fill mb-3 small" id="actionTabs">
            <li class="nav-item"><a class="nav-link active" data-bs-toggle="pill" href="#tabRemark"><i class="bi bi-chat-dots me-1"></i>Remark</a></li>
            <li class="nav-item"><a class="nav-link" data-bs-toggle="pill" href="#tabFollowup"><i class="bi bi-telephone me-1"></i>Follow-up</a></li>
            <li class="nav-item"><a class="nav-link" data-bs-toggle="pill" href="#tabVisit"><i class="bi bi-geo-alt me-1"></i>Visit</a></li>
          </ul>
          <div class="tab-content">

            <!-- Remark -->
            <div class="tab-pane fade show active" id="tabRemark">
              <form method="post" action="/enquiries/<%= enquiry.id %>/remark" enctype="application/x-www-form-urlencoded">
                <div class="input-group">
                  <textarea class="form-control" name="body" id="remarkBody" rows="2" placeholder="Type a remark…" required></textarea>
                  <button type="button" class="btn btn-outline-secondary" id="micBtn" title="Voice to text" style="display:none"><i class="bi bi-mic"></i></button>
                </div>
                <input type="hidden" name="photo" id="remarkPhoto">
                <div class="d-flex justify-content-between align-items-center mt-2">
                  <label class="btn btn-sm btn-outline-secondary mb-0">
                    <i class="bi bi-camera me-1"></i>Attach Photo
                    <input type="file" accept="image/*" capture="environment" class="d-none" onchange="readPhoto(this,'remarkPhoto')">
                  </label>
                  <button class="btn btn-sm btn-danger"><i class="bi bi-send me-1"></i>Post Remark</button>
                </div>
              </form>
            </div>

            <!-- Follow-up -->
            <div class="tab-pane fade" id="tabFollowup">
              <form method="post" action="/enquiries/<%= enquiry.id %>/followup">
                <div class="row g-2">
                  <div class="col-md-6">
                    <label class="form-label small">Call Status</label>
                    <select class="form-select form-select-sm" name="call_status">
                      <% CALL_STATUSES.forEach(c => { %><option value="<%= c %>"><%= c %></option><% }) %>
                    </select>
                  </div>
                  <div class="col-md-6">
                    <label class="form-label small">Next Follow-up Date</label>
                    <input type="date" class="form-control form-control-sm" name="next_followup_date">
                  </div>
                  <div class="col-12">
                    <label class="form-label small">Notes</label>
                    <textarea class="form-control form-control-sm" name="notes" rows="2"></textarea>
                  </div>
                </div>
                <button class="btn btn-sm btn-primary mt-2"><i class="bi bi-telephone me-1"></i>Log Follow-up</button>
              </form>
            </div>

            <!-- Visit -->
            <div class="tab-pane fade" id="tabVisit">
              <form method="post" action="/enquiries/<%= enquiry.id %>/visit" id="visitForm">
                <div class="row g-2">
                  <div class="col-md-6"><label class="form-label small">Visit Date</label><input type="date" class="form-control form-control-sm" name="visit_date" value="<%= new Date().toISOString().slice(0,10) %>"></div>
                  <div class="col-md-6"><label class="form-label small">Visit Location</label><input type="text" class="form-control form-control-sm" name="visit_location"></div>
                  <div class="col-md-6"><label class="form-label small">Purpose</label><input type="text" class="form-control form-control-sm" name="purpose" placeholder="e.g. Demo, negotiation"></div>
                  <div class="col-md-6"><label class="form-label small">Competitor Machine (if any)</label><input type="text" class="form-control form-control-sm" name="competitor_machine"></div>
                  <div class="col-12"><label class="form-label small">Outcome</label><textarea class="form-control form-control-sm" name="outcome" rows="2"></textarea></div>
                  <div class="col-6 form-check"><input class="form-check-input" type="checkbox" name="demo_given" value="1" id="chkDemoGiven"><label class="form-check-label small" for="chkDemoGiven">Demo Given</label></div>
                </div>
                <input type="hidden" name="lat" id="visitLat"><input type="hidden" name="lng" id="visitLng"><input type="hidden" name="photo" id="visitPhoto">
                <div class="d-flex gap-2 mt-2 flex-wrap">
                  <button type="button" class="btn btn-sm btn-outline-secondary" onclick="captureGPS()"><i class="bi bi-crosshair me-1"></i><span id="gpsLabel">Use My Location</span></button>
                  <label class="btn btn-sm btn-outline-secondary mb-0">
                    <i class="bi bi-camera me-1"></i>Attach Photo
                    <input type="file" accept="image/*" capture="environment" class="d-none" onchange="readPhoto(this,'visitPhoto')">
                  </label>
                  <button class="btn btn-sm btn-info ms-auto"><i class="bi bi-geo-alt me-1"></i>Log Visit</button>
                </div>
              </form>
            </div>

          </div>
        </div>
      </div>

      <!-- Timeline feed -->
      <div class="card border-0 shadow-sm">
        <div class="card-header py-2 bg-light"><span class="fw-semibold small">Timeline</span></div>
        <div class="card-body" style="max-height:640px;overflow-y:auto">
          <% if (!timeline.length) { %>
          <div class="text-center text-muted py-4">No activity yet.</div>
          <% } %>
          <% const typeIcon = { remark:'chat-dots-fill text-primary', followup:'telephone-fill text-info', visit:'geo-alt-fill text-warning', quotation:'file-earmark-text-fill text-success', sale:'trophy-fill text-success', system:'gear-fill text-muted' }; %>
          <% timeline.forEach(t => { %>
          <div class="d-flex gap-2 mb-3">
            <div class="flex-shrink-0">
              <div class="rounded-circle bg-light d-flex align-items-center justify-content-center" style="width:36px;height:36px">
                <i class="bi bi-<%= typeIcon[t.type] || 'circle-fill text-secondary' %>"></i>
              </div>
            </div>
            <div class="flex-grow-1">
              <div class="bg-light rounded p-2">
                <div class="d-flex justify-content-between">
                  <span class="fw-semibold small"><%= t.user_name %></span>
                  <small class="text-muted"><%= dbTime(t.created_at).toLocaleDateString('en-IN') %> · <%= dbTime(t.created_at).toLocaleTimeString('en-IN', {hour:'2-digit',minute:'2-digit'}) %></small>
                </div>
                <div class="small mt-1" style="white-space:pre-wrap"><%= t.text %></div>
                <% t.attachments.forEach(a => { %>
                  <% if (a.file_type === 'image') { %><a href="<%= a.file_path %>" target="_blank"><img src="<%= a.file_path %>" class="mt-2 rounded" style="max-height:120px"></a><% } %>
                <% }) %>
              </div>
            </div>
          </div>
          <% }) %>
        </div>
      </div>

    </div>
  </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
async function changeStatus(status) {
  const labels = { won: 'Mark as WON?', lost: 'Mark as LOST?', active: 'Reopen this enquiry?' };
  if (!confirm(labels[status] || 'Confirm?')) return;
  const r = await fetch('/enquiries/<%= enquiry.id %>/status', {
    method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ status })
  });
  const j = await r.json();
  if (j.ok) location.reload(); else alert(j.error || 'Error');
}

function readPhoto(input, targetId) {
  const file = input.files[0];
  if (!file) return;
  const reader = new FileReader();
  reader.onload = () => { document.getElementById(targetId).value = reader.result; };
  reader.readAsDataURL(file);
}

function captureGPS() {
  const label = document.getElementById('gpsLabel');
  label.textContent = 'Getting location…';
  navigator.geolocation.getCurrentPosition(pos => {
    document.getElementById('visitLat').value = pos.coords.latitude;
    document.getElementById('visitLng').value = pos.coords.longitude;
    label.textContent = 'Location captured ✓';
  }, () => { label.textContent = 'GPS unavailable'; }, { enableHighAccuracy: true, timeout: 10000 });
}

// Voice-to-text for remarks (Chrome/Edge only — feature-detected)
const SpeechRec = window.SpeechRecognition || window.webkitSpeechRecognition;
if (SpeechRec) {
  const micBtn = document.getElementById('micBtn');
  const remarkBody = document.getElementById('remarkBody');
  micBtn.style.display = '';
  const rec = new SpeechRec();
  rec.lang = 'en-IN'; rec.interimResults = false;
  let listening = false;
  micBtn.addEventListener('click', () => {
    if (listening) { rec.stop(); return; }
    rec.start(); listening = true;
    micBtn.classList.add('btn-danger'); micBtn.innerHTML = '<i class="bi bi-mic-fill"></i>';
  });
  rec.onresult = (e) => {
    const text = Array.from(e.results).map(r => r[0].transcript).join(' ');
    remarkBody.value = (remarkBody.value ? remarkBody.value + ' ' : '') + text;
  };
  rec.onend = () => { listening = false; micBtn.classList.remove('btn-danger'); micBtn.innerHTML = '<i class="bi bi-mic"></i>'; };
}
</script>
</body></html>
