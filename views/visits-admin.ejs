<%- include('partials/head', { title }) %>
<%- include('partials/sidebar', { active: 'visits-admin', user }) %>
<div class="main-content">
  <div class="page-header d-flex justify-content-between align-items-center mb-4">
    <h4 class="mb-0 fw-bold"><i class="bi bi-collection-fill me-2 text-danger"></i><%= t("All Site Visits") %></h4>
    <span class="badge bg-secondary"><%= total %> <%= t("total") %></span>
  </div>

  <div class="card border-0 shadow-sm mb-3">
    <div class="card-body py-2">
      <form method="get" class="row g-2 align-items-end">
        <div class="col-12 col-md-4">
          <label class="form-label small mb-1"><%= t("Employee") %></label>
          <select name="emp" class="form-select form-select-sm">
            <option value=""><%= t("All employees") %></option>
            <% employees.forEach(e => { %>
            <option value="<%= e.id %>" <%= empFilter === e.id ? 'selected' : '' %>><%= e.full_name || e.username %></option>
            <% }) %>
          </select>
        </div>
        <div class="col-6 col-md-3">
          <label class="form-label small mb-1"><%= t("Date") %></label>
          <input type="date" name="date" class="form-control form-control-sm" value="<%= dateFilter || '' %>" max="<%= new Date().toLocaleDateString('en-CA') %>">
        </div>
        <div class="col-6 col-md-auto">
          <button class="btn btn-sm btn-danger w-100"><i class="bi bi-search me-1"></i><%= t("Filter") %></button>
        </div>
        <% if (dateFilter || empFilter) { %>
        <div class="col-auto">
          <a href="/visits/admin" class="btn btn-sm btn-outline-secondary"><i class="bi bi-x me-1"></i><%= t("Clear") %></a>
        </div>
        <% } %>
      </form>
    </div>
  </div>

  <div class="card border-0 shadow-sm">
    <div class="table-responsive">
      <table class="table table-hover mb-0 align-middle">
        <thead class="table-light">
          <tr>
            <th class="small"><%= t("Visit ID") %></th>
            <th class="small"><%= t("Date & Time") %></th>
            <th class="small"><%= t("Employee") %></th>
            <th class="small"><%= t("Customer / Site") %></th>
            <th class="small"><%= t("Phone") %></th>
            <th class="small"><%= t("Purpose") %></th>
            <th class="small"><%= t("Location") %></th>
            <th class="small"><%= t("Photo") %></th>
            <th class="small"><%= t("Voice Note") %></th>
          </tr>
        </thead>
        <tbody>
          <% visits.forEach(v => { %>
          <tr>
            <td class="font-monospace small text-muted">VIS-<%= String(v.id).padStart(5,'0') %></td>
            <td class="small"><%= dbTime(v.visit_time).toLocaleString(locale,{day:'2-digit',month:'short',hour:'2-digit',minute:'2-digit'}) %></td>
            <td class="small fw-semibold"><%= v.emp_name || v.username %></td>
            <td>
              <div class="fw-semibold small"><%= v.customer_name %></div>
              <% if (v.contact_person) { %><div class="text-muted" style="font-size:11px"><%= v.contact_person %></div><% } %>
            </td>
            <td class="small"><% if (v.phone) { %><a href="tel:<%= v.phone %>"><%= v.phone %></a><% } else { %>—<% } %></td>
            <td class="small"><%= v.purpose || '—' %></td>
            <td class="small">
              <% if (v.lat) { %>
                <a href="https://maps.google.com/?q=<%= v.lat %>,<%= v.lng %>" target="_blank" class="text-decoration-none"><i class="bi bi-geo-alt-fill text-danger"></i> <%= t("Map") %></a>
              <% } else if (v.address) { %>
                <span class="text-muted" title="<%= t("No GPS — typed address") %>"><%= v.address.slice(0,40) %><%= v.address.length > 40 ? '…' : '' %></span>
              <% } else { %>—<% } %>
            </td>
            <td>
              <% if (v.photo) { %>
                <a href="<%= v.photo %>" target="_blank">
                  <img src="<%= v.photo %>" alt="photo" style="width:48px;height:36px;object-fit:cover;border-radius:4px">
                </a>
              <% } else { %><span class="text-muted small">—</span><% } %>
            </td>
            <td style="min-width:200px">
              <% if (v.voice_note) { %>
                <audio controls src="<%= v.voice_note %>" style="height:32px;width:190px;max-width:100%"></audio>
              <% } else { %><span class="text-muted small">—</span><% } %>
            </td>
          </tr>
          <% }) %>
          <% if (!visits.length) { %>
          <tr><td colspan="9" class="text-center text-muted py-4"><%= t("No field visits found.") %></td></tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>

  <% if (total > limit) { %>
  <nav class="mt-3">
    <ul class="pagination pagination-sm justify-content-center">
      <% for (let p = 1; p <= Math.ceil(total / limit); p++) { %>
      <li class="page-item <%= p === page ? 'active' : '' %>">
        <a class="page-link" href="?page=<%= p %><%= dateFilter ? '&date=' + dateFilter : '' %><%= empFilter ? '&emp=' + empFilter : '' %>"><%= p %></a>
      </li>
      <% } %>
    </ul>
  </nav>
  <% } %>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body></html>
