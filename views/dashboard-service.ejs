<%- include('partials/head', { title }) %>
<%- include('partials/sidebar', { active: 'dashboard', user }) %>
<%
  const isManager = (emp.position_level || 9) <= 3;
  const tod = today;
%>
<div class="main-content svc-dash">

  <!-- ── Greeting ─────────────────────────────────────────────────────────── -->
  <div class="svc-header">
    <div class="d-flex align-items-center gap-3">
      <% if (emp.photo_path) { %>
        <img src="<%= emp.photo_path %>" class="svc-avatar" alt="">
      <% } else { %>
        <div class="svc-avatar-fb"><%= (emp.full_name||'U').charAt(0).toUpperCase() %></div>
      <% } %>
      <div>
        <div class="svc-hello">Good <%= new Date().getHours()<12?'Morning':new Date().getHours()<17?'Afternoon':'Evening' %> 👋</div>
        <div class="svc-name"><%= emp.full_name || emp.username %></div>
        <% if (emp.designation) { %><div class="svc-sub"><%= emp.designation %></div><% } %>
        <div class="svc-sub"><%= new Date(tod).toLocaleDateString('en-IN',{weekday:'long',day:'numeric',month:'long'}) %></div>
      </div>
    </div>
    <div class="mt-3">
      <% if (todayAtt?.check_out_time) { %>
        <span class="att-pill att-done"><i class="bi bi-check-circle-fill me-1"></i>Day Complete</span>
      <% } else if (todayAtt?.check_in_time) { %>
        <span class="att-pill att-in"><i class="bi bi-dot me-1" style="font-size:1.4rem;line-height:0"></i>Checked In · <%= new Date(todayAtt.check_in_time).toLocaleTimeString('en-IN',{hour:'2-digit',minute:'2-digit'}) %></span>
      <% } else { %>
        <span class="att-pill att-out"><i class="bi bi-exclamation-circle me-1"></i>Not Checked In</span>
      <% } %>
    </div>
  </div>

  <!-- ── MANAGER VIEW: Team overview ──────────────────────────────────────── -->
  <% if (isManager && teamService) { %>

  <!-- 4 KPI cards -->
  <div class="kpi-grid">
    <div class="kpi-card kpi-danger">
      <div class="kpi-val"><%= (teamService.cStats.open_count||0) + (teamService.cStats.assigned_count||0) + (teamService.cStats.visited_count||0) %></div>
      <div class="kpi-label"><i class="bi bi-wrench-adjustable me-1"></i>Active Complaints</div>
      <div class="kpi-sub"><%= teamService.cStats.open_count||0 %> open · <%= teamService.cStats.assigned_count||0 %> assigned · <%= teamService.cStats.visited_count||0 %> visited</div>
    </div>
    <div class="kpi-card kpi-success">
      <div class="kpi-val"><%= teamService.closedMonth %></div>
      <div class="kpi-label"><i class="bi bi-check2-circle me-1"></i>Closed This Month</div>
      <div class="kpi-sub">Complaints resolved</div>
    </div>
    <div class="kpi-card kpi-blue">
      <div class="kpi-val"><%= teamService.spareMonth.c %></div>
      <div class="kpi-label"><i class="bi bi-box-seam me-1"></i>Spare Parts Sold</div>
      <div class="kpi-sub">₹<%= (teamService.spareMonth.v/1000).toFixed(0) %>k this month</div>
    </div>
    <div class="kpi-card kpi-teal">
      <div class="kpi-val"><%= teamService.engineers.filter(e=>e.check_in_time).length %>/<%= teamService.engineers.length %></div>
      <div class="kpi-label"><i class="bi bi-people-fill me-1"></i>Engineers Present</div>
      <div class="kpi-sub">Field staff today</div>
    </div>
  </div>

  <!-- Engineer attendance + work report -->
  <div class="card border-0 shadow-sm mb-3">
    <div class="card-header bg-white fw-semibold small d-flex justify-content-between align-items-center">
      <span><i class="bi bi-person-badge me-1 text-primary"></i>Engineer Status — Today</span>
      <span class="text-muted" style="font-size:11px"><%= new Date().toLocaleDateString('en-IN',{day:'numeric',month:'short'}) %></span>
    </div>
    <div class="eng-strip">
      <% if (!teamService.engineers.length) { %>
        <div class="p-3 text-center text-muted small">No field engineers in org chart.</div>
      <% } else { teamService.engineers.forEach(e => {
           const inTime  = e.check_in_time  ? new Date(e.check_in_time).toLocaleTimeString('en-IN',{hour:'2-digit',minute:'2-digit'}) : null;
           const outTime = e.check_out_time ? new Date(e.check_out_time).toLocaleTimeString('en-IN',{hour:'2-digit',minute:'2-digit'}) : null;
      %> %>
      <div class="eng-row">
        <div class="eng-dot <%= e.check_out_time ? 'dot-out' : e.check_in_time ? 'dot-in' : 'dot-abs' %>"></div>
        <div class="eng-info">
          <div class="eng-nm fw-semibold"><%= e.full_name || '—' %></div>
          <div class="eng-pos text-muted"><%= e.position_title || '' %></div>
        </div>
        <div class="eng-stats">
          <% if (inTime) { %>
            <span class="eng-time <%= outTime ? 'text-secondary' : 'text-success' %>"><%= outTime ? outTime + ' out' : inTime + ' in' %></span>
          <% } else { %>
            <span class="eng-time text-danger">Absent</span>
          <% } %>
          <div class="eng-work">
            <% if (e.visits_today > 0) { %><span class="ewp ewp-visit"><i class="bi bi-geo-alt-fill"></i><%= e.visits_today %></span><% } %>
            <% if (e.closed_today > 0) { %><span class="ewp ewp-closed"><i class="bi bi-check2"></i><%= e.closed_today %></span><% } %>
            <% if (e.open_mine > 0)   { %><span class="ewp ewp-open"><i class="bi bi-wrench"></i><%= e.open_mine %></span><% } %>
          </div>
        </div>
      </div>
      <% }) } %>
    </div>
  </div>

  <!-- Needs assignment -->
  <% if (teamService.needsAssignment.length) { %>
  <div class="card border-0 shadow-sm mb-3">
    <div class="card-header bg-white d-flex justify-content-between align-items-center">
      <span class="fw-semibold small"><i class="bi bi-exclamation-circle me-1 text-danger"></i>Needs Assignment</span>
      <span class="badge bg-danger"><%= teamService.needsAssignment.length %></span>
    </div>
    <div class="list-group list-group-flush">
      <% teamService.needsAssignment.forEach(c => { %>
      <a href="/complaints/<%= c.id %>" class="list-group-item list-group-item-action py-2">
        <div class="d-flex justify-content-between align-items-start gap-2">
          <div style="min-width:0">
            <div class="fw-semibold text-truncate small"><%= c.customer_name || '—' %></div>
            <div class="text-muted" style="font-size:11px"><%= c.complaint_number %> · <%= c.machine_no %><%= c.district ? ' · ' + c.district : '' %></div>
            <% if (c.problem) { %><div class="text-muted text-truncate" style="font-size:11px"><%= c.problem %></div><% } %>
          </div>
          <span class="badge bg-danger flex-shrink-0">Unassigned</span>
        </div>
      </a>
      <% }) %>
    </div>
    <div class="card-footer bg-white text-end">
      <a href="/complaints?f=open" class="btn btn-sm btn-outline-danger">View All Open →</a>
    </div>
  </div>
  <% } %>

  <!-- Visits today -->
  <% if (teamService.recentVisits.length) { %>
  <div class="card border-0 shadow-sm mb-3">
    <div class="card-header bg-white fw-semibold small d-flex justify-content-between align-items-center">
      <span><i class="bi bi-geo-alt-fill me-1 text-success"></i>Site Visits Today</span>
      <span class="badge bg-success"><%= teamService.recentVisits.length %></span>
    </div>
    <div class="list-group list-group-flush">
      <% teamService.recentVisits.forEach(v => { %>
      <a href="/complaints/<%= v.complaint_id %>" class="list-group-item list-group-item-action py-2">
        <div class="d-flex justify-content-between align-items-center gap-2">
          <div style="min-width:0">
            <div class="fw-semibold small text-truncate"><%= v.customer_name || '—' %> · <span class="text-muted"><%= v.machine_no %></span></div>
            <div class="text-muted" style="font-size:11px"><%= v.engineer_name || 'Unknown' %> · <%= v.complaint_number %><%= v.outcome ? ' · ' + v.outcome : '' %></div>
          </div>
          <span class="text-muted flex-shrink-0" style="font-size:11px"><%= new Date(v.created_at).toLocaleTimeString('en-IN',{hour:'2-digit',minute:'2-digit'}) %></span>
        </div>
      </a>
      <% }) %>
    </div>
  </div>
  <% } %>

  <% } %> <!-- /isManager -->

  <!-- ── PRIMARY ACTIONS (all service staff) ──────────────────────────────── -->
  <div class="primary-actions">
    <a href="/attendance" class="pa-btn <%= todayAtt?.check_out_time ? 'pa-done' : todayAtt?.check_in_time ? 'pa-out' : 'pa-in' %>">
      <i class="bi <%= todayAtt?.check_out_time ? 'bi-check2-circle' : todayAtt?.check_in_time ? 'bi-box-arrow-right' : 'bi-box-arrow-in-right' %>"></i>
      <span><%= todayAtt?.check_out_time ? 'Day Complete' : todayAtt?.check_in_time ? 'Check Out' : 'Check In' %></span>
    </a>
    <a href="#" class="pa-btn pa-visit" onclick="openVisitModal(); return false">
      <i class="bi bi-geo-alt-fill"></i><span>Site Visit</span>
      <small><%= myVisits %> today</small>
    </a>
    <a href="/complaints/new" class="pa-btn pa-complaint">
      <i class="bi bi-plus-circle-fill"></i><span>New Complaint</span>
    </a>
  </div>

  <!-- ── My active complaints ──────────────────────────────────────────────── -->
  <% if (myComplaints.length) { %>
  <div class="card border-0 shadow-sm mb-3">
    <div class="card-header bg-white d-flex justify-content-between align-items-center">
      <span class="fw-semibold small"><i class="bi bi-wrench-adjustable me-1 text-warning"></i>My Active Complaints</span>
      <a href="/complaints" class="text-muted" style="font-size:12px">View all →</a>
    </div>
    <div class="list-group list-group-flush">
      <% myComplaints.forEach(c => { %>
      <a href="/complaints/<%= c.id %>" class="list-group-item list-group-item-action py-2">
        <div class="d-flex justify-content-between align-items-start gap-2">
          <div style="min-width:0">
            <div class="fw-semibold small text-truncate"><%= c.customer_name || '—' %></div>
            <div class="text-muted" style="font-size:11px"><%= c.complaint_number %> · <%= c.machine_no %><%= c.district ? ' · ' + c.district : '' %></div>
            <% if (c.problem) { %><div class="text-muted text-truncate" style="font-size:11px"><%= c.problem %></div><% } %>
          </div>
          <% const badgeClr = c.status==='open'?'bg-danger':c.status==='assigned'?'bg-warning text-dark':c.status==='visited'?'bg-info text-dark':'bg-success'; %>
          <span class="badge <%= badgeClr %> flex-shrink-0"><%= c.status %></span>
        </div>
      </a>
      <% }) %>
    </div>
  </div>
  <% } %>

  <!-- ── Personal stat chips ───────────────────────────────────────────────── -->
  <div class="d-flex flex-wrap gap-2 mb-3">
    <div class="stat-chip"><i class="bi bi-wrench me-1"></i><strong><%= myComplaints.length %></strong> active complaints</div>
    <div class="stat-chip"><i class="bi bi-geo-alt me-1"></i><strong><%= myVisits %></strong> visits today</div>
    <div class="stat-chip"><i class="bi bi-receipt-cutoff me-1"></i><strong><%= mySpareQuotes %></strong> spare quotes this month</div>
    <% if (pendingLeaves > 0) { %><div class="stat-chip stat-chip-warn"><i class="bi bi-clock me-1"></i><strong><%= pendingLeaves %></strong> leave pending</div><% } %>
  </div>

  <!-- ── Action tiles ──────────────────────────────────────────────────────── -->
  <div class="tile-grid">

    <a href="/attendance" class="tile tile-attendance">
      <div class="tile-icon"><i class="bi bi-calendar-check-fill"></i></div>
      <div class="tile-label">Attendance</div>
      <div class="tile-sub"><%= !todayAtt?.check_in_time?'Check In':!todayAtt?.check_out_time?'Check Out':'Done' %></div>
    </a>

    <a href="/complaints" class="tile tile-complaint">
      <div class="tile-icon"><i class="bi bi-wrench-adjustable-circle-fill"></i></div>
      <div class="tile-label">Complaints</div>
      <div class="tile-sub"><%= myComplaints.length %> active</div>
    </a>

    <% if (hasPerm('sold_machines')) { %>
    <a href="/sold-machines" class="tile tile-machines">
      <div class="tile-icon"><i class="bi bi-hdd-rack-fill"></i></div>
      <div class="tile-label">Sold Machines</div>
      <div class="tile-sub">Machine register</div>
    </a>
    <% } %>

    <% if (hasPerm('spare_quotations')) { %>
    <a href="/spare-quotations/new" class="tile tile-spare">
      <div class="tile-icon"><i class="bi bi-receipt-cutoff"></i></div>
      <div class="tile-label">Spare Quote</div>
      <div class="tile-sub"><%= mySpareQuotes %> this month</div>
    </a>
    <% } %>

    <% if (hasPerm('stock')) { %>
    <a href="/stock" class="tile tile-stock">
      <div class="tile-icon"><i class="bi bi-clipboard-data-fill"></i></div>
      <div class="tile-label">Stock</div>
      <div class="tile-sub">Parts availability</div>
    </a>
    <% } %>

    <% if (hasPerm('spare_parts') && (emp.position_level||9) <= 3) { %>
    <a href="/part-orders" class="tile tile-orders">
      <div class="tile-icon"><i class="bi bi-cart-fill"></i></div>
      <div class="tile-label">Part Orders</div>
      <div class="tile-sub">Requests & tracking</div>
    </a>
    <% } %>

    <a href="/route-map" class="tile tile-route">
      <div class="tile-icon"><i class="bi bi-map-fill"></i></div>
      <div class="tile-label">Route Map</div>
      <div class="tile-sub">Today's route</div>
    </a>

    <% if (hasPerm('expense_claim')) { %>
    <a href="/travel-expenses/new" class="tile tile-expense">
      <div class="tile-icon"><i class="bi bi-truck"></i></div>
      <div class="tile-label">Travel Expense</div>
      <div class="tile-sub">₹<%= parseFloat(monthClaim||0).toFixed(0) %> this month</div>
    </a>
    <% } %>

    <a href="/leaves" class="tile tile-leave">
      <div class="tile-icon"><i class="bi bi-calendar-x-fill"></i></div>
      <div class="tile-label">My Leaves</div>
      <div class="tile-sub"><%= pendingLeaves>0?pendingLeaves+' pending':'Apply leave' %></div>
    </a>

    <a href="/salary" class="tile tile-salary">
      <div class="tile-icon"><i class="bi bi-cash-coin"></i></div>
      <div class="tile-label">My Salary</div>
      <div class="tile-sub">View slips</div>
    </a>

    <a href="/id-card" class="tile tile-id">
      <div class="tile-icon"><i class="bi bi-credit-card-2-front-fill"></i></div>
      <div class="tile-label">ID Card</div>
      <div class="tile-sub">View & Download</div>
    </a>

  </div>

  <% if (unreadCount > 0) { %>
  <a href="/notifications" class="notif-bar">
    <i class="bi bi-bell-fill me-2"></i>
    You have <strong><%= unreadCount %></strong> unread notification<%= unreadCount===1?'':'s' %>
    <i class="bi bi-chevron-right ms-auto"></i>
  </a>
  <% } %>
</div>

<!-- Site Visit Modal -->
<div class="modal fade" id="visitModal" tabindex="-1" data-bs-backdrop="static">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header"><h5 class="modal-title fw-bold"><i class="bi bi-geo-alt-fill text-danger me-2"></i>Site Punch-In</h5></div>
      <div class="modal-body">
        <div id="visitStep1">
          <div class="mb-3">
            <label class="form-label fw-semibold">Customer / Site Name <span class="text-danger">*</span></label>
            <input type="text" id="v_customer" class="form-control form-control-lg" placeholder="Enter customer / site name…">
          </div>
          <div class="row g-2 mb-3">
            <div class="col-7"><label class="form-label fw-semibold">Contact Person</label><input type="text" id="v_contact" class="form-control" placeholder="Who did you meet?"></div>
            <div class="col-5"><label class="form-label fw-semibold">Phone</label><input type="tel" id="v_phone" class="form-control" inputmode="numeric" maxlength="13" placeholder="10-digit"></div>
          </div>
          <div class="mb-3">
            <label class="form-label fw-semibold">Purpose of Visit</label>
            <select id="v_purpose" class="form-select">
              <option value="">— Select —</option>
              <option value="Service Visit">Service Visit</option>
              <option value="Machine Repair">Machine Repair</option>
              <option value="Warranty Service">Warranty Service</option>
              <option value="Spare Delivery">Spare Delivery</option>
              <option value="Other">Other</option>
            </select>
          </div>
          <div class="mb-3"><label class="form-label fw-semibold">Remarks</label><textarea id="v_remarks" class="form-control" rows="2" placeholder="Outcome, notes…"></textarea></div>
          <div class="d-flex align-items-start gap-2">
            <div id="v_gps_status" class="small text-muted flex-grow-1"><i class="bi bi-geo-alt me-1"></i>Getting location…</div>
            <button type="button" class="btn btn-sm btn-outline-secondary d-none" id="v_gps_retry" onclick="getVisitLocation()">Retry</button>
          </div>
          <div class="mt-2 d-none" id="v_address_wrap">
            <label class="form-label fw-semibold small mb-1">Visit address <span class="text-danger">*</span></label>
            <textarea id="v_address" class="form-control form-control-sm" rows="2" maxlength="300" placeholder="Village / area, town"></textarea>
          </div>
          <div class="mt-3 d-flex gap-2">
            <button class="btn btn-warning flex-grow-1 fw-bold text-dark" onclick="goToVisitCamera()"><i class="bi bi-camera-fill me-1"></i>Take Site Photo & Punch In</button>
            <button class="btn btn-outline-secondary" onclick="closeVisitModal()">Cancel</button>
          </div>
        </div>
        <div id="visitStepCam" class="d-none text-center">
          <p class="text-muted small mb-2">Take a photo of the site / machine</p>
          <video id="visitVideo" autoplay playsinline style="width:100%;border-radius:10px;max-height:280px;background:#000"></video>
          <div class="mt-3 d-flex gap-2 justify-content-center"><button class="btn btn-warning px-5 fw-bold text-dark" onclick="snapVisitPhoto()"><i class="bi bi-camera-fill me-1"></i>Snap Photo</button></div>
          <button class="btn btn-link text-muted btn-sm mt-1" onclick="backToVisitForm()">Back</button>
        </div>
        <div id="visitStep2" class="d-none text-center py-3"><div class="spinner-border text-warning mb-3"></div><p>Saving visit…</p></div>
        <div id="visitStep3" class="d-none text-center py-3">
          <i class="bi bi-check-circle-fill text-success" style="font-size:3rem"></i>
          <p class="fw-bold mt-2 mb-1">Site visit successfully recorded!</p>
          <div class="text-start small bg-light rounded p-3 mt-2" id="v_summary"></div>
        </div>
        <div id="visitStepErr" class="d-none text-center py-3">
          <i class="bi bi-exclamation-circle-fill text-danger" style="font-size:2.5rem"></i>
          <p class="fw-bold mt-2" id="v_err_msg">Something went wrong.</p>
          <button class="btn btn-outline-danger btn-sm" onclick="backToVisitForm()">Try Again</button>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
@media (min-width:992px){ .svc-dash { padding-top:20px; } }

/* Header */
.svc-header { background:linear-gradient(135deg,#1a2a3a 0%,#1e3a5f 100%); border-radius:16px; padding:20px; color:#fff; margin-bottom:16px; }
.svc-avatar  { width:60px;height:60px;border-radius:50%;object-fit:cover;border:3px solid rgba(255,255,255,.4);flex-shrink:0; }
.svc-avatar-fb { width:60px;height:60px;border-radius:50%;background:#fd7e14;display:flex;align-items:center;justify-content:center;font-size:1.8rem;font-weight:900;flex-shrink:0; }
.svc-hello { font-size:13px;opacity:.7; }
.svc-name  { font-size:20px;font-weight:800;line-height:1.2; }
.svc-sub   { font-size:12px;opacity:.65;margin-top:2px; }
.att-pill  { display:inline-flex;align-items:center;border-radius:20px;padding:4px 14px;font-size:13px;font-weight:600; }
.att-done  { background:rgba(40,167,69,.2);color:#7dffa9; }
.att-in    { background:rgba(255,193,7,.2);color:#ffe066; }
.att-out   { background:rgba(220,53,69,.2);color:#ff8a94; }

/* KPI cards */
.kpi-grid { display:grid;grid-template-columns:repeat(2,1fr);gap:10px;margin-bottom:16px; }
.kpi-card { border-radius:14px;padding:14px 12px;color:#fff; }
.kpi-val  { font-size:2rem;font-weight:900;line-height:1; }
.kpi-label{ font-size:12px;font-weight:700;margin-top:4px;opacity:.95; }
.kpi-sub  { font-size:10px;opacity:.75;margin-top:2px; }
.kpi-danger  { background:linear-gradient(135deg,#dc3545,#b02a37); }
.kpi-success { background:linear-gradient(135deg,#198754,#145c3c); }
.kpi-blue    { background:linear-gradient(135deg,#0d6efd,#0a47b0); }
.kpi-teal    { background:linear-gradient(135deg,#0dcaf0,#0891a8);color:#003040; }
.kpi-teal .kpi-label,.kpi-teal .kpi-sub,.kpi-teal .kpi-val { color:#003040; }

/* Engineer strip */
.eng-strip { }
.eng-row   { display:flex;align-items:center;gap:10px;padding:10px 14px;border-bottom:1px solid #f1f1f1; }
.eng-row:last-child { border-bottom:none; }
.eng-dot   { width:10px;height:10px;border-radius:50%;flex-shrink:0; }
.dot-in    { background:#28a745; }
.dot-out   { background:#6c757d; }
.dot-abs   { background:#dc3545; }
.eng-info  { flex:1;min-width:0; }
.eng-nm    { font-size:13px;line-height:1.2; }
.eng-pos   { font-size:11px; }
.eng-stats { text-align:right;flex-shrink:0; }
.eng-time  { font-size:12px;font-weight:600;display:block; }
.eng-work  { display:flex;gap:4px;justify-content:flex-end;margin-top:3px; }
.ewp       { font-size:10px;padding:2px 6px;border-radius:10px;display:inline-flex;align-items:center;gap:2px; }
.ewp-visit  { background:#cff4fc;color:#0a6577; }
.ewp-closed { background:#d1e7dd;color:#0a3622; }
.ewp-open   { background:#fff3cd;color:#664d03; }

/* Primary actions */
.primary-actions { display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-bottom:16px; }
.pa-btn { display:flex;flex-direction:column;align-items:center;justify-content:center;gap:2px;border-radius:16px;padding:14px 6px;min-height:84px;color:#fff;text-decoration:none;font-weight:700;font-size:14px;box-shadow:0 4px 14px rgba(0,0,0,.12); }
.pa-btn i { font-size:1.7rem;line-height:1; }
.pa-btn small { font-weight:500;opacity:.85;font-size:11px; }
.pa-btn:active { transform:scale(.97);color:#fff; }
.pa-btn:hover  { color:#fff;filter:brightness(1.05); }
.pa-in        { background:#198754; }
.pa-out       { background:#fd7e14; }
.pa-done      { background:#6c757d; }
.pa-visit     { background:#6f42c1; }
.pa-complaint { background:#dc3545; }

/* Stat chips */
.stat-chip      { background:rgba(0,0,0,.06);border-radius:20px;padding:5px 14px;font-size:12px;color:#444; }
.stat-chip-warn { background:#fff3cd;color:#856404; }

/* Tiles */
.tile-grid { display:grid;grid-template-columns:repeat(2,1fr);gap:12px;margin-bottom:16px; }
@media (min-width:576px){ .tile-grid { grid-template-columns:repeat(3,1fr); } }
@media (min-width:992px){ .tile-grid { grid-template-columns:repeat(4,1fr); } }
.tile { background:#fff;border-radius:16px;padding:18px 14px;text-decoration:none;color:#1a1d2e;box-shadow:0 2px 12px rgba(0,0,0,.08);transition:transform .15s,box-shadow .15s;display:flex;flex-direction:column;align-items:center;text-align:center;min-height:100px;justify-content:center;border:2px solid transparent; }
.tile:hover,.tile:active { transform:translateY(-2px);box-shadow:0 6px 20px rgba(0,0,0,.14);color:#1a1d2e; }
.tile-icon  { font-size:1.9rem;margin-bottom:6px; }
.tile-label { font-size:13px;font-weight:700;line-height:1.2; }
.tile-sub   { font-size:11px;color:#888;margin-top:2px; }
@media (max-width:575.98px){ .tile { min-height:88px;padding:12px 10px; } .tile-icon { font-size:1.6rem;margin-bottom:4px; } }
.tile-attendance { border-color:#28a745; } .tile-attendance .tile-icon { color:#28a745; }
.tile-complaint  { border-color:#dc3545; } .tile-complaint  .tile-icon { color:#dc3545; }
.tile-machines   { border-color:#0d6efd; } .tile-machines   .tile-icon { color:#0d6efd; }
.tile-spare      { border-color:#0dcaf0; } .tile-spare      .tile-icon { color:#0891a8; }
.tile-stock      { border-color:#198754; } .tile-stock      .tile-icon { color:#198754; }
.tile-orders     { border-color:#fd7e14; } .tile-orders     .tile-icon { color:#fd7e14; }
.tile-route      { border-color:#6f42c1; } .tile-route      .tile-icon { color:#6f42c1; }
.tile-expense    { border-color:#fd7e14; } .tile-expense    .tile-icon { color:#fd7e14; }
.tile-leave      { border-color:#e83e8c; } .tile-leave      .tile-icon { color:#e83e8c; }
.tile-salary     { border-color:#20c997; } .tile-salary     .tile-icon { color:#20c997; }
.tile-id         { border-color:#6c757d; } .tile-id         .tile-icon { color:#6c757d; }

/* Notif bar */
.notif-bar { background:#fff3cd;border:1px solid #ffc107;border-radius:12px;padding:12px 16px;display:flex;align-items:center;gap:4px;text-decoration:none;color:#856404;font-size:14px;font-weight:600; }
</style>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
let _visitLat=null,_visitLng=null,_visitStream=null,_visitAcc=null,_visitLocStatus='unavailable';
function showVisitStep(id){['visitStep1','visitStepCam','visitStep2','visitStep3','visitStepErr'].forEach(s=>document.getElementById(s).classList.add('d-none'));document.getElementById(id).classList.remove('d-none');}
function openVisitModal(){['v_customer','v_contact','v_phone','v_purpose','v_remarks','v_address'].forEach(id=>{document.getElementById(id).value='';});showVisitStep('visitStep1');new bootstrap.Modal(document.getElementById('visitModal')).show();getVisitLocation();}
function getVisitLocation(){
  _visitLat=null;_visitLng=null;_visitAcc=null;_visitLocStatus='unavailable';
  const status=document.getElementById('v_gps_status'),retry=document.getElementById('v_gps_retry');
  const needAddress=(show)=>document.getElementById('v_address_wrap').classList.toggle('d-none',!show);
  status.innerHTML='<span class="spinner-border spinner-border-sm me-1"></span>Getting your location…';retry.classList.add('d-none');needAddress(false);
  if(!navigator.geolocation){status.innerHTML='<i class="bi bi-exclamation-triangle text-warning me-1"></i>This device cannot share location. Type visit address.';needAddress(true);return;}
  navigator.geolocation.getCurrentPosition(pos=>{
    _visitLat=pos.coords.latitude;_visitLng=pos.coords.longitude;_visitAcc=pos.coords.accuracy;_visitLocStatus='gps';
    const acc=Math.round(pos.coords.accuracy);
    status.innerHTML=`<i class="bi bi-geo-alt-fill ${acc>200?'text-warning':'text-success'} me-1"></i>Location captured (±${acc} m)`;
    retry.classList.toggle('d-none',acc<=200);
  },err=>{
    _visitLocStatus=err.code===1?'denied':err.code===3?'timeout':'unavailable';
    const why=err.code===1?'Location blocked — allow in browser settings, then Retry':err.code===3?'Location timed out — tap Retry':'Location unavailable — turn on GPS then Retry';
    status.innerHTML=`<i class="bi bi-exclamation-triangle text-warning me-1"></i>${why} or type address below.`;
    retry.classList.remove('d-none');needAddress(true);
  },{enableHighAccuracy:true,timeout:15000,maximumAge:0});
}
async function goToVisitCamera(){
  const customer=document.getElementById('v_customer').value.trim();
  if(!customer){document.getElementById('v_customer').focus();return;}
  const phone=document.getElementById('v_phone').value.replace(/[^0-9+]/g,'');
  if(phone&&!/^(\+?91)?[6-9]\d{9}$/.test(phone)){alert('Enter a valid 10-digit number or leave blank.');document.getElementById('v_phone').focus();return;}
  if(_visitLat==null&&!document.getElementById('v_address').value.trim()){document.getElementById('v_address_wrap').classList.remove('d-none');document.getElementById('v_address').focus();return;}
  showVisitStep('visitStepCam');
  try{_visitStream=await navigator.mediaDevices.getUserMedia({video:{facingMode:'environment',width:{ideal:640},height:{ideal:480}},audio:false});}
  catch(e){try{_visitStream=await navigator.mediaDevices.getUserMedia({video:true,audio:false});}catch(e2){document.getElementById('v_err_msg').textContent='Camera not available: '+e2.message;showVisitStep('visitStepErr');return;}}
  document.getElementById('visitVideo').srcObject=_visitStream;
}
function backToVisitForm(){if(_visitStream){_visitStream.getTracks().forEach(t=>t.stop());_visitStream=null;}showVisitStep('visitStep1');}
async function snapVisitPhoto(){
  const video=document.getElementById('visitVideo');
  const canvas=document.createElement('canvas');canvas.width=640;canvas.height=480;
  canvas.getContext('2d').drawImage(video,0,0,640,480);
  const photoData=canvas.toDataURL('image/jpeg',.8);
  if(_visitStream){_visitStream.getTracks().forEach(t=>t.stop());_visitStream=null;}
  showVisitStep('visitStep2');
  try{
    const up=await fetch('/api/upload',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({data:photoData,folder:'visits'})}).then(r=>r.json());
    const customer=document.getElementById('v_customer').value.trim();
    const resp=await fetch('/visits',{method:'POST',headers:{'Content-Type':'application/json'},
      body:JSON.stringify({customer_name:customer,contact_person:document.getElementById('v_contact').value.trim(),
        phone:document.getElementById('v_phone').value.trim(),purpose:document.getElementById('v_purpose').value,
        remarks:document.getElementById('v_remarks').value,address:document.getElementById('v_address').value.trim(),
        lat:_visitLat,lng:_visitLng,accuracy:_visitAcc,location_status:_visitLocStatus,photo:up.path||''})}).then(r=>r.json());
    if(!resp.ok){document.getElementById('v_err_msg').textContent=resp.error||'Could not save visit.';showVisitStep('visitStepErr');return;}
    const now=new Date();
    document.getElementById('v_summary').innerHTML=`<div><strong>Visit ID:</strong> ${resp.visitId}</div><div><strong>Customer/Site:</strong> ${customer}</div><div><strong>Time:</strong> ${now.toLocaleTimeString('en-IN',{hour:'2-digit',minute:'2-digit'})}</div>`;
    showVisitStep('visitStep3');
    setTimeout(()=>{bootstrap.Modal.getInstance(document.getElementById('visitModal')).hide();location.reload();},2500);
  }catch(e){document.getElementById('v_err_msg').textContent='Network error. Please try again.';showVisitStep('visitStepErr');}
}
function closeVisitModal(){if(_visitStream){_visitStream.getTracks().forEach(t=>t.stop());_visitStream=null;}bootstrap.Modal.getInstance(document.getElementById('visitModal'))?.hide();}
</script>
</body></html>
