<%- include('../partials/head', { title }) %>
<%- include('../partials/sidebar', { active: 'challans', user }) %>
<%
  const tabs = [
    { id: 'to_dispatch', label: t('Waiting for dispatch'), n: counts.to_dispatch || 0 },
    { id: 'to_invoice',  label: t('Not invoiced yet'),     n: counts.to_invoice || 0 },
    { id: 'done',        label: t('Dispatched and invoiced') },
    { id: 'cancelled',   label: t('Cancelled') },
    { id: 'all',         label: t('All') },
  ];
  const stageBadge = {
    to_dispatch: ['bg-warning text-dark', t('Waiting for dispatch')],
    to_invoice:  ['bg-info text-dark',    t('Dispatched, not invoiced')],
    done:        ['bg-success',           t('Dispatched and invoiced')],
    cancelled:   ['bg-danger',            t('Cancelled')],
  };
%>
<div class="main-content">
  <div class="page-header d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0 fw-bold"><i class="bi bi-truck me-2 text-primary"></i><%= prices ? t("Delivery Challans") : t("Dispatch Slips") %></h4>
  </div>

  <% if (flash && flash.success) { %><div class="alert alert-success alert-dismissible"><%= flash.success %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div><% } %>
  <% if (flash && flash.error) { %><div class="alert alert-danger alert-dismissible"><%= flash.error %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div><% } %>

  <p class="text-muted small mb-2"><%= t("A delivery challan is made from an approved spare quotation. The store sends the parts from the dispatch slip; accounts enter the Tally invoice number.") %></p>

  <ul class="nav nav-pills flex-nowrap overflow-auto mb-3 small">
    <% tabs.forEach(x => { %>
    <li class="nav-item"><a class="nav-link text-nowrap <%= tab === x.id ? 'active' : '' %>" href="?tab=<%= x.id %><%= q ? '&q=' + encodeURIComponent(q) : '' %>">
      <%= x.label %><% if (x.n) { %> <span class="badge bg-light text-dark ms-1"><%= x.n %></span><% } %></a></li>
    <% }) %>
  </ul>

  <form method="get" class="d-flex gap-2 mb-3" style="max-width:520px">
    <input type="hidden" name="tab" value="<%= tab %>">
    <input name="q" value="<%= q %>" class="form-control form-control-sm" placeholder="<%= t("Search challan, quotation, customer, machine, invoice…") %>">
    <button class="btn btn-sm btn-outline-secondary"><%= t("Search") %></button>
  </form>

  <div class="card border-0 shadow-sm">
    <div class="table-responsive">
      <table class="table table-hover mb-0 align-middle small">
        <thead class="table-light">
          <tr>
            <th><%= t("Challan No") %></th>
            <th><%= t("Date") %></th>
            <th><%= t("Customer") %></th>
            <th><%= t("Machine No") %></th>
            <th><%= t("Quotation No") %></th>
            <% if (prices) { %><th class="text-end"><%= t("Value") %></th><% } %>
            <th><%= t("Status") %></th>
            <th><%= t("Invoice No") %></th>
          </tr>
        </thead>
        <tbody>
          <% if (!rows.length) { %>
          <tr><td colspan="8" class="text-center text-muted py-4"><%= t("Nothing here.") %></td></tr>
          <% } %>
          <% rows.forEach(r => { const b = stageBadge[r.stage]; %>
          <tr>
            <td><a class="fw-bold font-monospace" href="/challans/<%= r.id %><%= prices ? '' : '/slip' %>"><%= r.challan_no %></a></td>
            <td class="text-nowrap"><%= r.challan_date %></td>
            <td><%= r.customer_name %></td>
            <td class="font-monospace"><%= r.machine_no || '—' %></td>
            <td class="font-monospace"><%= r.quotation_no %></td>
            <% if (prices) { %><td class="text-end text-nowrap">₹<%= formatINR(r.grand_total) %></td><% } %>
            <td><span class="badge <%= b[0] %>"><%= b[1] %></span></td>
            <td class="font-monospace"><%= r.invoice_no || '—' %></td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body></html>
