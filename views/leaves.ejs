<%- include('partials/head', { title }) %>
<%- include('partials/sidebar', { active: 'leaves', user }) %>
<div class="main-content">
  <div class="page-header d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0 fw-bold"><i class="bi bi-calendar-x me-2 text-danger"></i><%= t("My Leaves —") %> <%= year %></h4>
    <button class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#applyModal">
      <i class="bi bi-plus-lg me-1"></i><%= t("Apply Leave") %>
    </button>
  </div>

  <% if (flash.success) { %><div class="alert alert-success alert-dismissible"><%= flash.success %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div><% } %>
  <% if (flash.error)   { %><div class="alert alert-danger  alert-dismissible"><%= flash.error   %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div><% } %>

  <!-- Leave Balances -->
  <div class="row g-3 mb-4">
    <% balances.forEach(b => { const avail = Math.max(0, b.allocated - b.used); %>
    <div class="col-6 col-md-3">
      <div class="card border-0 shadow-sm text-center py-3">
        <div class="fw-bold fs-3 text-<%= avail > 3 ? 'success' : avail > 0 ? 'warning' : 'danger' %>"><%= avail %></div>
        <div class="small fw-semibold"><%= b.name %></div>
        <div class="text-muted" style="font-size:11px"><%= b.used %> <%= t("used /") %> <%= b.allocated %> <%= t("total") %></div>
      </div>
    </div>
    <% }) %>
  </div>

  <!-- Leave History -->
  <div class="card border-0 shadow-sm">
    <div class="card-header bg-white fw-semibold"><%= t("Leave History") %></div>
    <div class="table-responsive">
      <table class="table table-hover mb-0">
        <thead class="table-light"><tr><th><%= t("Type") %></th><th><%= t("From") %></th><th><%= t("To") %></th><th><%= t("Days") %></th><th><%= t("Reason") %></th><th><%= t("Status") %></th><th><%= t("Comment") %></th></tr></thead>
        <tbody>
          <% history.forEach(l => { %>
          <tr>
            <td><span class="badge bg-secondary"><%= l.code %></span> <%= l.name %></td>
            <td class="small"><%= l.start_date %></td>
            <td class="small"><%= l.end_date %></td>
            <td class="fw-bold"><%= l.days %></td>
            <td class="small text-muted" style="max-width:150px"><%= l.reason || '—' %></td>
            <td>
              <span class="badge <%= l.status==='approved'?'bg-success':l.status==='rejected'?'bg-danger':'bg-warning text-dark' %>">
                <%= l.status %>
              </span>
            </td>
            <td class="small text-muted"><%= l.reviewer_comment || '—' %></td>
          </tr>
          <% }) %>
          <% if (!history.length) { %><tr><td colspan="7" class="text-center text-muted py-3"><%= t("No leave records yet.") %></td></tr><% } %>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Apply Leave Modal -->
  <div class="modal fade" id="applyModal" tabindex="-1">
    <div class="modal-dialog">
      <div class="modal-content">
        <div class="modal-header"><h5 class="modal-title fw-bold"><%= t("Apply for Leave") %></h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
        <form method="POST" action="/leaves/apply">
          <div class="modal-body">
            <div class="mb-3">
              <label class="form-label fw-semibold"><%= t("Leave Type") %></label>
              <select name="leave_type_id" class="form-select" required onchange="checkHalfDay(this)">
                <% leaveTypes.forEach(lt => { %>
                <option value="<%= lt.id %>" data-hd="<%= lt.code==='HD' ? 1 : 0 %>"><%= lt.name %></option>
                <% }) %>
              </select>
            </div>
            <div class="row g-2 mb-3" id="dateFields">
              <div class="col-6">
                <label class="form-label fw-semibold"><%= t("From Date") %></label>
                <input type="date" name="start_date" class="form-control" required
                       min="<%= new Date().toISOString().slice(0,10) %>" onchange="updateEndMin(this)">
              </div>
              <div class="col-6">
                <label class="form-label fw-semibold"><%= t("To Date") %></label>
                <input type="date" name="end_date" id="endDate" class="form-control" required
                       min="<%= new Date().toISOString().slice(0,10) %>">
              </div>
            </div>
            <div class="mb-3 d-none" id="hdNote">
              <input type="hidden" name="is_half_day" value="1">
              <div class="alert alert-info small py-2 mb-0"><%= t("Half Day leave = 0.5 day deducted. Only start date matters.") %></div>
            </div>
            <div class="mb-3">
              <label class="form-label fw-semibold"><%= t("Reason") %></label>
              <textarea name="reason" class="form-control" rows="2" placeholder="<%= t("Optional reason…") %>"></textarea>
            </div>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal"><%= t("Cancel") %></button>
            <button type="submit" class="btn btn-danger fw-bold"><%= t("Submit Application") %></button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
function checkHalfDay(sel) {
  const isHD = sel.options[sel.selectedIndex].dataset.hd === '1';
  document.getElementById('hdNote').classList.toggle('d-none', !isHD);
  document.getElementById('dateFields').querySelectorAll('[name="end_date"]').forEach(el => el.required = !isHD);
}
function updateEndMin(el) {
  document.getElementById('endDate').min = el.value;
  if (document.getElementById('endDate').value < el.value)
    document.getElementById('endDate').value = el.value;
}
</script>
</body></html>
