<%- include('../partials/head', { title }) %>
<%- include('../partials/sidebar', { active: 'extra-expenses', user }) %>
<%
  const BADGE = { submitted: 'bg-warning text-dark', approved: 'bg-success', rejected: 'bg-danger', withdrawn: 'bg-secondary' };
  const LABEL = { submitted: t('Pending'), approved: t('Approved'), rejected: t('Rejected'), withdrawn: t('Withdrawn') };
  const pdf = /\.pdf$/i.test(x.receipt_path || '');
  const when = (v) => { const d = dbTime(v); return d ? d.toLocaleString(locale, { day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' }) : ''; };
%>
<div class="main-content">
  <div class="page-header d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <div>
      <h4 class="mb-0 fw-bold"><i class="bi bi-receipt me-2 text-danger"></i><%= t("Extra Expense") %> <span class="font-monospace"><%= x.expense_no %></span></h4>
      <span class="badge <%= BADGE[x.status] %>"><%= LABEL[x.status] %></span>
    </div>
    <a href="<%= canDecide ? '/extra-expenses/queue' : '/extra-expenses' %>" class="btn btn-sm btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i><%= t("Back") %></a>
  </div>

  <% if (flash.success) { %><div class="alert alert-success alert-dismissible"><%= flash.success %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div><% } %>
  <% if (flash.error)   { %><div class="alert alert-danger  alert-dismissible"><%= flash.error   %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div><% } %>

  <div class="row g-3">
    <div class="col-md-6">
      <div class="card border-0 shadow-sm">
        <div class="card-body">
          <dl class="row mb-0 small">
            <dt class="col-5 text-muted"><%= t("Employee") %></dt><dd class="col-7 fw-semibold"><%= x.full_name || x.username %></dd>
            <dt class="col-5 text-muted"><%= t("Date") %></dt><dd class="col-7"><%= x.date %></dd>
            <dt class="col-5 text-muted"><%= t("Expense for") %></dt><dd class="col-7"><%= t(x.category) %></dd>
            <dt class="col-5 text-muted"><%= t("Amount") %></dt><dd class="col-7 fw-bold fs-6">₹<%= formatINR(x.amount) %></dd>
            <dt class="col-5 text-muted"><%= t("Details") %></dt><dd class="col-7"><%= x.description %></dd>
            <dt class="col-5 text-muted"><%= t("Submitted") %></dt><dd class="col-7"><%= when(x.created_at) %></dd>
            <% if (x.decided_at) { %>
            <dt class="col-5 text-muted"><%= LABEL[x.status] %></dt><dd class="col-7"><%= x.decided_by_name %> · <%= when(x.decided_at) %><% if (x.decision_note) { %><div class="<%= x.status === 'rejected' ? 'text-danger' : '' %>"><%= x.decision_note %></div><% } %></dd>
            <% } %>
          </dl>
        </div>
      </div>

      <% if (canDecide) { %>
      <div class="card border-0 shadow-sm mt-3">
        <div class="card-body">
          <form method="POST" action="/extra-expenses/<%= x.id %>/decide">
            <label class="form-label small mb-1" for="note"><%= t("Note (needed when rejecting)") %></label>
            <input id="note" name="note" class="form-control form-control-sm mb-2" maxlength="300">
            <div class="d-flex gap-2">
              <button name="action" value="approve" class="btn btn-success"><i class="bi bi-check-lg me-1"></i><%= t("Approve") %></button>
              <button name="action" value="reject" class="btn btn-outline-danger"><i class="bi bi-x-lg me-1"></i><%= t("Reject") %></button>
            </div>
          </form>
        </div>
      </div>
      <% } %>

      <% if (canWithdraw) { %>
      <form method="POST" action="/extra-expenses/<%= x.id %>/withdraw" class="mt-3" onsubmit="return confirm('<%= tjs("Withdraw this expense?") %>')">
        <button class="btn btn-sm btn-outline-secondary"><i class="bi bi-arrow-counterclockwise me-1"></i><%= t("Withdraw") %></button>
      </form>
      <% } %>
    </div>
    <div class="col-md-6">
      <div class="card border-0 shadow-sm">
        <div class="card-header bg-white fw-semibold small d-flex justify-content-between">
          <span><%= t("Receipt") %></span>
          <a href="<%= x.receipt_path %>" target="_blank" rel="noopener"><i class="bi bi-box-arrow-up-right me-1"></i><%= t("Open") %></a>
        </div>
        <div class="card-body text-center">
          <% if (pdf) { %>
            <a href="<%= x.receipt_path %>" target="_blank" rel="noopener" class="btn btn-outline-danger"><i class="bi bi-file-earmark-pdf me-1"></i><%= t("Open PDF receipt") %></a>
          <% } else { %>
            <a href="<%= x.receipt_path %>" target="_blank" rel="noopener"><img src="<%= x.receipt_path %>" alt="<%= t("Receipt") %>" class="img-fluid rounded" style="max-height:520px"></a>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body></html>
