<%- include('../partials/head', { title }) %>
<%- include('../partials/sidebar', { active: 'extra-expenses', user }) %>
<div class="main-content">
  <div class="page-header d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0 fw-bold"><i class="bi bi-receipt me-2 text-danger"></i><%= t("New Extra Expense") %></h4>
    <a href="/extra-expenses" class="btn btn-sm btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i><%= t("Back") %></a>
  </div>

  <% if (flash.info) { %><div class="alert alert-info small"><i class="bi bi-info-circle me-1"></i><%= flash.info %></div><% } %>
  <div class="alert alert-danger d-none" id="err"></div>

  <form id="xeForm" class="card border-0 shadow-sm" style="max-width:640px" novalidate>
    <div class="card-body">
      <div class="row g-3">
        <div class="col-6">
          <label class="form-label fw-semibold" for="xeDate"><%= t("Date") %></label>
          <input type="date" id="xeDate" name="date" class="form-control" value="<%= today %>" max="<%= today %>" required>
        </div>
        <div class="col-6">
          <label class="form-label fw-semibold" for="xeAmount"><%= t("Amount (₹)") %></label>
          <input type="number" id="xeAmount" name="amount" class="form-control" min="1" step="0.01" inputmode="decimal" required>
        </div>
        <div class="col-12">
          <label class="form-label fw-semibold" for="xeCat"><%= t("Expense for") %></label>
          <select id="xeCat" name="category" class="form-select" required>
            <option value=""><%= t("— Choose —") %></option>
            <% categories.forEach(c => { %><option value="<%= c %>"><%= t(c) %></option><% }) %>
          </select>
        </div>
        <div class="col-12">
          <label class="form-label fw-semibold" for="xeDesc"><%= t("Details") %></label>
          <textarea id="xeDesc" name="description" class="form-control" rows="2" maxlength="500" required placeholder="<%= t("Customer, place and reason, e.g. Lunch at Baghpat site visit, Ram Singh") %>"></textarea>
        </div>
        <div class="col-12">
          <label class="form-label fw-semibold"><%= t("Receipt") %></label>
          <div class="d-flex flex-wrap gap-2">
            <label class="btn btn-outline-danger mb-0"><i class="bi bi-camera-fill me-1"></i><%= t("Take Photo") %>
              <input type="file" accept="image/*" capture="environment" class="d-none" onchange="pick(this)"></label>
            <label class="btn btn-outline-secondary mb-0"><i class="bi bi-paperclip me-1"></i><%= t("Choose photo or PDF") %>
              <input type="file" accept="image/*,application/pdf" class="d-none" onchange="pick(this)"></label>
          </div>
          <div id="preview" class="mt-2 small text-muted"><%= t("A receipt is required.") %> <%= t("Photo or PDF, up to") %> <%= maxMb %> MB.</div>
        </div>
      </div>
    </div>
    <div class="card-footer bg-white">
      <button type="submit" class="btn btn-danger" id="xeSubmit"><i class="bi bi-send me-1"></i><%= t("Submit to Head of Finance") %></button>
    </div>
  </form>
</div>
<script>
let receipt = null;   // data URL of the photo (resized) or PDF
const MAX = <%= maxMb %> * 1024 * 1024;
const err = (m) => { const e = document.getElementById('err'); e.textContent = m; e.classList.toggle('d-none', !m); if (m) window.scrollTo(0, 0); };

// Photos are shrunk to 1600 px (keeps the text readable, the file small); PDFs go as they are
function pick(input) {
  const file = input.files[0]; input.value = '';
  if (!file) return;
  const pv = document.getElementById('preview');
  if (file.type === 'application/pdf') {
    if (file.size > MAX) return err(T('The receipt file is too large.'));
    const r = new FileReader();
    r.onload = () => { receipt = r.result; pv.innerHTML = '<i class="bi bi-file-earmark-pdf text-danger me-1"></i>'; pv.append(file.name); err(''); };
    r.readAsDataURL(file);
    return;
  }
  if (!file.type.startsWith('image/')) return err(T('Attach a photo or PDF of the receipt.'));
  const img = new Image();
  img.onload = () => {
    const k = Math.min(1, 1600 / Math.max(img.width, img.height));
    const c = document.createElement('canvas'); c.width = Math.round(img.width * k); c.height = Math.round(img.height * k);
    c.getContext('2d').drawImage(img, 0, 0, c.width, c.height);
    receipt = c.toDataURL('image/jpeg', 0.82);
    pv.innerHTML = '';
    const im = document.createElement('img'); im.src = receipt; im.style.cssText = 'max-width:180px;max-height:180px;border-radius:6px';
    pv.append(im); err('');
    URL.revokeObjectURL(img.src);
  };
  img.onerror = () => err(T('Attach a photo or PDF of the receipt.'));
  img.src = URL.createObjectURL(file);
}

document.getElementById('xeForm').addEventListener('submit', async (e) => {
  e.preventDefault();
  const f = e.target;
  if (!f.reportValidity()) return;
  if (!receipt) return err(T('Attach a photo or PDF of the receipt.'));
  const btn = document.getElementById('xeSubmit'); btn.disabled = true;
  try {
    const r = await fetch('/extra-expenses', { method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ date: f.date.value, amount: f.amount.value, category: f.category.value, description: f.description.value, receipt }) });
    const j = await r.json();
    if (!j.ok) { btn.disabled = false; return err(j.error || T('Could not submit. Please try again.')); }
    location.href = j.redirect;
  } catch (x) { btn.disabled = false; err(T('Could not submit. Please try again.')); }
});
</script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body></html>
