<%- include('../partials/head', { title }) %>
<%- include('../partials/sidebar', { active: 'databank', user }) %>
<div class="main-content" style="max-width:820px">
  <a href="<%= back.startsWith('/databank') ? back : '/databank' %>" class="text-decoration-none small"><i class="bi bi-arrow-left me-1"></i>Back to Databank</a>

  <% if (flash.success) { %><div class="alert alert-success alert-dismissible mt-2"><%= flash.success %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div><% } %>
  <% if (flash.error) { %><div class="alert alert-danger alert-dismissible mt-2"><%= flash.error %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div><% } %>

  <div class="card border-0 shadow-sm mt-2 mb-3">
    <div class="card-body">
      <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
        <div>
          <h4 class="fw-bold mb-1"><%= r.name || 'Unknown name' %></h4>
          <div class="text-muted"><i class="bi bi-geo-alt me-1"></i><%= r.location || '—' %><% if (r.district) { %> · <%= r.district %><% } %></div>
        </div>
        <% const waDigits = (r.phone || '').replace(/\D/g,'').slice(-10); %>
        <div class="d-flex flex-column gap-1">
          <a href="tel:+91<%= r.phone %>" class="btn btn-success"><i class="bi bi-telephone-fill me-1"></i><%= r.phone %></a>
          <% if (waDigits.length === 10) { %>
          <a href="https://wa.me/91<%= waDigits %>" target="_blank" rel="noopener" class="btn btn-outline-success btn-sm"><i class="bi bi-whatsapp me-1"></i>WhatsApp</a>
          <% } %>
        </div>
      </div>
      <hr>
      <div class="row g-3 small">
        <div class="col-md-8">
          <div class="text-muted fw-semibold">LAST REMARK</div>
          <div><%= r.last_remark || '—' %></div>
        </div>
        <div class="col-md-4">
          <div class="text-muted fw-semibold">LAST ACTIVITY</div>
          <div><%= r.last_activity ? new Date(r.last_activity + 'T00:00:00Z').toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' }) : '—' %></div>
        </div>
        <div class="col-12">
          <div class="text-muted fw-semibold">DATA SOURCE</div>
          <div class="text-muted"><%= r.data_source || '—' %></div>
        </div>
      </div>
      <% const hasCrm = r.machine_interested || r.bull_stage || r.bull_status || r.lead_source || r.enquiry_count; %>
      <% if (hasCrm) {
           const stageColor = { 'Won':'success', 'Lost':'secondary', 'Customer Not Interested':'secondary', 'Open':'warning' }[r.bull_stage] || 'info'; %>
      <hr>
      <div class="row g-3 small">
        <% if (r.bull_stage) { %>
        <div class="col-auto">
          <div class="text-muted fw-semibold">ENQUIRY STAGE</div>
          <span class="badge bg-<%= stageColor %>"><%= r.bull_stage %></span>
          <% if (r.bull_status) { %><span class="badge bg-light text-dark border"><%= r.bull_status %></span><% } %>
        </div>
        <% } %>
        <% if (r.machine_interested) { %>
        <div class="col-auto"><div class="text-muted fw-semibold">MACHINE</div><div><%= r.machine_interested %></div></div>
        <% } %>
        <% if (r.enquiry_count) { %>
        <div class="col-auto"><div class="text-muted fw-semibold">ENQUIRIES</div><div><%= r.enquiry_count %></div></div>
        <% } %>
        <% if (r.lead_source) { %>
        <div class="col-auto"><div class="text-muted fw-semibold">LEAD SOURCE</div><div><%= r.lead_source %></div></div>
        <% } %>
        <% if (r.first_seen) { %>
        <div class="col-auto"><div class="text-muted fw-semibold">FIRST SEEN</div>
          <div><%= new Date(r.first_seen + 'T00:00:00Z').toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' }) %></div></div>
        <% } %>
      </div>
      <% } %>
      <% if (enquiries.length) { %>
      <div class="alert alert-info small mt-3 mb-0"><i class="bi bi-funnel me-1"></i>Already an enquiry:
        <% enquiries.forEach((e, i) => { %><%= i ? ', ' : '' %><a href="/enquiries/<%= e.id %>"><%= e.enquiry_number %></a> (<%= e.status %>)<% }) %>
      </div>
      <% } %>
    </div>
  </div>

  <div class="card border-0 shadow-sm mb-3">
    <div class="card-header bg-white fw-semibold"><i class="bi bi-chat-left-text me-1"></i>Add call / visit remark</div>
    <div class="card-body">
      <form method="post" action="/databank/<%= r.id %>/remark">
        <input type="hidden" name="back" value="<%= back %>">
        <textarea name="remark" class="form-control mb-2" rows="2" maxlength="1000" placeholder="e.g. Has 2018 JCB 3DX, planning new machine after Diwali" required></textarea>
        <button class="btn btn-primary btn-sm"><i class="bi bi-check-lg me-1"></i>Save remark</button>
      </form>
    </div>
  </div>

  <% if (history.length) { %>
  <div class="card border-0 shadow-sm">
    <div class="card-header bg-white fw-semibold">Remark history</div>
    <ul class="list-group list-group-flush">
      <% history.forEach(h => {
           const t = dbTime(h.created_at);
           const when = h.activity_date
             ? new Date(h.activity_date + 'T00:00:00Z').toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' })
             : t.toLocaleString('en-IN', { day: 'numeric', month: 'short', year: 'numeric', hour: 'numeric', minute: '2-digit', timeZone: 'Asia/Kolkata' });
           const who = h.source ? '' : (h.full_name || h.username || 'Unknown'); %>
      <li class="list-group-item">
        <div><%= h.remark %></div>
        <div class="text-muted small">
          <% if (h.source) { %><span class="badge bg-light text-dark border me-1"><%= h.source %></span><% } %>
          <%= who %><%= who ? ' · ' : '' %><%= when %>
        </div>
      </li>
      <% }) %>
    </ul>
  </div>
  <% } %>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body></html>
