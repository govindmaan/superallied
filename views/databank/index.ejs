<%- include('../partials/head', { title }) %>
<%- include('../partials/sidebar', { active: 'databank', user }) %>
<%
  const link = (over) => {
    const p = { ...qs, sort, ...over };
    const s = Object.entries(p).filter(([, v]) => v).map(([k, v]) => `${k}=${encodeURIComponent(v)}`).join('&');
    return '/databank' + (s ? '?' + s : '');
  };
  const here = link({ page: page > 1 ? page : '' });
  const filtered = qs.q || qs.district || qs.village || qs.remark;
%>
<style>
  .db-chips { display:flex; flex-wrap:wrap; gap:6px; }
  .db-chip { display:inline-flex; align-items:center; gap:6px; padding:5px 10px; border:1px solid #dee2e6; border-radius:999px;
             background:#fff; color:#212529; text-decoration:none; font-size:13px; line-height:1.2; }
  .db-chip:hover { border-color:#0d6efd; color:#0d6efd; }
  .db-chip.on { background:#0d6efd; border-color:#0d6efd; color:#fff; }
  .db-chip .n { font-weight:600; font-variant-numeric:tabular-nums; opacity:.75; }
  .db-chip.on .n { opacity:1; }
  .db-villages { max-height:132px; overflow:auto; }
  .db-row { display:grid; grid-template-columns: minmax(0,1.3fr) 130px minmax(0,1fr) minmax(0,1.6fr); gap:12px; align-items:center;
            padding:10px 16px; border-bottom:1px solid #f1f3f5; color:inherit; text-decoration:none; }
  .db-row:hover { background:#f8f9fa; }
  .db-row .remark { color:#6c757d; font-size:13px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
  .db-row .loc { font-size:13px; }
  .db-head { font-size:12px; text-transform:uppercase; letter-spacing:.03em; color:#6c757d; background:#f8f9fa; }
  .db-head:hover { background:#f8f9fa; }
  @media (max-width: 767px) {
    .db-row { grid-template-columns: 1fr auto; gap:2px 10px; }
    .db-row .loc, .db-row .remark { grid-column: 1 / -1; }
    .db-row .phone { grid-row: 1; grid-column: 2; }
    .db-head { display:none; }
  }
</style>
<div class="main-content">
  <div class="page-header d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <div>
      <h4 class="mb-0 fw-bold"><i class="bi bi-database-fill me-2 text-primary"></i>Databank</h4>
      <div class="text-muted small"><%= grand.toLocaleString('en-IN') %> potential customers · one record per mobile number</div>
    </div>
    <% if (isAdmin) { %>
    <div class="d-flex gap-2">
      <button class="btn btn-outline-success btn-sm" onclick="document.getElementById('importModal').style.display='flex'"><i class="bi bi-upload me-1"></i>Import</button>
      <a class="btn btn-outline-secondary btn-sm" href="<%= '/databank/export' + (here.includes('?') ? here.slice(here.indexOf('?')) : '') %>"><i class="bi bi-download me-1"></i>Export</a>
      <a class="btn btn-outline-primary btn-sm" href="/databank/access"><i class="bi bi-shield-lock me-1"></i>Access</a>
    </div>
    <% } %>
  </div>

  <% if (flash.success) { %><div class="alert alert-success alert-dismissible"><%= flash.success %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div><% } %>
  <% if (flash.error) { %><div class="alert alert-danger alert-dismissible"><%= flash.error %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div><% } %>

  <% if (!grand) { %>
  <div class="card border-0 shadow-sm"><div class="card-body text-center text-muted py-5">
    <i class="bi bi-database fs-1 d-block mb-2"></i>The databank is empty.
    <% if (isAdmin) { %><div class="mt-2">Use <strong>Import</strong> to load the Customer_Databank.xlsx file.</div><% } %>
  </div></div>
  <% } else { %>

  <div class="card border-0 shadow-sm mb-3">
    <div class="card-body py-2">
      <form method="get" class="row g-2 align-items-center">
        <div class="col-12 col-md">
          <input name="q" value="<%= qs.q %>" class="form-control" placeholder="Search name, mobile, village, remark… (e.g. brick sardhana)" autofocus>
        </div>
        <div class="col-6 col-md-auto">
          <select name="remark" class="form-select" onchange="this.form.submit()">
            <option value="">All records</option>
            <option value="with" <%= qs.remark==='with'?'selected':'' %>>Has call remark</option>
            <option value="none" <%= qs.remark==='none'?'selected':'' %>>Never called</option>
            <option value="machine" <%= qs.remark==='machine'?'selected':'' %>>Machine owners</option>
            <option value="mine" <%= qs.remark==='mine'?'selected':'' %>>Updated in app</option>
          </select>
        </div>
        <div class="col-6 col-md-auto">
          <select name="sort" class="form-select" onchange="this.form.submit()">
            <option value="">Sort: Village</option>
            <option value="name" <%= sort==='name'?'selected':'' %>>Sort: Name</option>
            <option value="recent" <%= sort==='recent'?'selected':'' %>>Sort: Recent activity</option>
          </select>
        </div>
        <% if (qs.district) { %><input type="hidden" name="district" value="<%= qs.district %>"><% } %>
        <% if (qs.village) { %><input type="hidden" name="village" value="<%= qs.village %>"><% } %>
        <div class="col-auto"><button class="btn btn-primary"><i class="bi bi-search"></i><span class="d-none d-md-inline ms-1">Search</span></button></div>
        <% if (filtered) { %><div class="col-auto"><a href="/databank" class="btn btn-outline-secondary">Clear</a></div><% } %>
      </form>
    </div>
  </div>

  <div class="card border-0 shadow-sm mb-3">
    <div class="card-body">
      <div class="small fw-semibold text-muted mb-2"><i class="bi bi-geo-alt me-1"></i>DISTRICT</div>
      <div class="db-chips">
        <a class="db-chip <%= !qs.district ? 'on' : '' %>" href="<%= link({ district: '', village: '', page: '' }) %>">All <span class="n"><%= districts.reduce((t, d) => t + d.c, 0).toLocaleString('en-IN') %></span></a>
        <% districts.forEach(d => { const val = d.district === 'Unmapped' ? 'Unmapped' : d.district; %>
        <a class="db-chip <%= qs.district === val ? 'on' : '' %>" href="<%= link({ district: val, village: '', page: '' }) %>">
          <%= d.district %> <span class="n"><%= d.c.toLocaleString('en-IN') %></span></a>
        <% }) %>
      </div>
      <% if (qs.district && villages.length) { %>
      <div class="small fw-semibold text-muted mt-3 mb-2"><i class="bi bi-signpost-split me-1"></i>VILLAGE / TOWN IN <%= qs.district.toUpperCase() %></div>
      <div class="db-chips db-villages">
        <a class="db-chip <%= !qs.village ? 'on' : '' %>" href="<%= link({ village: '', page: '' }) %>">All</a>
        <% villages.forEach(v => { %>
        <a class="db-chip <%= qs.village.toLowerCase() === v.village.toLowerCase() ? 'on' : '' %>" href="<%= link({ village: v.village, page: '' }) %>"><%= v.village %> <span class="n"><%= v.c %></span></a>
        <% }) %>
      </div>
      <% } %>
    </div>
  </div>

  <div class="card border-0 shadow-sm">
    <div class="card-header bg-white d-flex justify-content-between align-items-center">
      <span class="fw-semibold"><%= total.toLocaleString('en-IN') %> customer<%= total === 1 ? '' : 's' %>
        <% if (qs.village) { %>in <%= qs.village %><% } else if (qs.district) { %>in <%= qs.district %><% } %></span>
      <% if (pages > 1) { %><span class="text-muted small">Page <%= page %> of <%= pages %></span><% } %>
    </div>
    <div class="db-row db-head"><span>Name</span><span>Mobile</span><span>Location</span><span>Last remark</span></div>
    <% if (!rows.length) { %><div class="text-center text-muted py-4">No customers match.</div><% } %>
    <% rows.forEach(r => { %>
    <a class="db-row" href="/databank/<%= r.id %>?back=<%= encodeURIComponent(here) %>">
      <span class="fw-semibold text-truncate"><%= r.name || '—' %></span>
      <span class="phone font-monospace"><%= r.phone %></span>
      <span class="loc text-truncate"><i class="bi bi-geo-alt text-muted me-1 d-md-none"></i><%= r.location || '—' %><% if (r.district && !r.location.toUpperCase().includes(r.district.split(' ')[0])) { %><span class="text-muted"> · <%= r.district %></span><% } %></span>
      <span class="remark"><% if (r.remark_at) { %><i class="bi bi-pencil-fill text-success me-1" title="Updated in app"></i><% } %><%= r.last_remark || '' %></span>
    </a>
    <% }) %>
    <% if (pages > 1) { %>
    <div class="card-footer bg-white d-flex justify-content-between">
      <a class="btn btn-sm btn-outline-secondary <%= page <= 1 ? 'disabled' : '' %>" href="<%= link({ page: page - 1 }) %>">‹ Previous</a>
      <a class="btn btn-sm btn-outline-secondary <%= page >= pages ? 'disabled' : '' %>" href="<%= link({ page: page + 1 }) %>">Next ›</a>
    </div>
    <% } %>
  </div>
  <% } %>
</div>

<% if (isAdmin) { %>
<div id="importModal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,.45);z-index:2000;align-items:center;justify-content:center;padding:16px">
  <div class="card shadow" style="max-width:520px;width:100%">
    <div class="card-header bg-white d-flex justify-content-between align-items-center">
      <span class="fw-semibold"><i class="bi bi-upload me-1"></i>Import into Databank</span>
      <button class="btn-close" onclick="document.getElementById('importModal').style.display='none'"></button>
    </div>
    <div class="card-body">
      <p class="small text-muted mb-2">Excel or CSV with columns <strong>Phone, Name, Location, Last Remark, Data Source</strong>
        (optional: Area (District), Last Activity). Uses the “Databank” sheet if present.</p>
      <ul class="small text-muted mb-3">
        <li>Matched on 10-digit mobile — existing numbers are updated, never duplicated.</li>
        <li>Remarks your team added in the app are kept.</li>
      </ul>
      <input type="file" id="importFile" accept=".xlsx,.xls,.csv" class="form-control mb-3">
      <div id="importResult" class="alert d-none small"></div>
      <button id="btnImport" class="btn btn-success w-100" onclick="runImport()"><i class="bi bi-upload me-1"></i>Import</button>
    </div>
  </div>
</div>
<script>
async function runImport() {
  const file = document.getElementById('importFile').files[0];
  if (!file) return alert('Choose a file first.');
  const btn = document.getElementById('btnImport');
  btn.disabled = true; btn.textContent = 'Importing…';
  const data = await new Promise(ok => { const fr = new FileReader(); fr.onload = () => ok(fr.result.split(',')[1]); fr.readAsDataURL(file); });
  const j = await fetch('/databank/import', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ data }) })
    .then(r => r.json()).catch(e => ({ ok: false, error: e.message }));
  btn.disabled = false; btn.innerHTML = '<i class="bi bi-upload me-1"></i>Import';
  const div = document.getElementById('importResult');
  div.classList.remove('d-none', 'alert-success', 'alert-danger');
  if (j.ok) {
    div.classList.add('alert-success');
    div.innerHTML = `Added <strong>${j.inserted}</strong>, updated <strong>${j.updated}</strong>, skipped <strong>${j.skipped}</strong> (no valid mobile).`;
    setTimeout(() => location.reload(), 2500);
  } else { div.classList.add('alert-danger'); div.textContent = j.error; }
}
</script>
<% } %>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body></html>
