<%- include('../partials/head', { title }) %>
<%- include('../partials/sidebar', { active: 'complaints', user }) %>
<div class="main-content" style="max-width:720px">
  <% if (flash.success) { %><div class="alert alert-success alert-dismissible"><%= flash.success %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div><% } %>
  <% if (flash.error) { %><div class="alert alert-danger alert-dismissible"><%= flash.error %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div><% } %>

  <div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="fw-bold mb-0"><i class="bi bi-tools text-primary me-2"></i><%= t("Machine Complaints") %></h4>
    <a href="/complaints/new" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg me-1"></i><%= t("New") %></a>
  </div>

  <% const tabs = [['active','Active'],['open','Open'],['assigned','Assigned'],['visited','Visited'],['closed','Closed']]; %>
  <div class="d-flex gap-1 overflow-auto pb-2 mb-2">
    <% tabs.forEach(([k,lbl]) => { %>
    <a href="/complaints?f=<%= k %>" class="btn btn-sm <%= f===k?'btn-primary':'btn-outline-secondary' %> text-nowrap"><%= t(lbl) %><% if (counts[k]) { %> <span class="badge bg-light text-dark"><%= counts[k] %></span><% } %></a>
    <% }) %>
  </div>

  <% if (!rows.length) { %><div class="text-muted text-center py-4"><%= t("No complaints in this view.") %></div><% } %>
  <div class="d-flex flex-column gap-2">
    <% rows.forEach(c => { const col = {open:'danger',assigned:'warning text-dark',visited:'info text-dark',closed:'secondary'}[c.status]; %>
    <a href="/complaints/<%= c.id %>" class="text-decoration-none text-dark">
      <div class="card border-0 shadow-sm"><div class="card-body py-2">
        <div class="d-flex justify-content-between">
          <span class="fw-bold"><%= c.customer_name || t('Unknown') %></span>
          <span class="badge bg-<%= col %>"><%= t(c.status) %></span>
        </div>
        <div class="small"><i class="bi bi-hdd-rack me-1 text-muted"></i><%= c.machine_no %><% if (c.model) { %> · <%= c.model %><% } %></div>
        <% if (c.problem) { %><div class="small text-muted text-truncate"><%= c.problem %></div><% } %>
        <div class="small text-muted"><%= c.complaint_number %><% if (c.engineer_name) { %> · <i class="bi bi-person-gear me-1"></i><%= c.engineer_name %><% } %><% if (c.district) { %> · <%= c.district %><% } %></div>
      </div></div>
    </a>
    <% }) %>
  </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body></html>
