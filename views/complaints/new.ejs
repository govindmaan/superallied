<%- include('../partials/head', { title }) %>
<%- include('../partials/sidebar', { active: 'complaints', user }) %>
<div class="main-content" style="max-width:560px">
  <a href="/complaints" class="text-decoration-none small"><i class="bi bi-arrow-left me-1"></i><%= t("Complaints") %></a>
  <% if (flash.error) { %><div class="alert alert-danger alert-dismissible mt-2"><%= flash.error %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div><% } %>
  <h4 class="fw-bold mt-2 mb-3"><i class="bi bi-plus-circle-fill text-primary me-2"></i><%= t("New Complaint") %></h4>

  <form method="post" action="/complaints" class="card border-0 shadow-sm">
    <div class="card-body">
      <label class="form-label small fw-semibold"><%= t("Machine Serial No *") %></label>
      <div class="input-group mb-1">
        <input name="machine_no" id="mno" class="form-control form-control-lg" required placeholder="<%= t("e.g. BE123456") %>" autofocus>
        <button type="button" class="btn btn-outline-secondary" id="lookupBtn"><i class="bi bi-search"></i></button>
      </div>
      <div id="mInfo" class="small text-success mb-2" style="display:none"></div>

      <div class="row g-2">
        <div class="col-12"><label class="form-label small fw-semibold"><%= t("Customer") %></label><input name="customer_name" id="cname" class="form-control"></div>
        <div class="col-6"><label class="form-label small fw-semibold"><%= t("Mobile") %></label><input name="customer_mobile" id="cmob" class="form-control"></div>
        <div class="col-6"><label class="form-label small fw-semibold"><%= t("Model") %></label><input name="model" id="cmodel" class="form-control"></div>
        <div class="col-6"><label class="form-label small fw-semibold"><%= t("Location") %></label><input name="location" id="cloc" class="form-control"></div>
        <div class="col-6"><label class="form-label small fw-semibold"><%= t("District") %></label><input name="district" id="cdist" class="form-control"></div>
      </div>

      <label class="form-label small fw-semibold mt-2"><%= t("Problem") %></label>
      <textarea name="problem" class="form-control" rows="2" placeholder="<%= t("What is the complaint?") %>"></textarea>

      <button class="btn btn-primary btn-lg w-100 mt-3"><i class="bi bi-check-lg me-1"></i><%= t("Create Complaint") %></button>
    </div>
  </form>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
  async function lookup() {
    const mno = document.getElementById('mno').value.trim();
    if (!mno) return;
    const info = document.getElementById('mInfo');
    try {
      const m = await fetch('/complaints/lookup?machine_no=' + encodeURIComponent(mno)).then(r => r.json());
      if (m && m.machine_no) {
        document.getElementById('cname').value = m.customer_name || '';
        document.getElementById('cmob').value = m.mobile_1 || '';
        document.getElementById('cmodel').value = m.model || '';
        document.getElementById('cloc').value = m.customer_address || '';
        document.getElementById('cdist').value = m.place_of_supply || '';
        info.textContent = '✓ ' + (m.customer_name || '') + ' — ' + (m.model || '');
        info.style.display = 'block';
      } else { info.textContent = 'Serial not found in Sold Machines — fill the details manually.'; info.className = 'small text-warning mb-2'; info.style.display = 'block'; }
    } catch(e) {}
  }
  document.getElementById('lookupBtn').addEventListener('click', lookup);
  document.getElementById('mno').addEventListener('change', lookup);
</script>
</body></html>
