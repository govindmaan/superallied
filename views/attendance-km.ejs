<%- include('partials/head', { title }) %>
<%- include('partials/sidebar', { active: 'attendance-km', user }) %>
<%
  const fmt = (d) => new Date(d + 'T00:00:00').toLocaleDateString(locale, { day: 'numeric', month: 'short', year: 'numeric' });
  const monthOf = to.slice(0, 7);
%>
<div class="main-content">
  <div class="page-header d-flex justify-content-between align-items-center mb-3">
    <div>
      <h4 class="mb-0 fw-bold"><i class="bi bi-speedometer2 me-2 text-danger"></i><%= t("Bike KM Summary") %></h4>
      <div class="small text-muted"><%= fmt(from) %> – <%= fmt(to) %></div>
    </div>
    <a href="/attendance/staff" class="btn btn-sm btn-outline-secondary"><i class="bi bi-person-badge me-1"></i><%= t("Employee Attendance") %></a>
  </div>

  <form method="GET" class="row g-2 align-items-end mb-3">
    <div class="col-6 col-md-3">
      <label class="form-label small mb-1" for="from"><%= t("From") %></label>
      <input type="date" name="from" id="from" class="form-control form-control-sm" value="<%= from %>" max="<%= todayStr %>">
    </div>
    <div class="col-6 col-md-3">
      <label class="form-label small mb-1" for="to"><%= t("To") %></label>
      <input type="date" name="to" id="to" class="form-control form-control-sm" value="<%= to %>" max="<%= todayStr %>">
    </div>
    <div class="col-auto"><button class="btn btn-sm btn-danger"><%= t("Show") %></button></div>
  </form>

  <div class="row g-2 mb-3">
    <div class="col-6 col-md-3"><div class="card border-0 shadow-sm h-100"><div class="card-body py-2">
      <div class="text-muted small"><%= t("Odometer km") %></div><div class="fs-4 fw-bold num"><%= totals.km.toFixed(0) %></div></div></div></div>
    <div class="col-6 col-md-3"><div class="card border-0 shadow-sm h-100"><div class="card-body py-2">
      <div class="text-muted small"><%= t("Km claimed in expenses") %></div><div class="fs-4 fw-bold num"><%= totals.claimed.toFixed(0) %></div></div></div></div>
    <div class="col-6 col-md-3"><div class="card border-0 shadow-sm h-100"><div class="card-body py-2">
      <div class="text-muted small"><%= t("People with km") %></div><div class="fs-4 fw-bold num"><%= totals.riders %></div></div></div></div>
    <div class="col-6 col-md-3"><div class="card border-0 shadow-sm h-100 <%= totals.incomplete ? 'border-start border-4 border-warning' : '' %>"><div class="card-body py-2">
      <div class="text-muted small"><%= t("Days missing a meter photo or end km") %></div><div class="fs-4 fw-bold num"><%= totals.incomplete %></div></div></div></div>
  </div>

  <div class="card border-0 shadow-sm">
    <div class="table-responsive">
      <table class="table table-sm table-hover mb-0 align-middle">
        <thead class="table-light"><tr>
          <th><%= t("Employee") %></th>
          <th class="text-end"><%= t("Days present") %></th>
          <th class="text-end"><%= t("Odometer km") %></th>
          <th class="text-end d-none d-md-table-cell"><%= t("Avg km / day") %></th>
          <th class="text-end"><%= t("Km claimed") %></th>
          <th class="text-end d-none d-md-table-cell"><%= t("Incomplete days") %></th>
          <th></th>
        </tr></thead>
        <tbody>
          <% rows.forEach(r => { const diff = r.claimed_km - r.km; const over = r.claimed_km > 0 && diff > Math.max(5, r.km * 0.1); %>
          <tr class="<%= r.km || r.claimed_km || r.present_days ? '' : 'text-muted' %>">
            <td><div class="fw-semibold"><%= r.full_name || r.username %></div><div class="small text-muted"><%= r.position_title || '—' %></div></td>
            <td class="text-end num"><%= r.present_days %></td>
            <td class="text-end num fw-semibold"><%= r.km.toFixed(0) %></td>
            <td class="text-end num d-none d-md-table-cell"><%= r.km_days ? (r.km / r.km_days).toFixed(0) : '—' %></td>
            <td class="text-end num <%= over ? 'text-danger fw-semibold' : '' %>" <% if (over) { %>title="<%= t("Claimed more than the odometer shows") %>"<% } %>><%= r.claimed_km.toFixed(0) %><% if (over) { %> <i class="bi bi-exclamation-triangle-fill"></i><% } %></td>
            <td class="text-end num d-none d-md-table-cell"><%= r.incomplete ? r.incomplete : '—' %></td>
            <td class="text-end text-nowrap">
              <a href="/attendance/staff?user=<%= r.id %>&m=<%= monthOf %>" class="btn btn-sm btn-link p-0" title="<%= t("Photos, location and km by day") %>" aria-label="<%= t("Photos, location and km by day") %>"><i class="bi bi-calendar3"></i></a>
              <a href="/travel-expenses/queue?status=all&user=<%= r.id %>&m=<%= monthOf %>" class="btn btn-sm btn-link p-0 ms-2" title="<%= t("Expense claims") %>" aria-label="<%= t("Expense claims") %>"><i class="bi bi-receipt"></i></a>
              <% if (canCorrect) { %><a href="/travel-expenses/km-grid?mode=employee&user=<%= r.id %>&week=<%= to %>" class="btn btn-sm btn-link p-0 ms-2" title="<%= t("Correct KM") %>" aria-label="<%= t("Correct KM") %>"><i class="bi bi-speedometer"></i></a><% } %>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
  <div class="small text-muted mt-2"><%= t("Odometer km comes from the start and end meter readings at check-in and check-out. A red figure means more km was claimed than the odometer shows. Tap the calendar icon to see each day's selfies, meter photos and location.") %></div>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body></html>
