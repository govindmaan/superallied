<%- include('../partials/head', { title }) %>
<%- include('../partials/sidebar', { active: 'machines', user }) %>
<div class="main-content">
  <div class="page-header d-flex justify-content-between align-items-center mb-4">
    <h4 class="mb-0 fw-bold"><i class="bi bi-sliders me-2 text-danger"></i><%= machine.display_name %></h4>
    <a href="/machines" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i><%= t("Back") %></a>
  </div>

  <div class="row g-4">
    <!-- Machine Details -->
    <div class="col-lg-6">
      <div class="card border-0 shadow-sm">
        <div class="card-header bg-light fw-semibold"><%= t("Machine Details") %></div>
        <div class="card-body">
          <dl class="row mb-0 small">
            <dt class="col-5 text-muted"><%= t("Name") %></dt><dd class="col-7 fw-semibold"><%= machine.display_name %></dd>
            <dt class="col-5 text-muted"><%= t("Category") %></dt><dd class="col-7"><%= machine.model_series || '—' %></dd>
            <dt class="col-5 text-muted"><%= t("Basic Price") %></dt><dd class="col-7 fw-bold">₹<%= machine.basic_price.toLocaleString('en-IN') %></dd>
            <dt class="col-5 text-muted"><%= t("GST %") %></dt><dd class="col-7"><%= machine.gst_rate ?? 18 %>%</dd>
            <dt class="col-5 text-muted"><%= t("HSN Code") %></dt><dd class="col-7 font-monospace"><%= machine.hsn_code || '—' %></dd>
            <dt class="col-5 text-muted"><%= t("Engine") %></dt><dd class="col-7"><%= machine.engine || '—' %></dd>
            <dt class="col-5 text-muted"><%= t("Transmission") %></dt><dd class="col-7"><%= machine.transmission || '—' %></dd>
            <dt class="col-5 text-muted"><%= t("Front Tyre") %></dt><dd class="col-7"><%= machine.front_tyre || '—' %></dd>
            <dt class="col-5 text-muted"><%= t("Rear Tyre") %></dt><dd class="col-7"><%= machine.rear_tyre || '—' %></dd>
            <dt class="col-5 text-muted"><%= t("Battery") %></dt><dd class="col-7"><%= machine.battery || '—' %></dd>
            <dt class="col-5 text-muted"><%= t("Weight") %></dt><dd class="col-7"><%= machine.weight || '—' %></dd>
            <dt class="col-5 text-muted"><%= t("Bucket") %></dt><dd class="col-7"><%= machine.bucket || '—' %></dd>
            <dt class="col-5 text-muted"><%= t("Warranty") %></dt><dd class="col-7"><%= machine.warranty || '—' %></dd>
            <dt class="col-5 text-muted"><%= t("Status") %></dt><dd class="col-7"><span class="badge <%= machine.active ? 'bg-success' : 'bg-secondary' %>"><%= machine.active ? t('Active') : t('Inactive') %></span><% if (used) { %> <span class="text-muted"><%= t("· used on") %> <%= used %> <%= t("quotation") %><%= used === 1 ? '' : 's' %></span><% } %></dd>
          </dl>
          <div class="mt-3 d-flex gap-2">
            <button class="btn btn-outline-primary btn-sm" onclick="editMachine()"><i class="bi bi-pencil me-1"></i><%= t("Edit") %></button>
            <% if (machine.active) { %>
            <button class="btn btn-outline-danger btn-sm" onclick="deleteMachine()"><i class="bi bi-trash me-1"></i><%= used ? t('Deactivate') : t('Remove') %></button>
            <% } else { %>
            <button class="btn btn-outline-success btn-sm" onclick="reactivateMachine()"><i class="bi bi-arrow-counterclockwise me-1"></i><%= t("Reactivate") %></button>
            <% } %>
          </div>
        </div>
      </div>
    </div>

    <!-- Machine Specifications -->
    <div class="col-lg-6">
      <div class="card border-0 shadow-sm">
        <div class="card-header bg-light d-flex justify-content-between align-items-center">
          <span class="fw-semibold"><%= t("Specifications (") %><%= specs.length %>)</span>
          <button class="btn btn-sm btn-success" onclick="openAddSpec()"><i class="bi bi-plus-lg"></i><%= t("Add Spec") %></button>
        </div>
        <div class="card-body" style="max-height: 600px; overflow-y: auto;">
          <% if (specs.length > 0) { %>
            <div class="list-group">
              <% specs.forEach((s, idx) => { %>
              <div class="list-group-item py-2 px-3">
                <div class="d-flex justify-content-between align-items-start gap-2">
                  <div class="flex-grow-1">
                    <div class="fw-semibold small text-danger"><%= s.spec_name %></div>
                    <div class="text-muted small"><%= s.spec_value %></div>
                  </div>
                  <button class="btn btn-sm btn-outline-danger" onclick="deleteSpec(<%= s.id %>)" title="<%= t("Delete") %>">
                    <i class="bi bi-trash"></i>
                  </button>
                </div>
              </div>
              <% }) %>
            </div>
          <% } else { %>
            <p class="text-center text-muted py-4"><%= t("No specifications added yet.") %></p>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Add Spec Modal -->
<div class="modal fade" id="addSpecModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header"><h5 class="modal-title fw-bold"><%= t("Add Specification") %></h5></div>
      <div class="modal-body">
        <form id="addSpecForm">
          <div class="mb-3">
            <label class="form-label fw-semibold"><%= t("Spec Name") %> <span class="text-danger">*</span></label>
            <input type="text" name="spec_name" class="form-control" required placeholder="<%= t("e.g. Horsepower, Fuel Capacity") %>">
          </div>
          <div class="mb-3">
            <label class="form-label fw-semibold"><%= t("Spec Value") %> <span class="text-danger">*</span></label>
            <input type="text" name="spec_value" class="form-control" required placeholder="<%= t("e.g. 75 HP, 60 Liters") %>">
          </div>
          <div class="mb-3">
            <label class="form-label fw-semibold"><%= t("Display Order") %></label>
            <input type="number" name="display_order" class="form-control" value="0">
          </div>
        </form>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" onclick="closeAddSpec()"><%= t("Cancel") %></button>
        <button type="button" class="btn btn-success" onclick="saveSpec()"><i class="bi bi-check-lg me-1"></i><%= t("Add Spec") %></button>
      </div>
    </div>
  </div>
</div>

<!-- Edit Machine Modal -->
<div class="modal fade" id="editMachineModal" tabindex="-1">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <div class="modal-header"><h5 class="modal-title fw-bold"><%= t("Edit Machine") %></h5></div>
      <div class="modal-body">
        <form id="editMachineForm">
          <%- include('_fields', { m: machine, categories }) %>
        </form>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" onclick="closeEditMachine()"><%= t("Cancel") %></button>
        <button type="button" class="btn btn-primary" onclick="updateMachine()"><i class="bi bi-check-lg me-1"></i><%= t("Save Changes") %></button>
      </div>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
const machineId = <%= machine.id %>;

function openAddSpec() {
  document.getElementById('addSpecForm').reset();
  new bootstrap.Modal(document.getElementById('addSpecModal')).show();
}

function closeAddSpec() {
  bootstrap.Modal.getInstance(document.getElementById('addSpecModal')).hide();
}

async function saveSpec() {
  const form = document.getElementById('addSpecForm');
  const data = new FormData(form);
  const obj = Object.fromEntries(data);

  const resp = await fetch(`/machines/${machineId}/specs`, {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify(obj)
  }).then(r => r.json());

  if (resp.ok) {
    closeAddSpec();
    location.reload();
  } else {
    alert('Error: ' + resp.error);
  }
}

async function deleteSpec(specId) {
  if (!confirm(T('Delete this specification?'))) return;

  const resp = await fetch(`/machines/${machineId}/specs/${specId}`, {
    method: 'DELETE'
  }).then(r => r.json());

  if (resp.ok) {
    location.reload();
  } else {
    alert('Error: ' + resp.error);
  }
}

function editMachine() {
  new bootstrap.Modal(document.getElementById('editMachineModal')).show();
}

function closeEditMachine() {
  bootstrap.Modal.getInstance(document.getElementById('editMachineModal')).hide();
}

async function updateMachine() {
  const form = document.getElementById('editMachineForm');
  if (!form.reportValidity()) return;
  const data = new FormData(form);
  const obj = Object.fromEntries(data);

  const resp = await fetch(`/machines/${machineId}`, {
    method: 'PUT',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify(obj)
  }).then(r => r.json());

  if (resp.ok) {
    closeEditMachine();
    location.reload();
  } else {
    alert('Error: ' + resp.error);
  }
}

function deleteMachine() {
  const used = <%= used %>;
  if (!confirm(used ? `This machine is used on ${used} quotation(s), so it will be deactivated: hidden from new quotations, with old ones unchanged. Continue?` : 'Remove this machine and its specifications?')) return;
  fetch(`/machines/${machineId}`, { method: 'DELETE' }).then(r => r.json()).then(resp => {
    if (resp.ok) window.location = '/machines';
    else alert('Error: ' + resp.error);
  });
}

function reactivateMachine() {
  fetch(`/machines/${machineId}/active`, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ active: true }) })
    .then(r => r.json()).then(resp => resp.ok ? location.reload() : alert('Error: ' + resp.error));
}
</script>
</body></html>
