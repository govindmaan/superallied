<%- include('../partials/head', { title }) %>
<%- include('../partials/sidebar', { active: 'machines', user }) %>
<div class="main-content">
  <div class="page-header d-flex justify-content-between align-items-center mb-4">
    <h4 class="mb-0 fw-bold"><i class="bi bi-tag me-2 text-danger"></i><%= t("Update Machine Selling Prices") %></h4>
    <a href="/machines" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i><%= t("Back") %></a>
  </div>

  <div class="alert alert-info mb-3">
    <i class="bi bi-info-circle me-2"></i>
    <strong><%= t("Selling Price") %></strong> <%= t("— The price at which you sell the machine to customers. Edit the price in the table below.") %>
  </div>

  <div class="card border-0 shadow-sm">
    <div class="table-responsive">
      <table class="table table-hover mb-0">
        <thead class="table-light">
          <tr>
            <th style="width: 40%"><%= t("Machine Model") %></th>
            <th style="width: 20%"><%= t("Series") %></th>
            <th style="width: 20%"><%= t("Current Price") %></th>
            <th style="width: 20%"><%= t("New Price") %></th>
          </tr>
        </thead>
        <tbody>
          <% machines.forEach(m => { %>
          <tr>
            <td class="fw-semibold"><%= m.display_name %></td>
            <td><small class="text-muted"><%= m.model_series %></small></td>
            <td class="fw-bold">₹<%= m.basic_price.toLocaleString('en-IN') %></td>
            <td>
              <div class="input-group input-group-sm" style="max-width: 150px">
                <span class="input-group-text">₹</span>
                <input type="number" class="form-control" value="<%= m.basic_price %>"
                       min="1" step="1000" data-machine-id="<%= m.id %>"
                       onchange="updatePrice(this)" onkeypress="if(event.key==='Enter') updatePrice(this)"
                       placeholder="<%= t("Price") %>">
              </div>
            </td>
          </tr>
          <% }) %>
          <% if (!machines.length) { %>
          <tr><td colspan="4" class="text-center text-muted py-4"><%= t("No machines found.") %></td></tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>

  <div class="mt-3 text-muted small">
    <i class="bi bi-lightbulb me-1"></i><%= t("Enter price and press Enter or Tab to save automatically.") %>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
async function updatePrice(input) {
  const machineId = input.getAttribute('data-machine-id');
  const newPrice = parseFloat(input.value) || 0;

  if (newPrice <= 0) {
    alert(T('Price must be greater than 0'));
    location.reload();
    return;
  }

  try {
    const resp = await fetch(`/machines/${machineId}/selling-price`, {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ basic_price: newPrice })
    }).then(r => r.json());

    if (resp.ok) {
      input.classList.add('is-valid');
      setTimeout(() => input.classList.remove('is-valid'), 2000);
    } else {
      alert('Error: ' + resp.error);
      location.reload();
    }
  } catch(e) {
    alert('Network error: ' + e.message);
    location.reload();
  }
}
</script>
</body></html>
