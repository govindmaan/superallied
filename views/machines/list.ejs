<%- include('../partials/head', { title }) %>
<%- include('../partials/sidebar', { active: 'machines', user }) %>
<div class="main-content">
  <div class="page-header d-flex justify-content-between align-items-center mb-4">
    <h4 class="mb-0 fw-bold"><i class="bi bi-sliders me-2 text-danger"></i>Machine Master</h4>
    <div class="d-flex gap-2">
      <a href="/machines/price-update" class="btn btn-outline-primary"><i class="bi bi-tag me-1"></i>Update Prices</a>
      <button class="btn btn-danger" onclick="openAddMachine()"><i class="bi bi-plus-lg me-1"></i>Add Machine</button>
    </div>
  </div>

  <div class="card border-0 shadow-sm">
    <div class="table-responsive">
      <table class="table table-hover mb-0">
        <thead class="table-light">
          <tr>
            <th>Name</th>
            <th>Category</th>
            <th class="text-end">Basic Price</th>
            <th class="text-end">GST %</th>
            <th>HSN Code</th>
            <th>Status</th>
            <th class="text-end">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% machines.forEach(m => { %>
          <tr class="<%= m.active ? '' : 'text-muted' %>">
            <td class="fw-semibold"><%= m.display_name %></td>
            <td class="small"><%= m.model_series || '—' %></td>
            <td class="text-end">₹<%= m.basic_price.toLocaleString('en-IN') %></td>
            <td class="text-end"><%= m.gst_rate ?? 18 %>%</td>
            <td class="small font-monospace"><%= m.hsn_code || '—' %></td>
            <td><span class="badge <%= m.active ? 'bg-success' : 'bg-secondary' %>"><%= m.active ? 'Active' : 'Inactive' %></span></td>
            <td class="text-end text-nowrap">
              <a href="/machines/<%= m.id %>" class="btn btn-sm btn-outline-primary" title="View / Edit"><i class="bi bi-pencil"></i></a>
              <% if (m.active) { %>
              <button class="btn btn-sm btn-outline-danger" data-remove="<%= m.id %>" data-name="<%= m.display_name %>" title="Remove"><i class="bi bi-trash"></i></button>
              <% } else { %>
              <button class="btn btn-sm btn-outline-success" data-activate="<%= m.id %>" title="Reactivate"><i class="bi bi-arrow-counterclockwise"></i></button>
              <% } %>
            </td>
          </tr>
          <% }) %>
          <% if (!machines.length) { %>
          <tr><td colspan="7" class="text-center text-muted py-4">No machines found. <a href="javascript:openAddMachine()" class="text-danger">Add one</a></td></tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<!-- Add Machine Modal -->
<div class="modal fade" id="addMachineModal" tabindex="-1">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <div class="modal-header"><h5 class="modal-title fw-bold">Add New Machine</h5></div>
      <div class="modal-body">
        <form id="addMachineForm">
          <%- include('_fields', { m: null, categories }) %>
        </form>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" onclick="closeAddMachine()">Cancel</button>
        <button type="button" class="btn btn-danger" onclick="saveMachine()"><i class="bi bi-check-lg me-1"></i>Add Machine</button>
      </div>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
function openAddMachine() {
  document.getElementById('addMachineForm').reset();
  new bootstrap.Modal(document.getElementById('addMachineModal')).show();
}

function closeAddMachine() {
  bootstrap.Modal.getInstance(document.getElementById('addMachineModal')).hide();
}

async function saveMachine() {
  const form = document.getElementById('addMachineForm');
  if (!form.reportValidity()) return;
  const data = new FormData(form);
  const obj = Object.fromEntries(data);

  const resp = await fetch('/machines', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify(obj)
  }).then(r => r.json());

  if (resp.ok) {
    closeAddMachine();
    location.reload();
  } else {
    alert('Error: ' + resp.error);
  }
}

document.querySelectorAll('[data-remove]').forEach(b => b.addEventListener('click', async () => {
  if (!confirm(`Remove machine "${b.dataset.name}"?\n\nIf it has been used on quotations it will be deactivated instead, and those quotations stay as they are.`)) return;
  const resp = await fetch(`/machines/${b.dataset.remove}`, { method: 'DELETE' }).then(r => r.json());
  if (!resp.ok) return alert('Error: ' + resp.error);
  if (resp.deactivated) alert(`Used on ${resp.used} quotation(s), so it was deactivated. It no longer appears on new quotations.`);
  location.reload();
}));
document.querySelectorAll('[data-activate]').forEach(b => b.addEventListener('click', async () => {
  const resp = await fetch(`/machines/${b.dataset.activate}/active`, {
    method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ active: true })
  }).then(r => r.json());
  resp.ok ? location.reload() : alert('Error: ' + resp.error);
}));
</script>
</body></html>
