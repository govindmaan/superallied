<%- include('../partials/head', { title }) %>
<%- include('../partials/sidebar', { active: 'hr', user }) %>
<div class="main-content">
  <div class="page-header d-flex justify-content-between align-items-center mb-4">
    <h4 class="mb-0 fw-bold"><%= emp ? 'Edit Employee' : 'Add New Employee' %></h4>
    <a href="<%= emp ? '/hr/employees/'+emp.id : '/hr/employees' %>" class="btn btn-outline-secondary">
      <i class="bi bi-arrow-left me-1"></i>Back
    </a>
  </div>

  <% if (flash.error) { %><div class="alert alert-danger"><%= flash.error %></div><% } %>

  <form method="POST" action="<%= emp ? '/hr/employees/'+emp.id : '/hr/employees' %>" id="empForm">
    <div class="row g-3">
      <div class="col-lg-8">
        <!-- Login Details (only on create) -->
        <% if (!emp) { %>
        <div class="card border-0 shadow-sm mb-3">
          <div class="card-header bg-white fw-semibold">Login Credentials</div>
          <div class="card-body">
            <div class="row g-2">
              <div class="col-md-6">
                <label class="form-label fw-semibold">Username <span class="text-danger">*</span></label>
                <input type="text" name="username" class="form-control" required placeholder="e.g. ramesh.sharma">
              </div>
              <div class="col-md-6">
                <label class="form-label fw-semibold">Password <span class="text-danger">*</span></label>
                <input type="password" name="password" class="form-control" required minlength="6" placeholder="Min 6 chars">
              </div>
            </div>
          </div>
        </div>
        <% } %>

        <!-- Personal Details -->
        <div class="card border-0 shadow-sm mb-3">
          <div class="card-header bg-white fw-semibold">Personal Details</div>
          <div class="card-body">
            <div class="row g-2">
              <div class="col-md-8">
                <label class="form-label fw-semibold">Full Name <span class="text-danger">*</span></label>
                <input type="text" name="full_name" class="form-control" required value="<%= emp?.full_name || '' %>">
              </div>
              <div class="col-md-4">
                <label class="form-label fw-semibold">Employee ID</label>
                <input type="text" class="form-control bg-light font-monospace" value="<%= emp?.employee_code || 'Assigned automatically' %>" readonly tabindex="-1">
              </div>
              <div class="col-md-6">
                <label class="form-label fw-semibold">Mobile</label>
                <input type="text" name="mobile" class="form-control" value="<%= emp?.mobile || '' %>" placeholder="10-digit mobile">
              </div>
              <div class="col-md-6">
                <label class="form-label fw-semibold">Emergency Contact</label>
                <input type="text" name="emergency_contact" class="form-control" value="<%= emp?.emergency_contact || '' %>" placeholder="Name: Number">
              </div>
            </div>
          </div>
        </div>

        <!-- Employment Details -->
        <div class="card border-0 shadow-sm mb-3">
          <div class="card-header bg-white fw-semibold">Employment Details</div>
          <div class="card-body">
            <div class="row g-2">
              <div class="col-md-6">
                <label class="form-label fw-semibold">Designation</label>
                <input type="text" name="designation" class="form-control" value="<%= emp?.designation || '' %>" placeholder="e.g. Sales Executive">
              </div>
              <div class="col-md-6">
                <label class="form-label fw-semibold">Department</label>
                <input type="text" name="department" class="form-control" value="<%= emp?.department || '' %>" placeholder="e.g. Sales, Admin">
              </div>
              <div class="col-md-4">
                <label class="form-label fw-semibold">Date of Joining</label>
                <input type="date" name="date_of_joining" class="form-control" value="<%= emp?.date_of_joining || '' %>">
              </div>
              <div class="col-md-4">
                <label class="form-label fw-semibold">Role</label>
                <select name="role" class="form-select">
                  <% allRoles.forEach(r => { %>
                  <option value="<%= r %>" <%=(emp?emp.role===r:r==='sales')?'selected':''%>><%= r.charAt(0).toUpperCase()+r.slice(1) %></option>
                  <% }) %>
                </select>
              </div>
              <div class="col-md-4">
                <label class="form-label fw-semibold">Reports To</label>
                <select name="manager_id" class="form-select">
                  <option value="">— None —</option>
                  <% managers.forEach(m => { %>
                  <option value="<%= m.id %>" <%=emp?.manager_id==m.id?'selected':''%>><%= m.full_name %></option>
                  <% }) %>
                </select>
              </div>
              <% if (emp) { %>
              <div class="col-md-4">
                <label class="form-label fw-semibold">Status</label>
                <select name="is_hr_active" class="form-select">
                  <option value="1" <%=emp.is_hr_active!==0?'selected':''%>>Active</option>
                  <option value="0" <%=emp.is_hr_active===0?'selected':''%>>Inactive</option>
                </select>
              </div>
              <% } %>
            </div>
          </div>
        </div>

        <!-- Vehicle Details (used to pre-fill Travel Expense claims) -->
        <div class="card border-0 shadow-sm mb-3">
          <div class="card-header bg-white fw-semibold">Vehicle Details</div>
          <div class="card-body">
            <div class="row g-2">
              <div class="col-md-6">
                <label class="form-label fw-semibold">Vehicle Type</label>
                <select name="vehicle_type" class="form-select">
                  <option value="" <%=!emp?.vehicle_type?'selected':''%>>— Not set —</option>
                  <option value="Own Two Wheeler"  <%=emp?.vehicle_type==='Own Two Wheeler'?'selected':''%>>Own Two Wheeler</option>
                  <option value="Own Four Wheeler" <%=emp?.vehicle_type==='Own Four Wheeler'?'selected':''%>>Own Four Wheeler</option>
                  <option value="Company Vehicle"  <%=emp?.vehicle_type==='Company Vehicle'?'selected':''%>>Company Vehicle</option>
                  <option value="Other"            <%=emp?.vehicle_type==='Other'?'selected':''%>>Other</option>
                </select>
              </div>
              <div class="col-md-6">
                <label class="form-label fw-semibold">Vehicle Number</label>
                <input type="text" name="vehicle_number" class="form-control" value="<%= emp?.vehicle_number || '' %>" placeholder="e.g. MH12AB1234">
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Right: Photo Upload -->
      <div class="col-lg-4">
        <div class="card border-0 shadow-sm mb-3">
          <div class="card-header bg-white fw-semibold">Employee Photo</div>
          <div class="card-body text-center">
            <div id="photoPreview" class="mb-3">
              <% if (emp?.photo_path) { %>
                <img src="<%= emp.photo_path %>" id="currentPhoto" style="width:120px;height:120px;border-radius:50%;object-fit:cover;border:3px solid #cc0000">
              <% } else { %>
                <div style="width:120px;height:120px;border-radius:50%;background:#f0f0f0;display:flex;align-items:center;justify-content:center;margin:0 auto;font-size:3rem;color:#ccc"><i class="bi bi-person"></i></div>
              <% } %>
            </div>
            <% if (emp) { %>
            <button type="button" class="btn btn-outline-danger btn-sm" onclick="openCamera()">
              <i class="bi bi-camera me-1"></i>Take Photo
            </button>
            <video id="photoCamera" style="display:none;width:100%;border-radius:8px" autoplay playsinline></video>
            <div id="cameraControls" style="display:none" class="mt-2 d-flex gap-2 justify-content-center">
              <button type="button" class="btn btn-danger btn-sm" onclick="snapPhoto()">Snap</button>
              <button type="button" class="btn btn-outline-secondary btn-sm" onclick="closeCamera()">Cancel</button>
            </div>
            <% } else { %>
            <small class="text-muted">Save employee first, then add photo.</small>
            <% } %>
          </div>
        </div>
      </div>
    </div>

    <div class="d-flex gap-2">
      <button type="submit" class="btn btn-danger fw-bold px-4">
        <i class="bi bi-check-lg me-1"></i><%= emp ? 'Update Employee' : 'Create Employee' %>
      </button>
      <a href="<%= emp ? '/hr/employees/'+emp.id : '/hr/employees' %>" class="btn btn-outline-secondary">Cancel</a>
    </div>
  </form>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<% if (emp) { %>
<script>
let _stream = null;
async function openCamera() {
  try {
    _stream = await navigator.mediaDevices.getUserMedia({ video: { facingMode: 'user' }, audio: false });
    const vid = document.getElementById('photoCamera');
    vid.srcObject = _stream; vid.style.display = 'block';
    document.getElementById('cameraControls').style.display = 'flex';
    document.querySelector('[onclick="openCamera()"]').style.display = 'none';
  } catch(e) { alert('Camera error: ' + e.message); }
}
async function snapPhoto() {
  const vid = document.getElementById('photoCamera');
  const c = document.createElement('canvas'); c.width = 480; c.height = 480;
  c.getContext('2d').drawImage(vid, 0, 0, 480, 480);
  const data = c.toDataURL('image/jpeg', 0.8);
  closeCamera();
  const r = await fetch('/hr/employees/<%= emp.id %>/photo', {
    method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ photo: data })
  }).then(r=>r.json());
  if (r.ok) {
    document.getElementById('photoPreview').innerHTML = `<img src="${r.path}" style="width:120px;height:120px;border-radius:50%;object-fit:cover;border:3px solid #cc0000">`;
  }
}
function closeCamera() {
  if (_stream) { _stream.getTracks().forEach(t=>t.stop()); _stream=null; }
  document.getElementById('photoCamera').style.display = 'none';
  document.getElementById('cameraControls').style.display = 'none';
  document.querySelector('[onclick="openCamera()"]').style.display = '';
}
</script>
<% } %>
</body></html>
