<%- include('../partials/head', { title }) %>
<%- include('../partials/sidebar', { active: 'hr', user }) %>
<div class="main-content">
  <div class="page-header d-flex justify-content-between align-items-center mb-4">
    <h4 class="mb-0 fw-bold"><i class="bi bi-cash-coin me-2 text-danger"></i>Salary Management</h4>
    <div class="d-flex gap-2">
      <button class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#salaryModal"><i class="bi bi-plus-lg me-1"></i>Upload Salary</button>
      <button class="btn btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#incentiveModal"><i class="bi bi-trophy me-1"></i>Add Incentive</button>
      <button class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#travelPayModal"><i class="bi bi-truck me-1"></i>Pay Travel Expense</button>
    </div>
  </div>

  <% if (flash.success) { %><div class="alert alert-success alert-dismissible"><%= flash.success %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div><% } %>
  <% if (flash.error) { %><div class="alert alert-danger alert-dismissible"><%= flash.error %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div><% } %>

  <!-- Filters -->
  <div class="card border-0 shadow-sm mb-3">
    <div class="card-body py-2">
      <form method="GET" class="d-flex flex-wrap gap-2 align-items-end">
        <div>
          <label class="form-label small mb-1">Month</label>
          <input type="month" name="month" value="<%= month %>" class="form-control" style="max-width:160px">
        </div>
        <div>
          <label class="form-label small mb-1">Employee</label>
          <select name="emp" class="form-select" style="max-width:200px">
            <option value="">All Employees</option>
            <% employees.forEach(e => { %><option value="<%= e.id %>" <%=empFilter==e.id?'selected':''%>><%= e.full_name %></option><% }) %>
          </select>
        </div>
        <button class="btn btn-outline-secondary"><i class="bi bi-filter"></i></button>
      </form>
    </div>
  </div>

  <!-- Totals -->
  <% if (records.length) { %>
  <div class="row g-2 mb-3">
    <div class="col-4"><div class="card border-0 bg-light text-center py-2"><div class="fw-bold">₹<%= formatINR(totals.gross) %></div><div class="small text-muted">Total Gross</div></div></div>
    <div class="col-4"><div class="card border-0 bg-danger bg-opacity-10 text-center py-2"><div class="fw-bold">₹<%= formatINR(totals.pf) %></div><div class="small text-muted">Total PF</div></div></div>
    <div class="col-4"><div class="card border-0 bg-success bg-opacity-10 text-center py-2"><div class="fw-bold text-success">₹<%= formatINR(totals.net) %></div><div class="small text-muted">Total Net</div></div></div>
  </div>
  <% } %>

  <div class="card border-0 shadow-sm">
    <div class="table-responsive">
      <table class="table table-hover mb-0">
        <thead class="table-light"><tr><th>Employee</th><th>Basic</th><th>HRA</th><th>Gross</th><th>PF</th><th>Net Salary</th><th>Incentive</th><th>Paid On</th><th></th></tr></thead>
        <tbody>
          <% records.forEach(r => { %>
          <tr>
            <td>
              <div class="fw-semibold small"><%= r.full_name %></div>
              <small class="text-muted font-monospace"><%= r.employee_code %></small>
            </td>
            <td class="small">₹<%= formatINR(r.basic) %></td>
            <td class="small">₹<%= formatINR(r.hra) %></td>
            <td class="fw-semibold">₹<%= formatINR(r.gross) %></td>
            <td class="small text-danger">₹<%= formatINR(r.pf) %></td>
            <td class="fw-bold text-success">₹<%= formatINR(r.net_salary) %></td>
            <td><%= r.incentive > 0 ? '₹'+formatINR(r.incentive) : '—' %></td>
            <td class="small text-muted"><%= r.paid_on || '—' %></td>
            <td>
              <a href="/hr/salary/<%= r.id %>/pdf" class="btn btn-sm btn-outline-danger" title="Salary Slip PDF">
                <i class="bi bi-file-pdf"></i>
              </a>
            </td>
          </tr>
          <% }) %>
          <% if (!records.length) { %><tr><td colspan="9" class="text-center text-muted py-4">No salary records for <%= month %>. Click "Upload Salary" to add.</td></tr><% } %>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Travel expense payments this month -->
  <% const tpTotal = travelPayments.reduce((a, p) => a + p.amount, 0); %>
  <div class="card border-0 shadow-sm mt-3">
    <div class="card-header bg-white fw-semibold d-flex justify-content-between">
      <span><i class="bi bi-truck me-1 text-primary"></i>Travel expense payments — <%= month %></span>
      <span class="text-primary">₹<%= formatINR(tpTotal) %></span>
    </div>
    <div class="table-responsive">
      <table class="table table-sm table-hover mb-0 align-middle">
        <thead class="table-light"><tr><th>Employee</th><th>TA Bill</th><th>Paid On</th><th>Mode</th><th>Reference</th><th class="text-end">Amount</th><th></th></tr></thead>
        <tbody>
          <% travelPayments.forEach(p => { %>
          <tr>
            <td><div class="fw-semibold small"><%= p.full_name %></div><small class="text-muted font-monospace"><%= p.employee_code %></small></td>
            <td class="small"><% if (p.bill_no) { %><a href="/travel-expenses/bills/<%= p.ta_bill_id %>" class="font-monospace text-decoration-none"><%= p.bill_no %></a><% } else { %>—<% } %></td>
            <td class="small"><%= p.paid_on %></td>
            <td class="small"><%= p.mode || '—' %></td>
            <td class="small"><%= p.reference || '—' %><% if (p.remarks) { %><div class="text-muted"><%= p.remarks %></div><% } %></td>
            <td class="text-end fw-semibold">₹<%= formatINR(p.amount) %></td>
            <td class="text-end">
              <form method="POST" action="/hr/salary/travel-payment/<%= p.id %>/delete" class="d-inline" onsubmit="return confirm('Remove this travel payment record?')">
                <button class="btn btn-sm btn-outline-secondary" title="Remove"><i class="bi bi-trash"></i></button>
              </form>
            </td>
          </tr>
          <% }) %>
          <% if (!travelPayments.length) { %><tr><td colspan="7" class="text-center text-muted py-3">No travel expense payments in <%= month %>.</td></tr><% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<!-- Upload Salary Modal -->
<div class="modal fade" id="salaryModal" tabindex="-1">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <div class="modal-header"><h5 class="modal-title fw-bold">Upload Salary Record</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
      <form method="POST" action="/hr/salary">
        <div class="modal-body">
          <div class="row g-2">
            <div class="col-md-6">
              <label class="form-label fw-semibold">Employee <span class="text-danger">*</span></label>
              <select name="user_id" class="form-select" required>
                <option value="">— Select Employee —</option>
                <% employees.forEach(e => { %><option value="<%= e.id %>"><%= e.full_name %> (<%= e.employee_code || 'No Code' %>)</option><% }) %>
              </select>
            </div>
            <div class="col-md-3">
              <label class="form-label fw-semibold">Month <span class="text-danger">*</span></label>
              <input type="month" name="month" class="form-control" value="<%= month %>" required>
            </div>
            <div class="col-md-3">
              <label class="form-label fw-semibold">Paid On</label>
              <input type="date" name="paid_on" class="form-control">
            </div>
            <div class="col-md-4">
              <label class="form-label fw-semibold">Basic (₹)</label>
              <input type="number" name="basic" class="form-control" value="0" oninput="calcSalary()">
            </div>
            <div class="col-md-4">
              <label class="form-label fw-semibold">HRA (₹)</label>
              <input type="number" name="hra" class="form-control" value="0" oninput="calcSalary()">
            </div>
            <div class="col-md-4">
              <label class="form-label fw-semibold">Other Allowances (₹)</label>
              <input type="number" name="allowances" class="form-control" value="0" oninput="calcSalary()">
            </div>
            <div class="col-md-3">
              <label class="form-label fw-semibold">PF (₹)</label>
              <input type="number" name="pf" class="form-control" value="0" oninput="calcSalary()">
            </div>
            <div class="col-md-3">
              <label class="form-label fw-semibold">ESIC (₹)</label>
              <input type="number" name="esic" class="form-control" value="0" oninput="calcSalary()">
            </div>
            <div class="col-md-3">
              <label class="form-label fw-semibold">TDS (₹)</label>
              <input type="number" name="tds" class="form-control" value="0" oninput="calcSalary()">
            </div>
            <div class="col-md-3">
              <label class="form-label fw-semibold">Other Deductions (₹)</label>
              <input type="number" name="other_ded" class="form-control" value="0" oninput="calcSalary()">
            </div>
            <div class="col-12">
              <div class="alert alert-success py-2 d-flex justify-content-between align-items-center mb-0">
                <span>Net Salary</span>
                <strong id="netCalc" class="fs-5">₹0</strong>
              </div>
            </div>
            <div class="col-12">
              <label class="form-label fw-semibold">Remarks</label>
              <input type="text" name="remarks" class="form-control" placeholder="Optional notes…">
            </div>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-danger fw-bold">Save Salary Record</button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- Add Incentive Modal -->
<div class="modal fade" id="incentiveModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header"><h5 class="modal-title fw-bold">Add Incentive</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
      <form method="POST" action="/hr/salary/incentive">
        <div class="modal-body">
          <div class="mb-3">
            <label class="form-label fw-semibold">Employee</label>
            <select name="user_id" class="form-select" required>
              <option value="">— Select —</option>
              <% employees.forEach(e => { %><option value="<%= e.id %>"><%= e.full_name %></option><% }) %>
            </select>
          </div>
          <div class="row g-2">
            <div class="col-6"><label class="form-label fw-semibold">Month</label><input type="month" name="month" class="form-control" value="<%= month %>" required></div>
            <div class="col-6"><label class="form-label fw-semibold">Amount (₹)</label><input type="number" name="amount" class="form-control" min="1" required></div>
          </div>
          <div class="mt-2">
            <label class="form-label fw-semibold">Reason</label>
            <input type="text" name="reason" class="form-control" placeholder="e.g. Target achieved, Special bonus">
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-warning fw-bold">Add Incentive</button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- Pay Travel Expense Modal -->
<div class="modal fade" id="travelPayModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header"><h5 class="modal-title fw-bold"><i class="bi bi-truck me-1 text-primary"></i>Pay Travel Expense</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
      <form method="POST" action="/hr/salary/travel-payment">
        <div class="modal-body">
          <div class="mb-2">
            <label class="form-label fw-semibold">Employee <span class="text-danger">*</span></label>
            <select name="user_id" id="tp_user" class="form-select" required onchange="loadTravelDue()">
              <option value="">— Select Employee —</option>
              <% employees.forEach(e => { %><option value="<%= e.id %>"><%= e.full_name %> (<%= e.employee_code || 'No Code' %>)</option><% }) %>
            </select>
          </div>
          <div class="mb-2">
            <label class="form-label fw-semibold">TA Bill</label>
            <select name="ta_bill_id" id="tp_bill" class="form-select" onchange="fillBalance()">
              <option value="">— Choose an employee first —</option>
            </select>
            <div class="form-text" id="tp_hint">The amount fills in with what is approved and not yet paid.</div>
          </div>
          <div class="row g-2">
            <div class="col-6">
              <label class="form-label fw-semibold">Amount (₹) <span class="text-danger">*</span></label>
              <input type="number" name="amount" id="tp_amount" class="form-control" min="1" step="0.01" required>
            </div>
            <div class="col-6">
              <label class="form-label fw-semibold">Paid On <span class="text-danger">*</span></label>
              <input type="date" name="paid_on" class="form-control" value="<%= today %>" required>
            </div>
            <div class="col-6">
              <label class="form-label fw-semibold">Mode</label>
              <select name="mode" class="form-select">
                <option>Bank Transfer</option><option>UPI</option><option>Cash</option><option>Cheque</option>
              </select>
            </div>
            <div class="col-6">
              <label class="form-label fw-semibold">Reference / UTR</label>
              <input type="text" name="reference" class="form-control" maxlength="60">
            </div>
            <div class="col-12">
              <label class="form-label fw-semibold">Remarks</label>
              <input type="text" name="remarks" class="form-control" maxlength="200">
            </div>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
          <button class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Record Payment</button>
        </div>
      </form>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
let travelDue = [];
const rs = n => '₹' + Number(n).toLocaleString('en-IN', { maximumFractionDigits: 2 });
const dshort = d => new Date(d + 'T00:00:00').toLocaleDateString('en-IN', { day: '2-digit', month: 'short' });
async function loadTravelDue() {
  const uid = document.getElementById('tp_user').value, sel = document.getElementById('tp_bill');
  sel.innerHTML = '<option value="">Loading…</option>';
  travelDue = uid ? (await (await fetch('/hr/salary/travel-due/' + uid)).json()).bills : [];
  sel.innerHTML = '';
  travelDue.forEach(b => {
    const o = document.createElement('option');
    o.value = b.id;
    o.textContent = `${b.bill_no} · ${dshort(b.week_start)}–${dshort(b.week_end)} · balance ${rs(b.balance)}`;
    sel.appendChild(o);
  });
  const none = document.createElement('option');
  none.value = ''; none.textContent = 'No TA bill (older trips / other)';
  sel.appendChild(none);
  // Default to the oldest bill that still has a balance
  const due = [...travelDue].reverse().find(b => b.balance > 0);
  sel.value = due ? due.id : (travelDue[0]?.id || '');
  fillBalance();
}
function fillBalance() {
  const b = travelDue.find(x => String(x.id) === document.getElementById('tp_bill').value);
  const hint = document.getElementById('tp_hint');
  if (!b) { hint.textContent = 'Enter the amount paid.'; return; }
  document.getElementById('tp_amount').value = b.balance || '';
  hint.textContent = `Approved ${rs(b.approved)} · already paid ${rs(b.paid)}` + (b.pending ? ` · ${b.pending} trip(s) still awaiting approval` : '');
}
</script>
<script>
function calcSalary() {
  const get = name => parseFloat(document.querySelector(`[name="${name}"]`).value)||0;
  const gross = get('basic') + get('hra') + get('allowances');
  const ded   = get('pf') + get('esic') + get('tds') + get('other_ded');
  const net   = gross - ded;
  document.getElementById('netCalc').textContent = '₹' + net.toLocaleString('en-IN');
}
</script>
</body></html>
