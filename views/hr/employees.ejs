<%- include('../partials/head', { title }) %>
<%- include('../partials/sidebar', { active: 'hr', user }) %>
<div class="main-content">
  <div class="page-header d-flex justify-content-between align-items-center mb-4">
    <h4 class="mb-0 fw-bold"><i class="bi bi-people me-2 text-danger"></i><%= t("Employees") %></h4>
    <a href="/hr/employees/new" class="btn btn-danger"><i class="bi bi-person-plus me-1"></i><%= t("Add Employee") %></a>
  </div>

  <div class="card border-0 shadow-sm mb-3">
    <div class="card-body py-2">
      <form method="GET" class="d-flex flex-wrap gap-2">
        <input type="text" name="q" value="<%= q %>" class="form-control" style="max-width:220px" placeholder="<%= t("Search name / code / phone…") %>">
        <select name="dept" class="form-select" style="max-width:160px">
          <option value=""><%= t("All Departments") %></option>
          <% departments.forEach(d => { %><option value="<%= d %>" <%=dept===d?'selected':''%>><%= d %></option><% }) %>
        </select>
        <select name="role" class="form-select" style="max-width:150px">
          <option value=""><%= t("All Roles") %></option>
          <% allRoles.forEach(r => { %><option value="<%= r %>" <%=role===r?'selected':''%>><%= r %></option><% }) %>
        </select>
        <select name="status" class="form-select" style="max-width:140px">
          <option value=""><%= t("All Statuses") %></option>
          <option value="active"   <%=status==='active'?'selected':''%>><%= t("Active") %></option>
          <option value="inactive" <%=status==='inactive'?'selected':''%>><%= t("Inactive") %></option>
        </select>
        <button class="btn btn-outline-secondary"><i class="bi bi-search"></i></button>
        <% if (q || dept || role || status) { %><a href="/hr/employees" class="btn btn-outline-danger"><%= t("Clear") %></a><% } %>
      </form>
    </div>
  </div>

  <div class="card border-0 shadow-sm">
    <div class="table-responsive">
      <table class="table table-hover mb-0">
        <thead class="table-light">
          <tr><th><%= t("Employee") %></th><th><%= t("Code") %></th><th><%= t("Department") %></th><th><%= t("Role") %></th><th><%= t("Mobile") %></th><th><%= t("Status") %></th><th></th></tr>
        </thead>
        <tbody>
          <% employees.forEach(e => { %>
          <tr class="<%= e.is_hr_active===0 ? 'opacity-50' : '' %>">
            <td>
              <div class="d-flex align-items-center gap-2">
                <% if (e.photo_path) { %>
                  <img src="<%= e.photo_path %>" style="width:36px;height:36px;border-radius:50%;object-fit:cover">
                <% } else { %>
                  <div style="width:36px;height:36px;border-radius:50%;background:#cc0000;color:#fff;display:flex;align-items:center;justify-content:center;font-weight:900;font-size:14px;flex-shrink:0">
                    <%= (e.full_name || 'U').charAt(0).toUpperCase() %>
                  </div>
                <% } %>
                <div>
                  <div class="fw-semibold"><%= e.full_name || e.username %></div>
                  <small class="text-muted"><%= e.designation || '' %></small>
                </div>
              </div>
            </td>
            <td class="font-monospace small"><%= e.employee_code || '—' %></td>
            <td class="small"><%= e.department || '—' %></td>
            <td><span class="badge <%= e.role==='admin'?'bg-danger':e.role==='manager'?'bg-warning text-dark':'bg-primary' %>"><%= e.role %></span></td>
            <td class="small"><%= e.mobile || '—' %></td>
            <td><span class="badge <%= e.is_hr_active===0?'bg-secondary':'bg-success' %>"><%= e.is_hr_active===0?t('Inactive'):t('Active') %></span></td>
            <td class="text-end text-nowrap">
              <a href="/hr/employees/<%= e.id %>" class="btn btn-sm btn-outline-secondary me-1" title="<%= t("View") %>"><i class="bi bi-eye"></i></a>
              <a href="/hr/employees/<%= e.id %>/edit" class="btn btn-sm btn-outline-secondary me-1" title="<%= t("Edit") %>"><i class="bi bi-pencil"></i></a>
              <% if (e.is_hr_active === 0) { %>
              <form method="POST" action="/hr/employees/<%= e.id %>/activate" class="d-inline" data-confirm-activate="<%= e.full_name || e.username %>">
                <button class="btn btn-sm btn-outline-success" title="<%= t("Activate") %>"><i class="bi bi-check-circle"></i></button>
              </form>
              <% } else { %>
              <form method="POST" action="/hr/employees/<%= e.id %>/deactivate" class="d-inline" data-confirm-deactivate="<%= e.full_name || e.username %>">
                <button class="btn btn-sm btn-outline-warning" title="<%= t("Deactivate") %>"><i class="bi bi-slash-circle"></i></button>
              </form>
              <% } %>
            </td>
          </tr>
          <% }) %>
          <% if (!employees.length) { %><tr><td colspan="7" class="text-center text-muted py-4"><%= t("No employees found.") %></td></tr><% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
document.querySelectorAll('[data-confirm-activate]').forEach(f => {
  f.addEventListener('submit', e => { if (!confirm('Activate ' + f.dataset.confirmActivate + '?')) e.preventDefault(); });
});
document.querySelectorAll('[data-confirm-deactivate]').forEach(f => {
  f.addEventListener('submit', e => { if (!confirm('Deactivate ' + f.dataset.confirmDeactivate + '? They will not be able to log in. Their records are preserved.')) e.preventDefault(); });
});
</script>
</body></html>
