<%- include('partials/head', { title }) %>
<%- include('partials/sidebar', { active: 'dashboard', user }) %>
<div class="main-content">
  <div class="page-header d-flex justify-content-between align-items-center mb-4">
    <h4 class="mb-0 fw-bold">Dashboard</h4>
    <a href="/quotations/new" class="btn btn-danger">
      <i class="bi bi-plus-lg me-1"></i>New Quotation
    </a>
  </div>

  <% if (flash.success) { %><div class="alert alert-success alert-dismissible"><%= flash.success %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div><% } %>
  <% if (flash.error) { %><div class="alert alert-danger alert-dismissible"><%= flash.error %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div><% } %>

  <div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
      <div class="stat-card card border-0 shadow-sm">
        <div class="card-body text-center">
          <div class="stat-icon bg-danger-subtle text-danger"><i class="bi bi-file-earmark-text fs-3"></i></div>
          <h3 class="fw-bold mb-0"><%= stats.quotations %></h3>
          <small class="text-muted">Machine Quotations</small>
        </div>
      </div>
    </div>
    <div class="col-6 col-md-3">
      <div class="stat-card card border-0 shadow-sm">
        <div class="card-body text-center">
          <div class="stat-icon bg-success-subtle text-success"><i class="bi bi-receipt-cutoff fs-3"></i></div>
          <h3 class="fw-bold mb-0"><%= stats.spareQuotations %></h3>
          <small class="text-muted">Spare Quotations</small>
        </div>
      </div>
    </div>
    <div class="col-6 col-md-3">
      <div class="stat-card card border-0 shadow-sm">
        <div class="card-body text-center">
          <div class="stat-icon bg-primary-subtle text-primary"><i class="bi bi-hdd-rack fs-3"></i></div>
          <h3 class="fw-bold mb-0"><%= stats.soldMachines %></h3>
          <small class="text-muted">Registered Machines</small>
        </div>
      </div>
    </div>
    <div class="col-6 col-md-3">
      <div class="stat-card card border-0 shadow-sm">
        <div class="card-body text-center">
          <div class="stat-icon bg-warning-subtle text-warning"><i class="bi bi-box-seam fs-3"></i></div>
          <h3 class="fw-bold mb-0"><%= stats.spareParts %></h3>
          <small class="text-muted">Spare Parts</small>
        </div>
      </div>
    </div>
  </div>

  <!-- Quick Actions -->
  <div class="row g-2 mb-4">
    <div class="col-auto">
      <a href="/spare-quotations/new" class="btn btn-success btn-sm"><i class="bi bi-receipt-cutoff me-1"></i>New Spare Quotation</a>
    </div>
    <div class="col-auto">
      <a href="/sold-machines/new" class="btn btn-outline-primary btn-sm"><i class="bi bi-hdd-rack me-1"></i>Register Machine</a>
    </div>
    <div class="col-auto">
      <a href="/quotations/new" class="btn btn-outline-danger btn-sm"><i class="bi bi-file-earmark-plus me-1"></i>Machine Quotation</a>
    </div>
  </div>

  <!-- Recent Spare Quotations -->
  <% if (recentSpare && recentSpare.length) { %>
  <div class="card border-0 shadow-sm mb-3">
    <div class="card-header bg-white d-flex justify-content-between align-items-center">
      <span class="fw-semibold"><i class="bi bi-receipt-cutoff me-2 text-success"></i>Recent Spare Quotations</span>
      <a href="/spare-quotations" class="btn btn-sm btn-outline-secondary">View All</a>
    </div>
    <div class="table-responsive">
      <table class="table table-hover mb-0 small">
        <thead class="table-light">
          <tr><th>No</th><th>Machine No</th><th>Customer</th><th class="text-end">Total</th><th>Status</th><th>Date</th></tr>
        </thead>
        <tbody>
          <% recentSpare.forEach(sq => { %>
          <tr>
            <td><a href="/spare-quotations/<%= sq.id %>" class="text-decoration-none fw-semibold"><%= sq.quotation_no %></a></td>
            <td class="font-monospace"><%= sq.machine_no || '—' %></td>
            <td><%= sq.customer_name %></td>
            <td class="text-end fw-semibold">₹<%= formatINR(sq.grand_total) %></td>
            <td><% const sc={draft:'bg-secondary',sent:'bg-primary',approved:'bg-success',rejected:'bg-danger',converted:'bg-info'}; %><span class="badge <%= sc[sq.status]||'bg-secondary' %>" style="font-size:9px"><%= sq.status %></span></td>
            <td class="text-muted"><%= new Date(sq.created_at).toLocaleDateString('en-IN') %></td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
  <% } %>

  <div class="card border-0 shadow-sm">
    <div class="card-header bg-white d-flex justify-content-between align-items-center">
      <span class="fw-semibold">Recent Machine Quotations</span>
      <a href="/quotations" class="btn btn-sm btn-outline-secondary">View All</a>
    </div>
    <div class="table-responsive">
      <table class="table table-hover mb-0">
        <thead class="table-light">
          <tr>
            <th>Quot. No.</th><th>Customer</th><th>Machine</th><th>Amount</th><th>Status</th><th>Date</th><th></th>
          </tr>
        </thead>
        <tbody>
          <% recent.forEach(q => {
               const total = calcQuotation(q, settings).total;
          %>
          <tr>
            <td><a href="/quotations/<%= q.id %>" class="fw-semibold text-decoration-none"><%= q.quotation_number %></a></td>
            <td><%= q.customer_name %></td>
            <td class="text-muted small"><%= q.machine_name %></td>
            <td class="fw-semibold">₹<%= formatINR(total) %></td>
            <td><span class="badge <%= q.status==='sent'?'bg-primary':q.status==='accepted'?'bg-success':q.status==='rejected'?'bg-danger':'bg-secondary' %>"><%= q.status %></span></td>
            <td class="text-muted small"><%= new Date(q.created_at).toLocaleDateString('en-IN') %></td>
            <td>
              <a href="/quotations/<%= q.id %>/pdf" class="btn btn-sm btn-outline-danger"><i class="bi bi-file-pdf"></i></a>
            </td>
          </tr>
          <% }) %>
          <% if (!recent.length) { %>
          <tr><td colspan="7" class="text-center text-muted py-4">No quotations yet. <a href="/quotations/new">Create one.</a></td></tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body></html>
