<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="theme-color" content="#1a1d2e">
  <title>Login — Super Allied</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
  <link href="/style.css" rel="stylesheet">
  <% if (turnstileSiteKey) { %><script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script><% } %>
  <style>
    body.login-page { padding: 16px; }
    .login-shell { width: 100%; max-width: 400px; }
    .login-card { border: 0; border-radius: 20px; padding: 28px 24px 22px; box-shadow: 0 20px 60px rgba(0,0,0,.35); }
    .brand { display: flex; align-items: center; gap: 12px; margin-bottom: 22px; }
    .brand-mark { width: 48px; height: 48px; border-radius: 12px; background: #cc0000; color: #fff;
                  display: flex; align-items: center; justify-content: center; font-weight: 900; font-size: 18px; flex-shrink: 0; }
    .brand-name { font-weight: 800; font-size: 20px; letter-spacing: .5px; line-height: 1.1; color: #1a1d2e; }
    .brand-sub  { font-size: 12px; color: #6c757d; }
    .brand img  { height: 30px; margin-left: auto; border-radius: 4px; }

    .mode-switch { display: grid; grid-template-columns: 1fr 1fr; background: #f1f3f5; border-radius: 12px; padding: 4px; margin-bottom: 18px; }
    .mode-switch button { border: 0; background: none; border-radius: 9px; padding: 9px; font-weight: 600; font-size: 14px; color: #6c757d; }
    .mode-switch button.active { background: #fff; color: #cc0000; box-shadow: 0 1px 4px rgba(0,0,0,.12); }

    .login-card .form-control { border-radius: 10px; padding: 11px 14px; }
    .login-card .form-control:focus { border-color: #cc0000; box-shadow: 0 0 0 .2rem rgba(204,0,0,.15); }
    .pin-input { font-size: 28px !important; letter-spacing: .6em; text-align: center; font-family: ui-monospace, monospace; padding-left: .6em !important; }
    .pw-wrap { position: relative; }
    .pw-wrap .form-control { padding-right: 44px; }
    .pw-toggle { position: absolute; right: 6px; top: 50%; transform: translateY(-50%); border: 0; background: none; color: #6c757d; padding: 6px 8px; }

    .who { display: flex; align-items: center; gap: 10px; background: #f8f9fa; border-radius: 12px; padding: 10px 12px; margin-bottom: 14px; }
    .who-avatar { width: 36px; height: 36px; border-radius: 50%; background: #1a1d2e; color: #fff; display: flex; align-items: center; justify-content: center; font-weight: 700; }
    .btn-login { border-radius: 12px; padding: 12px; font-size: 16px; }
    .login-foot { color: rgba(255,255,255,.55); font-size: 12px; text-align: center; margin-top: 16px; }
    .cf-turnstile { display: flex; justify-content: center; margin-bottom: 14px; min-height: 65px; }
  </style>
</head>
<body class="login-page">
  <div class="login-shell">
    <div class="card login-card">
      <div class="brand">
        <div class="brand-mark">SA</div>
        <div>
          <div class="brand-name">SUPER ALLIED</div>
          <div class="brand-sub">Bull Construction Equipment Dealer</div>
        </div>
        <img src="/bull-logo.jpg" alt="Bull" onerror="this.remove()">
      </div>

      <% if (flash.error) { %>
      <div class="alert alert-danger py-2 small d-flex gap-2" role="alert"><i class="bi bi-exclamation-triangle-fill"></i><span><%= flash.error %></span></div>
      <% } %>

      <div class="mode-switch" role="tablist">
        <button type="button" data-mode="pin" role="tab"><i class="bi bi-grid-3x3-gap me-1"></i>PIN</button>
        <button type="button" data-mode="password" role="tab"><i class="bi bi-key me-1"></i>Password</button>
      </div>

      <form method="POST" action="/login" id="loginForm" novalidate>
        <input type="hidden" name="mode" id="mode" value="password">

        <!-- Remembered user (this device) -->
        <div class="who d-none" id="whoBox">
          <div class="who-avatar" id="whoInitial"></div>
          <div class="flex-grow-1 lh-sm">
            <div class="small text-muted">Welcome back</div>
            <div class="fw-semibold" id="whoName"></div>
          </div>
          <button type="button" class="btn btn-link btn-sm text-muted p-0" id="notYou">Not you?</button>
        </div>

        <div class="mb-3" id="userField">
          <label class="form-label fw-semibold small" for="username">Username</label>
          <input type="text" name="username" id="username" class="form-control" autocomplete="username" autocapitalize="none"
                 spellcheck="false" required value="<%= flash.username || '' %>">
        </div>

        <div class="mb-3 d-none" id="pinField">
          <label class="form-label fw-semibold small" for="pin">6-digit PIN</label>
          <input type="password" name="pin" id="pin" class="form-control pin-input" inputmode="numeric" pattern="[0-9]{6}"
                 maxlength="6" autocomplete="one-time-code" placeholder="••••••">
        </div>

        <div class="mb-3" id="pwField">
          <label class="form-label fw-semibold small" for="password">Password</label>
          <div class="pw-wrap">
            <input type="password" name="password" id="password" class="form-control" autocomplete="current-password">
            <button type="button" class="pw-toggle" id="pwToggle" aria-label="Show password"><i class="bi bi-eye"></i></button>
          </div>
        </div>

        <div class="form-check mb-3" id="rememberRow">
          <input class="form-check-input" type="checkbox" id="remember">
          <label class="form-check-label small" for="remember">Remember me on this device</label>
        </div>

        <% if (turnstileSiteKey) { %>
        <div class="cf-turnstile" data-sitekey="<%= turnstileSiteKey %>" data-callback="onCaptcha" data-expired-callback="onCaptchaExpired"></div>
        <% } %>

        <button class="btn btn-danger w-100 fw-bold btn-login" id="submitBtn"><i class="bi bi-box-arrow-in-right me-1"></i>Log in</button>
        <div class="text-center small text-muted mt-3">Forgot your password or PIN? Contact your admin.</div>
      </form>
    </div>
    <div class="login-foot">Super Allied · Meerut</div>
  </div>

<script>
(() => {
  const KEY = 'sa-login';
  const store = {
    get() { try { return JSON.parse(localStorage.getItem(KEY)) || null; } catch (e) { return null; } },
    set(v) { try { localStorage.setItem(KEY, JSON.stringify(v)); } catch (e) {} },
    clear() { try { localStorage.removeItem(KEY); } catch (e) {} },
  };
  const $ = id => document.getElementById(id);
  const captchaOn = <%= turnstileSiteKey ? 'true' : 'false' %>;
  let captchaReady = !captchaOn;

  const saved = store.get();               // { username, mode }
  const flashMode = <%- JSON.stringify(flash.loginMode || null) %>;
  const flashUser = <%- JSON.stringify(flash.username || '').replace(/</g, '\\u003c') %>;
  let mode = flashMode || saved?.mode || 'password';

  function setMode(m) {
    mode = m;
    $('mode').value = m;
    document.querySelectorAll('.mode-switch button').forEach(b => b.classList.toggle('active', b.dataset.mode === m));
    $('pinField').classList.toggle('d-none', m !== 'pin');
    $('pwField').classList.toggle('d-none', m !== 'password');
    $('pin').required = m === 'pin';
    $('password').required = m === 'password';
    focusFirst();
  }
  function focusFirst() {
    const u = $('username');
    if (!u.value) return u.focus();
    (mode === 'pin' ? $('pin') : $('password')).focus();
  }
  function showWho(name) {
    $('whoBox').classList.remove('d-none');
    $('userField').classList.add('d-none');
    $('rememberRow').classList.add('d-none');
    $('whoName').textContent = name;
    $('whoInitial').textContent = name.charAt(0).toUpperCase();
    $('username').value = name;
    $('remember').checked = true;
  }

  if (saved?.username && (!flashUser || flashUser === saved.username)) showWho(saved.username);
  $('notYou').addEventListener('click', () => {
    store.clear();
    $('whoBox').classList.add('d-none');
    $('userField').classList.remove('d-none');
    $('rememberRow').classList.remove('d-none');
    $('username').value = '';
    $('remember').checked = false;
    $('username').focus();
  });
  document.querySelectorAll('.mode-switch button').forEach(b => b.addEventListener('click', () => setMode(b.dataset.mode)));

  $('pwToggle').addEventListener('click', () => {
    const p = $('password'), show = p.type === 'password';
    p.type = show ? 'text' : 'password';
    $('pwToggle').innerHTML = show ? '<i class="bi bi-eye-slash"></i>' : '<i class="bi bi-eye"></i>';
    $('pwToggle').setAttribute('aria-label', show ? 'Hide password' : 'Show password');
  });

  // Digits only; submit automatically once all 6 are in (and the security check is done)
  $('pin').addEventListener('input', e => {
    e.target.value = e.target.value.replace(/\D/g, '').slice(0, 6);
    if (e.target.value.length === 6 && captchaReady && $('username').value.trim()) $('loginForm').requestSubmit();
  });

  $('loginForm').addEventListener('submit', e => {
    const f = e.target;
    if (!f.checkValidity()) { e.preventDefault(); f.reportValidity(); return; }
    if (!captchaReady) { e.preventDefault(); alert('Please complete the security check first.'); return; }
    if ($('remember').checked) store.set({ username: $('username').value.trim(), mode });
    else store.clear();
    $('submitBtn').disabled = true;
    $('submitBtn').innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Logging in…';
  });

  window.onCaptcha = () => { captchaReady = true; };
  window.onCaptchaExpired = () => { captchaReady = false; };

  setMode(mode);
})();
</script>
</body>
</html>
