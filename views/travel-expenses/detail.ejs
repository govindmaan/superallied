<%- include('../partials/head', { title }) %>
<%- include('../partials/sidebar', { active: 'travel-expenses', user }) %>
<div class="main-content">
  <div class="page-header d-flex justify-content-between align-items-center mb-3">
    <div>
      <h4 class="mb-0 fw-bold"><i class="bi bi-truck me-2 text-danger"></i><%= expense.expense_number %></h4>
      <small class="text-muted"><%= owner.full_name %> <% if (owner.employee_code) { %>(<%= owner.employee_code %>)<% } %></small>
    </div>
    <div class="d-flex gap-2 align-items-center">
      <% const badge = { draft:'bg-secondary', submitted:'bg-warning text-dark', approved:'bg-success', rejected:'bg-danger' }; %>
      <span class="badge <%= badge[expense.status] %> fs-6"><%= expense.status.toUpperCase() %></span>
      <% if (locked) { %>
      <span class="badge bg-light text-dark border align-self-center"><i class="bi bi-lock-fill me-1"></i><%= t("Week closed") %><% if (bill) { %> · <a href="/travel-expenses/bills/<%= bill.id %>"><%= bill.bill_no %></a><% } %></span>
      <% } %>
      <% if (isOwner && ['draft','rejected'].includes(expense.status) && !locked) { %>
      <a href="/travel-expenses/<%= expense.id %>/edit" class="btn btn-outline-secondary"><i class="bi bi-pencil me-1"></i><%= t("Edit") %></a>
      <% } %>
      <a href="/travel-expenses/my" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i><%= t("Back") %></a>
    </div>
  </div>

  <% if (flash.success) { %><div class="alert alert-success alert-dismissible"><%= flash.success %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div><% } %>
  <% if (flash.error)   { %><div class="alert alert-danger  alert-dismissible"><%= flash.error   %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div><% } %>

  <div class="row g-3">
    <div class="col-lg-8">
      <div class="card border-0 shadow-sm mb-3">
        <div class="card-header bg-white fw-semibold"><%= t("Trip Details") %></div>
        <div class="card-body">
          <div class="row g-2 small">
            <div class="col-6"><span class="text-muted"><%= t("Date:") %></span> <strong><%= expense.date %></strong></div>
            <div class="col-6"><span class="text-muted"><%= t("Travel Type:") %></span> <strong><%= expense.travel_type %></strong></div>
            <div class="col-6"><span class="text-muted"><%= t("Vehicle Number:") %></span> <strong><%= expense.vehicle_number || '—' %></strong></div>
            <div class="col-6"><span class="text-muted"><%= t("Purpose:") %></span> <strong><%= expense.purpose || '—' %></strong></div>
            <div class="col-6"><span class="text-muted"><%= t("Starting Odometer:") %></span> <strong><%= expense.start_odo %> <%= t("km") %></strong></div>
            <div class="col-6"><span class="text-muted"><%= t("Ending Odometer:") %></span> <strong><%= expense.end_odo %> <%= t("km") %></strong></div>
            <div class="col-6"><span class="text-muted"><%= t("Distance:") %></span> <strong><%= expense.distance_km.toFixed(1) %> <%= t("km") %></strong></div>
            <div class="col-6"><span class="text-muted"><%= t("Rate:") %></span> <strong>₹<%= expense.rate_per_km %><%= t("/km") %></strong></div>
          </div>
          <% if (expense.remarks) { %><hr><div class="small"><span class="text-muted"><%= t("Remarks:") %></span> <%= expense.remarks %></div><% } %>
        </div>
      </div>

      <% if (typeof day !== 'undefined') {
           const proof = [
             ['Check-in selfie', day.att.check_in_photo, day.att.check_in_time],
             ['Start odometer', day.journey.start_photo, day.journey.start_km],
             ['Check-out selfie', day.att.check_out_photo, day.att.check_out_time],
             ['End odometer', day.journey.end_photo, day.journey.end_km],
           ];
           const anyProof = proof.some(p => p[1]); %>
      <% if (anyProof) { %>
      <div class="card border-0 shadow-sm mb-3">
        <div class="card-header bg-white fw-semibold"><%= t("Day proof") %>
          <% if (day.journey.total_km) { %><span class="badge bg-info text-dark ms-1"><%= day.journey.total_km.toFixed(1) %> <%= t("km") %></span><% } %></div>
        <div class="card-body">
          <div class="d-flex flex-wrap gap-3">
            <% proof.forEach(([label, photo, meta]) => { %>
            <div class="text-center" style="width:110px">
              <% if (photo) { %><a href="<%= photo %>" target="_blank"><img src="<%= photo %>" style="width:100px;height:100px;object-fit:cover;border-radius:8px;border:1px solid #ddd"></a>
              <% } else { %><div style="width:100px;height:100px;border-radius:8px;border:1px dashed #ccc;display:flex;align-items:center;justify-content:center" class="text-muted small"><%= t("missing") %></div><% } %>
              <div class="small mt-1"><%= t(label) %><% if (meta && String(meta).match(/^\d+(\.\d+)?$/)) { %> · <%= meta %> km<% } %></div>
            </div>
            <% }) %>
          </div>
        </div>
      </div>
      <% } } %>

      <% if (visits.length) { %>
      <div class="card border-0 shadow-sm mb-3">
        <div class="card-header bg-white fw-semibold"><%= t("Linked Site Visits") %></div>
        <div class="card-body">
          <% visits.forEach(v => { %>
          <div class="small mb-1"><%= t("VIS-") %><%= String(v.id).padStart(5,'0') %> — <strong><%= v.customer_name %></strong> <span class="text-muted"><%= dbTime(v.visit_time).toLocaleString(locale, { dateStyle: 'medium', timeStyle: 'short' }) %></span></div>
          <% }) %>
        </div>
      </div>
      <% } %>

      <div class="card border-0 shadow-sm mb-3">
        <div class="card-header bg-white fw-semibold"><%= t("Receipts / Documents") %></div>
        <div class="card-body">
          <% if (!docs.length) { %><small class="text-muted"><%= t("No documents attached.") %></small><% } %>
          <div class="d-flex flex-wrap gap-3">
            <% docs.forEach(d => { %>
            <div class="text-center" style="width:110px">
              <a href="<%= d.file_path %>" target="_blank"><img src="<%= d.file_path %>" style="width:100px;height:100px;object-fit:cover;border-radius:8px;border:1px solid #ddd"></a>
              <div class="small text-capitalize mt-1"><%= d.doc_type.replace('_',' ') %></div>
            </div>
            <% }) %>
          </div>
        </div>
      </div>

      <% if (expense.status === 'rejected' && expense.approval_remarks) { %>
      <div class="alert alert-danger"><strong><%= t("Rejection reason:") %></strong> <%= expense.approval_remarks %></div>
      <% } %>
      <% if (expense.status === 'approved') { %>
      <div class="alert alert-success">
        <strong><%= t("Approved") %></strong> <%= t("by") %> <%= approver?.full_name || '—' %> <%= t("on") %> <%= new Date(expense.approved_at).toLocaleString('en-IN') %>
        <% if (expense.approval_remarks) { %><br><%= expense.approval_remarks %><% } %>
      </div>
      <% } %>

      <% if (isApprover && expense.status === 'submitted') { %>
      <div class="card border-0 shadow-sm">
        <div class="card-header bg-white fw-semibold"><%= t("Approval Decision") %></div>
        <div class="card-body">
          <textarea id="approvalComment" class="form-control mb-2" rows="2" placeholder="<%= t("Comments (optional for approve, recommended for reject)") %>"></textarea>
          <div class="d-flex gap-2">
            <button class="btn btn-success flex-grow-1" onclick="decide('approve')"><i class="bi bi-check-lg me-1"></i><%= t("Approve") %></button>
            <button class="btn btn-danger flex-grow-1" onclick="decide('reject')"><i class="bi bi-x-lg me-1"></i><%= t("Reject") %></button>
          </div>
        </div>
      </div>
      <% } %>
    </div>

    <div class="col-lg-4">
      <div class="card border-0 shadow-sm mb-3">
        <div class="card-header bg-white fw-semibold"><%= t("Claim Breakdown") %></div>
        <div class="card-body">
          <div class="d-flex justify-content-between small"><span><%= t("Travel (") %><%= expense.distance_km.toFixed(1) %> <%= t("km × ₹") %><%= expense.rate_per_km %>)</span><strong>₹<%= expense.travel_amount.toFixed(0) %></strong></div>
          <hr class="my-2">
          <div class="d-flex justify-content-between"><span class="fw-bold"><%= t("Total Claim") %></span><strong class="text-danger fs-5">₹<%= expense.total_claim.toFixed(0) %></strong></div>
        </div>
      </div>
    </div>
  </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<% if (isApprover && expense.status === 'submitted') { %>
<script>
function decide(action) {
  const comment = document.getElementById('approvalComment').value;
  if (action === 'reject' && !comment.trim()) { if (!confirm(T('Reject without a comment?'))) return; }
  const form = document.createElement('form');
  form.method = 'POST'; form.action = `/travel-expenses/<%= expense.id %>/${action}`;
  const input = document.createElement('input'); input.type = 'hidden'; input.name = 'comment'; input.value = comment;
  form.appendChild(input); document.body.appendChild(form); form.submit();
}
</script>
<% } %>
</body></html>
