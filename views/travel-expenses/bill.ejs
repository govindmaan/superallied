<%- include('../partials/head', { title }) %>
<%- include('../partials/sidebar', { active: 'travel-expenses', user }) %>
<%
  const badge = { draft:'bg-secondary', submitted:'bg-warning text-dark', approved:'bg-success', rejected:'bg-danger' };
  const BILL = { pending: ['bg-warning text-dark', t('Waiting for approval')], approved: ['bg-success', t('Approved')], rejected: ['bg-danger', t('Rejected')] };
  const st = BILL[bill.status] || BILL.pending;
  const dayName = (d) => new Date(d + 'T00:00:00Z').toLocaleDateString(locale, { weekday: 'short', day: 'numeric', month: 'short', timeZone: 'UTC' });
  const inr = (n) => '₹' + Math.round(n || 0).toLocaleString('en-IN');
%>
<div class="main-content">
  <div class="page-header d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
      <h4 class="mb-0 fw-bold"><%= t("Weekly Travel Report") %> <span class="font-monospace text-muted fs-6"><%= bill.bill_no %></span></h4>
      <small class="text-muted"><%= bill.full_name %> · <%= period %></small>
    </div>
    <div class="d-flex gap-2">
      <a href="/travel-expenses/bills<%= isApprover ? '?week=' + bill.week_start : '' %>" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i><%= t("All bills") %></a>
      <a href="/travel-expenses/bills/<%= bill.id %>/pdf" class="btn btn-danger"><i class="bi bi-file-pdf me-1"></i><%= t("PDF") %></a>
    </div>
  </div>

  <% if (flash.success) { %><div class="alert alert-success alert-dismissible"><%= flash.success %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div><% } %>
  <% if (flash.error)   { %><div class="alert alert-danger alert-dismissible"><%= flash.error %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div><% } %>

  <div class="row g-3 mb-3">
    <div class="col-6 col-md-3"><div class="card border-0 shadow-sm h-100"><div class="card-body"><div class="small text-muted"><%= t("Days") %></div><div class="fs-4 fw-bold"><%= days.filter(d => d.trips.length || d.meterKm).length %></div></div></div></div>
    <div class="col-6 col-md-3"><div class="card border-0 shadow-sm h-100"><div class="card-body"><div class="small text-muted"><%= t("Distance") %></div><div class="fs-4 fw-bold"><%= totals.km.toFixed(0) %> <%= t("km") %></div></div></div></div>
    <div class="col-6 col-md-3"><div class="card border-0 shadow-sm h-100"><div class="card-body"><div class="small text-muted"><%= t("Amount") %></div><div class="fs-4 fw-bold text-danger"><%= inr(totals.amount) %></div></div></div></div>
    <div class="col-6 col-md-3"><div class="card border-0 shadow-sm h-100"><div class="card-body"><div class="small text-muted"><%= t("Status") %></div>
      <span class="badge <%= st[0] %> fs-6 mt-1"><%= st[1] %></span>
      <% if (decider) { %><div class="small text-muted mt-1"><%= t("By") %> <%= decider.full_name || decider.username %></div><% } %></div></div></div>
  </div>

  <% if (bill.decision_note && bill.status !== 'pending') { %>
  <div class="alert <%= bill.status === 'rejected' ? 'alert-danger' : 'alert-light border' %> small"><strong><%= t("Note") %>:</strong> <%= bill.decision_note %></div>
  <% } %>

  <% if (isApprover && bill.status !== 'approved') { %>
  <!-- Head of Finance / admin decision -->
  <div class="card border-0 shadow-sm mb-3 border-start border-4 border-warning">
    <div class="card-body">
      <form method="POST" action="/travel-expenses/bills/<%= bill.id %>/decide" class="d-flex flex-wrap gap-2 align-items-center">
        <input type="text" name="note" class="form-control" style="max-width:380px" placeholder="<%= t("Note (required to reject)") %>" aria-label="<%= t("Note") %>">
        <button name="action" value="approve" class="btn btn-success"><i class="bi bi-check-lg me-1"></i><%= t("Approve week") %> · <%= inr(totals.amount) %></button>
        <% if (bill.status === 'pending') { %><button name="action" value="reject" class="btn btn-outline-danger"><i class="bi bi-x-lg me-1"></i><%= t("Reject week") %></button><% } %>
      </form>
      <div class="small text-muted mt-2"><%= t("Check the days marked in yellow. Use the pencil to correct a day's start or end km; the amount is recalculated.") %></div>
    </div>
  </div>
  <% } %>

  <% if (payments.length) { %>
  <div class="alert alert-success d-flex flex-wrap gap-2 align-items-center">
    <i class="bi bi-cash-coin"></i><strong><%= t("Paid ₹") %><%= totals.paid.toLocaleString('en-IN', { maximumFractionDigits: 2 }) %></strong>
    <span class="small">— <%= payments.map(p => `${p.paid_on}${p.mode ? ' · ' + p.mode : ''}${p.reference ? ' · ' + p.reference : ''}`).join('; ') %></span>
  </div>
  <% } %>

  <!-- Day by day -->
  <div class="card border-0 shadow-sm">
    <div class="list-group list-group-flush">
      <% days.forEach(d => { const amount = d.trips.filter(x => x.status !== 'rejected').reduce((a, x) => a + x.total_claim, 0);
           const km = d.trips.filter(x => x.status !== 'rejected').reduce((a, x) => a + x.distance_km, 0); %>
      <div class="list-group-item <%= d.flags.length ? 'bg-warning-subtle' : '' %>">
        <div class="d-flex flex-wrap justify-content-between gap-2">
          <div style="min-width:200px">
            <div class="fw-semibold"><%= dayName(d.date) %></div>
            <div class="small text-muted">
              <%= t("Meter") %>: <%= d.j && d.j.start_km > 0 ? d.j.start_km : '—' %> → <%= d.j && d.j.end_km > 0 ? d.j.end_km : '—' %>
              <% if (d.meterKm !== null) { %> = <strong class="text-dark"><%= d.meterKm.toFixed(0) %> <%= t("km") %></strong><% } %>
              <% if (d.j?.start_photo) { %><a href="<%= d.j.start_photo %>" target="_blank" class="ms-1" title="<%= t("Start odometer") %>"><i class="bi bi-image"></i></a><% } %>
              <% if (d.j?.end_photo) { %><a href="<%= d.j.end_photo %>" target="_blank" class="ms-1" title="<%= t("End odometer") %>"><i class="bi bi-image-fill"></i></a><% } %>
            </div>
            <% if (d.flags.length) { %><div class="small mt-1"><% d.flags.forEach(f => { %><span class="badge text-bg-warning me-1"><%= t(f) %></span><% }) %></div><% } %>
            <% if (d.j?.edit_note) { %><div class="small text-muted"><i class="bi bi-pencil me-1"></i><%= d.j.edit_note %></div><% } %>
          </div>
          <div class="text-end">
            <% if (d.trips.length) { %>
              <div class="fw-bold"><%= inr(amount) %></div>
              <div class="small text-muted"><%= km.toFixed(0) %> <%= t("km") %> × ₹<%= d.trips[0].rate_per_km %></div>
              <% d.trips.forEach(x => { %><a href="/travel-expenses/<%= x.id %>" class="badge <%= badge[x.status] %> text-decoration-none"><%= x.expense_number %> · <%= t(x.status) %></a> <% }) %>
            <% } else { %><span class="small text-muted"><%= t("No claim") %></span><% } %>
            <% if (isApprover && bill.status !== 'approved') { %>
            <div><a href="/travel-expenses/km/<%= bill.user_id %>/<%= d.date %>?back=<%= encodeURIComponent(back) %>" class="btn btn-sm btn-link p-0 mt-1"><i class="bi bi-pencil-square me-1"></i><%= t("Correct km") %></a></div>
            <% } %>
          </div>
        </div>
      </div>
      <% }) %>
      <div class="list-group-item d-flex justify-content-between fw-bold bg-light">
        <span><%= t("Total") %><% if (totals.rejected) { %> <span class="fw-normal small text-muted"><%= t("(excludes") %> <%= totals.rejected %> <%= t("rejected)") %></span><% } %></span>
        <span><%= totals.km.toFixed(0) %> <%= t("km") %> · <%= inr(totals.amount) %></span>
      </div>
    </div>
  </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body></html>
