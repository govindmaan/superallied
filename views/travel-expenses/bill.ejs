<%- include('../partials/head', { title }) %>
<%- include('../partials/sidebar', { active: 'travel-expenses', user }) %>
<% const badge = { draft:'bg-secondary', submitted:'bg-warning text-dark', approved:'bg-success', rejected:'bg-danger' }; %>
<div class="main-content">
  <div class="page-header d-flex justify-content-between align-items-center mb-3">
    <div>
      <h4 class="mb-0 fw-bold"><%= t("Travelling Allowance Bill") %> <span class="font-monospace text-muted fs-6"><%= bill.bill_no %></span></h4>
      <small class="text-muted"><%= bill.full_name %> <%= t("· Week") %> <%= period %></small>
    </div>
    <div class="d-flex gap-2">
      <a href="/travel-expenses/bills" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i><%= t("All bills") %></a>
      <a href="/travel-expenses/bills/<%= bill.id %>/pdf" class="btn btn-danger"><i class="bi bi-file-pdf me-1"></i><%= t("Download PDF") %></a>
    </div>
  </div>

  <div class="row g-3 mb-3">
    <div class="col-6 col-md-3"><div class="card border-0 shadow-sm h-100"><div class="card-body"><div class="small text-muted"><%= t("Trips") %></div><div class="fs-4 fw-bold"><%= trips.length %></div></div></div></div>
    <div class="col-6 col-md-3"><div class="card border-0 shadow-sm h-100"><div class="card-body"><div class="small text-muted"><%= t("Distance") %></div><div class="fs-4 fw-bold"><%= totals.km.toFixed(0) %> <%= t("km") %></div></div></div></div>
    <div class="col-6 col-md-3"><div class="card border-0 shadow-sm h-100"><div class="card-body"><div class="small text-muted"><%= t("Bill amount") %></div><div class="fs-4 fw-bold text-danger">₹<%= totals.amount.toLocaleString('en-IN', { maximumFractionDigits: 0 }) %></div></div></div></div>
    <div class="col-6 col-md-3"><div class="card border-0 shadow-sm h-100"><div class="card-body"><div class="small text-muted"><%= t("Approved so far") %></div><div class="fs-4 fw-bold text-success">₹<%= totals.approved.toLocaleString('en-IN', { maximumFractionDigits: 0 }) %></div>
      <% if (totals.pending) { %><div class="small text-muted"><%= totals.pending %> <%= t("trip") %><%= totals.pending === 1 ? '' : 's' %> <%= t("awaiting approval") %></div><% } %></div></div></div>
  </div>

  <% if (payments.length) { %>
  <div class="alert alert-success d-flex flex-wrap gap-2 align-items-center">
    <i class="bi bi-cash-coin"></i><strong><%= t("Paid ₹") %><%= totals.paid.toLocaleString('en-IN', { maximumFractionDigits: 2 }) %></strong>
    <span class="small">— <%= payments.map(p => `${p.paid_on}${p.mode ? ' · ' + p.mode : ''}${p.reference ? ' · ' + p.reference : ''}`).join('; ') %></span>
  </div>
  <% } %>

  <div class="card border-0 shadow-sm">
    <div class="table-responsive">
      <table class="table table-sm mb-0 align-middle">
        <thead class="table-light"><tr><th><%= t("Date") %></th><th><%= t("Expense #") %></th><th><%= t("Purpose") %></th><th><%= t("Vehicle") %></th><th class="text-end"><%= t("Odometer") %></th><th class="text-end"><%= t("Km") %></th><th class="text-end"><%= t("Rate") %></th><th class="text-end"><%= t("Amount") %></th><th><%= t("Status") %></th></tr></thead>
        <tbody>
          <% trips.forEach(trip => { %>
          <tr class="<%= trip.status === 'rejected' ? 'text-muted text-decoration-line-through' : '' %>">
            <td class="small text-nowrap"><%= fmtD(trip.date) %></td>
            <td><a href="/travel-expenses/<%= trip.id %>" class="font-monospace small text-decoration-none"><%= trip.expense_number %></a></td>
            <td class="small"><%= trip.purpose || '—' %></td>
            <td class="small"><%= trip.travel_type %></td>
            <td class="text-end small text-nowrap"><%= trip.start_odo %> → <%= trip.end_odo %></td>
            <td class="text-end"><%= trip.distance_km.toFixed(1) %></td>
            <td class="text-end small">₹<%= trip.rate_per_km %></td>
            <td class="text-end fw-semibold">₹<%= trip.total_claim.toFixed(0) %></td>
            <td style="text-decoration:none"><span class="badge <%= badge[trip.status] %>"><%= trip.status %></span></td>
          </tr>
          <% }) %>
        </tbody>
        <tfoot class="table-light fw-bold">
          <tr><td colspan="5"><%= t("Total") %><% if (totals.rejected) { %> <span class="fw-normal small text-muted"><%= t("(excludes") %> <%= totals.rejected %> <%= t("rejected)") %></span><% } %></td>
            <td class="text-end"><%= totals.km.toFixed(1) %></td><td></td><td class="text-end">₹<%= totals.amount.toFixed(0) %></td><td></td></tr>
        </tfoot>
      </table>
    </div>
  </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body></html>
