<%- include('../partials/head', { title }) %>
<%- include('../partials/sidebar', { active: 'travel-expenses', user }) %>
<div class="main-content">
  <div class="page-header d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0 fw-bold"><i class="bi bi-sliders me-2 text-danger"></i><%= t("Travel Expense Rate Configuration") %></h4>
    <a href="/travel-expenses/queue" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i><%= t("Back to Approvals") %></a>
  </div>

  <% if (flash.success) { %><div class="alert alert-success alert-dismissible"><%= flash.success %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div><% } %>
  <% if (flash.error)   { %><div class="alert alert-danger  alert-dismissible"><%= flash.error   %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div><% } %>

  <div class="card border-0 shadow-sm" style="max-width:520px">
    <div class="card-header bg-white fw-semibold"><%= t("Reimbursement Rate per Vehicle Type") %></div>
    <div class="card-body">
      <form method="POST" action="/travel-expenses/admin/rates">
        <% rates.forEach(r => { %>
        <div class="row g-2 align-items-center mb-2">
          <div class="col-7">
            <input type="hidden" name="vehicle_type" value="<%= r.vehicle_type %>">
            <label class="form-label fw-semibold mb-0"><%= r.vehicle_type %></label>
          </div>
          <div class="col-5">
            <div class="input-group">
              <span class="input-group-text">₹</span>
              <input type="number" step="0.01" name="rate_per_km" class="form-control" value="<%= r.rate_per_km %>">
              <span class="input-group-text"><%= t("/km") %></span>
            </div>
          </div>
        </div>
        <% }) %>
        <button class="btn btn-danger fw-bold mt-2"><i class="bi bi-check-lg me-1"></i><%= t("Save Rates") %></button>
      </form>
    </div>
  </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body></html>
