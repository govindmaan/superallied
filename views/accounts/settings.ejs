<%- include('_top') %>
<div class="page-header"><h4 class="mb-0 fw-bold"><i class="bi bi-sliders me-2 text-primary"></i><%= t("Accounts Settings") %></h4>
  <small class="text-muted"><%= t("Numbering, approval rules and branches. Business name, address and GSTIN printed on receipts come from") %> <a href="/settings"><%= t("Settings") %></a>.</small></div>
<div class="row g-3">
<form method="POST" action="/accounts/settings" class="col-lg-7"><div class="card border-0 shadow-sm p-3">
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <div class="row g-3">
    <div class="col-md-6"><label class="form-label"><%= t("Receipt number prefix") %></label><input name="acc_receipt_prefix" value="<%= s.acc_receipt_prefix %>" class="form-control" maxlength="20">
      <div class="form-text"><%= t("Numbers look like") %> <b><%= s.acc_receipt_prefix %>/<%= today.slice(2, 4) %>-..../0001</b> <%= t("and restart each financial year (April).") %></div></div>
    <div class="col-md-6"><label class="form-label"><%= t("Cancellation document prefix") %></label><input name="acc_cancel_prefix" value="<%= s.acc_cancel_prefix %>" class="form-control" maxlength="20"></div>
    <div class="col-12"><div class="form-check form-switch"><input class="form-check-input" type="checkbox" name="acc_cancel_needs_approval" value="1" id="ap" <%= s.acc_cancel_needs_approval !== '0' ? 'checked' : '' %>>
      <label class="form-check-label" for="ap"><%= t("Receipt cancellations by an accountant need accounts-manager approval") %></label></div></div>
    <div class="col-md-6"><label class="form-label"><%= t("Flag challans without invoice after (days)") %></label><input name="acc_challan_invoice_days" value="<%= s.acc_challan_invoice_days %>" class="form-control" inputmode="numeric"></div>
    <div class="col-md-6"><label class="form-label"><%= t("Default invoice due (days after invoice date)") %></label><input name="acc_default_due_days" value="<%= s.acc_default_due_days %>" class="form-control" inputmode="numeric"></div>
    <div class="col-md-6"><label class="form-label"><%= t("Max upload size (MB, 1–15)") %></label><input name="acc_max_upload_mb" value="<%= s.acc_max_upload_mb %>" class="form-control" inputmode="numeric"></div>
    <div class="col-md-6"><label class="form-label"><%= t("Branches (comma separated)") %></label><input name="acc_branches" value="<%= s.acc_branches %>" class="form-control"></div>
  </div>
  <button class="btn btn-primary mt-3"><%= t("Save") %></button>
</div></form>
<div class="col-lg-5"><div class="card border-0 shadow-sm p-3 small">
  <h6 class="fw-bold"><%= t("Who can do what") %></h6>
  <table class="table table-sm mb-2"><tbody>
    <tr><td><b><%= t("Accountant") %></b></td><td><%= t("Upload/edit unverified invoices, record payments & receipts, allocate, request cancellations & adjustments, reports.") %></td></tr>
    <tr><td><b><%= t("Accounts manager") %></b></td><td><%= t("Everything an accountant can, plus verify invoices & payments, approve cancellations, adjustments and reversals.") %></td></tr>
    <tr><td><b><%= t("Manager") %></b></td><td><%= t("Read-only dashboards, registers, reports and audit log.") %></td></tr>
    <tr><td><b><%= t("Sales / office") %></b></td><td><%= t("Read-only: their own customers’ invoices, receipts and balances.") %></td></tr>
    <tr><td><b><%= t("Admin") %></b></td><td><%= t("Everything, plus these settings.") %></td></tr></tbody></table>
  <div class="text-muted"><%= t("Current accounts permissions by role:") %></div>
  <ul class="mb-0"><% perms.forEach(p => { %><li><b><%= p.role %></b>: <%= p.p %></li><% }) %></ul>
  <div class="text-muted mt-2"><%= t("Give someone a role in") %> <a href="/users"><%= t("Users") %></a> <%= t("or HR → Employees. Permissions are enforced on the server for every action.") %></div>
</div></div>
</div>
<%- include('_bottom') %>
