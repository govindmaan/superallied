<dl class="row mb-0 small">
  <dt class="col-5"><%= t("Customer") %></dt><dd class="col-7"><a href="/accounts/customers/<%= i.customer_id %>"><%= i.customer_name %></a> <span class="text-muted"><%= t("ID") %> <%= i.customer_id %></span></dd>
  <dt class="col-5"><%= t("Document") %></dt><dd class="col-7"><%= DOC_TYPES[i.doc_type] %> <span class="docno"><%= i.invoice_number %></span> <%= t("· FY") %> <%= i.financial_year %></dd>
  <dt class="col-5"><%= t("Invoice date") %></dt><dd class="col-7"><%= i.invoice_date %></dd>
  <dt class="col-5"><%= t("GSTIN on invoice") %></dt><dd class="col-7"><%= i.customer_gstin || '—' %> <span class="text-muted"><%= t("(master:") %> <%= i.master_gstin || '—' %>)</span></dd>
  <dt class="col-5"><%= t("Basic / taxable value") %></dt><dd class="col-7 num text-start"><%= inr(i.basic_value) %></dd>
  <dt class="col-5"><%= t("GST") %></dt><dd class="col-7"><%= inr(i.gst_amount) %></dd>
  <dt class="col-5"><%= t("Total") %></dt><dd class="col-7 fw-bold"><%= inr(i.total_amount) %></dd>
  <dt class="col-5"><%= t("Due date / terms") %></dt><dd class="col-7"><%= i.due_date || '—' %> · <%= i.payment_terms || '—' %></dd>
  <dt class="col-5"><%= t("Quotation") %></dt><dd class="col-7"><%- i.quotation_number ? `<a href="/quotations/${i.quotation_id}">${i.quotation_number}</a>` : '—' %></dd>
  <dt class="col-5"><%= t("Delivery challan(s)") %></dt><dd class="col-7"><%- i.challans.length ? i.challans.map(ch => `<a href="/accounts/challans/${ch.id}">${ch.challan_number}</a>`).join(', ') : (i.challan_expected ? 'None linked' : 'Not expected') %></dd>
  <% if (i.against_invoice_id) { %><dt class="col-5"><%= t("Against invoice") %></dt><dd class="col-7"><a href="/accounts/invoices/<%= i.against_invoice_id %>"><%= i.against_number %></a></dd><% } %>
  <dt class="col-5"><%= t("Machine / equipment") %></dt><dd class="col-7"><%= i.machine_details || '—' %></dd>
  <dt class="col-5"><%= t("Salesperson / branch") %></dt><dd class="col-7"><%= i.salesperson_name || '—' %> / <%= i.branch || '—' %></dd>
  <dt class="col-5"><%= t("Remarks") %></dt><dd class="col-7"><%= i.remarks || '—' %></dd>
</dl>
