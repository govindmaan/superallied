<!DOCTYPE html><html><head><meta charset="utf-8"><title>Statement — <%= c.name %></title>
<style>body { font-family: Arial, sans-serif; font-size: 11px; color: #111; margin: 0; } h1 { font-size: 16px; margin: 0 0 2px; color: #cc0000; } .sub { color: #444; margin-bottom: 8px; }
table { width: 100%; border-collapse: collapse; } th, td { border: 1px solid #ccc; padding: 4px 6px; text-align: left; } th { background: #f1f1f1; } .r { text-align: right; white-space: nowrap; }
tfoot td, .open td { font-weight: bold; background: #f8f8f8; } thead { display: table-header-group; } tr { page-break-inside: avoid; } .note { font-size: 9.5px; color: #555; margin-top: 8px; }</style></head>
<body>
<% const drcr = (p) => money(Math.abs(p)) + (p > 0 ? ' Dr' : p < 0 ? ' Cr' : ''); %>
<h1>Statement of Account</h1>
<div class="sub"><b><%= c.name %></b> (Customer ID <%= c.id %>)<%= c.gstin ? ' · GSTIN ' + c.gstin : '' %><br><%= [c.address, c.city, c.state].filter(Boolean).join(', ') %><br>
  Period: <%= from || 'beginning' %> to <%= to || 'today' %> · issued by <%= s.company_name %> (GSTIN <%= s.company_gstin %>)</div>
<table><thead><tr><th>Date</th><th>Document</th><th>Description</th><th class="r">Debit (₹)</th><th class="r">Credit (₹)</th><th class="r">Balance (₹)</th></tr></thead>
<tbody><tr class="open"><td></td><td></td><td>Opening balance</td><td></td><td></td><td class="r"><%= drcr(led.opening) %></td></tr>
<% led.rows.forEach(r => { %><tr><td><%= r.date %></td><td><%= r.doc %></td><td><%= r.description %></td><td class="r"><%= r.debit ? money(r.debit) : '' %></td><td class="r"><%= r.credit ? money(r.credit) : '' %></td><td class="r"><%= drcr(r.balance) %></td></tr><% }) %></tbody>
<tfoot><tr><td colspan="3">Totals / closing balance</td><td class="r"><%= money(led.totals.debit) %></td><td class="r"><%= money(led.totals.credit) %></td><td class="r"><%= drcr(led.closing) %></td></tr></tfoot></table>
<div class="note">Debit = Tally invoices / debit notes and reversed receipts; Credit = payments received, credit notes and approved adjustments. Dr balance = amount due from you; Cr balance = advance held for you.
  Tally is the books of account; this statement lists Tally documents uploaded and receipts issued by <%= s.company_name %>.</div>
</body></html>
