<%- include('_top') %>
<% const r = (p) => p == null ? '' : (p / 100).toFixed(2); const linked = i.challans.map(c => c.id); %>
<div class="page-header"><h4 class="mb-0 fw-bold"><i class="bi bi-pencil me-2 text-primary"></i><%= t("Edit") %> <%= DOC_TYPES[i.doc_type] %> <span class="docno"><%= i.invoice_number %></span></h4>
  <small class="text-muted"><%= i.status === 'draft' ? t('Draft — not yet confirmed.') : t('Every change is recorded with before/after values. Changes to amounts, dates or the number need a reason.') %>
  <%= t("To change the file, use “Replace file” on the invoice page.") %></small></div>
<form method="POST" action="/accounts/invoices/<%= i.id %>" class="card border-0 shadow-sm p-3" style="max-width:960px">
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <div class="row g-3">
    <div class="col-md-6"><label class="form-label"><%= t("Customer") %></label>
      <select name="customer_id" id="customer" class="form-select" data-search <%= i.allocated_amount ? 'disabled' : '' %>>
        <% customers.forEach(c => { %><option value="<%= c.id %>" <%= c.id === i.customer_id ? 'selected' : '' %>><%= c.name %><%= c.phone ? ' · ' + c.phone : '' %></option><% }) %></select>
      <% if (i.allocated_amount) { %><input type="hidden" name="customer_id" value="<%= i.customer_id %>"><div class="form-text"><%= t("Has allocations — customer cannot change.") %></div><% } %></div>
    <div class="col-md-3"><label class="form-label"><%= t("Document type") %></label>
      <select name="doc_type" class="form-select" <%= i.allocated_amount ? 'disabled' : '' %>><% Object.entries(DOC_TYPES).forEach(([k, v]) => { %><option value="<%= k %>" <%= k === i.doc_type ? 'selected' : '' %>><%= v %></option><% }) %></select>
      <% if (i.allocated_amount) { %><input type="hidden" name="doc_type" value="<%= i.doc_type %>"><% } %></div>
    <div class="col-md-3"><label class="form-label"><%= t("Tally number") %></label><input name="invoice_number" class="form-control" value="<%= i.invoice_number %>" required></div>
    <div class="col-md-6"><label class="form-label"><%= t("Linked quotation") %></label><select name="quotation_id" id="quotation" class="form-select"><option value=""><%= t("None") %></option></select></div>
    <div class="col-md-6"><label class="form-label"><%= t("Against original invoice (notes)") %></label><select name="against_invoice_id" id="against" class="form-select"><option value=""><%= t("None") %></option></select></div>
    <div class="col-12"><label class="form-label"><%= t("Delivery challan(s)") %></label><div id="challans" class="border rounded p-2 small"><%= t("Loading…") %></div></div>
    <div class="col-md-3"><label class="form-label"><%= t("Invoice date") %></label><input type="date" name="invoice_date" class="form-control" value="<%= i.invoice_date %>" max="<%= today %>" required></div>
    <div class="col-md-3"><label class="form-label"><%= t("Due date") %></label><input type="date" name="due_date" class="form-control" value="<%= i.due_date || '' %>"></div>
    <div class="col-md-6"><label class="form-label"><%= t("Payment terms") %></label><input name="payment_terms" class="form-control" value="<%= i.payment_terms %>"></div>
    <div class="col-md-3"><label class="form-label"><%= t("Basic value ₹") %></label><input name="basic_value" class="form-control" value="<%= r(i.basic_value) %>" required></div>
    <div class="col-md-3"><label class="form-label"><%= t("GST ₹") %></label><input name="gst_amount" class="form-control" value="<%= r(i.gst_amount) %>" required></div>
    <div class="col-md-3"><label class="form-label"><%= t("Total ₹") %></label><input name="total_amount" class="form-control fw-bold" value="<%= r(i.total_amount) %>" required>
      <% if (i.allocated_amount) { %><div class="form-text"><%= t("Not below") %> <%= inr(i.allocated_amount) %> <%= t("already allocated.") %></div><% } %></div>
    <div class="col-md-3"><label class="form-label"><%= t("GSTIN on invoice") %></label><input name="customer_gstin" class="form-control text-uppercase" value="<%= i.customer_gstin %>" maxlength="15"></div>
    <div class="col-12"><label class="form-label"><%= t("Machine / equipment") %></label><input name="machine_details" class="form-control" value="<%= i.machine_details %>"></div>
    <div class="col-md-4"><label class="form-label"><%= t("Salesperson") %></label><select name="salesperson_id" class="form-select"><option value="">—</option><% salespersons.forEach(s => { %><option value="<%= s.id %>" <%= s.id === i.salesperson_id ? 'selected' : '' %>><%= s.name %></option><% }) %></select></div>
    <div class="col-md-4"><label class="form-label"><%= t("Branch") %></label><select name="branch" class="form-select"><% [...new Set([i.branch, ...branches].filter(Boolean))].forEach(b => { %><option <%= b === i.branch ? 'selected' : '' %>><%= b %></option><% }) %></select></div>
    <div class="col-md-4"><label class="form-label"><%= t("Challan expected?") %></label><select name="challan_expected" class="form-select"><option value="1"><%= t("Yes") %></option><option value="0" <%= i.challan_expected ? '' : 'selected' %>><%= t("No") %></option></select></div>
    <div class="col-12"><label class="form-label"><%= t("Remarks") %></label><textarea name="remarks" class="form-control" rows="2"><%= i.remarks %></textarea></div>
    <% if (i.status !== 'draft') { %><div class="col-12"><label class="form-label"><%= t("Reason for change") %></label><input name="change_reason" class="form-control" placeholder="<%= t("Required when amounts, dates, number, type or customer change") %>"></div><% } %>
  </div>
  <div class="mt-3 d-flex gap-2"><button class="btn btn-primary"><%= t("Save changes") %></button><a class="btn btn-outline-secondary" href="/accounts/invoices/<%= i.id %>"><%= t("Cancel") %></a></div>
</form>
<%- include('_bottom') %>
<script>
const linked = <%- JSON.stringify(linked) %>, curQ = '<%= i.quotation_id || '' %>', curA = '<%= i.against_invoice_id || '' %>';
async function load() {
  const cid = document.getElementById('customer').value;
  const j = await (await fetch('/accounts/api/customers/' + cid + '/docs')).json();
  const q = document.getElementById('quotation'), a = document.getElementById('against');
  j.quotations.forEach(x => q.add(new Option(`${x.quotation_number} · ${x.machine} · ${SA.money(x.value)}`, x.id, false, String(x.id) === curQ)));
  j.invoices.filter(x => x.id !== <%= i.id %>).forEach(x => a.add(new Option(`${x.invoice_number} · ${x.invoice_date}`, x.id, false, String(x.id) === curA)));
  document.getElementById('challans').innerHTML = '<input type="hidden" name="challans_loaded" value="1">' + (j.challans.map(ch => `<label class="d-block"><input type="checkbox" name="challan_ids" value="${ch.id}" class="form-check-input me-1" ${linked.includes(ch.id) ? 'checked' : ''}>
    <b>${SA.esc(ch.challan_number)}</b> · ${ch.challan_date} · ${SA.esc(ch.machine || '')}</label>`).join('') || '<span class="text-muted">No challans for this customer.</span>');
}
document.getElementById('customer').addEventListener('change', () => { document.getElementById('quotation').length = 1; document.getElementById('against').length = 1; load(); });
load();
</script>
