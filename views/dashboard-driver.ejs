<%- include('partials/head', { title }) %>
<%- include('partials/sidebar', { active: 'dashboard', user }) %>

<div class="main-content drv-dash">

  <!-- Header -->
  <div class="drv-header">
    <div class="d-flex align-items-center gap-3">
      <% if (emp.photo_path) { %>
        <img src="<%= emp.photo_path %>" class="drv-avatar" alt="">
      <% } else { %>
        <div class="drv-avatar-fb"><%= (emp.full_name||'U').charAt(0).toUpperCase() %></div>
      <% } %>
      <div>
        <div class="drv-hello">Good <%= new Date().getHours()<12?'Morning':new Date().getHours()<17?'Afternoon':'Evening' %> 👋</div>
        <div class="drv-name"><%= emp.full_name || emp.username %></div>
        <div class="drv-sub"><%= new Date(today).toLocaleDateString('en-IN',{weekday:'long',day:'numeric',month:'long'}) %></div>
      </div>
    </div>
    <div class="mt-3">
      <% if (todayAtt?.check_out_time) { %>
        <span class="att-pill att-done"><i class="bi bi-check-circle-fill me-1"></i>Day Complete</span>
      <% } else if (todayAtt?.check_in_time) { %>
        <span class="att-pill att-in"><i class="bi bi-dot me-1" style="font-size:1.4rem;line-height:0"></i>Checked In · <%= new Date(todayAtt.check_in_time).toLocaleTimeString('en-IN',{hour:'2-digit',minute:'2-digit'}) %></span>
      <% } else { %>
        <span class="att-pill att-out"><i class="bi bi-exclamation-circle me-1"></i>Not Checked In</span>
      <% } %>
    </div>
  </div>

  <!-- Attendance card -->
  <div class="card border-0 shadow-sm mb-3">
    <div class="card-body p-3">
      <div class="fw-bold mb-3"><i class="bi bi-calendar-check-fill me-2 text-success"></i>Today's Attendance</div>
      <% if (todayAtt?.check_in_time) { %>
        <div class="att-row mb-2">
          <span class="text-muted small">Check In</span>
          <span class="fw-semibold"><%= new Date(todayAtt.check_in_time).toLocaleTimeString('en-IN',{hour:'2-digit',minute:'2-digit'}) %></span>
        </div>
        <% if (todayAtt.check_out_time) { %>
        <div class="att-row mb-3">
          <span class="text-muted small">Check Out</span>
          <span class="fw-semibold"><%= new Date(todayAtt.check_out_time).toLocaleTimeString('en-IN',{hour:'2-digit',minute:'2-digit'}) %></span>
        </div>
        <% } else { %>
        <a href="/attendance" class="btn btn-warning w-100 fw-bold mb-1">
          <i class="bi bi-box-arrow-right me-1"></i>Check Out
        </a>
        <% } %>
      <% } else { %>
        <a href="/attendance" class="btn btn-success w-100 fw-bold mb-1">
          <i class="bi bi-box-arrow-in-right me-1"></i>Check In Now
        </a>
      <% } %>
      <a href="/attendance" class="btn btn-outline-secondary btn-sm w-100 mt-2">View Attendance History</a>
    </div>
  </div>

  <!-- Expense card -->
  <div class="card border-0 shadow-sm mb-3">
    <div class="card-body p-3">
      <div class="d-flex justify-content-between align-items-center mb-3">
        <div class="fw-bold"><i class="bi bi-truck me-2 text-warning"></i>Travel Expenses</div>
        <span class="text-muted small">₹<%= parseFloat(monthClaim||0).toFixed(0) %> this month</span>
      </div>
      <a href="/travel-expenses/new" class="btn btn-primary w-100 fw-bold mb-2">
        <i class="bi bi-plus-circle me-1"></i>New Expense Claim
      </a>
      <% if (recentExpenses.length) { %>
        <div class="mt-2">
          <% recentExpenses.forEach(e => {
               const sc = e.status==='approved'?'text-success':e.status==='rejected'?'text-danger':'text-warning';
          %> %>
          <a href="/travel-expenses/<%= e.id %>" class="list-group-item list-group-item-action py-2 px-0 border-0 border-bottom d-flex justify-content-between align-items-center text-decoration-none text-dark">
            <div>
              <div class="small fw-semibold"><%= e.purpose||'Expense' %></div>
              <div class="text-muted" style="font-size:11px"><%= new Date(e.claim_date).toLocaleDateString('en-IN',{day:'numeric',month:'short'}) %></div>
            </div>
            <div class="text-end">
              <div class="small fw-bold">₹<%= parseFloat(e.total_amount||0).toFixed(0) %></div>
              <div class="<%= sc %>" style="font-size:11px;text-transform:capitalize"><%= e.status||'draft' %></div>
            </div>
          </a>
          <% }) %>
        </div>
      <% } %>
      <a href="/travel-expenses/my" class="btn btn-outline-secondary btn-sm w-100 mt-2">View All Claims</a>
    </div>
  </div>

  <!-- Leaves & Salary tiles -->
  <div class="row g-3">
    <div class="col-6">
      <a href="/leaves" class="tile-sm">
        <i class="bi bi-calendar-x-fill text-danger fs-4"></i>
        <div class="tile-sm-label">My Leaves</div>
        <div class="tile-sm-sub"><%= pendingLeaves>0?pendingLeaves+' pending':'Apply leave' %></div>
      </a>
    </div>
    <div class="col-6">
      <a href="/salary" class="tile-sm">
        <i class="bi bi-cash-coin text-success fs-4"></i>
        <div class="tile-sm-label">My Salary</div>
        <div class="tile-sm-sub">View slips</div>
      </a>
    </div>
  </div>

</div>

<style>
.drv-header { background:linear-gradient(135deg,#1a3a2e 0%,#2d5540 100%); border-radius:16px; padding:20px; color:#fff; margin-bottom:16px; }
.drv-avatar    { width:56px;height:56px;border-radius:50%;object-fit:cover;border:3px solid rgba(255,255,255,.4);flex-shrink:0; }
.drv-avatar-fb { width:56px;height:56px;border-radius:50%;background:#198754;display:flex;align-items:center;justify-content:center;font-size:1.6rem;font-weight:900;flex-shrink:0; }
.drv-hello { font-size:13px;opacity:.7; }
.drv-name  { font-size:19px;font-weight:800;line-height:1.2; }
.drv-sub   { font-size:12px;opacity:.65;margin-top:2px; }
.att-pill  { display:inline-flex;align-items:center;border-radius:20px;padding:4px 14px;font-size:13px;font-weight:600; }
.att-done  { background:rgba(40,167,69,.2);color:#7dffa9; }
.att-in    { background:rgba(255,193,7,.2);color:#ffe066; }
.att-out   { background:rgba(220,53,69,.2);color:#ff8a94; }
.att-row   { display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid #f0f0f0;padding-bottom:8px; }
.tile-sm   { background:#fff;border-radius:14px;padding:16px;display:flex;flex-direction:column;align-items:center;text-align:center;text-decoration:none;color:#1a1d2e;box-shadow:0 2px 10px rgba(0,0,0,.08);min-height:90px;justify-content:center;gap:4px; }
.tile-sm:hover { transform:translateY(-2px);box-shadow:0 6px 18px rgba(0,0,0,.12);color:#1a1d2e; }
.tile-sm-label { font-size:13px;font-weight:700; }
.tile-sm-sub   { font-size:11px;color:#888; }
</style>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body></html>
