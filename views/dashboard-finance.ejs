<%- include('partials/head', { title }) %>
<%- include('partials/sidebar', { active: 'home', user }) %>
<div class="main-content" style="max-width:820px">
  <% if (flash.success) { %><div class="alert alert-success alert-dismissible"><%= flash.success %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div><% } %>
  <% if (flash.error) { %><div class="alert alert-danger alert-dismissible"><%= flash.error %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div><% } %>

  <div class="mb-3">
    <h4 class="fw-bold mb-0"><i class="bi bi-cash-coin text-primary me-2"></i><%= t("Finance") %></h4>
    <div class="text-muted small"><%= user.full_name || user.username %> · <%= t("Head of Finance") %></div>
  </div>

  <div class="row g-2 mb-3">
    <div class="col-6 col-md-3">
      <a href="/travel-expenses/queue" class="text-decoration-none">
        <div class="card border-0 shadow-sm h-100 text-center"><div class="card-body p-2">
          <i class="bi bi-inbox-fill text-warning fs-4"></i>
          <div class="fw-bold fs-4 lh-1"><%= pendingExpenses %></div>
          <div class="text-muted" style="font-size:11px"><%= t("Pending approvals") %></div>
        </div></div>
      </a>
    </div>
    <div class="col-6 col-md-3">
      <div class="card border-0 shadow-sm h-100 text-center"><div class="card-body p-2">
        <i class="bi bi-currency-rupee text-danger fs-4"></i>
        <div class="fw-bold fs-5 lh-1">₹<%= formatINR(Math.round(pendingAmount)) %></div>
        <div class="text-muted" style="font-size:11px"><%= t("Awaiting approval") %></div>
      </div></div>
    </div>
    <div class="col-6 col-md-3">
      <div class="card border-0 shadow-sm h-100 text-center"><div class="card-body p-2">
        <i class="bi bi-check2-circle text-success fs-4"></i>
        <div class="fw-bold fs-4 lh-1"><%= approvedToday %></div>
        <div class="text-muted" style="font-size:11px"><%= t("Approved today") %></div>
      </div></div>
    </div>
    <div class="col-6 col-md-3">
      <a href="/attendance" class="text-decoration-none">
        <div class="card border-0 shadow-sm h-100 text-center"><div class="card-body p-2">
          <i class="bi bi-people-fill text-info fs-4"></i>
          <div class="fw-bold fs-4 lh-1"><%= present %>/<%= staff %></div>
          <div class="text-muted" style="font-size:11px"><%= t("Present today") %><% if (stillOut) { %> · <%= stillOut %> <%= t("out") %><% } %></div>
        </div></div>
      </a>
    </div>
  </div>

  <a href="/travel-expenses/queue" class="btn btn-primary btn-lg w-100 py-3 shadow-sm mb-3">
    <i class="bi bi-inbox-fill me-2"></i><%= t("Expense Approvals") %><% if (pendingExpenses) { %> <span class="badge bg-light text-dark"><%= pendingExpenses %></span><% } %>
  </a>

  <div class="d-flex gap-2 mb-3">
    <a href="/attendance" class="btn btn-outline-secondary flex-fill"><i class="bi bi-calendar-check me-1"></i><%= t("Attendance") %></a>
    <a href="/route-map" class="btn btn-outline-secondary flex-fill"><i class="bi bi-map me-1"></i><%= t("Route Map") %></a>
    <a href="/route-map/heatmap" class="btn btn-outline-secondary flex-fill"><i class="bi bi-fire me-1"></i><%= t("Heatmap") %></a>
  </div>

  <div class="card border-0 shadow-sm">
    <div class="card-header bg-white fw-semibold"><%= t("Expenses waiting for you") %></div>
    <% if (!recent.length) { %><div class="card-body text-muted small"><%= t("Nothing pending. All caught up.") %></div><% } %>
    <ul class="list-group list-group-flush">
      <% recent.forEach(e => { %>
      <a href="/travel-expenses/<%= e.id %>" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
        <span><span class="fw-semibold"><%= e.full_name %></span> <span class="text-muted small"><%= e.expense_number %><% if (e.department) { %> · <%= e.department %><% } %></span></span>
        <span class="fw-semibold">₹<%= formatINR(Math.round(e.total_claim)) %></span>
      </a>
      <% }) %>
    </ul>
  </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body></html>
