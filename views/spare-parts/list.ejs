<%- include('../partials/head', { title }) %>
<%- include('../partials/sidebar', { active: 'spare-parts', user }) %>
<div class="main-content">
  <div class="page-header d-flex justify-content-between align-items-center mb-4">
    <div>
      <h4 class="mb-0 fw-bold"><i class="bi bi-box-seam me-2 text-warning"></i>Spare Parts Master</h4>
      <small class="text-muted"><%= total %> parts in catalog<% if (priceDate) { %> · price list dated <%= new Date(priceDate + 'T00:00:00').toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' }) %><% } %></small>
    </div>
    <div class="d-flex gap-2">
      <a href="/spare-parts/export/sample" class="btn btn-outline-secondary btn-sm"><i class="bi bi-download me-1"></i>Sample Excel</a>
      <a href="/spare-parts/export/csv" class="btn btn-outline-info btn-sm"><i class="bi bi-filetype-csv me-1"></i>Export CSV</a>
      <button class="btn btn-outline-success btn-sm" onclick="document.getElementById('importModal').style.display='flex'">
        <i class="bi bi-upload me-1"></i>Import Excel
      </button>
      <% if (user && user.role === 'admin') { %>
      <form method="POST" action="/spare-parts/delete-all" class="d-inline"
        onsubmit="return confirm('DELETE ALL <%= total %> PARTS? This cannot be undone.')">
        <button class="btn btn-danger btn-sm"><i class="bi bi-trash3-fill me-1"></i>Delete All</button>
      </form>
      <% } %>
      <button class="btn btn-warning text-dark btn-sm" onclick="document.getElementById('addPartModal').style.display='flex'">
        <i class="bi bi-plus-lg me-1"></i>Add Part
      </button>
    </div>
  </div>

  <% if (flash.success) { %><div class="alert alert-success alert-dismissible"><%= flash.success %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div><% } %>
  <% if (flash.error) { %><div class="alert alert-danger alert-dismissible"><%= flash.error %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div><% } %>

  <div class="card border-0 shadow-sm mb-3">
    <div class="card-body py-2">
      <form method="get" class="d-flex gap-2">
        <input name="q" value="<%= q %>" class="form-control" placeholder="Search by SAP No, RND No, Description…" style="max-width:400px">
        <button class="btn btn-outline-secondary">Search</button>
        <% if (q) { %><a href="/spare-parts" class="btn btn-outline-secondary">Clear</a><% } %>
      </form>
    </div>
  </div>

  <div class="card border-0 shadow-sm">
    <div class="table-responsive">
      <table class="table table-hover mb-0 align-middle small">
        <thead class="table-light">
          <tr>
            <th>SAP Part No.</th>
            <th>RND Part No.</th>
            <th>Description</th>
            <th>HSN</th>
            <th class="text-end">NDP (Basic)</th>
            <th class="text-end">MRP (Basic)</th>
            <th class="text-end">MRP (With Tax)</th>
            <th class="text-center">Tax %</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% if (parts.length === 0) { %>
          <tr><td colspan="9" class="text-center text-muted py-4">
            No parts found. <button class="btn btn-sm btn-warning" onclick="document.getElementById('importModal').style.display='flex'">Import from Excel</button>
          </td></tr>
          <% } %>
          <% parts.forEach(p => { %>
          <tr>
            <td><code class="text-dark"><%= p.sap_part_no || '—' %></code></td>
            <td><code class="text-secondary"><%= p.rnd_part_no || '—' %></code></td>
            <td class="fw-semibold" style="max-width:250px"><%= p.material_description %></td>
            <td><%= p.hsn_code || '—' %></td>
            <td class="text-end">₹<%= Number(p.ndp_basic).toFixed(2) %></td>
            <td class="text-end">₹<%= Number(p.mrp_basic).toFixed(2) %></td>
            <td class="text-end fw-semibold">₹<%= Number(p.mrp_price).toFixed(2) %></td>
            <td class="text-center"><%= p.tax_rate %>%</td>
            <td>
              <button class="btn btn-sm btn-outline-secondary" onclick="openEdit(<%= JSON.stringify(p).replace(/'/g,"&#39;") %>)" title="Edit"><i class="bi bi-pencil"></i></button>
              <form method="post" action="/spare-parts/<%= p.id %>/delete" style="display:inline" onsubmit="return confirm('Delete this part?')">
                <button class="btn btn-sm btn-outline-danger" title="Delete"><i class="bi bi-trash"></i></button>
              </form>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <% if (q && parts.length === 200) { %>
    <div class="card-footer text-muted small">Showing first 200 results. Refine your search.</div>
    <% } %>
  </div>
</div>

<!-- Add Part Modal -->
<div id="addPartModal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.5);z-index:9999;align-items:center;justify-content:center;overflow-y:auto">
  <div class="card border-0 shadow-lg my-3" style="width:640px;max-width:95vw">
    <div class="card-header d-flex justify-content-between align-items-center">
      <span class="fw-semibold" id="modalTitle">Add New Part</span>
      <button class="btn btn-sm btn-outline-secondary" onclick="closeModals()">✕</button>
    </div>
    <form method="post" id="partForm" action="/spare-parts">
      <input type="hidden" name="_method" id="partMethod">
      <div class="card-body">
        <div class="row g-2">
          <div class="col-md-6">
            <label class="form-label small fw-semibold">SAP Part No.</label>
            <input name="sap_part_no" id="f_sap" class="form-control form-control-sm">
          </div>
          <div class="col-md-6">
            <label class="form-label small fw-semibold">RND Part No.</label>
            <input name="rnd_part_no" id="f_rnd" class="form-control form-control-sm">
          </div>
          <div class="col-12">
            <label class="form-label small fw-semibold">Material Description <span class="text-danger">*</span></label>
            <input name="material_description" id="f_desc" class="form-control form-control-sm" required>
          </div>
          <div class="col-md-4">
            <label class="form-label small fw-semibold">HSN Code</label>
            <input name="hsn_code" id="f_hsn" class="form-control form-control-sm">
          </div>
          <div class="col-md-4">
            <label class="form-label small fw-semibold">Tax Rate %</label>
            <select name="tax_rate" id="f_tax" class="form-select form-select-sm">
              <option value="5">5%</option>
              <option value="12">12%</option>
              <option value="18" selected>18%</option>
              <option value="28">28%</option>
            </select>
          </div>
          <div class="col-12"><hr class="my-1"></div>
          <div class="col-md-4">
            <label class="form-label small fw-semibold">NDP Basic</label>
            <input name="ndp_basic" id="f_ndp_basic" type="number" step="0.01" class="form-control form-control-sm" value="0" oninput="calcModal()">
          </div>
          <div class="col-md-4">
            <label class="form-label small fw-semibold">NDP GST Amt</label>
            <input name="ndp_gst" id="f_ndp_gst" type="number" step="0.01" class="form-control form-control-sm" value="0">
          </div>
          <div class="col-md-4">
            <label class="form-label small fw-semibold">NDP (Total)</label>
            <input name="ndp_price" id="f_ndp" type="number" step="0.01" class="form-control form-control-sm" value="0">
          </div>
          <div class="col-md-4">
            <label class="form-label small fw-semibold">MRP Basic</label>
            <input name="mrp_basic" id="f_mrp_basic" type="number" step="0.01" class="form-control form-control-sm" value="0" oninput="calcModal()">
          </div>
          <div class="col-md-4">
            <label class="form-label small fw-semibold">MRP GST Amt</label>
            <input name="mrp_gst" id="f_mrp_gst" type="number" step="0.01" class="form-control form-control-sm" value="0">
          </div>
          <div class="col-md-4">
            <label class="form-label small fw-semibold">MRP (Total)</label>
            <input name="mrp_price" id="f_mrp" type="number" step="0.01" class="form-control form-control-sm" value="0">
          </div>
        </div>
      </div>
      <div class="card-footer d-flex gap-2 justify-content-end">
        <button type="button" class="btn btn-outline-secondary" onclick="closeModals()">Cancel</button>
        <button type="submit" class="btn btn-warning text-dark">Save Part</button>
      </div>
    </form>
  </div>
</div>

<!-- Import Modal -->
<div id="importModal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.5);z-index:9999;align-items:center;justify-content:center;overflow-y:auto;padding:20px 0">
  <div class="card border-0 shadow-lg" style="width:720px;max-width:96vw">
    <div class="card-header d-flex justify-content-between align-items-center">
      <span class="fw-semibold"><i class="bi bi-upload me-2"></i>Import Spare Parts from Excel</span>
      <button class="btn btn-sm btn-outline-secondary" onclick="closePartsImport()">✕</button>
    </div>

    <!-- Step 1 -->
    <div id="pStep1" class="card-body">
      <p class="text-muted small mb-3">Upload any Excel file. You'll map columns on the next screen.</p>
      <div class="mb-3">
        <label class="form-label small fw-semibold">Import Mode</label>
        <select id="importMode" class="form-select form-select-sm" style="max-width:320px">
          <option value="insert">Insert New Only (skip duplicates)</option>
          <option value="upsert">Insert + Update Existing (by SAP Part No)</option>
        </select>
      </div>
      <input type="file" id="importFile" accept=".xlsx,.xls" class="form-control mb-2">
      <div id="pParseError" class="alert alert-danger d-none small py-2"></div>
    </div>

    <!-- Step 2 -->
    <div id="pStep2" class="card-body d-none">
      <div class="alert alert-info small py-2 mb-3" id="pPreviewInfo"></div>
      <div class="table-responsive" style="max-height:55vh;overflow-y:auto">
        <table class="table table-sm table-bordered mb-0 small">
          <thead class="table-light"><tr><th style="width:32%">System Field</th><th>Excel Column</th><th style="width:36%">Sample Value</th></tr></thead>
          <tbody id="pMappingRows"></tbody>
        </table>
      </div>
      <div id="pImportResult" class="alert d-none mt-2"></div>
    </div>

    <div class="card-footer d-flex gap-2 justify-content-end">
      <button class="btn btn-outline-secondary" onclick="closePartsImport()">Cancel</button>
      <button id="pBtnParse"  class="btn btn-primary"  onclick="parsePartsFile()"><i class="bi bi-arrow-right me-1"></i>Next: Map Fields</button>
      <button id="pBtnImport" class="btn btn-success d-none" onclick="doImportParts()"><i class="bi bi-upload me-1"></i>Import</button>
    </div>
  </div>
</div>

<script>
function closeModals() { document.getElementById('addPartModal').style.display = 'none'; }
function calcModal() {
  const tax = parseFloat(document.getElementById('f_tax').value) / 100;
  const ndpB = parseFloat(document.getElementById('f_ndp_basic').value) || 0;
  const mrpB = parseFloat(document.getElementById('f_mrp_basic').value) || 0;
  document.getElementById('f_ndp_gst').value = (ndpB * tax).toFixed(2);
  document.getElementById('f_ndp').value = (ndpB * (1 + tax)).toFixed(2);
  document.getElementById('f_mrp_gst').value = (mrpB * tax).toFixed(2);
  document.getElementById('f_mrp').value = (mrpB * (1 + tax)).toFixed(2);
}
function openEdit(p) {
  document.getElementById('modalTitle').textContent = 'Edit Part';
  document.getElementById('partForm').action = `/spare-parts/${p.id}/update`;
  document.getElementById('f_sap').value = p.sap_part_no || '';
  document.getElementById('f_rnd').value = p.rnd_part_no || '';
  document.getElementById('f_desc').value = p.material_description || '';
  document.getElementById('f_hsn').value = p.hsn_code || '';
  document.getElementById('f_tax').value = p.tax_rate || 18;
  document.getElementById('f_ndp_basic').value = p.ndp_basic || 0;
  document.getElementById('f_ndp_gst').value = p.ndp_gst || 0;
  document.getElementById('f_ndp').value = p.ndp_price || 0;
  document.getElementById('f_mrp_basic').value = p.mrp_basic || 0;
  document.getElementById('f_mrp_gst').value = p.mrp_gst || 0;
  document.getElementById('f_mrp').value = p.mrp_price || 0;
  document.getElementById('addPartModal').style.display = 'flex';
}

const PARTS_FIELDS = [
  { key:'price_date',           label:'Pricing Date',        required:false, hints:['pricing date','price date','price list date'] },
  { key:'sap_part_no',          label:'SAP Part No.',        required:false, hints:['sap part no','sap part no.','sap no','sap','part no','part number'] },
  { key:'rnd_part_no',          label:'RND Part No.',        required:false, hints:['rnd part no','rnd part no.','rnd no','rnd'] },
  { key:'material_description', label:'Material Description',required:true,  hints:['material description','description','part description','item','name'] },
  { key:'hsn_code',             label:'HSN Code',            required:false, hints:['hsn code','hsn','hsn/sac'] },
  { key:'tax_rate',             label:'Tax Rate (%)',         required:false, hints:['tax_rate','tax rate','gst rate','gst %','tax%'] },
  { key:'ndp_basic',            label:'NDP Basic',           required:false, hints:['ndp basic','ndp_basic','ndp base'] },
  { key:'ndp_gst',              label:'NDP GST Amount',      required:false, hints:['ndp gst','ndp_gst','gst'] },
  { key:'ndp_price',            label:'NDP Total Price',     required:false, hints:['ndp','ndp price','ndp total','ndp_price'] },
  { key:'mrp_basic',            label:'MRP Basic',           required:false, hints:['mrp basic','mrp_basic','mrp base'] },
  { key:'mrp_gst',              label:'MRP GST Amount',      required:false, hints:['mrp gst','mrp_gst','gst 1'] },
  { key:'mrp_price',            label:'MRP Total Price',     required:false, hints:['mrp','mrp price','mrp total','mrp_price'] },
];

let pBase64 = '', pHeaders = [], pSample = [];

function closePartsImport() {
  document.getElementById('importModal').style.display = 'none';
  document.getElementById('pStep1').classList.remove('d-none');
  document.getElementById('pStep2').classList.add('d-none');
  document.getElementById('pBtnParse').classList.remove('d-none');
  document.getElementById('pBtnImport').classList.add('d-none');
  document.getElementById('importFile').value = '';
  document.getElementById('pParseError').classList.add('d-none');
  document.getElementById('pImportResult').classList.add('d-none');
}

function ab2b64p(buf) {
  const bytes = new Uint8Array(buf); let bin = ''; const C = 8192;
  for (let i=0;i<bytes.length;i+=C) bin += String.fromCharCode.apply(null, bytes.subarray(i,i+C));
  return btoa(bin);
}

// Exact header names win first (so "NDP" is NDP total, not "NDP Basic"); then a
// partial match, skipping headers that are an exact name for some other field.
function partsAutoDetect(headers) {
  const norm = h => h.toLowerCase().replace(/[^a-z0-9]/g,' ').replace(/\s+/g,' ').trim();
  const mapping = {}, used = new Set();
  const exactFor = h => PARTS_FIELDS.find(f => f.hints.includes(norm(h)));
  PARTS_FIELDS.forEach(f => {
    const match = headers.find(h => !used.has(h) && f.hints.includes(norm(h)));
    if (match) { mapping[f.key] = match; used.add(match); }
  });
  PARTS_FIELDS.forEach(f => {
    if (mapping[f.key]) return;
    const match = headers.find(h => !used.has(h) && !exactFor(h) && f.hints.some(hint => hint.length > 3 && norm(h).includes(hint)));
    if (match) { mapping[f.key] = match; used.add(match); }
  });
  return mapping;
}

async function parsePartsFile() {
  const file = document.getElementById('importFile').files[0];
  if (!file) return alert('Select an Excel file first.');
  const errDiv = document.getElementById('pParseError');
  errDiv.classList.add('d-none');
  const btn = document.getElementById('pBtnParse');
  btn.disabled = true; btn.textContent = 'Reading…';

  pBase64 = ab2b64p(await file.arrayBuffer());
  const r = await fetch('/spare-parts/parse-preview', {
    method:'POST', headers:{'Content-Type':'application/json'},
    body: JSON.stringify({ data: pBase64 })
  });
  const j = await r.json();
  btn.disabled = false; btn.textContent = 'Next: Map Fields';

  if (!j.ok) { errDiv.textContent = j.error; errDiv.classList.remove('d-none'); return; }

  pHeaders = j.headers; pSample = j.sample;
  const detected = partsAutoDetect(pHeaders);
  document.getElementById('pPreviewInfo').textContent =
    `File has ${pHeaders.length} columns. Auto-detected ${Object.keys(detected).length} field(s). Review and adjust below.`;

  const tbody = document.getElementById('pMappingRows');
  tbody.innerHTML = PARTS_FIELDS.map(f => {
    const opts = ['<option value="">(skip)</option>',
      ...pHeaders.map(h => `<option value="${h.replace(/"/g,'&quot;')}" ${detected[f.key]===h?'selected':''}>${h}</option>`)
    ].join('');
    const selCol = detected[f.key];
    const colIdx = selCol ? pHeaders.indexOf(selCol) : -1;
    const sample = colIdx >= 0 && pSample[0] ? pSample.map(r => r[colIdx]).filter(Boolean).slice(0,2).join(', ') : '—';
    return `<tr>
      <td>${f.required ? '<span class="text-danger">*</span> ' : ''}<b>${f.label}</b></td>
      <td><select class="form-select form-select-sm" id="pmap_${f.key}" onchange="pUpdateSample('${f.key}')">${opts}</select></td>
      <td class="text-muted" id="psmp_${f.key}" style="font-size:11px">${sample}</td>
    </tr>`;
  }).join('');

  document.getElementById('pStep1').classList.add('d-none');
  document.getElementById('pStep2').classList.remove('d-none');
  document.getElementById('pBtnParse').classList.add('d-none');
  document.getElementById('pBtnImport').classList.remove('d-none');
}

function pUpdateSample(field) {
  const sel = document.getElementById(`pmap_${field}`).value;
  const idx = pHeaders.indexOf(sel);
  const s   = idx >= 0 ? pSample.map(r => r[idx]).filter(Boolean).slice(0,2).join(', ') : '—';
  document.getElementById(`psmp_${field}`).textContent = s || '—';
}

async function doImportParts() {
  const mapping = {};
  PARTS_FIELDS.forEach(f => { const v = document.getElementById(`pmap_${f.key}`)?.value; if (v) mapping[f.key] = v; });
  if (!mapping.material_description) return alert('Material Description column mapping is required.');
  const mode = document.getElementById('importMode').value;
  const btn  = document.getElementById('pBtnImport');
  btn.disabled = true; btn.textContent = 'Importing…';
  const r = await fetch('/spare-parts/import/excel', {
    method:'POST', headers:{'Content-Type':'application/json'},
    body: JSON.stringify({ data: pBase64, mode, mapping })
  });
  const j = await r.json();
  btn.disabled = false; btn.innerHTML = '<i class="bi bi-upload me-1"></i>Import';
  const div = document.getElementById('pImportResult');
  div.classList.remove('d-none','alert-success','alert-danger');
  if (j.ok) {
    div.classList.add('alert-success');
    div.innerHTML = `✓ Inserted: <strong>${j.inserted}</strong>, Updated: <strong>${j.updated||0}</strong>, Skipped: <strong>${j.skipped}</strong>` +
      (j.errors?.length ? `<br><small>Errors: ${j.errors.slice(0,3).join('; ')}</small>` : '');
    setTimeout(() => location.reload(), 2500);
  } else {
    div.classList.add('alert-danger');
    div.textContent = '✗ ' + j.error;
  }
}
</script>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body></html>
