<%- include('../partials/head', { title }) %>
<%- include('../partials/sidebar', { active: 'part-orders', user }) %>
<%
  const statusBadge = {
    pending:   'bg-warning text-dark',
    confirmed: 'bg-success',
    cancelled: 'bg-secondary'
  }[order.status] || 'bg-secondary';
  const fmtDate = d => d ? new Date(d.replace(' ', 'T') + 'Z').toLocaleString('en-IN', { dateStyle: 'medium', timeStyle: 'short' }) : '—';
  const totalQty = items.reduce((s, it) => s + (it.qty || 0), 0);
%>
<div class="main-content">
  <div class="page-header d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0 fw-bold">
      <i class="bi bi-cart-fill me-2 text-primary"></i><span class="font-monospace"><%= order.order_no %></span>
      <span class="badge <%= statusBadge %> ms-2 fs-6 align-middle"><%= order.status.charAt(0).toUpperCase() + order.status.slice(1) %></span>
    </h4>
    <a href="/part-orders" class="btn btn-sm btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Back</a>
  </div>

  <% if (flash.success) { %>
  <div class="alert alert-success alert-dismissible"><%= flash.success %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
  <% } %>
  <% if (flash.error) { %>
  <div class="alert alert-danger alert-dismissible"><%= flash.error %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
  <% } %>

  <div class="row g-3 mb-3">
    <div class="col-md-7">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-header bg-white py-2 fw-semibold small"><i class="bi bi-person-fill me-1"></i>Machine & Customer</div>
        <div class="card-body small">
          <div class="row g-2">
            <div class="col-5 text-muted">Machine No.</div><div class="col-7 fw-semibold"><%= order.machine_no || '—' %></div>
            <div class="col-5 text-muted">Customer</div><div class="col-7"><%= order.customer_name || '—' %></div>
            <div class="col-5 text-muted">Mobile</div><div class="col-7"><%= order.mobile || '—' %></div>
            <div class="col-5 text-muted">Address</div><div class="col-7"><%= order.customer_address || '—' %></div>
            <% if (order.remarks) { %>
            <div class="col-5 text-muted">Remarks</div><div class="col-7"><%= order.remarks %></div>
            <% } %>
          </div>
        </div>
      </div>
    </div>
    <div class="col-md-5">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-header bg-white py-2 fw-semibold small"><i class="bi bi-clock-history me-1"></i>History</div>
        <div class="card-body small">
          <div class="row g-2">
            <div class="col-5 text-muted">Placed by</div><div class="col-7"><%= order.created_by_name || '—' %></div>
            <div class="col-5 text-muted">Placed on</div><div class="col-7"><%= fmtDate(order.created_at) %></div>
            <% if (order.status === 'confirmed') { %>
            <div class="col-5 text-muted">Confirmed by</div><div class="col-7"><%= order.confirmed_by_name || '—' %></div>
            <div class="col-5 text-muted">Confirmed on</div><div class="col-7"><%= fmtDate(order.confirmed_at) %></div>
            <% } %>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="card border-0 shadow-sm mb-3">
    <div class="card-header bg-white d-flex justify-content-between py-2">
      <span class="small fw-semibold"><%= items.length %> part<%= items.length === 1 ? '' : 's' %> · <%= totalQty %> qty</span>
    </div>
    <div class="table-responsive">
      <table class="table table-sm mb-0 align-middle">
        <thead class="table-light">
          <tr><th>#</th><th>SAP Part No.</th><th>R&amp;D Part No.</th><th>Description</th><th class="text-end">Qty</th></tr>
        </thead>
        <tbody>
          <% items.forEach((it, i) => { %>
          <tr>
            <td class="small text-muted"><%= i + 1 %></td>
            <td class="font-monospace small"><%= it.sap_part_no || '—' %></td>
            <td class="font-monospace small"><%= it.rnd_part_no || '—' %></td>
            <td class="small"><%= it.description %></td>
            <td class="text-end fw-semibold"><%= it.qty %></td>
          </tr>
          <% }) %>
          <% if (!items.length) { %>
          <tr><td colspan="5" class="text-center text-muted py-4">No parts on this order.</td></tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>

  <div class="d-flex flex-wrap gap-2">
    <% if (isAdmin && order.status === 'pending') { %>
    <form method="POST" action="/part-orders/<%= order.id %>/confirm" onsubmit="return confirm('Confirm order <%= order.order_no %>?')">
      <button class="btn btn-success"><i class="bi bi-check2-circle me-1"></i>Confirm Order</button>
    </form>
    <% } %>
    <% if (canCancel) { %>
    <form method="POST" action="/part-orders/<%= order.id %>/cancel" onsubmit="return confirm('Cancel order <%= order.order_no %>?')">
      <button class="btn btn-outline-warning"><i class="bi bi-x-circle me-1"></i>Cancel Order</button>
    </form>
    <% } %>
    <% if (isAdmin) { %>
    <form method="POST" action="/part-orders/<%= order.id %>/delete" class="ms-auto" onsubmit="return confirm('Permanently delete order <%= order.order_no %>?')">
      <button class="btn btn-outline-danger"><i class="bi bi-trash me-1"></i>Delete</button>
    </form>
    <% } %>
  </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body></html>
