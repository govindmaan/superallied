<%- include('../partials/head', { title }) %>
<%- include('../partials/sidebar', { active: 'part-orders', user }) %>
<div class="main-content">
  <div class="page-header d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0 fw-bold"><i class="bi bi-cart-fill me-2 text-primary"></i>Spare Part Orders</h4>
    <a href="/part-orders/new" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i>New Order</a>
  </div>

  <% if (flash.success) { %>
  <div class="alert alert-success alert-dismissible"><%= flash.success %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
  <% } %>
  <% if (flash.error) { %>
  <div class="alert alert-danger alert-dismissible"><%= flash.error %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
  <% } %>

  <!-- Filters -->
  <form method="GET" class="card border-0 shadow-sm mb-3 p-3">
    <div class="row g-2 align-items-end">
      <div class="col-md-4">
        <input type="text" name="q" class="form-control form-control-sm" value="<%= filters.q %>" placeholder="Search order no, machine, customer…">
      </div>
      <div class="col-md-3">
        <select name="status" class="form-select form-select-sm">
          <option value="">All Statuses</option>
          <option value="pending"   <%= filters.status==='pending'  ?'selected':'' %>>Pending</option>
          <option value="confirmed" <%= filters.status==='confirmed'?'selected':'' %>>Confirmed</option>
          <option value="cancelled" <%= filters.status==='cancelled'?'selected':'' %>>Cancelled</option>
        </select>
      </div>
      <div class="col-md-2 d-flex gap-2">
        <button type="submit" class="btn btn-sm btn-primary flex-fill"><i class="bi bi-search me-1"></i>Filter</button>
        <a href="/part-orders" class="btn btn-sm btn-outline-secondary">Clear</a>
      </div>
    </div>
  </form>

  <div class="card border-0 shadow-sm">
    <div class="card-header bg-white d-flex justify-content-between py-2">
      <span class="small fw-semibold"><%= total %> orders</span>
    </div>
    <div class="table-responsive">
      <table class="table table-hover table-sm mb-0 align-middle">
        <thead class="table-light">
          <tr>
            <th>Order No.</th>
            <th>Machine No.</th>
            <th>Customer</th>
            <th class="text-center">Parts</th>
            <th>Status</th>
            <th>Created By</th>
            <th>Date</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% rows.forEach(r => { %>
          <%
            const statusBadge = {
              pending:   'bg-warning text-dark',
              confirmed: 'bg-success',
              cancelled: 'bg-secondary'
            }[r.status] || 'bg-secondary';
          %>
          <tr>
            <td class="font-monospace fw-semibold small"><%= r.order_no %></td>
            <td class="small"><%= r.machine_no || '—' %></td>
            <td class="small"><%= r.customer_name || '—' %></td>
            <td class="text-center"><span class="badge bg-primary"><%= r.item_count %></span></td>
            <td><span class="badge <%= statusBadge %>"><%= r.status.charAt(0).toUpperCase() + r.status.slice(1) %></span></td>
            <td class="small text-muted"><%= r.created_by_name || '—' %></td>
            <td class="small text-muted"><%= new Date(r.created_at).toLocaleDateString('en-IN') %></td>
            <td><a href="/part-orders/<%= r.id %>" class="btn btn-sm btn-outline-primary py-0 px-2">View</a></td>
          </tr>
          <% }) %>
          <% if (!rows.length) { %>
          <tr><td colspan="8" class="text-center text-muted py-4">No orders found.</td></tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>

  <% if (pages > 1) { %>
  <nav class="mt-3 d-flex justify-content-center">
    <ul class="pagination pagination-sm mb-0">
      <% for (let p = 1; p <= pages; p++) { %>
      <li class="page-item <%= p===page?'active':'' %>">
        <a class="page-link" href="/part-orders?<%= new URLSearchParams({...filters, page: p}) %>"><%= p %></a>
      </li>
      <% } %>
    </ul>
  </nav>
  <% } %>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body></html>
