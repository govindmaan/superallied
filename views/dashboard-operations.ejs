<%- include('partials/head', { title }) %>
<%- include('partials/sidebar', { active: 'dashboard', user }) %>
<%
  const lvl = emp.position_level || 9;
  const isSenior = lvl <= 4;    // Stock & Parts In-charge or above
%>
<div class="main-content ops-dash">

  <!-- ── Greeting ─────────────────────────────────────────────────────────── -->
  <div class="ops-header">
    <div class="d-flex align-items-center gap-3">
      <% if (emp.photo_path) { %>
        <img src="<%= emp.photo_path %>" class="ops-avatar" alt="">
      <% } else { %>
        <div class="ops-avatar-fb"><%= (emp.full_name||'U').charAt(0).toUpperCase() %></div>
      <% } %>
      <div>
        <div class="ops-hello">Good <%= new Date().getHours()<12?'Morning':new Date().getHours()<17?'Afternoon':'Evening' %> 👋</div>
        <div class="ops-name"><%= emp.full_name || emp.username %></div>
        <% if (emp.designation) { %><div class="ops-sub"><%= emp.designation %></div><% } %>
        <div class="ops-sub"><%= new Date(today).toLocaleDateString('en-IN',{weekday:'long',day:'numeric',month:'long'}) %></div>
      </div>
    </div>
    <div class="mt-3">
      <% if (todayAtt?.check_out_time) { %>
        <span class="att-pill att-done"><i class="bi bi-check-circle-fill me-1"></i>Day Complete</span>
      <% } else if (todayAtt?.check_in_time) { %>
        <span class="att-pill att-in"><i class="bi bi-dot me-1" style="font-size:1.4rem;line-height:0"></i>Checked In · <%= new Date(todayAtt.check_in_time).toLocaleTimeString('en-IN',{hour:'2-digit',minute:'2-digit'}) %></span>
      <% } else { %>
        <span class="att-pill att-out"><i class="bi bi-exclamation-circle me-1"></i>Not Checked In</span>
      <% } %>
    </div>
  </div>

  <!-- ── KPI row ───────────────────────────────────────────────────────────── -->
  <div class="kpi-grid">
    <div class="kpi-card <%= zeroStockCount>0?'kpi-danger':'kpi-success' %>">
      <div class="kpi-val"><%= zeroStockCount %></div>
      <div class="kpi-label"><i class="bi bi-exclamation-triangle-fill me-1"></i>Out of Stock</div>
      <div class="kpi-sub">Parts at zero qty</div>
    </div>
    <div class="kpi-card <%= lowStockCount>0?'kpi-warn':'kpi-neutral' %>">
      <div class="kpi-val"><%= lowStockCount %></div>
      <div class="kpi-label"><i class="bi bi-dash-circle-fill me-1"></i>Low Stock</div>
      <div class="kpi-sub">1–3 qty remaining</div>
    </div>
    <div class="kpi-card kpi-blue">
      <div class="kpi-val"><%= mySpareQuotes %></div>
      <div class="kpi-label"><i class="bi bi-receipt-cutoff me-1"></i>Spare Quotes</div>
      <div class="kpi-sub"><%= myQuotesToday %> today · this month</div>
    </div>
    <div class="kpi-card <%= pendingOrders>0?'kpi-warn':'kpi-teal' %>">
      <div class="kpi-val"><%= pendingOrders %></div>
      <div class="kpi-label"><i class="bi bi-cart-fill me-1"></i>Orders Pending</div>
      <div class="kpi-sub">Part orders awaiting</div>
    </div>
  </div>

  <!-- L4+: team totals row -->
  <% if (isSenior && teamOps) { %>
  <div class="team-row">
    <div class="team-chip">
      <i class="bi bi-receipt me-1 text-primary"></i>
      <strong><%= teamOps.teamQuotesMonth.c %></strong> quotes · <strong>₹<%= (teamOps.teamQuotesMonth.v/1000).toFixed(0) %>k</strong> this month
    </div>
    <% if (teamOps.pendingApproval > 0) { %>
    <a href="/spare-quotations?status=pending" class="team-chip team-chip-warn text-decoration-none">
      <i class="bi bi-clock-fill me-1"></i>
      <strong><%= teamOps.pendingApproval %></strong> quotes need approval
    </a>
    <% } %>
    <div class="team-chip">
      <i class="bi bi-boxes me-1 text-secondary"></i>
      <strong><%= teamOps.totalParts %></strong> parts in catalogue
    </div>
  </div>
  <% } %>

  <!-- ── Quick actions ─────────────────────────────────────────────────────── -->
  <div class="primary-actions">
    <a href="/attendance" class="pa-btn <%= todayAtt?.check_out_time?'pa-done':todayAtt?.check_in_time?'pa-out':'pa-in' %>">
      <i class="bi <%= todayAtt?.check_out_time?'bi-check2-circle':todayAtt?.check_in_time?'bi-box-arrow-right':'bi-box-arrow-in-right' %>"></i>
      <span><%= todayAtt?.check_out_time?'Day Complete':todayAtt?.check_in_time?'Check Out':'Check In' %></span>
    </a>
    <% if (hasPerm('spare_quotations')) { %>
    <a href="/spare-quotations/new" class="pa-btn pa-quote">
      <i class="bi bi-receipt-cutoff"></i><span>New Spare Quote</span>
      <small><%= myQuotesToday %> today</small>
    </a>
    <% } %>
    <% if (hasPerm('stock')) { %>
    <a href="/stock" class="pa-btn <%= zeroStockCount>0?'pa-stock-alert':'pa-stock' %>">
      <i class="bi bi-clipboard-data-fill"></i><span>Stock</span>
      <small><%= zeroStockCount>0?zeroStockCount+' out of stock':lowStockCount>0?lowStockCount+' low':'All good' %></small>
    </a>
    <% } %>
  </div>

  <!-- ── Out-of-stock alert ─────────────────────────────────────────────────── -->
  <% if (zeroStockItems.length) { %>
  <div class="card border-0 shadow-sm mb-3">
    <div class="card-header bg-white d-flex justify-content-between align-items-center">
      <span class="fw-semibold small"><i class="bi bi-exclamation-triangle-fill me-1 text-danger"></i>Out of Stock — Needs Replenishment</span>
      <% if (zeroStockCount > zeroStockItems.length) { %>
        <a href="/stock" class="text-danger" style="font-size:12px">+<%= zeroStockCount - zeroStockItems.length %> more →</a>
      <% } else { %>
        <a href="/stock" class="text-muted" style="font-size:12px">View all →</a>
      <% } %>
    </div>
    <div class="list-group list-group-flush">
      <% zeroStockItems.forEach(p => { %>
      <div class="list-group-item py-2">
        <div class="d-flex justify-content-between align-items-start gap-2">
          <div style="min-width:0">
            <div class="fw-semibold small text-truncate"><%= p.material_description %></div>
            <div class="text-muted" style="font-size:11px">
              <% if (p.sap_part_no) { %><span class="me-2">SAP: <%= p.sap_part_no %></span><% } %>
              <% if (p.rnd_part_no) { %><span>R&D: <%= p.rnd_part_no %></span><% } %>
              <% if (p.category) { %><span class="ms-2 text-secondary"><%= p.category %></span><% } %>
            </div>
          </div>
          <span class="badge bg-danger flex-shrink-0">0 qty</span>
        </div>
      </div>
      <% }) %>
    </div>
  </div>
  <% } %>

  <!-- ── Recent part orders ─────────────────────────────────────────────────── -->
  <% if (recentOrders.length) { %>
  <div class="card border-0 shadow-sm mb-3">
    <div class="card-header bg-white d-flex justify-content-between align-items-center">
      <span class="fw-semibold small"><i class="bi bi-cart-fill me-1 text-warning"></i>Part Orders</span>
      <a href="/part-orders" class="text-muted" style="font-size:12px">View all →</a>
    </div>
    <div class="list-group list-group-flush">
      <% recentOrders.forEach(o => {
           const badgeClr = o.status==='pending'?'bg-warning text-dark':o.status==='confirmed'?'bg-success':'bg-secondary';
      %> %>
      <a href="/part-orders/<%= o.id %>" class="list-group-item list-group-item-action py-2">
        <div class="d-flex justify-content-between align-items-start gap-2">
          <div style="min-width:0">
            <div class="fw-semibold small"><%= o.order_no %><% if (o.customer_name) { %> · <span class="text-muted fw-normal"><%= o.customer_name %></span><% } %></div>
            <div class="text-muted" style="font-size:11px"><%= o.machine_no || '—' %><% if (o.creator_name) { %> · <%= o.creator_name %><% } %> · <%= new Date(o.created_at).toLocaleDateString('en-IN',{day:'numeric',month:'short'}) %></div>
          </div>
          <span class="badge <%= badgeClr %> flex-shrink-0"><%= o.status %></span>
        </div>
      </a>
      <% }) %>
    </div>
  </div>
  <% } %>

  <!-- ── Recent spare quotations ───────────────────────────────────────────── -->
  <% if (recentSpare.length) { %>
  <div class="card border-0 shadow-sm mb-3">
    <div class="card-header bg-white d-flex justify-content-between align-items-center">
      <span class="fw-semibold small"><i class="bi bi-receipt-cutoff me-1 text-primary"></i>Recent Spare Quotations</span>
      <a href="/spare-quotations" class="text-muted" style="font-size:12px">View all →</a>
    </div>
    <div class="list-group list-group-flush">
      <% recentSpare.forEach(sq => {
           const appr = sq.approval_status;
           const apprBadge = appr==='approved'?'bg-success':appr==='pending'?'bg-warning text-dark':appr==='rejected'?'bg-danger':'bg-light text-muted';
      %> %>
      <a href="/spare-quotations/<%= sq.id %>" class="list-group-item list-group-item-action py-2">
        <div class="d-flex justify-content-between align-items-start gap-2">
          <div style="min-width:0">
            <div class="fw-semibold small"><%= sq.quotation_no %> · <span class="text-muted fw-normal"><%= sq.customer_name %></span></div>
            <div class="text-muted" style="font-size:11px"><%= sq.machine_no||'—' %><% if (sq.creator_name) { %> · <%= sq.creator_name %><% } %> · ₹<%= formatINR(sq.grand_total) %></div>
          </div>
          <div class="text-end flex-shrink-0">
            <span class="badge <%= apprBadge %> d-block mb-1"><%= appr||'draft' %></span>
            <span class="text-muted" style="font-size:10px"><%= new Date(sq.created_at).toLocaleDateString('en-IN',{day:'numeric',month:'short'}) %></span>
          </div>
        </div>
      </a>
      <% }) %>
    </div>
  </div>
  <% } %>

  <!-- ── Action tiles ──────────────────────────────────────────────────────── -->
  <div class="tile-grid">

    <a href="/attendance" class="tile tile-attendance">
      <div class="tile-icon"><i class="bi bi-calendar-check-fill"></i></div>
      <div class="tile-label">Attendance</div>
      <div class="tile-sub"><%= !todayAtt?.check_in_time?'Check In':!todayAtt?.check_out_time?'Check Out':'Done' %></div>
    </a>

    <% if (hasPerm('spare_quotations')) { %>
    <a href="/spare-quotations/new" class="tile tile-spare">
      <div class="tile-icon"><i class="bi bi-receipt-cutoff"></i></div>
      <div class="tile-label">New Spare Quote</div>
      <div class="tile-sub"><%= mySpareQuotes %> this month</div>
    </a>
    <% } %>

    <% if (hasPerm('stock')) { %>
    <a href="/stock" class="tile <%= zeroStockCount>0?'tile-stock-alert':'tile-stock' %>">
      <div class="tile-icon"><i class="bi bi-clipboard-data-fill"></i></div>
      <div class="tile-label">Stock</div>
      <div class="tile-sub"><%= zeroStockCount>0?zeroStockCount+' out of stock':lowStockCount>0?lowStockCount+' low':'All good' %></div>
    </a>
    <% } %>

    <% if (hasPerm('spare_parts')) { %>
    <a href="/part-orders" class="tile tile-orders">
      <div class="tile-icon"><i class="bi bi-cart-fill"></i></div>
      <div class="tile-label">Part Orders</div>
      <div class="tile-sub"><%= pendingOrders > 0 ? pendingOrders + ' pending' : 'View orders' %></div>
    </a>
    <% } %>

    <% if (hasPerm('spare_parts')) { %>
    <a href="/spare-parts" class="tile tile-parts">
      <div class="tile-icon"><i class="bi bi-boxes"></i></div>
      <div class="tile-label">Parts Master</div>
      <div class="tile-sub">Catalogue</div>
    </a>
    <% } %>

    <% if (hasPerm('sold_machines') || hasPerm('spare_parts')) { %>
    <a href="/form-22" class="tile tile-form22">
      <div class="tile-icon"><i class="bi bi-patch-check-fill"></i></div>
      <div class="tile-label">Form 22</div>
      <div class="tile-sub">Delivery note</div>
    </a>
    <% } %>

    <% if (hasPerm('sold_machines') && lvl <= 3) { %>
    <a href="/sold-machines" class="tile tile-machines">
      <div class="tile-icon"><i class="bi bi-hdd-rack-fill"></i></div>
      <div class="tile-label">Sold Machines</div>
      <div class="tile-sub">Machine register</div>
    </a>
    <% } %>

    <% if (hasPerm('expense_claim')) { %>
    <a href="/travel-expenses/my" class="tile tile-expense">
      <div class="tile-icon"><i class="bi bi-truck"></i></div>
      <div class="tile-label">Travel Expense</div>
      <div class="tile-sub">₹<%= parseFloat(monthClaim||0).toFixed(0) %> this month</div>
    </a>
    <% } %>

    <a href="/leaves" class="tile tile-leave">
      <div class="tile-icon"><i class="bi bi-calendar-x-fill"></i></div>
      <div class="tile-label">My Leaves</div>
      <div class="tile-sub"><%= pendingLeaves>0?pendingLeaves+' pending':'Apply leave' %></div>
    </a>

    <a href="/salary" class="tile tile-salary">
      <div class="tile-icon"><i class="bi bi-cash-coin"></i></div>
      <div class="tile-label">My Salary</div>
      <div class="tile-sub">View slips</div>
    </a>

    <a href="/id-card" class="tile tile-id">
      <div class="tile-icon"><i class="bi bi-credit-card-2-front-fill"></i></div>
      <div class="tile-label">ID Card</div>
      <div class="tile-sub">View & Download</div>
    </a>

  </div>

  <% if (unreadCount > 0) { %>
  <a href="/notifications" class="notif-bar">
    <i class="bi bi-bell-fill me-2"></i>
    You have <strong><%= unreadCount %></strong> unread notification<%= unreadCount===1?'':'s' %>
    <i class="bi bi-chevron-right ms-auto"></i>
  </a>
  <% } %>
</div>

<style>
@media (min-width:992px){ .ops-dash { padding-top:20px; } }

/* Header */
.ops-header { background:linear-gradient(135deg,#1a1a2e 0%,#2d2550 100%); border-radius:16px; padding:20px; color:#fff; margin-bottom:16px; }
.ops-avatar    { width:60px;height:60px;border-radius:50%;object-fit:cover;border:3px solid rgba(255,255,255,.4);flex-shrink:0; }
.ops-avatar-fb { width:60px;height:60px;border-radius:50%;background:#6f42c1;display:flex;align-items:center;justify-content:center;font-size:1.8rem;font-weight:900;flex-shrink:0; }
.ops-hello { font-size:13px;opacity:.7; }
.ops-name  { font-size:20px;font-weight:800;line-height:1.2; }
.ops-sub   { font-size:12px;opacity:.65;margin-top:2px; }
.att-pill  { display:inline-flex;align-items:center;border-radius:20px;padding:4px 14px;font-size:13px;font-weight:600; }
.att-done  { background:rgba(40,167,69,.2);color:#7dffa9; }
.att-in    { background:rgba(255,193,7,.2);color:#ffe066; }
.att-out   { background:rgba(220,53,69,.2);color:#ff8a94; }

/* KPI cards */
.kpi-grid { display:grid;grid-template-columns:repeat(2,1fr);gap:10px;margin-bottom:12px; }
.kpi-card { border-radius:14px;padding:14px 12px;color:#fff; }
.kpi-val  { font-size:2rem;font-weight:900;line-height:1; }
.kpi-label{ font-size:12px;font-weight:700;margin-top:4px;opacity:.95; }
.kpi-sub  { font-size:10px;opacity:.75;margin-top:2px; }
.kpi-danger  { background:linear-gradient(135deg,#dc3545,#b02a37); }
.kpi-success { background:linear-gradient(135deg,#198754,#145c3c); }
.kpi-blue    { background:linear-gradient(135deg,#0d6efd,#0a47b0); }
.kpi-teal    { background:linear-gradient(135deg,#20c997,#149e78);color:#003020; }
.kpi-teal .kpi-label,.kpi-teal .kpi-sub,.kpi-teal .kpi-val { color:#003020; }
.kpi-warn    { background:linear-gradient(135deg,#fd7e14,#c96000); }
.kpi-neutral { background:linear-gradient(135deg,#6c757d,#495057); }

/* Team row */
.team-row { display:flex;flex-wrap:wrap;gap:8px;margin-bottom:14px; }
.team-chip { background:rgba(0,0,0,.06);border-radius:20px;padding:6px 14px;font-size:12px;color:#333; }
.team-chip-warn { background:#fff3cd;color:#664d03;border:1px solid #ffc107; }

/* Primary actions */
.primary-actions { display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-bottom:16px; }
.pa-btn { display:flex;flex-direction:column;align-items:center;justify-content:center;gap:2px;border-radius:16px;padding:14px 6px;min-height:84px;color:#fff;text-decoration:none;font-weight:700;font-size:14px;box-shadow:0 4px 14px rgba(0,0,0,.12); }
.pa-btn i { font-size:1.7rem;line-height:1; }
.pa-btn small { font-weight:500;opacity:.85;font-size:11px; }
.pa-btn:active { transform:scale(.97);color:#fff; }
.pa-btn:hover  { color:#fff;filter:brightness(1.05); }
.pa-in          { background:#198754; }
.pa-out         { background:#fd7e14; }
.pa-done        { background:#6c757d; }
.pa-quote       { background:#0d6efd; }
.pa-stock       { background:#198754; }
.pa-stock-alert { background:#dc3545; }

/* Tiles */
.tile-grid { display:grid;grid-template-columns:repeat(2,1fr);gap:12px;margin-bottom:16px; }
@media (min-width:576px){ .tile-grid { grid-template-columns:repeat(3,1fr); } }
@media (min-width:992px){ .tile-grid { grid-template-columns:repeat(4,1fr); } }
.tile { background:#fff;border-radius:16px;padding:18px 14px;text-decoration:none;color:#1a1d2e;box-shadow:0 2px 12px rgba(0,0,0,.08);transition:transform .15s,box-shadow .15s;display:flex;flex-direction:column;align-items:center;text-align:center;min-height:100px;justify-content:center;border:2px solid transparent; }
.tile:hover,.tile:active { transform:translateY(-2px);box-shadow:0 6px 20px rgba(0,0,0,.14);color:#1a1d2e; }
.tile-icon  { font-size:1.9rem;margin-bottom:6px; }
.tile-label { font-size:13px;font-weight:700;line-height:1.2; }
.tile-sub   { font-size:11px;color:#888;margin-top:2px; }
@media (max-width:575.98px){ .tile { min-height:88px;padding:12px 10px; } .tile-icon { font-size:1.6rem;margin-bottom:4px; } }
.tile-attendance { border-color:#28a745; } .tile-attendance .tile-icon { color:#28a745; }
.tile-spare      { border-color:#0d6efd; } .tile-spare      .tile-icon { color:#0d6efd; }
.tile-stock      { border-color:#198754; } .tile-stock      .tile-icon { color:#198754; }
.tile-stock-alert{ border-color:#dc3545;background:#fff5f5; } .tile-stock-alert .tile-icon { color:#dc3545; }
.tile-orders     { border-color:#fd7e14; } .tile-orders     .tile-icon { color:#fd7e14; }
.tile-parts      { border-color:#6f42c1; } .tile-parts      .tile-icon { color:#6f42c1; }
.tile-form22     { border-color:#20c997; } .tile-form22     .tile-icon { color:#20c997; }
.tile-machines   { border-color:#0dcaf0; } .tile-machines   .tile-icon { color:#0891a8; }
.tile-expense    { border-color:#fd7e14; } .tile-expense    .tile-icon { color:#fd7e14; }
.tile-leave      { border-color:#e83e8c; } .tile-leave      .tile-icon { color:#e83e8c; }
.tile-salary     { border-color:#20c997; } .tile-salary     .tile-icon { color:#20c997; }
.tile-id         { border-color:#6c757d; } .tile-id         .tile-icon { color:#6c757d; }

/* Notif bar */
.notif-bar { background:#fff3cd;border:1px solid #ffc107;border-radius:12px;padding:12px 16px;display:flex;align-items:center;gap:4px;text-decoration:none;color:#856404;font-size:14px;font-weight:600; }
</style>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body></html>
