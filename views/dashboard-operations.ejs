<%- include('partials/head', { title }) %>
<%- include('partials/sidebar', { active: 'dashboard', user }) %>
<% const lvl = emp.position_level || 5; /* lower = more senior */ %>
<div class="main-content emp-home">

  <!-- Greeting -->
  <div class="emp-greeting">
    <div class="d-flex align-items-center gap-3">
      <% if (emp.photo_path) { %>
        <img src="<%= emp.photo_path %>" class="emp-avatar" alt="">
      <% } else { %>
        <div class="emp-avatar-fallback"><%= (emp.full_name||'U').charAt(0).toUpperCase() %></div>
      <% } %>
      <div>
        <div class="emp-hello">Good <%= new Date().getHours() < 12 ? 'Morning' : new Date().getHours() < 17 ? 'Afternoon' : 'Evening' %> 👋</div>
        <div class="emp-name"><%= emp.full_name || emp.username %></div>
        <% if (emp.designation) { %><div class="emp-date"><%= emp.designation %></div><% } %>
        <div class="emp-date"><%= new Date(today).toLocaleDateString('en-IN',{weekday:'long',day:'numeric',month:'long',year:'numeric'}) %></div>
      </div>
    </div>
    <!-- Attendance pill -->
    <div class="mt-3">
      <% if (todayAtt?.check_out_time) { %>
        <span class="att-pill att-done"><i class="bi bi-check-circle-fill me-1"></i>Day Complete</span>
      <% } else if (todayAtt?.check_in_time) { %>
        <span class="att-pill att-in"><i class="bi bi-dot me-1" style="font-size:1.4rem;line-height:0"></i>Checked In at <%= new Date(todayAtt.check_in_time).toLocaleTimeString('en-IN',{hour:'2-digit',minute:'2-digit'}) %></span>
      <% } else { %>
        <span class="att-pill att-out"><i class="bi bi-exclamation-circle me-1"></i>Not Checked In</span>
      <% } %>
    </div>
  </div>

  <!-- Stat chips -->
  <div class="d-flex flex-wrap gap-2 mb-4">
    <div class="stat-chip"><i class="bi bi-receipt me-1"></i><strong><%= mySpareQuotes %></strong> Spare quotes this month</div>
    <% if (zeroStockCount > 0) { %>
    <div class="stat-chip stat-chip-warn"><i class="bi bi-exclamation-triangle me-1"></i><strong><%= zeroStockCount %></strong> Out of stock</div>
    <% } %>
    <% if (lowStockCount > 0) { %>
    <div class="stat-chip stat-chip-warn"><i class="bi bi-clipboard-data me-1"></i><strong><%= lowStockCount %></strong> Low stock items</div>
    <% } %>
    <% if (pendingLeaves > 0) { %>
    <div class="stat-chip stat-chip-warn"><i class="bi bi-clock me-1"></i><strong><%= pendingLeaves %></strong> Leave pending</div>
    <% } %>
  </div>

  <!-- Action tiles -->
  <div class="tile-grid">

    <!-- Attendance -->
    <a href="/attendance" class="tile tile-attendance">
      <div class="tile-icon"><i class="bi bi-calendar-check-fill"></i></div>
      <div class="tile-label">Attendance</div>
      <div class="tile-sub">
        <% if (!todayAtt?.check_in_time) { %>Tap to Check In
        <% } else if (!todayAtt?.check_out_time) { %>Checked In • Check Out
        <% } else { %>Done for today<% } %>
      </div>
    </a>

    <!-- Spare Quotation -->
    <% if (hasPerm('spare_quotations')) { %>
    <a href="/spare-quotations/new" class="tile" style="background:linear-gradient(135deg,#0d6efd,#0a58ca)">
      <div class="tile-icon"><i class="bi bi-receipt-cutoff"></i></div>
      <div class="tile-label">New Spare Quote</div>
      <div class="tile-sub"><%= mySpareQuotes %> this month</div>
    </a>
    <% } %>

    <!-- Stock Availability -->
    <% if (hasPerm('stock')) { %>
    <a href="/stock" class="tile" style="background:linear-gradient(135deg,<%= zeroStockCount>0?'#dc3545,#b02a37':'#198754,#146c43' %>)">
      <div class="tile-icon"><i class="bi bi-clipboard-data-fill"></i></div>
      <div class="tile-label">Stock</div>
      <div class="tile-sub"><%= zeroStockCount > 0 ? zeroStockCount + ' out of stock' : lowStockCount > 0 ? lowStockCount + ' low stock' : 'All good' %></div>
    </a>
    <% } %>

    <!-- Parts Master (L4 and above) -->
    <% if (hasPerm('spare_parts') && lvl <= 4) { %>
    <a href="/spare-parts" class="tile" style="background:linear-gradient(135deg,#6610f2,#520dc2)">
      <div class="tile-icon"><i class="bi bi-boxes"></i></div>
      <div class="tile-label">Parts Master</div>
      <div class="tile-sub">Catalogue</div>
    </a>
    <% } %>

    <!-- Part Orders (L4 and above) -->
    <% if (hasPerm('spare_parts') && lvl <= 4) { %>
    <a href="/part-orders" class="tile" style="background:linear-gradient(135deg,#fd7e14,#dc6502)">
      <div class="tile-icon"><i class="bi bi-cart-fill"></i></div>
      <div class="tile-label">Part Orders</div>
      <div class="tile-sub">Requests & tracking</div>
    </a>
    <% } %>

    <!-- Form 22 (L4 and above) -->
    <% if ((hasPerm('sold_machines') || hasPerm('spare_parts')) && lvl <= 4) { %>
    <a href="/form-22" class="tile" style="background:linear-gradient(135deg,#20c997,#1aa179)">
      <div class="tile-icon"><i class="bi bi-patch-check-fill"></i></div>
      <div class="tile-label">Form 22</div>
      <div class="tile-sub">Delivery note</div>
    </a>
    <% } %>

    <!-- Sold Machines (L3 and above) -->
    <% if (hasPerm('sold_machines') && lvl <= 3) { %>
    <a href="/sold-machines" class="tile tile-visit">
      <div class="tile-icon"><i class="bi bi-hdd-rack-fill"></i></div>
      <div class="tile-label">Sold Machines</div>
      <div class="tile-sub">Machine register</div>
    </a>
    <% } %>

    <!-- Travel Expense -->
    <% if (hasPerm('expense_claim')) { %>
    <a href="/travel-expenses/my" class="tile tile-expense">
      <div class="tile-icon"><i class="bi bi-truck"></i></div>
      <div class="tile-label">Travel Expense</div>
      <div class="tile-sub">₹<%= parseFloat(monthClaim||0).toFixed(0) %> this month</div>
    </a>
    <% } %>

    <!-- My Leaves -->
    <a href="/leaves" class="tile tile-leave">
      <div class="tile-icon"><i class="bi bi-calendar-x-fill"></i></div>
      <div class="tile-label">My Leaves</div>
      <div class="tile-sub"><%= pendingLeaves > 0 ? pendingLeaves + ' pending' : 'Apply leave' %></div>
    </a>

    <!-- My Salary -->
    <a href="/salary" class="tile tile-salary">
      <div class="tile-icon"><i class="bi bi-cash-coin"></i></div>
      <div class="tile-label">My Salary</div>
      <div class="tile-sub">View slips</div>
    </a>

  </div>

  <!-- Recent Spare Quotations -->
  <% if (recentSpare.length > 0) { %>
  <div class="card border-0 shadow-sm mt-4">
    <div class="card-header bg-white d-flex justify-content-between align-items-center">
      <span class="fw-semibold small"><i class="bi bi-receipt-cutoff me-2 text-primary"></i>Recent Spare Quotations</span>
      <a href="/spare-quotations" class="btn btn-sm btn-outline-primary">View All</a>
    </div>
    <div class="table-responsive">
      <table class="table table-hover mb-0 small align-middle">
        <thead class="table-light">
          <tr><th>Quotation No.</th><th>Machine No.</th><th>Customer</th><th>Amount</th><th>Date</th><th></th></tr>
        </thead>
        <tbody>
          <% recentSpare.forEach(sq => { %>
          <tr>
            <td><a href="/spare-quotations/<%= sq.id %>" class="fw-semibold text-decoration-none"><%= sq.quotation_no %></a></td>
            <td class="font-monospace"><%= sq.machine_no || '—' %></td>
            <td><%= sq.customer_name || '—' %></td>
            <td>₹<%= formatINR(sq.grand_total) %></td>
            <td class="text-muted"><%= new Date(sq.created_at).toLocaleDateString('en-IN') %></td>
            <td><a href="/spare-quotations/<%= sq.id %>/pdf" class="btn btn-sm btn-outline-danger"><i class="bi bi-file-pdf"></i></a></td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
  <% } %>

</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body></html>
