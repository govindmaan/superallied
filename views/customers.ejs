<%- include('partials/head', { title }) %>
<%- include('partials/sidebar', { active: 'customers', user }) %>
<div class="main-content">
  <div class="page-header d-flex justify-content-between align-items-center mb-4">
    <h4 class="mb-0 fw-bold">Customers <span class="badge bg-secondary ms-2"><%= customers.length %></span></h4>
    <a href="/customers/new" class="btn btn-danger"><i class="bi bi-plus-lg me-1"></i>Add Customer</a>
  </div>

  <% if (flash.success) { %><div class="alert alert-success alert-dismissible"><%= flash.success %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div><% } %>
  <% if (flash.error) { %><div class="alert alert-danger alert-dismissible"><%= flash.error %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div><% } %>

  <div class="card border-0 shadow-sm mb-3">
    <div class="card-body py-2">
      <form method="GET" action="/customers" class="d-flex gap-2">
        <input type="text" name="q" value="<%= q %>" class="form-control" placeholder="Search by name, phone, GSTIN or PAN…">
        <button class="btn btn-outline-secondary"><i class="bi bi-search"></i></button>
        <% if (q) { %><a href="/customers" class="btn btn-outline-danger">Clear</a><% } %>
      </form>
    </div>
  </div>

  <div class="card border-0 shadow-sm">
    <div class="table-responsive">
      <table class="table table-hover mb-0">
        <thead class="table-light">
          <tr><th>Name</th><th>Phone</th><th>GSTIN / PAN</th><th>City / State</th><th>Added</th><th></th></tr>
        </thead>
        <tbody>
          <% customers.forEach(c => { %>
          <tr>
            <td class="fw-semibold"><%= c.name %></td>
            <td><%= c.phone %></td>
            <td class="font-monospace small"><%= c.gstin %><% if (c.pan && !c.gstin) { %><%= c.pan %><% } %></td>
            <td class="text-muted small"><%= [c.city, c.state].filter(Boolean).join(', ') %></td>
            <td class="text-muted small"><%= new Date(c.created_at).toLocaleDateString('en-IN') %></td>
            <td class="text-end">
              <a href="/quotations/new?customer_id=<%= c.id %>" class="btn btn-sm btn-outline-danger me-1" title="New Quotation"><i class="bi bi-file-earmark-plus"></i></a>
              <a href="/customers/<%= c.id %>/edit" class="btn btn-sm btn-outline-secondary me-1"><i class="bi bi-pencil"></i></a>
              <form method="POST" action="/customers/<%= c.id %>/delete" class="d-inline" onsubmit="return confirm('Delete this customer?')">
                <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
              </form>
            </td>
          </tr>
          <% }) %>
          <% if (!customers.length) { %>
          <tr><td colspan="6" class="text-center text-muted py-4">No customers found. <a href="/customers/new">Add one.</a></td></tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body></html>
