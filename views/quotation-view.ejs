<%- include('partials/head', { title }) %>
<%- include('partials/sidebar', { active: 'quotations', user }) %>
<div class="main-content">
  <div class="page-header d-flex justify-content-between align-items-center mb-4">
    <h4 class="mb-0 fw-bold">Quotation <%= q.quotation_number %></h4>
    <div class="d-flex gap-2">
      <a href="/quotations/<%= q.id %>/edit" class="btn btn-outline-secondary"><i class="bi bi-pencil me-1"></i>Edit</a>
      <a href="/quotations/<%= q.id %>/pdf" class="btn btn-danger"><i class="bi bi-file-pdf me-1"></i>Download PDF</a>
    </div>
  </div>

  <% if (flash.success) { %><div class="alert alert-success"><%= flash.success %></div><% } %>
  <% if (flash.error) { %><div class="alert alert-danger"><%= flash.error %></div><% } %>

  <div class="row g-3">
    <div class="col-md-6">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-header bg-white fw-semibold">Customer Details</div>
        <div class="card-body">
          <dl class="row mb-0">
            <dt class="col-4 text-muted">Name</dt><dd class="col-8 fw-semibold"><%= q.customer_name %></dd>
            <dt class="col-4 text-muted">Phone</dt><dd class="col-8"><%= q.customer_phone %></dd>
            <dt class="col-4 text-muted">Address</dt><dd class="col-8"><%= q.customer_address %></dd>
            <dt class="col-4 text-muted">City/State</dt><dd class="col-8"><%= [q.customer_city, q.customer_state].filter(Boolean).join(', ') %></dd>
            <dt class="col-4 text-muted">GSTIN</dt><dd class="col-8 font-monospace"><%= q.customer_gstin %></dd>
            <dt class="col-4 text-muted">HP With</dt><dd class="col-8"><%= q.hp_with || '—' %></dd>
          </dl>
        </div>
      </div>
    </div>
    <div class="col-md-6">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-header bg-white fw-semibold">Machine Details</div>
        <div class="card-body">
          <dl class="row mb-0">
            <dt class="col-4 text-muted">Machine</dt><dd class="col-8"><div class="fw-semibold"><%= q.machine_name %></div>
              <% if (specs && specs.length > 0) { %>
                <div class="small text-muted mt-2">
                  <% specs.forEach(s => { %>
                    <div><strong><%= s.spec_name %>:</strong> <%= s.spec_value %></div>
                  <% }) %>
                </div>
              <% } %>
            </dd>
            <dt class="col-4 text-muted">Model Code</dt><dd class="col-8 small font-monospace"><%= q.model_code %></dd>
            <dt class="col-4 text-muted">HSN Code</dt><dd class="col-8"><%= q.hsn_code %></dd>
            <dt class="col-4 text-muted">Engine</dt><dd class="col-8 small"><%= q.engine %></dd>
            <dt class="col-4 text-muted">Transmission</dt><dd class="col-8 small"><%= q.transmission %></dd>
            <% if (q.tyre_option) { %><dt class="col-4 text-muted">Tyre Type</dt><dd class="col-8 small"><%= q.tyre_option === 'HD' ? 'HD Tyre - 14.00x25' : 'IT Tyre - 16.09x28' %></dd><% } %>
            <dt class="col-4 text-muted">Quantity</dt><dd class="col-8"><%= q.quantity %></dd>
            <dt class="col-4 text-muted">Status</dt><dd class="col-8"><span class="badge <%= q.status==='accepted'?'bg-success':q.status==='sent'?'bg-primary':q.status==='rejected'?'bg-danger':'bg-secondary' %>"><%= q.status %></span></dd>
          </dl>
        </div>
      </div>
    </div>
    <div class="col-md-6">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-header bg-white fw-semibold">Salesperson</div>
        <div class="card-body">
          <dl class="row mb-0">
            <dt class="col-4 text-muted">Name</dt><dd class="col-8 fw-semibold"><%= q.salesperson_name || '—' %></dd>
            <dt class="col-4 text-muted">Phone</dt><dd class="col-8"><%= q.salesperson_phone || '—' %></dd>
          </dl>
        </div>
      </div>
    </div>
    <div class="col-12">
      <div class="card border-0 shadow-sm">
        <div class="card-header bg-white fw-semibold">Price Breakdown</div>
        <div class="card-body">
          <table class="table table-sm table-bordered mb-0" style="max-width:500px">
            <tr><td>Basic Price (× <%= q.quantity %>)</td><td class="text-end">₹<%= formatINR(calc.basic) %></td></tr>
            <% if (q.tax_mode === 'IGST') { %>
            <tr><td>IGST @ <%= q.igst_rate %>%</td><td class="text-end">₹<%= formatINR(calc.igst) %></td></tr>
            <% } else { %>
            <tr><td>CGST @ <%= q.cgst_rate %>%</td><td class="text-end">₹<%= formatINR(calc.cgst) %></td></tr>
            <tr><td>SGST @ <%= q.sgst_rate %>%</td><td class="text-end">₹<%= formatINR(calc.sgst) %></td></tr>
            <% } %>
            <tr class="table-light fw-semibold"><td>Total (before TCS)</td><td class="text-end">₹<%= formatINR(calc.preTcs) %></td></tr>
            <% if (q.has_tcs) { %>
            <tr><td>TCS @ <%= q.tcs_rate %>%</td><td class="text-end">₹<%= formatINR(calc.tcs) %></td></tr>
            <% } %>
            <% if (calc.roundoffApplied) { %>
            <tr style="background-color: #fff3cd"><td><strong>Roundoff (Up)</strong></td><td class="text-end text-warning fw-bold">+ ₹<%= formatINR(calc.roundoff) %></td></tr>
            <% } %>
            <tr class="table-secondary fw-semibold"><td>Ex-Showroom Price</td><td class="text-end">₹<%= formatINR(calc.exShowroom) %></td></tr>
            <tr><td>Insurance (with IMT-23)</td><td class="text-end"><%= calc.insuranceAmount > 0 ? '₹' + formatINR(calc.insuranceAmount) : '—' %></td></tr>
            <tr><td>TRC / LTT</td><td class="text-end"><%= calc.trcAmount > 0 ? '₹' + formatINR(calc.trcAmount) : '—' %></td></tr>
            <tr><td>Handling Charges</td><td class="text-end"><%= calc.handling > 0 ? '₹' + formatINR(calc.handling) : '—' %></td></tr>
            <tr><td>Transport</td><td class="text-end"><%= calc.transport > 0 ? '₹' + formatINR(calc.transport) : 'Extra as Actual' %></td></tr>
            <tr class="table-danger fw-bold"><td>Grand Total</td><td class="text-end">₹<%= formatINR(calc.total) %></td></tr>
          </table>
          <p class="mt-3 mb-0 fst-italic text-muted">Amount in words: <strong><%= calc.amountWords %></strong></p>
        </div>
      </div>
    </div>
  </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body></html>
