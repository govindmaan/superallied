<%- include('partials/head', { title }) %>
<%- include('partials/sidebar', { active: 'quotations', user }) %>
<div class="main-content">
  <div class="page-header d-flex justify-content-between align-items-center mb-4">
    <h4 class="mb-0 fw-bold"><%= t("Quotation") %> <%= q.quotation_number %></h4>
    <div class="d-flex gap-2">
      <% if (q.cancelled_at) { %>
      <form method="POST" action="/quotations/<%= q.id %>/restore">
        <button class="btn btn-success"><i class="bi bi-arrow-counterclockwise me-1"></i><%= t("Restore") %></button>
      </form>
      <% } else { %>
      <a href="/quotations/<%= q.id %>/edit" class="btn btn-outline-secondary"><i class="bi bi-pencil me-1"></i><%= t("Edit") %></a>
      <a href="/quotations/<%= q.id %>/pdf" class="btn btn-danger"><i class="bi bi-file-pdf me-1"></i><%= t("Download PDF") %></a>
      <% } %>
    </div>
  </div>

  <% if (q.cancelled_at) { %>
  <div class="alert alert-dark d-flex align-items-center gap-2">
    <i class="bi bi-x-circle-fill fs-5"></i>
    <div><strong><%= t("Cancelled") %></strong><%= q.cancelled_by_name ? ' by ' + q.cancelled_by_name : '' %> <%= t("on") %>
      <%= new Date(q.cancelled_at + 'Z').toLocaleString(locale, { dateStyle: 'medium', timeStyle: 'short', timeZone: 'Asia/Kolkata' }) %><%= t(". It is hidden from users. Restore it to edit or download.") %></div>
  </div>
  <% } %>

  <% if (flash.success) { %><div class="alert alert-success"><%= flash.success %></div><% } %>
  <% if (flash.error) { %><div class="alert alert-danger"><%= flash.error %></div><% } %>

  <div class="row g-3">
    <div class="col-md-6">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-header bg-white fw-semibold"><%= t("Customer Details") %></div>
        <div class="card-body">
          <dl class="row mb-0">
            <dt class="col-4 text-muted"><%= t("Name") %></dt><dd class="col-8 fw-semibold"><%= q.customer_name %></dd>
            <dt class="col-4 text-muted"><%= t("Phone") %></dt><dd class="col-8"><%= q.customer_phone %></dd>
            <dt class="col-4 text-muted"><%= t("Address") %></dt><dd class="col-8"><%= q.customer_address %></dd>
            <dt class="col-4 text-muted"><%= t("City/State") %></dt><dd class="col-8"><%= [q.customer_city, q.customer_state].filter(Boolean).join(', ') %></dd>
            <% customerIds.forEach(id => { %>
            <dt class="col-4 text-muted"><%= t(id.label) %></dt><dd class="col-8 font-monospace"><%= id.value %></dd>
            <% }) %>
            <dt class="col-4 text-muted"><%= t("HP With") %></dt><dd class="col-8"><%= q.hp_with || '—' %></dd>
          </dl>
        </div>
      </div>
    </div>
    <div class="col-md-6">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-header bg-white fw-semibold"><%= t("Machine Details") %></div>
        <div class="card-body">
          <dl class="row mb-0">
            <dt class="col-4 text-muted"><%= t("Machine") %></dt><dd class="col-8"><div class="fw-semibold"><%= q.machine_name %></div>
              <% if (specs && specs.length > 0) { %>
                <div class="small text-muted mt-2">
                  <% specs.forEach(s => { %>
                    <div><strong><%= s.spec_name %>:</strong> <%= s.spec_value %></div>
                  <% }) %>
                </div>
              <% } %>
            </dd>
            <dt class="col-4 text-muted"><%= t("Model Code") %></dt><dd class="col-8 small font-monospace"><%= q.model_code %></dd>
            <dt class="col-4 text-muted"><%= t("HSN Code") %></dt><dd class="col-8"><%= q.hsn_code %></dd>
            <dt class="col-4 text-muted"><%= t("Engine") %></dt><dd class="col-8 small"><%= q.engine %></dd>
            <% if (q.tyre_option) { %><dt class="col-4 text-muted"><%= t("Tyre Type") %></dt><dd class="col-8 small"><%= q.tyre_option === 'HD' ? t('HD Tyre - 14.00x25') : t('IT Tyre - 16.09x28') %></dd><% } %>
            <dt class="col-4 text-muted"><%= t("Quantity") %></dt><dd class="col-8"><%= q.quantity %></dd>
            <dt class="col-4 text-muted"><%= t("Status") %></dt><dd class="col-8"><span class="badge <%= q.status==='accepted'?'bg-success':q.status==='sent'?'bg-primary':q.status==='rejected'?'bg-danger':'bg-secondary' %>"><%= q.status %></span></dd>
          </dl>
        </div>
      </div>
    </div>
    <div class="col-md-6">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-header bg-white fw-semibold"><%= t("Salesperson") %></div>
        <div class="card-body">
          <dl class="row mb-0">
            <dt class="col-4 text-muted"><%= t("Name") %></dt><dd class="col-8 fw-semibold"><%= q.salesperson_name || '—' %></dd>
            <dt class="col-4 text-muted"><%= t("Phone") %></dt><dd class="col-8"><%= q.salesperson_phone || '—' %></dd>
            <dt class="col-4 text-muted"><%= t("Quotation Date") %></dt><dd class="col-8"><%= quotationDate %></dd>
            <dt class="col-4 text-muted"><%= t("Valid Till") %></dt><dd class="col-8"><%= validTill %></dd>
          </dl>
        </div>
      </div>
    </div>
    <div class="col-12">
      <div class="card border-0 shadow-sm">
        <div class="card-header bg-white fw-semibold"><%= t("Price Breakdown") %></div>
        <div class="card-body">
          <table class="table table-sm table-bordered mb-0" style="max-width:500px">
            <tr><td><%= t("Basic Price (×") %> <%= q.quantity %>)</td><td class="text-end">₹<%= formatINR(calc.basic) %></td></tr>
            <% if (q.tax_mode === 'IGST') { %>
            <tr><td><%= t("IGST @") %> <%= q.igst_rate %>%</td><td class="text-end">₹<%= formatINR(calc.igst) %></td></tr>
            <% } else { %>
            <tr><td><%= t("CGST @") %> <%= q.cgst_rate %>%</td><td class="text-end">₹<%= formatINR(calc.cgst) %></td></tr>
            <tr><td><%= t("SGST @") %> <%= q.sgst_rate %>%</td><td class="text-end">₹<%= formatINR(calc.sgst) %></td></tr>
            <% } %>
            <tr class="table-light fw-semibold"><td><%= t("Total (before TCS)") %></td><td class="text-end">₹<%= formatINR(calc.preTcs) %></td></tr>
            <% if (q.has_tcs) { %>
            <tr><td><%= t("TCS @") %> <%= q.tcs_rate %>%</td><td class="text-end">₹<%= formatINR(calc.tcs) %></td></tr>
            <% } %>
            <% if (calc.roundoffApplied) { %>
            <tr style="background-color: #fff3cd"><td><strong><%= t("Roundoff (Up)") %></strong></td><td class="text-end text-warning fw-bold">+ ₹<%= formatINR(calc.roundoff) %></td></tr>
            <% } %>
            <tr class="table-secondary fw-semibold"><td><%= t("Ex-Showroom Price") %></td><td class="text-end">₹<%= formatINR(calc.exShowroom) %></td></tr>
            <% calc.extraItems.forEach(it => { %>
            <tr><td><%= it.description %></td><td class="text-end">₹<%= formatINR(it.amount) %></td></tr>
            <% }) %>
            <tr><td><%= t("Insurance (with IMT-23)") %></td><td class="text-end"><%= calc.insuranceAmount > 0 ? '₹' + formatINR(calc.insuranceAmount) : '—' %></td></tr>
            <tr><td><%= t("TRC / LTT") %></td><td class="text-end"><%= calc.trcAmount > 0 ? '₹' + formatINR(calc.trcAmount) : '—' %></td></tr>
            <tr><td><%= t("Handling Charges") %></td><td class="text-end"><%= calc.handling > 0 ? '₹' + formatINR(calc.handling) : '—' %></td></tr>
            <tr><td><%= t("Transport") %></td><td class="text-end"><%= calc.transport > 0 ? '₹' + formatINR(calc.transport) : t('Extra as Actual') %></td></tr>
            <tr class="table-danger fw-bold"><td><%= t("Grand Total") %></td><td class="text-end">₹<%= formatINR(calc.total) %></td></tr>
          </table>
          <p class="mt-3 mb-0 fst-italic text-muted"><%= t("Amount in words:") %> <strong><%= calc.amountWords %></strong></p>
        </div>
      </div>
    </div>
    <div class="col-12">
      <div class="card border-0 shadow-sm">
        <div class="card-header bg-white fw-semibold"><%= t("Terms & Conditions") %> <small class="text-muted fw-normal"><%= t("— printed on the PDF") %></small></div>
        <div class="card-body">
          <ol class="mb-0 small">
            <% terms.forEach(term => { %><li class="mb-1"><strong><%= term.label %>:</strong> <%= term.text %></li><% }) %>
          </ol>
        </div>
      </div>
    </div>
  </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body></html>
