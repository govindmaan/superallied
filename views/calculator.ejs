<%- include('partials/head', { title }) %>
<%- include('partials/sidebar', { active: 'calculator', user }) %>
<div class="main-content">
  <div class="page-header mb-4">
    <h4 class="mb-0 fw-bold"><i class="bi bi-calculator me-2 text-danger"></i><%= t("Profit / Dealer Landing Calculator") %></h4>
    <p class="text-muted small mb-0 mt-1"><%= t("Internal use only — not shown on quotation. Based on dealer purchase price from price list.") %></p>
  </div>

  <div class="row g-4">
    <!-- LEFT: Inputs -->
    <div class="col-lg-5">

      <!-- Machine Selection -->
      <div class="card border-0 shadow-sm mb-3">
        <div class="card-header bg-white fw-semibold"><%= t("Machine") %></div>
        <div class="card-body">
          <label class="form-label small"><%= t("Select from catalog (auto-fills purchase price)") %></label>
          <select id="machineSelect" class="form-select form-select-sm mb-3" onchange="pickMachine(this)">
            <option value=""><%= t("— Select Machine —") %></option>
            <% const series = [...new Set(machines.map(m=>m.model_series))];
               series.forEach(s => { %>
            <optgroup label="<%= s %>">
              <% machines.filter(m=>m.model_series===s).forEach(m => { %>
              <option value="<%= m.basic_price %>"><%= m.display_name %> — ₹<%= formatINR(m.basic_price) %></option>
              <% }) %>
            </optgroup>
            <% }) %>
          </select>

          <label class="form-label small fw-semibold"><%= t("Basic Price (Purchase / Dealer Price) ₹") %></label>
          <input type="number" id="i_basic" class="form-control" value="0" oninput="calc()">
        </div>
      </div>

      <!-- Purchase Cost -->
      <div class="card border-0 shadow-sm mb-3">
        <div class="card-header bg-white fw-semibold"><%= t("Purchase Cost to Dealer") %></div>
        <div class="card-body">
          <div class="row g-2">
            <div class="col-8">
              <label class="form-label small"><%= t("Transit Insurance") %> <span class="badge bg-secondary"><%= t("Fixed") %></span></label>
              <input type="number" id="i_transit" class="form-control form-control-sm" value="2360" oninput="calc()">
            </div>
            <div class="col-4">
              <label class="form-label small"><%= t("GST Rate %") %></label>
              <input type="number" id="i_gst" class="form-control form-control-sm" value="18" step="0.01" oninput="calc()">
            </div>
          </div>
        </div>
      </div>

      <!-- Expenses -->
      <div class="card border-0 shadow-sm mb-3">
        <div class="card-header bg-white fw-semibold"><%= t("Add: Expenses") %></div>
        <div class="card-body">
          <div class="row g-2">
            <div class="col-6">
              <label class="form-label small"><%= t("Transport ₹") %></label>
              <input type="number" id="i_transport" class="form-control form-control-sm" value="0" oninput="calc()">
            </div>
            <div class="col-6">
              <label class="form-label small"><%= t("Insurance ₹") %></label>
              <input type="number" id="i_insurance" class="form-control form-control-sm" value="0" oninput="calc()">
            </div>
            <div class="col-6">
              <label class="form-label small"><%= t("TCS Rate %") %></label>
              <input type="number" id="i_tcs_rate" class="form-control form-control-sm" value="1" step="0.01" oninput="calc()">
            </div>
            <div class="col-6">
              <label class="form-label small"><%= t("RTO Charges ₹") %></label>
              <input type="number" id="i_rto" class="form-control form-control-sm" value="0" oninput="calc()">
            </div>
            <div class="col-12">
              <label class="form-label small"><%= t("Handling Charges ₹") %></label>
              <input type="number" id="i_handling" class="form-control form-control-sm" value="0" oninput="calc()">
            </div>
          </div>
        </div>
      </div>

      <!-- Selling Price -->
      <div class="card border-danger shadow-sm">
        <div class="card-header bg-danger text-white fw-semibold"><%= t("Selling Price (to Customer)") %></div>
        <div class="card-body">
          <input type="number" id="i_selling" class="form-control form-control-lg fw-bold"
                 value="0" oninput="calc()" placeholder="<%= t("Enter selling price...") %>">
          <small class="text-muted"><%= t("Enter the price you'll quote to the customer") %></small>
        </div>
      </div>
    </div>

    <!-- RIGHT: Live Results -->
    <div class="col-lg-7">
      <div class="card border-0 shadow-sm sticky-top" style="top:20px">
        <div class="card-header bg-dark text-white fw-semibold d-flex justify-content-between align-items-center">
          <span><%= t("Live Calculation") %></span>
          <button class="btn btn-sm btn-outline-light" onclick="resetAll()"><%= t("Reset") %></button>
        </div>
        <div class="card-body p-0">
          <table class="table table-sm mb-0">
            <tbody>
              <!-- Purchase cost section -->
              <tr class="table-light">
                <td colspan="2" class="fw-bold text-uppercase small text-muted px-3 py-2"><%= t("Purchase Cost (Dealer)") %></td>
              </tr>
              <tr>
                <td class="px-3"><%= t("Basic Price") %></td>
                <td class="text-end px-3 fw-semibold" id="r_basic">₹0</td>
              </tr>
              <tr>
                <td class="px-3"><%= t("Transit Insurance") %></td>
                <td class="text-end px-3" id="r_transit">₹0</td>
              </tr>
              <tr class="table-secondary">
                <td class="px-3 fw-bold"><%= t("Total Basic (Pre-GST)") %></td>
                <td class="text-end px-3 fw-bold" id="r_total_basic">₹0</td>
              </tr>
              <tr>
                <td class="px-3" id="r_gst_label"><%= t("GST @ 18%") %></td>
                <td class="text-end px-3" id="r_gst">₹0</td>
              </tr>
              <tr class="table-warning">
                <td class="px-3 fw-bold"><%= t("Price with GST") %> <small class="text-muted"><%= t("(Purchase Price)") %></small></td>
                <td class="text-end px-3 fw-bold" id="r_price_gst">₹0</td>
              </tr>

              <!-- Expenses section -->
              <tr class="table-light">
                <td colspan="2" class="fw-bold text-uppercase small text-muted px-3 py-2"><%= t("Expenses") %></td>
              </tr>
              <tr>
                <td class="px-3"><%= t("Transport") %></td>
                <td class="text-end px-3" id="r_transport">₹0</td>
              </tr>
              <tr>
                <td class="px-3"><%= t("Insurance") %></td>
                <td class="text-end px-3" id="r_insurance">₹0</td>
              </tr>
              <tr>
                <td class="px-3" id="r_tcs_label"><%= t("TCS @ 1%") %></td>
                <td class="text-end px-3" id="r_tcs">₹0</td>
              </tr>
              <tr>
                <td class="px-3"><%= t("RTO Charges") %></td>
                <td class="text-end px-3" id="r_rto">₹0</td>
              </tr>
              <tr>
                <td class="px-3"><%= t("Handling Charges") %></td>
                <td class="text-end px-3" id="r_handling">₹0</td>
              </tr>
              <tr class="table-secondary">
                <td class="px-3 fw-bold"><%= t("Total Expenses") %></td>
                <td class="text-end px-3 fw-bold" id="r_exp_total">₹0</td>
              </tr>

              <!-- Dealer Landing -->
              <tr class="table-danger">
                <td class="px-3 fw-bold fs-6"><%= t("Dealer Landing Price") %></td>
                <td class="text-end px-3 fw-bold fs-6" id="r_landing">₹0</td>
              </tr>

              <!-- Profit section -->
              <tr class="table-light">
                <td colspan="2" class="fw-bold text-uppercase small text-muted px-3 py-2"><%= t("Profit Analysis") %></td>
              </tr>
              <tr>
                <td class="px-3"><%= t("Selling Price") %></td>
                <td class="text-end px-3 fw-semibold" id="r_selling">₹0</td>
              </tr>
              <tr>
                <td class="px-3"><%= t("Dealer Landing") %></td>
                <td class="text-end px-3" id="r_landing2">₹0</td>
              </tr>
              <tr id="profitRow">
                <td class="px-3 fw-bold fs-5"><%= t("Profit") %></td>
                <td class="text-end px-3 fw-bold fs-5" id="r_profit">₹0</td>
              </tr>
              <tr id="profitPctRow">
                <td class="px-3 fw-semibold"><%= t("Profit %") %></td>
                <td class="text-end px-3" id="r_profit_pct">
                  <span class="badge bg-secondary fs-6">0.00%</span>
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
function inr(n) {
  return '₹' + Math.abs(n).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
}

function pickMachine(sel) {
  const v = parseFloat(sel.value);
  if (!isNaN(v)) { document.getElementById('i_basic').value = v; calc(); }
}

function resetAll() {
  ['i_basic','i_transport','i_insurance','i_rto','i_handling','i_selling'].forEach(id => {
    document.getElementById(id).value = 0;
  });
  document.getElementById('i_transit').value = 2360;
  document.getElementById('i_gst').value     = 18;
  document.getElementById('i_tcs_rate').value = 1;
  document.getElementById('machineSelect').value = '';
  calc();
}

function calc() {
  const basic      = parseFloat(document.getElementById('i_basic').value)    || 0;
  const transit    = parseFloat(document.getElementById('i_transit').value)   || 0;
  const gstRate    = parseFloat(document.getElementById('i_gst').value)       || 0;
  const transport  = parseFloat(document.getElementById('i_transport').value) || 0;
  const insurance  = parseFloat(document.getElementById('i_insurance').value) || 0;
  const tcsRate    = parseFloat(document.getElementById('i_tcs_rate').value)  || 0;
  const rto        = parseFloat(document.getElementById('i_rto').value)       || 0;
  const handling   = parseFloat(document.getElementById('i_handling').value)  || 0;
  const selling    = parseFloat(document.getElementById('i_selling').value)   || 0;

  const totalBasic = basic + transit;
  const gst        = totalBasic * gstRate / 100;
  const priceGST   = totalBasic + gst;                         // purchase price
  const tcs        = priceGST * tcsRate / 100;
  const totalExp   = transport + insurance + tcs + rto + handling;
  const landing    = priceGST + totalExp;                      // dealer landing
  const profit     = selling - landing;
  const profitPct  = landing > 0 ? (profit / landing) * 100 : 0;

  // Update labels
  document.getElementById('r_gst_label').textContent  = `GST @ ${gstRate}%`;
  document.getElementById('r_tcs_label').textContent  = `TCS @ ${tcsRate}%`;

  // Update values
  document.getElementById('r_basic').textContent      = inr(basic);
  document.getElementById('r_transit').textContent    = inr(transit);
  document.getElementById('r_total_basic').textContent= inr(totalBasic);
  document.getElementById('r_gst').textContent        = inr(gst);
  document.getElementById('r_price_gst').textContent  = inr(priceGST);
  document.getElementById('r_transport').textContent  = inr(transport);
  document.getElementById('r_insurance').textContent  = inr(insurance);
  document.getElementById('r_tcs').textContent        = inr(tcs);
  document.getElementById('r_rto').textContent        = inr(rto);
  document.getElementById('r_handling').textContent   = inr(handling);
  document.getElementById('r_exp_total').textContent  = inr(totalExp);
  document.getElementById('r_landing').textContent    = inr(landing);
  document.getElementById('r_landing2').textContent   = inr(landing);
  document.getElementById('r_selling').textContent    = inr(selling);

  const profitEl  = document.getElementById('r_profit');
  const profitRow = document.getElementById('profitRow');
  const pctEl     = document.getElementById('r_profit_pct').querySelector('.badge');

  profitEl.textContent = (profit >= 0 ? '+' : '-') + inr(profit);
  profitEl.className   = 'text-end px-3 fw-bold fs-5 ' + (profit >= 0 ? 'text-success' : 'text-danger');
  profitRow.className  = profit >= 0 ? 'table-success' : 'table-danger';
  pctEl.textContent    = profitPct.toFixed(2) + '%';
  pctEl.className      = 'badge fs-6 ' + (profitPct >= 5 ? 'bg-success' : profitPct >= 0 ? 'bg-warning text-dark' : 'bg-danger');
}

window.addEventListener('DOMContentLoaded', calc);
</script>
</body></html>
