<%- include('../partials/head', { title }) %>
<%- include('../partials/sidebar', { active: 'sold-machines', user }) %>
<div class="main-content">
  <div class="page-header d-flex justify-content-between align-items-center mb-4">
    <div>
      <h4 class="mb-0 fw-bold"><i class="bi bi-hdd-rack me-2 text-primary"></i><%= machine.machine_no %></h4>
      <small class="text-muted"><%= machine.model || '' %></small>
    </div>
    <div class="d-flex gap-2">
      <a href="/spare-quotations/new?machine_no=<%= encodeURIComponent(machine.machine_no) %>" class="btn btn-success">
        <i class="bi bi-plus-lg me-1"></i>New Spare Quotation
      </a>
      <a href="/sold-machines/<%= machine.id %>/edit" class="btn btn-outline-secondary">
        <i class="bi bi-pencil me-1"></i>Edit
      </a>
      <a href="/sold-machines" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i>Back
      </a>
    </div>
  </div>

  <% if (flash.success) { %><div class="alert alert-success alert-dismissible"><%= flash.success %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div><% } %>

  <div class="row g-3 mb-4">
    <!-- Customer Info -->
    <div class="col-md-6">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-header bg-success text-white fw-semibold"><i class="bi bi-person me-2"></i>Customer Details</div>
        <div class="card-body">
          <dl class="row mb-0 small">
            <dt class="col-5 text-muted">Customer Name</dt><dd class="col-7 fw-semibold"><%= machine.customer_name %></dd>
            <dt class="col-5 text-muted">Contact Person</dt><dd class="col-7"><%= machine.contact_person || '—' %></dd>
            <dt class="col-5 text-muted">Mobile 1</dt><dd class="col-7">
              <% if (machine.mobile_1) { %><a href="tel:<%= machine.mobile_1 %>"><%= machine.mobile_1 %></a><% } else { %>—<% } %>
            </dd>
            <dt class="col-5 text-muted">Mobile 2</dt><dd class="col-7"><%= machine.mobile_2 || '—' %></dd>
            <dt class="col-5 text-muted">Address</dt><dd class="col-7"><%= machine.customer_address || '—' %></dd>
            <dt class="col-5 text-muted">Place of Supply</dt><dd class="col-7"><%= machine.place_of_supply || '—' %></dd>
            <dt class="col-5 text-muted">GST Number</dt><dd class="col-7 font-monospace"><%= machine.gst_number || '—' %></dd>
            <dt class="col-5 text-muted">PAN Number</dt><dd class="col-7 font-monospace"><%= machine.pan_number || '—' %></dd>
          </dl>
        </div>
      </div>
    </div>
    <!-- Machine Info -->
    <div class="col-md-6">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-header bg-primary text-white fw-semibold"><i class="bi bi-hdd-rack me-2"></i>Machine Details</div>
        <div class="card-body">
          <dl class="row mb-0 small">
            <dt class="col-5 text-muted">Machine No</dt><dd class="col-7 fw-bold font-monospace"><%= machine.machine_no %></dd>
            <dt class="col-5 text-muted">Model</dt><dd class="col-7"><%= machine.model || '—' %></dd>
            <dt class="col-5 text-muted">Chassis No</dt><dd class="col-7 font-monospace"><%= machine.chassis_number || '—' %></dd>
            <dt class="col-5 text-muted">Engine No</dt><dd class="col-7 font-monospace"><%= machine.engine_number || '—' %></dd>
            <dt class="col-5 text-muted">Reg. No</dt><dd class="col-7"><%= machine.registration_no || '—' %></dd>
            <dt class="col-5 text-muted">Finance</dt><dd class="col-7"><%= machine.finance_type %> <% if (machine.financier) { %><small class="text-muted">(<%= machine.financier %>)</small><% } %></dd>
            <dt class="col-5 text-muted">Dealer</dt><dd class="col-7"><%= machine.dealer || '—' %></dd>
            <dt class="col-5 text-muted">Date of Sale</dt><dd class="col-7"><%= machine.date_of_sale ? new Date(machine.date_of_sale).toLocaleDateString('en-IN') : '—' %></dd>
          </dl>
        </div>
      </div>
    </div>
  </div>

  <!-- Quotation History -->
  <div class="card border-0 shadow-sm">
    <div class="card-header bg-white d-flex justify-content-between align-items-center">
      <span class="fw-semibold"><i class="bi bi-file-earmark-text me-2"></i>Spare Part Quotation History (<%= quotations.length %>)</span>
      <a href="/spare-quotations/new?machine_no=<%= encodeURIComponent(machine.machine_no) %>" class="btn btn-sm btn-success">
        <i class="bi bi-plus-lg me-1"></i>New Quotation
      </a>
    </div>
    <div class="table-responsive">
      <table class="table table-hover mb-0 align-middle">
        <thead class="table-light">
          <tr>
            <th>Quotation No</th>
            <th>Date</th>
            <th>Items</th>
            <th>Grand Total</th>
            <th>Status</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% if (quotations.length === 0) { %>
          <tr><td colspan="6" class="text-center text-muted py-4">No quotations yet.</td></tr>
          <% } %>
          <% quotations.forEach(q => { %>
          <tr>
            <td><a href="/spare-quotations/<%= q.id %>" class="fw-semibold text-decoration-none"><%= q.quotation_no %></a></td>
            <td><small><%= new Date(q.created_at).toLocaleDateString('en-IN') %></small></td>
            <td><span class="badge bg-secondary"><%= q.item_count %> parts</span></td>
            <td class="fw-semibold">₹<%= formatINR(q.grand_total) %></td>
            <td>
              <% const sc = {draft:'bg-secondary',sent:'bg-primary',approved:'bg-success',rejected:'bg-danger',converted:'bg-info'}; %>
              <span class="badge <%= sc[q.status]||'bg-secondary' %>"><%= q.status %></span>
            </td>
            <td>
              <a href="/spare-quotations/<%= q.id %>/pdf" class="btn btn-sm btn-outline-danger" title="PDF">
                <i class="bi bi-file-pdf"></i>
              </a>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Danger zone -->
  <% if (user && user.role === 'admin') { %>
  <div class="card border-0 shadow-sm mt-3">
    <div class="card-body d-flex align-items-center justify-content-between">
      <% if (machine.is_active !== 0) { %>
      <span class="text-muted small">Deactivate this machine to hide it from active records. Data is preserved.</span>
      <form method="post" action="/sold-machines/<%= machine.id %>/deactivate"
            onsubmit="return confirm('Deactivate machine <%= machine.machine_no %>?')">
        <button class="btn btn-sm btn-outline-danger"><i class="bi bi-slash-circle me-1"></i>Deactivate Machine</button>
      </form>
      <% } else { %>
      <span class="text-muted small">This machine is currently inactive.</span>
      <form method="post" action="/sold-machines/<%= machine.id %>/reactivate">
        <button class="btn btn-sm btn-outline-success"><i class="bi bi-arrow-counterclockwise me-1"></i>Reactivate Machine</button>
      </form>
      <% } %>
    </div>
  </div>
  <% } %>
</div>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body></html>
