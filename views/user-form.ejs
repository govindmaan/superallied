<%- include('partials/head', { title }) %>
<%- include('partials/sidebar', { active: 'users', user }) %>
<div class="main-content">
  <div class="page-header d-flex justify-content-between align-items-center mb-4">
    <h4 class="mb-0 fw-bold"><i class="bi bi-person-plus me-2 text-danger"></i><%= t("Add Staff Account") %></h4>
    <a href="/users" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i><%= t("Back") %></a>
  </div>

  <% if (flash.error) { %><div class="alert alert-danger"><%= flash.error %></div><% } %>

  <div class="row justify-content-center">
    <div class="col-lg-5 col-md-7">
      <div class="card border-0 shadow-sm">
        <div class="card-body p-4">
          <form method="POST" action="/users">
            <div class="mb-3">
              <label class="form-label fw-semibold"><%= t("Username") %> <span class="text-danger">*</span></label>
              <input type="text" name="username" class="form-control" required
                     placeholder="<%= t("e.g. rahul.sales") %>" autocomplete="off">
              <small class="text-muted"><%= t("Used to log in. No spaces, lowercase preferred.") %></small>
            </div>
            <div class="mb-3">
              <label class="form-label fw-semibold"><%= t("Full Name") %></label>
              <input type="text" name="full_name" class="form-control"
                     placeholder="<%= t("e.g. Rahul Sharma") %>">
            </div>
            <div class="mb-3">
              <label class="form-label fw-semibold" for="position_code"><%= t("Position") %> <span class="text-danger">*</span></label>
              <select name="position_code" id="position_code" class="form-select" required>
                <option value=""><%= t("Choose position…") %></option>
                <% sections.forEach(sec => { const ps = positions.filter(p => p.section === sec); if (!ps.length) return; %>
                <optgroup label="<%= sec %>">
                  <% ps.forEach(p => { %>
                  <option value="<%= p.code %>" data-role="<%= p.default_role %>"
                          data-approvers="<%= p.approvers %>" data-vacant="<%= p.vacant.join(' → ') %>">L<%= p.level %> · <%= p.title %> (<%= p.filled %>/<%= p.planned %>)</option>
                  <% }) %>
                </optgroup>
                <% }) %>
              </select>
              <small class="text-muted"><%= t("From the organisation chart. Sets designation and department.") %></small>
              <div id="approvalPreview" class="alert alert-light border small py-2 mt-2 mb-0" hidden>
                <i class="bi bi-arrow-up-circle text-danger me-1"></i><%= t("Approvals will go to") %>: <strong id="approvalTo"></strong>
                <div class="text-muted text-xs" id="approvalVacant"></div>
              </div>
            </div>
            <div class="alert alert-light border small py-2 mb-3">
              <i class="bi bi-info-circle me-1 text-secondary"></i>
              <%= t("Access is determined by the position above — no separate role needed.") %>
            </div>
            <div class="mb-3">
              <label class="form-label fw-semibold"><%= t("Password") %> <span class="text-danger">*</span></label>
              <input type="password" name="password" class="form-control" required
                     autocomplete="new-password" minlength="6" placeholder="<%= t("Min. 6 characters") %>">
            </div>
            <div class="mb-4">
              <label class="form-label fw-semibold"><%= t("Confirm Password") %> <span class="text-danger">*</span></label>
              <input type="password" name="confirm" class="form-control" required
                     autocomplete="new-password" placeholder="<%= t("Repeat password") %>">
            </div>
            <button type="submit" class="btn btn-danger w-100 fw-bold">
              <i class="bi bi-person-plus me-1"></i><%= t("Create Account") %>
            </button>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
// Position → default app role, and where this person's approvals will go
(function () {
  const sel = document.getElementById('position_code');
  const box = document.getElementById('approvalPreview');
  const VACANT = <%- JSON.stringify(t('Vacant now, skipped')) %>;
  sel.addEventListener('change', () => {
    const o = sel.selectedOptions[0];
    if (!o || !o.value) { box.hidden = true; return; }
    document.getElementById('approvalTo').textContent = o.dataset.approvers || '—';
    document.getElementById('approvalVacant').textContent = o.dataset.vacant ? VACANT + ': ' + o.dataset.vacant : '';
    box.hidden = !o.dataset.approvers;
  });
})();
</script>
</body></html>
