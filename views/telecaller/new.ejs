<%- include('../partials/head', { title }) %>
<%- include('../partials/sidebar', { active: 'telecaller', user }) %>
<div class="main-content" style="max-width:560px">
  <a href="/telecaller" class="text-decoration-none small"><i class="bi bi-arrow-left me-1"></i><%= t("Telecaller Home") %></a>
  <% if (flash.error) { %><div class="alert alert-danger alert-dismissible mt-2"><%= flash.error %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div><% } %>

  <h4 class="fw-bold mt-2 mb-3"><i class="bi bi-plus-circle-fill text-primary me-2"></i><%= t("New Enquiry") %></h4>

  <form method="post" action="/telecaller/new" class="card border-0 shadow-sm">
    <div class="card-body">
      <label class="form-label small fw-semibold"><%= t("Customer Name *") %></label>
      <input name="customer_name" class="form-control form-control-lg mb-2" required autofocus>

      <label class="form-label small fw-semibold"><%= t("Mobile Number *") %></label>
      <input name="phone" type="tel" inputmode="numeric" class="form-control form-control-lg mb-1" maxlength="15" required
             placeholder="<%= t("10-digit mobile") %>">
      <div id="dupWarn" class="small text-danger mb-2" style="display:none"></div>

      <label class="form-label small fw-semibold"><%= t("Alternate Mobile") %></label>
      <input name="alt_phone" type="tel" inputmode="numeric" class="form-control mb-2" maxlength="15">

      <label class="form-label small fw-semibold"><%= t("Machine Interested") %></label>
      <input name="machine_interested" class="form-control mb-2" list="machines" placeholder="<%= t("e.g. SD76 AC Cabin") %>">
      <datalist id="machines">
        <option value="SD76 AC Cabin"><%= t("SD76 AC Cabin") %></option><option value="SD76 Supersmart"><%= t("SD76 Supersmart") %></option><option value="Challenger 55"><%= t("Challenger 55") %></option><option value="Challenger Turbo"><%= t("Challenger Turbo") %></option>
      </datalist>

      <div class="row g-2">
        <div class="col-6"><label class="form-label small fw-semibold"><%= t("Village / Town") %></label><input name="village_city" class="form-control"></div>
        <div class="col-6"><label class="form-label small fw-semibold"><%= t("District") %></label><input name="district" class="form-control" list="districts"></div>
      </div>
      <datalist id="districts">
        <option value="Meerut"><%= t("Meerut") %></option><option value="Baghpat"><%= t("Baghpat") %></option><option value="Muzaffarnagar"><%= t("Muzaffarnagar") %></option><option value="Shamli"><%= t("Shamli") %></option>
        <option value="Saharanpur"><%= t("Saharanpur") %></option><option value="Hapur"><%= t("Hapur") %></option><option value="Bijnor"><%= t("Bijnor") %></option><option value="Bulandshahar"><%= t("Bulandshahar") %></option>
      </datalist>
      <div class="row g-2 mt-0">
        <div class="col-6"><label class="form-label small fw-semibold"><%= t("State") %></label><input name="state" class="form-control" value="Uttar Pradesh"></div>
        <div class="col-6"><label class="form-label small fw-semibold"><%= t("Lead Source") %></label>
          <select name="lead_source" class="form-select">
            <option value="Telecaller"><%= t("Telecaller") %></option><option value="Bull CRM"><%= t("Bull CRM") %></option><option value="Call"><%= t("Call") %></option><option value="Reference"><%= t("Reference") %></option>
            <option value="Advertisement"><%= t("Advertisement") %></option><option value="Exhibition"><%= t("Exhibition") %></option><option value="Walk-in"><%= t("Walk-in") %></option><option value="Other"><%= t("Other") %></option>
          </select>
        </div>
      </div>

      <button class="btn btn-primary btn-lg w-100 mt-3"><i class="bi bi-check-lg me-1"></i><%= t("Save & Call") %></button>
    </div>
  </form>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
  // Live duplicate check against the existing enquiries endpoint
  const phone = document.querySelector('[name=phone]'), warn = document.getElementById('dupWarn');
  let t; phone.addEventListener('input', () => {
    clearTimeout(t); const d = phone.value.replace(/\D/g,'').slice(-10);
    if (d.length !== 10) { warn.style.display='none'; return; }
    t = setTimeout(async () => {
      try {
        const r = await fetch('/enquiries/api/check-duplicate?phone=' + d).then(x => x.json());
        if (Array.isArray(r) && r.length) {
          warn.textContent = '⚠ ' + r.length + ' existing enquiry(s) for this number: ' + r.map(e => e.enquiry_number).join(', ');
          warn.style.display = 'block';
        } else { warn.style.display='none'; }
      } catch(e) { warn.style.display='none'; }
    }, 400);
  });
</script>
</body></html>
