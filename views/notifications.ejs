<%- include('partials/head', { title }) %>
<%- include('partials/sidebar', { active: 'notifications', user }) %>
<div class="main-content">
  <div class="page-header d-flex justify-content-between align-items-center mb-4">
    <h4 class="mb-0 fw-bold"><i class="bi bi-bell me-2 text-danger"></i>Notifications</h4>
    <% if (notifications.length) { %>
    <form method="POST" action="/notifications/read-all" id="readAllForm">
      <button type="submit" class="btn btn-outline-secondary btn-sm">Mark all read</button>
    </form>
    <% } %>
  </div>

  <div class="card border-0 shadow-sm">
    <% if (!notifications.length) { %>
    <div class="card-body text-center text-muted py-5">
      <i class="bi bi-bell-slash fs-1 d-block mb-2"></i>
      No notifications yet.
    </div>
    <% } else { %>
    <div class="list-group list-group-flush">
      <% notifications.forEach(n => { %>
      <div class="list-group-item list-group-item-action <%= n.is_read ? '' : 'bg-light border-start border-danger border-3' %>">
        <div class="d-flex gap-3 align-items-start">
          <div class="mt-1">
            <% const icons = { salary:'cash-coin', leave:'calendar-x', attendance:'calendar-check', info:'info-circle' }; %>
            <i class="bi bi-<%= icons[n.type] || 'info-circle' %> text-danger fs-5"></i>
          </div>
          <div class="flex-grow-1">
            <div class="fw-semibold <%= n.is_read ? 'text-muted' : '' %>"><%= n.title %></div>
            <% if (n.body) { %><div class="small text-muted"><%= n.body %></div><% } %>
            <div class="text-muted" style="font-size:11px"><%= dbTime(n.created_at).toLocaleString('en-IN', { dateStyle: 'medium', timeStyle: 'short' }) %></div>
          </div>
          <% if (!n.is_read) { %><span class="badge bg-danger rounded-pill mt-1">New</span><% } %>
        </div>
      </div>
      <% }) %>
    </div>
    <% } %>
  </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
document.getElementById('readAllForm')?.addEventListener('submit', async e => {
  e.preventDefault();
  await fetch('/notifications/read-all', { method: 'POST' });
  location.reload();
});
</script>
</body></html>
