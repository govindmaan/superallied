<%- include('partials/head', { title }) %>
<%- include('partials/sidebar', { active: 'profile', user }) %>
<div class="main-content">
  <div class="page-header mb-4">
    <h4 class="mb-0 fw-bold"><i class="bi bi-person-circle me-2 text-danger"></i>My Profile</h4>
  </div>

  <% if (flash.success) { %><div class="alert alert-success alert-dismissible"><%= flash.success %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div><% } %>
  <% if (flash.error) { %><div class="alert alert-danger alert-dismissible"><%= flash.error %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div><% } %>

  <div class="row g-3 justify-content-center">
    <div class="col-md-6 col-lg-5">
      <div class="card border-0 shadow-sm">
        <div class="card-body text-center py-4">
          <!-- Photo -->
          <div id="photoContainer" class="mb-3">
            <% if (emp.photo_path) { %>
              <img src="<%= emp.photo_path %>" id="currentPhoto" style="width:120px;height:120px;border-radius:50%;object-fit:cover;border:3px solid #cc0000">
            <% } else { %>
              <div style="width:120px;height:120px;border-radius:50%;background:#cc0000;color:#fff;display:flex;align-items:center;justify-content:center;font-size:3rem;font-weight:900;margin:0 auto">
                <%= (emp.full_name||'U').charAt(0).toUpperCase() %>
              </div>
            <% } %>
          </div>

          <h5 class="fw-bold mb-0"><%= emp.full_name || emp.username %></h5>
          <p class="text-muted small mb-1"><%= emp.designation || '' %> <% if(emp.department){ %> · <%= emp.department %><% } %></p>
          <span class="badge bg-secondary mb-3"><%= emp.role %></span>

          <!-- Camera capture -->
          <div class="mb-3">
            <video id="camVideo" style="display:none;width:100%;border-radius:8px;max-height:240px" autoplay playsinline></video>
          </div>
          <div id="camControls" class="d-none d-flex gap-2 justify-content-center mb-3">
            <button class="btn btn-danger" onclick="snapSelfie()"><i class="bi bi-camera-fill me-1"></i>Snap</button>
            <button class="btn btn-outline-secondary" onclick="closeCamera()">Cancel</button>
          </div>
          <div id="uploadStatus" class="small text-muted mb-2"></div>
          <button id="openCamBtn" class="btn btn-outline-danger" onclick="openCamera()">
            <i class="bi bi-camera me-1"></i>Update Photo
          </button>
        </div>

        <hr class="my-0">

        <div class="card-body">
          <dl class="row mb-0">
            <dt class="col-5 text-muted small">Employee Code</dt><dd class="col-7 font-monospace small"><%= emp.employee_code || '—' %></dd>
            <dt class="col-5 text-muted small">Mobile</dt><dd class="col-7 small"><%= emp.mobile || '—' %></dd>
            <dt class="col-5 text-muted small">Department</dt><dd class="col-7 small"><%= emp.department || '—' %></dd>
            <dt class="col-5 text-muted small">Date of Joining</dt><dd class="col-7 small"><%= emp.date_of_joining || '—' %></dd>
            <dt class="col-5 text-muted small">Username</dt><dd class="col-7 font-monospace small"><%= emp.username %></dd>
          </dl>
          <div class="mt-3">
            <a href="/settings" class="btn btn-outline-secondary btn-sm"><i class="bi bi-key me-1"></i>Change Password</a>
            <a href="/id-card" class="btn btn-outline-danger btn-sm ms-2"><i class="bi bi-credit-card-2-front me-1"></i>My ID Card</a>
          </div>
        </div>
      </div>
    </div>

    <!-- Login PIN -->
    <div class="col-md-6 col-lg-5">
      <div class="card border-0 shadow-sm" id="pin">
        <div class="card-header bg-white fw-semibold d-flex justify-content-between align-items-center">
          <span><i class="bi bi-grid-3x3-gap me-1 text-danger"></i>Login PIN</span>
          <% if (emp.pin_hash) { %><span class="badge bg-success">On</span><% } else { %><span class="badge bg-secondary">Not set</span><% } %>
        </div>
        <div class="card-body">
          <p class="small text-muted">A 6-digit PIN lets you log in quickly on your phone. Your password still works too.</p>
          <form method="POST" action="/profile/pin" autocomplete="off">
            <div class="row g-2">
              <div class="col-6">
                <label class="form-label small fw-semibold"><%= emp.pin_hash ? 'New PIN' : 'PIN' %></label>
                <input type="password" name="pin" class="form-control form-control-lg text-center pin-field" inputmode="numeric"
                       pattern="[0-9]{6}" maxlength="6" placeholder="••••••" required autocomplete="new-password">
              </div>
              <div class="col-6">
                <label class="form-label small fw-semibold">Repeat PIN</label>
                <input type="password" name="confirm" class="form-control form-control-lg text-center pin-field" inputmode="numeric"
                       pattern="[0-9]{6}" maxlength="6" placeholder="••••••" required autocomplete="new-password">
              </div>
              <div class="col-12">
                <label class="form-label small fw-semibold">Current password</label>
                <input type="password" name="password" class="form-control" required autocomplete="current-password">
              </div>
            </div>
            <div class="d-flex gap-2 mt-3">
              <button class="btn btn-danger flex-grow-1"><i class="bi bi-check-lg me-1"></i><%= emp.pin_hash ? 'Change PIN' : 'Set PIN' %></button>
            </div>
          </form>
          <% if (emp.pin_hash) { %>
          <details class="mt-3 small">
            <summary class="text-muted">Remove PIN</summary>
            <form method="POST" action="/profile/pin" class="d-flex gap-2 mt-2">
              <input type="hidden" name="remove" value="1">
              <input type="password" name="password" class="form-control form-control-sm" placeholder="Current password" required autocomplete="current-password">
              <button class="btn btn-sm btn-outline-danger text-nowrap">Remove</button>
            </form>
          </details>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</div>
<style>.pin-field { letter-spacing: .5em; font-family: monospace; }</style>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
let _stream = null;
async function openCamera() {
  try {
    _stream = await navigator.mediaDevices.getUserMedia({ video: { facingMode: 'user' }, audio: false });
    document.getElementById('camVideo').srcObject = _stream;
    document.getElementById('camVideo').style.display = 'block';
    document.getElementById('camControls').classList.remove('d-none');
    document.getElementById('openCamBtn').style.display = 'none';
  } catch(e) { alert('Camera error: ' + e.message); }
}
async function snapSelfie() {
  const v = document.getElementById('camVideo');
  const c = document.createElement('canvas'); c.width = 480; c.height = 480;
  c.getContext('2d').drawImage(v, 0, 0, 480, 480);
  const data = c.toDataURL('image/jpeg', 0.8);
  closeCamera();
  document.getElementById('uploadStatus').textContent = 'Uploading…';
  try {
    const r = await fetch('/profile/photo', {
      method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ photo: data })
    }).then(r=>r.json());
    if (r.ok) {
      document.getElementById('photoContainer').innerHTML =
        `<img src="${r.path}" style="width:120px;height:120px;border-radius:50%;object-fit:cover;border:3px solid #cc0000">`;
      document.getElementById('uploadStatus').innerHTML = '<span class="text-success">✓ Photo updated!</span>';
    }
  } catch(e) { document.getElementById('uploadStatus').textContent = 'Upload failed.'; }
}
function closeCamera() {
  if (_stream) { _stream.getTracks().forEach(t=>t.stop()); _stream=null; }
  document.getElementById('camVideo').style.display = 'none';
  document.getElementById('camControls').classList.add('d-none');
  document.getElementById('openCamBtn').style.display = '';
}
</script>
</body></html>
