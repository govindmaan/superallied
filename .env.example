# Copy this file to .env for local development (never commit .env)

# Server port (Railway sets this automatically — do not add PORT to Railway variables)
PORT=3000

# Session secret — use a long random string in production
SESSION_SECRET=replace-with-64-random-chars

# SQLite database path
# Local:   DB_PATH=./data/quotation.db

# Accounts module: private folder for uploaded Tally invoices and receipt PDFs.
# Default: <folder of DB_PATH>/private/accounts (on Railway that is inside the /app/data volume).
# ACC_FILES_DIR=./data/private/accounts   (default, no need to set)
# Railway: DB_PATH=/app/data/quotation.db
DB_PATH=./data/quotation.db
